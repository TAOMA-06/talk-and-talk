.case-detail-page {
  padding-bottom: 64rpx;
}

.case-hero {
  margin-bottom: 22rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  border: 1rpx solid var(--tt-border);
}

.safety-hero {
  background: var(--tt-danger-soft);
  border-color: var(--tt-border);
}

.support-hero {
  background: var(--tt-info-soft);
  border-color: var(--tt-border);
}

.hero-kicker {
  color: var(--tt-accent);
  font-size: 20rpx;
  word-break: break-all;
}

.hero-title {
  margin-top: 10rpx;
  color: var(--tt-accent);
  font-size: 40rpx;
  font-weight: 800;
}

.hero-copy {
  margin-top: 13rpx;
  color: var(--tt-text);
  font-size: 24rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.section-title {
  margin-bottom: 13rpx;
  color: var(--tt-accent);
  font-size: 29rpx;
  font-weight: 800;
}

.submitted-summary {
  margin-bottom: 10rpx;
  padding: 18rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 15rpx;
  background: var(--tt-bg);
  border-color: var(--tt-border);
}

.detail-label {
  color: var(--tt-text-secondary);
  font-size: 21rpx;
  font-weight: 700;
}

.submitted-summary-copy {
  margin-top: 9rpx;
  color: var(--tt-text);
  font-size: 24rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 22rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--tt-accent-soft);
  color: var(--tt-text);
  font-size: 23rpx;
  line-height: 1.55;
}

.detail-row text:first-child {
  flex: 0 0 120rpx;
  color: var(--tt-text-secondary);
}

.detail-row text:last-child {
  flex: 1;
  text-align: right;
}

.privacy-note, .closed-note {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 13rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  line-height: 1.65;
}

.case-body, .follow-up-text {
  color: var(--tt-text);
  font-size: 24rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.follow-up {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--tt-accent-soft);
}

.follow-up-time {
  margin-top: 8rpx;
  color: var(--tt-text-secondary);
  font-size: 20rpx;
}

.follow-up-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-text);
  font-size: 24rpx;
  line-height: 1.65;
  border-color: var(--tt-border);
}

.full-button, .order-button, .center-button {
  width: 100%;
  margin-top: 18rpx;
  font-size: 25rpx;
}

.order-button, .center-button {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
  color: var(--tt-accent);
  min-height: 80rpx;
  border-color: var(--tt-accent-soft);
  border-radius: 14rpx;
}

.resolution-card {
  border-left: 7rpx solid var(--tt-success);
  border-left-color: var(--tt-success);
  background: var(--tt-success-soft);
}

.resolution-code {
  margin-top: 12rpx;
  color: var(--tt-text-secondary);
  font-size: 21rpx;
  overflow-wrap: anywhere;
}

.compact {
  padding: 38rpx 10rpx;
}

.retry-button {
  margin-top: 22rpx;
  background: var(--tt-accent);
  color: var(--tt-on-accent);
  font-size: 24rpx;
}

.order-button::after, .center-button::after, .retry-button::after {
  border: 0;
}

.evidence-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0 12rpx;
}

.evidence-action, .evidence-chip, .evidence-remove {
  margin: 0;
}

.evidence-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.evidence-draft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 16rpx;
  margin: 10rpx 0;
  border-radius: 14rpx;
  background: var(--tt-warning-soft);
  font-size: 24rpx;
}

.hero-title, .section-title {
  color: var(--tt-text);
  font-weight: 700;
}

.hero-copy, .detail-row, .privacy-note, .closed-note, .case-body, .follow-up-text {
  color: var(--tt-text-secondary);
}

.detail-label, .detail-row text:first-child, .follow-up-time, .resolution-code {
  color: var(--tt-text-tertiary);
}

.detail-row, .follow-up {
  border-color: var(--tt-border);
}

.privacy-note, .closed-note, .evidence-draft {
  background: var(--tt-surface-alt);
}

.full-button, .retry-button {
  min-height: 88rpx;
  border-radius: 14rpx;
}

.retry-button.button-hover {
  background: var(--tt-accent-pressed);
}

.retry-button[disabled], .full-button[disabled] {
  opacity: 0.52;
}

/* UI4 authority grouping: functional depth only, no perspective or playful motion. */
.case-hero {
  transition: opacity var(--tt-motion-press) var(--tt-ease-standard), transform var(--tt-motion-standard) var(--tt-ease-standard);
}

.case-authority-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--tt-border);
  border-top-width: 5rpx;
  background: var(--tt-surface);
  box-shadow: none;
  transform: none;
}

.case-record-card { border-top-color: var(--tt-color-pastel-blue-stroke); }
.case-followup-card { border-top-color: var(--tt-color-pastel-lavender-stroke); }
.resolution-card { border-top-color: var(--tt-color-status-success-stroke); }

.authority-label {
  display: inline-flex;
  min-height: 38rpx;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 0 12rpx;
  border: 1rpx solid var(--tt-border);
  border-radius: 999rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-tertiary);
  font-size: 19rpx;
  font-weight: 700;
}

.follow-up-input,
.evidence-draft,
.closed-note,
.privacy-note { transition: opacity var(--tt-motion-press) var(--tt-ease-standard), transform var(--tt-motion-standard) var(--tt-ease-standard); }

.follow-up-input:focus { border-color: var(--tt-border-strong); background: var(--tt-surface); }

@media (prefers-reduced-motion: reduce) {
  .case-hero,
  .case-authority-card,
  .follow-up-input,
  .evidence-draft,
  .closed-note,
  .privacy-note { animation: none !important; transition: none !important; transform: none !important; }
}

.case-detail-page.tt-motion-off .case-hero,
.case-detail-page.tt-motion-off .case-authority-card,
.case-detail-page.tt-motion-off .follow-up-input,
.case-detail-page.tt-motion-off .evidence-draft,
.case-detail-page.tt-motion-off .closed-note,
.case-detail-page.tt-motion-off .privacy-note {
  animation: none !important;
  transition: none !important;
  transform: none !important;
}
