.profile-page { padding-top: 22rpx; overflow-x: hidden; }
.personal-desk { position: relative; margin: 0 -8rpx 10rpx; padding: 6rpx 8rpx 0; }
.personal-desk::before { content: ""; position: absolute; top: 84rpx; right: -96rpx; width: 310rpx; height: 310rpx; border: 1rpx solid var(--tt-color-pastel-lavender-stroke); border-radius: 50%; opacity: .4; pointer-events: none; }
.desk-sign { position: relative; z-index: 5; display: flex; align-items: center; justify-content: space-between; min-height: 72rpx; padding: 0 10rpx; color: var(--tt-text-tertiary); font-size: 19rpx; font-weight: 800; letter-spacing: 2rpx; }
.desk-stage-layer { width: 100%; }
.desk-context-card { display: flex; min-height: 270rpx; flex-direction: column; justify-content: flex-end; padding: 32rpx; border: 1rpx solid; border-radius: 30rpx; }
.desk-context-card view { color: currentColor; font-size: 20rpx; font-weight: 800; letter-spacing: 2rpx; }
.desk-context-card text { width: 62%; margin-top: 14rpx; font-size: 27rpx; font-weight: 700; line-height: 1.38; }
.desk-private-card { border-color: var(--tt-color-pastel-blue-stroke); background: var(--tt-color-pastel-blue-bg); color: var(--tt-color-pastel-blue-fg); }
.desk-account-card { border-color: var(--tt-color-pastel-mint-stroke); background: var(--tt-color-pastel-mint-bg); color: var(--tt-color-pastel-mint-fg); }
.profile-hero { display: flex; min-height: 270rpx; align-items: center; gap: 24rpx; margin: 0; padding: 32rpx; border: 1rpx solid var(--tt-color-pastel-rose-stroke); border-radius: 30rpx; background: var(--tt-color-pastel-rose-bg); color: var(--tt-color-pastel-rose-fg); }
.profile-hero .title,
.profile-hero .muted { color: currentColor; }
.profile-hero .muted { color: var(--tt-color-pastel-rose-fg); }
.profile-identity { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: flex-start; gap: 8rpx; }
.profile-editor { margin-bottom: 20rpx; border-radius: 26rpx; }
input,textarea,.picker { width: 100%; margin-top: 14rpx; padding: 16rpx 18rpx; }
textarea { min-height: 160rpx; }
.profile-field-copy { margin-top: 8rpx; color: var(--tt-text-tertiary); font-size: 21rpx; line-height: 1.5; }
.small { font-size: 31rpx; }
.profile-hub { padding: 4rpx 24rpx; border-radius: 26rpx; }
.title.section-title,.section-title { margin: 40rpx 4rpx 16rpx; font-size: 32rpx; }
.text-button,.legal { min-height: 64rpx; padding: 10rpx 14rpx; border: 0; background: transparent; color: var(--tt-accent); font-size: 23rpx; }
.notification-header,.recommendation-header,.favorites-heading,.recent-views-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.notification-header .section-title { min-width: 0; flex: 1; }
.recommendation-header > view,.favorites-heading > view:first-child,.recent-views-heading > view:first-child { min-width: 0; flex: 1; }
.compact { padding: 40rpx 10rpx; }
.notification { position: relative; }
.notification.unread { border-left: 6rpx solid var(--tt-accent); background: var(--tt-accent-soft); }
.notification .name { padding-right: 72rpx; }
.unread-marker { position: absolute; top: 20rpx; right: 22rpx; padding: 4rpx 10rpx; border-radius: 999rpx; background: var(--tt-surface); color: var(--tt-accent); font-size: 19rpx; }
.name { color: var(--tt-text); font-size: 27rpx; font-weight: 700; line-height: 1.45; }
.recommendation-label { margin-top: 24rpx; color: var(--tt-text); font-size: 26rpx; font-weight: 700; }
.choices { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.choice,.behavior-tag { display: inline-flex; min-height: 66rpx; align-items: center; padding: 10rpx 18rpx; border: 1rpx solid var(--tt-border); border-radius: 999rpx; background: var(--tt-surface); color: var(--tt-text-secondary); font-size: 22rpx; }
.choice.selected { border-color: var(--tt-accent); background: var(--tt-accent-soft); color: var(--tt-accent); }
.behavior-tag { border-color: var(--tt-warning); background: var(--tt-warning-soft); color: var(--tt-warning); }
.recommendation-off,.behavior-tags { margin-top: 18rpx; }
.recommendation-exclusions,.favorites-card,.recent-views-card,.safety-entry,.companion-workbench,.companion-onboarding-card { position: relative; isolation: isolate; border-radius: 26rpx; background: var(--tt-surface); }
.recommendation-exclusions::before,.favorites-card::before,.recent-views-card::before,.safety-entry::before,.companion-workbench::before,.companion-onboarding-card::before { content: ""; position: absolute; z-index: 0; right: 14rpx; bottom: -7rpx; left: 14rpx; height: 50rpx; border: 1rpx solid var(--tt-border); border-radius: 20rpx; background: var(--tt-color-depth-neutral-near); opacity: .64; }
.recommendation-exclusions .title,
.recommendation-exclusions .muted,
.recommendation-exclusions .recommendation-exclusion-empty,
.recommendation-exclusions .recommendation-exclusion-list,
.favorites-card .favorites-heading,
.favorites-card .private-resource-error,
.favorites-card .favorite-list,
.favorites-card .favorites-empty,
.recent-views-card .recent-views-heading,
.recent-views-card .private-resource-error,
.recent-views-card .recent-views-list,
.recent-views-card .recent-views-empty,
.safety-entry .title,
.safety-entry .muted,
.safety-entry .safety-entry-button,
.companion-workbench .title,
.companion-workbench .muted,
.companion-workbench .workbench-button,
.companion-onboarding-card .title,
.companion-onboarding-card .muted,
.companion-onboarding-card .workbench-button { position: relative; z-index: 1; }
.recommendation-exclusion-list,.favorite-list,.recent-views-list { margin-top: 16rpx; padding-top: 4rpx; border-top: 1rpx solid var(--tt-border); }
.recommendation-exclusion-item,.favorite-item,.recent-view-item { margin-top: 12rpx; padding: 16rpx 18rpx; border: 1rpx solid var(--tt-border); border-radius: 16rpx; background: var(--tt-surface-alt); }
.recommendation-exclusion-main,.favorite-item-main,.recent-view-item-main { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.recommendation-exclusion-avatar { display: flex; width: 58rpx; height: 58rpx; flex: none; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--tt-accent-soft); color: var(--tt-accent); font-size: 19rpx; font-weight: 700; }
.recommendation-exclusion-copy { min-width: 0; flex: 1; }
.recommendation-exclusion-name,.favorite-item-name,.recent-view-item-name { min-width: 0; color: var(--tt-text); font-size: 25rpx; font-weight: 700; line-height: 1.45; }
.recommendation-exclusion-state,.favorite-item-meta,.recent-view-item-meta { margin-top: 5rpx; color: var(--tt-text-secondary); font-size: 21rpx; line-height: 1.48; }
.favorite-item-status,.recent-view-item-status { flex: none; color: var(--tt-accent); font-size: 22rpx; }
.recommendation-exclusion-actions { display: flex; gap: 10rpx; margin-top: 12rpx; }
.recommendation-exclusion-secondary,.recommendation-exclusion-restore { min-width: 0; min-height: 66rpx; flex: 1; padding: 10rpx; font-size: 22rpx; }
.recommendation-exclusion-secondary { background: var(--tt-surface); color: var(--tt-text-secondary); }
.recommendation-exclusion-restore { border-color: var(--tt-accent); background: var(--tt-accent-soft); color: var(--tt-accent); }
.recommendation-exclusion-empty,.favorites-empty,.recent-views-empty { margin-top: 14rpx; padding: 18rpx; border-radius: 16rpx; background: var(--tt-surface-alt); color: var(--tt-text-secondary); font-size: 23rpx; line-height: 1.58; }
.recommendation-exclusion-pagination,.favorite-pagination { margin-top: 14rpx; color: var(--tt-text-tertiary); font-size: 21rpx; text-align: center; }
.favorites-private,.recent-views-private { flex: none; padding: 4rpx 10rpx; border-radius: 999rpx; background: var(--tt-info-soft); color: var(--tt-info); font-size: 20rpx; }
.favorite-reminder { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid var(--tt-border); }
.favorite-reminder-copy { min-width: 0; flex: 1; }
.favorite-reminder-title { color: var(--tt-text); font-size: 23rpx; font-weight: 700; }
.favorite-reminder-state,.favorite-reminder-limit { margin-left: 6rpx; color: var(--tt-info); font-size: 20rpx; }
.favorite-reminder-description { margin-top: 5rpx; color: var(--tt-text-secondary); font-size: 20rpx; line-height: 1.48; }
.favorite-pagination-error,.private-resource-error { margin-top: 12rpx; padding: 16rpx; border-radius: 16rpx; background: var(--tt-danger-soft); color: var(--tt-danger); font-size: 22rpx; line-height: 1.55; }
.recent-views-clear,.safety-entry-button,.workbench-button,.notification-center-entry,.resource-retry { width: 100%; margin-top: 16rpx; }
.recent-views-clear { border-color: var(--tt-warning); background: var(--tt-warning-soft); color: var(--tt-warning); }
.safety-entry { background: var(--tt-accent-soft); }
.safety-entry-button { border-color: var(--tt-accent); background: var(--tt-surface); color: var(--tt-accent); }
.companion-workbench { background: var(--tt-info-soft); }
.resource-error-card { border-color: var(--tt-danger); background: var(--tt-danger-soft); }
.legal-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 6rpx 10rpx; margin-top: 30rpx; }
.legal { color: var(--tt-text-secondary); text-align: center; }
.account-actions { display: flex; flex-direction: column; gap: 6rpx; margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid var(--tt-border); }
.danger { color: var(--tt-danger); }
.profile-hub { border-color: var(--tt-color-pastel-lavender-stroke); background: var(--tt-color-pastel-lavender-bg); }
.favorites-card { border-color: var(--tt-color-pastel-rose-stroke); background: var(--tt-color-pastel-rose-bg); }
.recent-views-card { border-color: var(--tt-color-pastel-blue-stroke); background: var(--tt-color-pastel-blue-bg); }
.safety-entry { border-color: var(--tt-color-pastel-butter-stroke); background: var(--tt-color-pastel-butter-bg); }
.companion-workbench { border-color: var(--tt-color-pastel-mint-stroke); background: var(--tt-color-pastel-mint-bg); }
.companion-onboarding-card { border-color: var(--tt-color-pastel-apricot-stroke); background: var(--tt-color-pastel-apricot-bg); }
.notification.unread { border-left-color: var(--tt-color-status-info-fg); background: var(--tt-color-status-info-bg); }
.unread-marker { color: var(--tt-color-status-info-fg); }
.profile-page.tt-motion-off .desk-sign,
.profile-page.tt-motion-off .profile-editor,
.profile-page.tt-motion-off .profile-hub,
.profile-page.tt-motion-off .choice,
.profile-page.tt-motion-off .favorite-item,
.profile-page.tt-motion-off .recent-view-item,
.profile-page.tt-motion-off .notification { animation: none; transition: none; transform: none; }
@media (prefers-reduced-motion: reduce) {
  .personal-desk::before { display: none; }
}
