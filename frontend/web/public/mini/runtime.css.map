.public-profile-metric-label { margin-top: 6rpx; color: var(--tt-text-secondary); font-size: 21rpx; line-height: 1.45; }
.public-profile-group { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--tt-border); }
.public-profile-label { color: var(--tt-text); font-size: 24rpx; font-weight: 700; }
