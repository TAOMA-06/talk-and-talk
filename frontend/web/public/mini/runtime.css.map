.dispute-page {
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.policy-card, .card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--tt-surface);
  box-shadow: none;
  border: 1rpx solid var(--tt-border);
}

.authority-card {
  position: relative;
  overflow: hidden;
  box-shadow: none;
  transform: none;
}

.authority-label {
  display: inline-flex;
  min-height: 38rpx;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 0 12rpx;
  border: 1rpx solid var(--tt-border);
  border-radius: 999rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-tertiary);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: .4rpx;
}

.policy-card {
  background: var(--tt-accent-soft);
  border-color: var(--tt-border);
  border-left: 8rpx solid var(--tt-accent);
}

.intake-card { border-top: 5rpx solid var(--tt-color-pastel-butter-stroke); }
.attendance-card { border-top: 5rpx solid var(--tt-color-pastel-blue-stroke); }
.statements-card { border-top: 5rpx solid var(--tt-color-pastel-lavender-stroke); }

.eyebrow {
  color: var(--tt-accent);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.policy-title {
  margin-top: 10rpx;
  color: var(--tt-accent);
  font-size: 34rpx;
  font-weight: 800;
}

.policy-copy, .hint {
  margin-top: 12rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.policy-error {
  margin-top: 14rpx;
  padding: 14rpx;
  border-left: 5rpx solid var(--tt-danger);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 23rpx;
  line-height: 1.65;
  border-left-color: var(--tt-danger);
}

.eligibility-lock { border: 1rpx solid var(--tt-color-status-danger-stroke); border-left-width: 5rpx; }

.section-title {
  color: var(--tt-accent);
  font-size: 30rpx;
  font-weight: 800;
}

.issue {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  padding: 19rpx 0;
  border-bottom: 1rpx solid var(--tt-danger-soft);
  border-bottom-color: var(--tt-border);
}

.issue-label {
  color: var(--tt-text);
  font-size: 26rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.issue-help {
  margin-top: 5rpx;
  color: var(--tt-text-secondary);
  font-size: 21rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.statement {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--tt-danger-soft);
  border-radius: 14rpx;
  background: var(--tt-bg);
  color: var(--tt-text);
  font-size: 24rpx;
  line-height: 1.6;
  border-color: var(--tt-border);
  overflow-wrap: anywhere;
  transition: opacity var(--tt-motion-press) var(--tt-ease-standard), transform var(--tt-motion-standard) var(--tt-ease-standard);
}

.primary, .secondary, .retry {
  width: 100%;
  margin-top: 18rpx;
  border-radius: 14rpx;
  font-size: 25rpx;
  min-height: 88rpx;
}

.primary {
  background: var(--tt-accent);
  color: var(--tt-on-accent);
  border-color: var(--tt-accent);
}

.secondary, .retry {
  border: 1rpx solid var(--tt-border-strong);
  background: var(--tt-surface);
  color: var(--tt-accent);
  border-color: var(--tt-border-strong);
}

.primary::after, .secondary::after, .retry::after {
  border: 0;
}

.status-card {
  border-left: 8rpx solid var(--tt-accent);
  border-left-color: var(--tt-accent);
  background: var(--tt-surface);
}

.status-row, .deadline, .statement-meta {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.status-row {
  align-items: baseline;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
}

.status {
  color: var(--tt-accent);
  font-size: 31rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.deadline {
  padding: 13rpx 0;
  border-bottom: 1rpx solid var(--tt-danger-soft);
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  border-bottom-color: var(--tt-border);
}

.deadline text:last-child {
  color: var(--tt-text);
  min-width: 0;
  font-weight: 600;
  text-align: right;
  overflow-wrap: anywhere;
}

.trusted, .warning {
  margin-top: 14rpx;
  padding: 15rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  border: 1rpx solid;
}

.trusted {
  background: var(--tt-success-soft);
  color: var(--tt-success);
  border-color: var(--tt-border);
}

.warning {
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  border-color: var(--tt-border);
}

.participant-grid {
  display: flex;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.participant {
  padding: 18rpx;
  border-radius: 14rpx;
  background: var(--tt-bg);
  color: var(--tt-text-secondary);
  font-size: 20rpx;
  line-height: 1.7;
  min-width: 0;
  flex: 1 1 260rpx;
  border: 1rpx solid var(--tt-border);
  overflow-wrap: anywhere;
}

.participant-title {
  color: var(--tt-text);
  font-size: 25rpx;
  font-weight: 700;
}

.statement-item {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: var(--tt-bg);
  border: 1rpx solid var(--tt-border);
}

.statement-meta {
  color: var(--tt-text-tertiary);
  font-size: 20rpx;
}

.statement-copy {
  margin-top: 9rpx;
  color: var(--tt-accent);
  font-size: 24rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.decision-card {
  border-left: 8rpx solid var(--tt-border-strong);
  border-left-color: var(--tt-info);
  background: var(--tt-info-soft);
}

.status-card,
.decision-card,
.policy-error,
.trusted,
.warning { transition: opacity var(--tt-motion-press) var(--tt-ease-standard), transform var(--tt-motion-standard) var(--tt-ease-standard); }

.decision {
  margin-top: 12rpx;
  color: var(--tt-accent);
  font-size: 24rpx;
  line-height: 1.65;
}

.refund-state {
  margin-top: 16rpx;
  color: var(--tt-info);
  font-size: 25rpx;
  font-weight: 700;
}

.evidence-panel {
  margin: 18rpx 0;
  padding: 18rpx;
  border-radius: 18rpx;
  background: var(--tt-surface-alt);
  border: 1rpx solid var(--tt-border);
}

.evidence-toolbar, .evidence-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.evidence-toolbar button, .evidence-list button, .evidence-draft button {
  margin: 0;
  min-height: 64rpx;
  border-color: var(--tt-border-strong);
  background: var(--tt-surface);
  color: var(--tt-accent);
}

.evidence-draft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--tt-text);
  overflow-wrap: anywhere;
}

.evidence-list {
  margin-top: 12rpx;
}

.policy-title, .section-title {
  color: var(--tt-text);
  font-weight: 700;
  overflow-wrap: anywhere;
}

.statement-meta text:first-child {
  min-width: 0;
  overflow-wrap: anywhere;
}

.statement-meta text:last-child {
  flex: 0 0 auto;
  text-align: right;
}

.statement-copy, .decision {
  color: var(--tt-text);
  overflow-wrap: anywhere;
}

@media (prefers-reduced-motion: reduce) {
  .authority-card,
  .statement,
  .status-card,
  .decision-card,
  .policy-error,
  .trusted,
  .warning { animation: none !important; transition: none !important; transform: none !important; }
}

.dispute-page.tt-motion-off .authority-card,
.dispute-page.tt-motion-off .statement,
.dispute-page.tt-motion-off .status-card,
.dispute-page.tt-motion-off .decision-card,
.dispute-page.tt-motion-off .policy-error,
.dispute-page.tt-motion-off .trusted,
.dispute-page.tt-motion-off .warning {
  animation: none !important;
  transition: none !important;
  transform: none !important;
}
