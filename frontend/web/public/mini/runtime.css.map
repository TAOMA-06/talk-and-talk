.availability-page { padding-top: 22rpx; overflow-x: hidden; }
.calendar-studio { position: relative; margin: 0 -8rpx 22rpx; padding: 8rpx 8rpx 0; }
.calendar-studio::before { content: ""; position: absolute; top: 78rpx; right: -110rpx; width: 320rpx; height: 320rpx; border: 1rpx solid var(--tt-color-pastel-butter-stroke); border-radius: 50%; opacity: .42; pointer-events: none; }
.calendar-sign { position: relative; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0 10rpx 2rpx; color: var(--tt-text-tertiary); font-size: 19rpx; font-weight: 800; letter-spacing: 1.8rpx; }
.calendar-zone { flex: none; padding: 6rpx 13rpx; border: 1rpx solid var(--tt-color-pastel-blue-stroke); border-radius: 999rpx; background: var(--tt-color-pastel-blue-bg); color: var(--tt-color-pastel-blue-fg); letter-spacing: 0; }
.calendar-layer { width: 100%; }
.calendar-stage-card,.intro-card { box-sizing: border-box; min-height: 320rpx; padding: 32rpx; border: 1rpx solid; border-radius: 32rpx; overflow: hidden; }
.calendar-stage-card { position: relative; display: flex; flex-direction: column; justify-content: flex-end; }
.calendar-stage-capacity { border-color: var(--tt-color-pastel-mint-stroke); background: var(--tt-color-pastel-mint-bg); color: var(--tt-color-pastel-mint-fg); }
.calendar-stage-source { border-color: var(--tt-color-pastel-lavender-stroke); background: var(--tt-color-pastel-lavender-bg); color: var(--tt-color-pastel-lavender-fg); }
.stage-index { position: absolute; top: 28rpx; right: 30rpx; font-size: 19rpx; font-weight: 800; letter-spacing: 1.6rpx; }
.stage-title { width: 68%; font-size: 29rpx; font-weight: 750; line-height: 1.34; }
.stage-copy { width: 68%; margin-top: 10rpx; font-size: 21rpx; }
.calendar-props { display: flex; align-items: flex-end; gap: 2rpx; }
.intro-card {
  padding: 32rpx;
  background: var(--tt-color-pastel-butter-bg);
  border: 1rpx solid var(--tt-color-pastel-butter-stroke);
  color: var(--tt-color-pastel-butter-fg);
}

.summary {
  margin-top: 18rpx;
  color: var(--tt-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.create-button {
  margin-top: 22rpx;
  font-size: 28rpx;
  min-height: 88rpx;
}

.section-title {
  margin: 30rpx 0 16rpx;
  color: var(--tt-danger);
  font-size: 33rpx;
  font-weight: 700;
}

.window-card {
  min-width: 0;
}
.window-item { margin-bottom: 20rpx; }

.window-card.subdued {
  background: var(--tt-bg);
}
.window-item.subdued { color: var(--tt-text-secondary); }

.window-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.date-label {
  color: var(--tt-accent);
  font-size: 29rpx;
  font-weight: 700;
}

.time-label {
  margin-top: 10rpx;
  color: var(--tt-danger);
  font-size: 34rpx;
  font-weight: 700;
}

.window-meta {
  margin-top: 18rpx;
  color: var(--tt-text-secondary);
  font-size: 25rpx;
}

.window-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.edit-button {
  min-width: 104rpx;
  line-height: 68rpx;
  font-size: 25rpx;
}

.retire-button {
  min-width: 142rpx;
  line-height: 68rpx;
  font-size: 25rpx;
  border-color: var(--tt-border-strong);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.status-chip {
  flex: none;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.status-chip.active {
  background: var(--tt-success-soft);
  color: var(--tt-success);
}

.status-chip.inProgress {
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
}

.status-chip.expired, .status-chip.retired {
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
}

.access-empty {
  line-height: 1.7;
}

.access-title {
  color: var(--tt-danger);
  font-size: 34rpx;
  font-weight: 700;
}

.retry-button {
  margin-top: 28rpx;
}

.plain-button {
  margin: 0;
  padding: 0 22rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-accent);
  font-size: 27rpx;
  line-height: 82rpx;
}

.calendar-empty {
  padding-top: 62rpx;
  padding-bottom: 62rpx;
  line-height: 1.7;
}

.action-error {
  margin: 0 0 22rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 25rpx;
  line-height: 1.6;
}

.editor-mask {
  position: fixed;
  z-index: 10;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: var(--tt-overlay-scrim);
}

.editor-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 90vh;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--tt-surface);
}

.editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.small {
  font-size: 34rpx;
}

.close-button {
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--tt-text-secondary);
  font-size: 27rpx;
}

.editor-tip {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  font-size: 24rpx;
  line-height: 1.55;
}

.field-label {
  margin-top: 28rpx;
  color: var(--tt-accent);
  font-size: 28rpx;
  font-weight: 700;
}

.compact-label {
  margin-top: 0;
}

input, .picker {
  box-sizing: border-box;
  width: 100%;
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid var(--tt-danger-soft);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-text);
  font-size: 28rpx;
  border-color: var(--tt-border);
}

.field-hint {
  margin-top: 10rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.publish-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 32rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--tt-danger-soft);
  border-bottom: 1rpx solid var(--tt-danger-soft);
  border-color: var(--tt-border);
}

.publish-row > view {
  flex: 1;
}

.form-error {
  margin-top: 22rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 25rpx;
  line-height: 1.55;
}

.editor-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.cancel-button, .save-button {
  flex: 1;
  margin: 0;
  min-height: 88rpx;
  border-radius: 14rpx;
}

.cancel-button {
  line-height: 84rpx;
}

.primary-button {
  min-height: 88rpx;
}

.summary, .window-meta, .field-hint, .close-button {
  color: var(--tt-text-tertiary);
}

.section-title, .date-label, .time-label, .access-title, .field-label, .small {
  color: var(--tt-text);
  font-weight: 700;
}

.plain-button, .edit-button, .retire-button {
  min-height: 72rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
}

.action-error, .form-error {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.save-button.button-hover, .primary-button.button-hover {
  background: var(--tt-accent-pressed);
}

.save-button[disabled], .primary-button[disabled], .plain-button[disabled], .retire-button[disabled] {
  opacity: 0.52;
}

.intro-card .tt-kicker,.intro-card .title,.intro-card .muted,.intro-card .summary { color: currentColor; }

@media (prefers-reduced-motion: reduce) {
  .calendar-studio::before { display: none; }
}
