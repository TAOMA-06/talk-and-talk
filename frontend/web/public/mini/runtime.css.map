.adult-page {
  padding-top: 24rpx;
  padding-bottom: 64rpx;
}

.hero {
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--tt-surface);
  border: 2rpx solid var(--tt-border-strong);
}

.hero-ledger { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 24rpx; color: var(--tt-text-tertiary); font-size: 18rpx; font-weight: 800; letter-spacing: 1.6rpx; }

.eyebrow {
  color: var(--tt-accent);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 10rpx;
  color: var(--tt-accent);
  font-size: 38rpx;
  font-weight: 900;
}

.hero-copy, .section-copy {
  margin-top: 10rpx;
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  line-height: 1.7;
}

.eligibility-rail { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 8rpx; margin-top: 24rpx; }
.eligibility-rail > view { display: flex; min-width: 0; flex-direction: column; gap: 5rpx; padding: 14rpx; border: 1rpx solid var(--tt-border); border-radius: 14rpx; background: var(--tt-surface-alt); color: var(--tt-text-secondary); font-size: 19rpx; line-height: 1.35; }
.eligibility-rail text:first-child { color: var(--tt-text-tertiary); font-size: 17rpx; font-weight: 800; }

.card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: var(--tt-surface);
  box-shadow: none;
  border: 2rpx solid var(--tt-border);
}

.state-card {
  color: var(--tt-text);
  font-size: 23rpx;
  line-height: 1.6;
}

.error-card {
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.status-card {
  border: 1rpx solid var(--tt-border);
}

.status-success {
  border-color: var(--tt-border-strong);
  background: var(--tt-success-soft);
  color: var(--tt-success);
}

.status-pending {
  border-color: var(--tt-border);
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
}

.status-warning {
  border-color: var(--tt-border-strong);
  background: var(--tt-border);
}

.status-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  color: var(--tt-accent);
  font-size: 29rpx;
  font-weight: 850;
}

.status-pill {
  flex: 0 0 auto;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 20rpx;
  font-weight: 750;
}

.fact-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 18rpx;
  color: var(--tt-text);
  font-size: 21rpx;
  line-height: 1.5;
}

.fact-row text:first-child {
  flex: 0 0 auto;
  color: var(--tt-text-secondary);
}

.fact-row text:last-child {
  text-align: right;
  word-break: break-all;
}

.review-reason, .boundary-note {
  margin-top: 18rpx;
  padding: 15rpx;
  border-radius: 13rpx;
  background: var(--tt-surface);
  color: var(--tt-text-secondary);
  font-size: 21rpx;
  line-height: 1.65;
  border: 1rpx solid var(--tt-border);
}

.warning-note {
  color: var(--tt-danger);
}

.boundary-list {
  margin-top: 15rpx;
  color: var(--tt-text);
  font-size: 22rpx;
  line-height: 1.85;
}

.form {
  margin-top: 18rpx;
}

.picker-field, .form-input {
  box-sizing: border-box;
  width: 100%;
  margin-top: 14rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-text);
  font-size: 23rpx;
  border-color: var(--tt-border);
}

.picker-field {
  display: flex;
  justify-content: space-between;
  padding: 18rpx;
}

.form-input {
  height: 80rpx;
  padding: 0 18rpx;
}

.method-help {
  margin-top: 9rpx;
  color: var(--tt-text-secondary);
  font-size: 20rpx;
  line-height: 1.55;
}

.confirmation-row {
  display: flex;
  gap: 13rpx;
  margin-top: 18rpx;
  color: var(--tt-text);
  font-size: 21rpx;
  line-height: 1.65;
}

.confirmation-row checkbox {
  flex: 0 0 auto;
}

.full-button {
  width: 100%;
  margin-top: 18rpx;
  font-size: 24rpx;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  line-height: 1.35;
}

.primary-button {
  background: var(--tt-accent);
  color: var(--tt-on-accent);
}

.secondary-button {
  border: 1rpx solid var(--tt-border-strong);
  background: var(--tt-surface);
  color: var(--tt-accent);
}

.text-button {
  margin: 11rpx auto 0;
  background: transparent;
  color: var(--tt-accent);
  font-size: 22rpx;
}

.rights-card {
  border: 1rpx solid var(--tt-border);
}

.primary-button::after, .secondary-button::after, .text-button::after {
  border: 0;
}

.hero-title, .section-title {
  color: var(--tt-text);
  font-weight: 700;
}

.hero-copy, .section-copy, .state-card, .fact-row, .boundary-list, .confirmation-row {
  color: var(--tt-text-secondary);
}

.error-card, .status-warning {
  border-color: var(--tt-border);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.fact-row text:first-child, .method-help {
  color: var(--tt-text-tertiary);
}

.primary-button.button-hover {
  background: var(--tt-accent-pressed);
}

.primary-button[disabled], .secondary-button[disabled] {
  opacity: 0.52;
}
