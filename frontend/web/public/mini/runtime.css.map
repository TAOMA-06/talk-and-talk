.onboarding-page { padding-top: 24rpx; }
.hero {
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--tt-surface);
  box-shadow: none;
  border: 2rpx solid var(--tt-border-strong);
}

.hero-ledger { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 24rpx; color: var(--tt-text-tertiary); font-size: 19rpx; font-weight: 800; letter-spacing: 1.6rpx; }

.eyebrow {
  color: var(--tt-accent);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-copy {
  margin-top: 14rpx;
  color: var(--tt-text);
  font-size: 26rpx;
  line-height: 1.6;
}

.process-rail { display: grid; grid-template-columns: repeat(3,1fr); gap: 8rpx; margin-top: 24rpx; }
.process-step { display: flex; min-width: 0; flex-direction: column; gap: 5rpx; padding: 14rpx; border: 1rpx solid var(--tt-border); border-radius: 14rpx; background: var(--tt-surface-alt); color: var(--tt-text-tertiary); font-size: 20rpx; }
.process-step text:first-child { font-size: 18rpx; font-weight: 800; }
.process-step.current { border-color: var(--tt-color-pastel-apricot-stroke); background: var(--tt-color-pastel-apricot-bg); color: var(--tt-color-pastel-apricot-fg); }
.status-facts { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 8rpx; margin-top: 24rpx; }
.status-fact { display: flex; min-width: 0; flex-direction: column; gap: 6rpx; padding: 14rpx; border: 1rpx solid var(--tt-border); border-radius: 14rpx; background: var(--tt-surface-alt); color: var(--tt-text-secondary); font-size: 20rpx; line-height: 1.35; }
.status-fact text:last-child { color: var(--tt-text); font-weight: 700; overflow-wrap: anywhere; }

.warning {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  font-size: 24rpx;
  border: 1rpx solid var(--tt-border);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 34rpx 4rpx 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}
.section-index { display: inline-flex; width: 42rpx; height: 42rpx; align-items: center; justify-content: center; border: 1rpx solid var(--tt-border-strong); border-radius: 50%; color: var(--tt-text-secondary); font-size: 18rpx; }

.form-card {
  padding: 32rpx;
  border: 2rpx solid var(--tt-border);
  background: var(--tt-surface);
  box-shadow: none;
}

.field-label {
  margin: 22rpx 0 10rpx;
  color: var(--tt-text);
  font-size: 24rpx;
  font-weight: 600;
}

.field {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--tt-border-strong);
  border-radius: 16rpx;
  background: var(--tt-surface);
  font-size: 27rpx;
}

.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 220rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--tt-border-strong);
  border-radius: 16rpx;
  background: var(--tt-surface);
  font-size: 27rpx;
  line-height: 1.55;
}

.textarea.compact {
  min-height: 150rpx;
}

.two-column {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.subsection {
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid var(--tt-danger-soft);
  font-size: 28rpx;
  font-weight: 700;
  border-color: var(--tt-border);
}

.status-line, .hint {
  margin-top: 12rpx;
  color: var(--tt-text);
  font-size: 24rpx;
  line-height: 1.55;
}

.hint {
  color: var(--tt-text-tertiary);
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.status-title {
  font-size: 30rpx;
  font-weight: 700;
}

.status-badge {
  flex: none;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 22rpx;
}

.status-verified {
  background: var(--tt-success-soft);
  color: var(--tt-success);
}

.status-suspended {
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.privacy-notice {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
  border: 1rpx solid var(--tt-border);
}

.form-error {
  margin-top: 20rpx;
  color: var(--tt-danger);
  font-size: 24rpx;
  line-height: 1.5;
}

.submit {
  margin-top: 28rpx;
  min-height: 88rpx;
}

.secondary-button {
  margin-top: 16rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
  min-height: 80rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
}

.empty-title {
  margin-bottom: 14rpx;
  color: var(--tt-danger);
  font-size: 34rpx;
  font-weight: 700;
}

.retry {
  margin-top: 28rpx;
}

.primary-button {
  min-height: 88rpx;
}

.hero-title, .section-title, .status-title, .empty-title, .subsection {
  color: var(--tt-text);
  font-weight: 700;
}

.hero-copy, .field-label, .status-line {
  color: var(--tt-text-secondary);
}

.field, .textarea {
  border: 1rpx solid var(--tt-border);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-text);
}

.primary-button.button-hover {
  background: var(--tt-accent-pressed);
}

.primary-button[disabled], .secondary-button[disabled] {
  opacity: 0.52;
}
