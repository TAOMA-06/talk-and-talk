.favorite-control { margin: 22rpx 32rpx 0; padding: 18rpx; border: 1rpx solid var(--tt-color-pastel-blue-stroke); border-left: 7rpx solid var(--tt-color-pastel-blue-fg); border-radius: 16rpx; background: var(--tt-color-pastel-blue-bg); text-align: left; }
.favorite-toggle { width: 100%; min-height: 64rpx; margin: 0; padding: 0; border: 0; background: transparent; color: var(--tt-info); font-size: 27rpx; font-weight: 700; line-height: 1.55; text-align: left; }
