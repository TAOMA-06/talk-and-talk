.companion-error-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 24rpx; }
.companion-error-retry,.companion-error-back { display: flex; min-height: 88rpx; align-items: center; justify-content: center; margin: 0; padding: 14rpx 16rpx; border-radius: 16rpx; font-size: 24rpx; font-weight: 700; line-height: 1.4; text-align: center; }
.companion-error-retry { border: 1rpx solid var(--tt-accent); background: var(--tt-accent); color: var(--tt-on-accent); }
