.public-profile-chip { padding: 8rpx 14rpx; border: 1rpx solid var(--tt-color-pastel-blue-stroke); border-radius: 999rpx; background: var(--tt-color-pastel-blue-bg); color: var(--tt-color-pastel-blue-fg); font-size: 22rpx; line-height: 1.5; }
.public-profile-chip-accent { border-color: var(--tt-color-pastel-apricot-stroke); background: var(--tt-color-pastel-apricot-bg); color: var(--tt-color-pastel-apricot-fg); }
.public-profile-copy, .public-profile-empty { margin-top: 8rpx; color: var(--tt-text-secondary); font-size: 23rpx; line-height: 1.65; overflow-wrap: anywhere; white-space: pre-wrap; }
.public-profile-empty { color: var(--tt-text-tertiary); }
.boundary-list { margin-top: 10rpx; }
