.companion-page { padding-right: 0; padding-bottom: calc(170rpx + env(safe-area-inset-bottom)); padding-left: 0; }
.companion-page > .emergency-entry,.companion-page > .empty,.companion-page > .card,.companion-page > .plain-button { margin-right: 32rpx; margin-left: 32rpx; }
.profile { overflow: visible; margin-bottom: 24rpx; padding-bottom: 30rpx; background: transparent; }
.profile-theatre { position: relative; margin: 0 24rpx; padding: 10rpx 0 0; }
.profile-theatre::before { content: ""; position: absolute; top: 82rpx; left: -104rpx; width: 300rpx; height: 300rpx; border: 1rpx solid var(--tt-color-pastel-rose-stroke); border-radius: 50%; opacity: .42; pointer-events: none; }
.profile-theatre-label { position: relative; z-index: 6; display: flex; align-items: center; justify-content: space-between; min-height: 74rpx; padding: 0 10rpx; color: var(--tt-text-tertiary); font-size: 20rpx; font-weight: 800; letter-spacing: 2rpx; }
.profile-stage-layer { width: 100%; }
.profile-context-card,.profile-person-card { position: relative; min-height: 470rpx; border: 1rpx solid; border-radius: 34rpx; overflow: hidden; }
.profile-context-card { padding: 38rpx; }
.profile-context-card::after { content: ""; position: absolute; right: -56rpx; bottom: -72rpx; width: 240rpx; height: 240rpx; border: 2rpx solid currentColor; border-radius: 42% 58% 54% 46%; opacity: .1; transform: rotate(14deg); }
.profile-context-trust { border-color: var(--tt-color-pastel-mint-stroke); background: var(--tt-color-pastel-mint-bg); color: var(--tt-color-pastel-mint-fg); }
