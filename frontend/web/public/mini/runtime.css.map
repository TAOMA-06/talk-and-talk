.confirmation-note { margin-top: 20rpx; padding: 18rpx; border: 1rpx solid var(--tt-info-soft); border-radius: 14rpx; background: var(--tt-info-soft); color: var(--tt-info); font-size: 22rpx; line-height: 1.65; }
.confirmation-check { width: 100%; min-height: 88rpx; margin-top: 14rpx; padding: 18rpx; border: 2rpx solid var(--tt-border); border-radius: 14rpx; background: var(--tt-surface); color: var(--tt-text-secondary); font-size: 23rpx; line-height: 1.55; text-align: left; }
.confirmation-check.checked { border-color: var(--tt-accent); background: var(--tt-accent-soft); color: var(--tt-accent-pressed); font-weight: 600; }
.confirmation-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.confirmation-cancel, .confirmation-submit { min-height: 88rpx; flex: 1; margin: 0; border-radius: 14rpx; font-size: 26rpx; }
.confirmation-cancel { border: 1rpx solid var(--tt-border-strong); background: var(--tt-surface); color: var(--tt-accent); }
.confirmation-submit { border-color: var(--tt-accent); background: var(--tt-accent); color: var(--tt-on-accent); }
.confirmation-submit[disabled] { border-color: var(--tt-border); background: var(--tt-surface-alt); color: var(--tt-text-tertiary); opacity: 1; }
.confirmation-check::after, .confirmation-cancel::after, .confirmation-submit::after { border: 0; }
.favorite-state { padding: 14rpx; border-radius: 14rpx; background: var(--tt-surface-alt); color: var(--tt-text-secondary); font-size: 23rpx; line-height: 1.6; }
.favorite-state-error { border-left: 5rpx solid var(--tt-danger); background: var(--tt-danger-soft); color: var(--tt-danger); }
.favorite-state-retry { width: 100%; min-height: 80rpx; margin: 12rpx 0 0; border: 1rpx solid var(--tt-border-strong); background: var(--tt-surface); color: var(--tt-accent); font-size: 23rpx; }
.favorite-state-retry::after { border: 0; }
.emergency-entry { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 20rpx; padding: 22rpx 24rpx; border: 1rpx solid var(--tt-danger-soft); border-left: 7rpx solid var(--tt-danger); border-radius: 20rpx; background: var(--tt-danger-soft); }
.emergency-entry > view:first-child { min-width: 0; flex: 1; }
.emergency-title { color: var(--tt-danger); font-size: 25rpx; font-weight: 700; }
.emergency-copy { margin-top: 6rpx; color: var(--tt-text-secondary); font-size: 21rpx; line-height: 1.55; overflow-wrap: anywhere; }
.emergency-arrow { flex: 0 0 auto; color: var(--tt-danger); font-size: 42rpx; }
.companion-page.tt-motion-off .profile-theatre-label,
.companion-page.tt-motion-off .service-offering,
.companion-page.tt-motion-off .service-intent-option,
.companion-page.tt-motion-off .availability-slot,
.companion-page.tt-motion-off .review-card { animation: none; transition: none; transform: none; }
@media (prefers-reduced-motion: reduce) {
  .profile-theatre::before { display: none; }
  .service-offering,.service-offering-0,.service-offering-1,.service-offering-2,.service-offering.is-selected,.review-card-0,.review-card-1,.review-card-2 { transition: none; transform: none; }
}
