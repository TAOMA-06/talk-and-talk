.chat-page {
  padding-bottom: calc(164rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

/* UI4 keeps the conversation transcript immobile; only the static boundary papers gain depth. */
.chat-boundary-stack { position: relative; isolation: isolate; margin-bottom: 26rpx; padding: 18rpx 18rpx 2rpx; border: 1rpx solid var(--tt-border); border-radius: 24rpx; background: var(--tt-surface); }
.chat-boundary-stack::before { content: ""; position: absolute; z-index: 0; right: 14rpx; bottom: -8rpx; left: 14rpx; height: 80rpx; border: 1rpx solid var(--tt-border); border-radius: 20rpx; background: var(--tt-color-depth-neutral-near); }
.chat-boundary-stack .chat-room-label,
.chat-boundary-stack .boundary-notice,
.chat-boundary-stack .text-only-notice { position: relative; z-index: 1; }
.chat-room-label { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 14rpx; color: var(--tt-text-tertiary); font-size: 18rpx; font-weight: 750; letter-spacing: 1.4rpx; }
.chat-room-label text:last-child { font-weight: 500; letter-spacing: 0; text-align: right; }
.chat-boundary-stack .notice { margin-bottom: 12rpx; border-radius: 16rpx; box-shadow: none; }
.chat-page.tt-motion-off .conversation-tools-trigger,
.chat-page.tt-motion-off .conversation-tools-panel,
.chat-page.tt-motion-off .composer button { animation: none; transition: none; transform: none; }

.conversation-tools-trigger { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 16rpx; padding: 18rpx 20rpx; border: 1rpx solid var(--tt-color-pastel-butter-stroke); border-radius: 18rpx; background: var(--tt-color-pastel-butter-bg); color: var(--tt-color-pastel-butter-fg); }
.conversation-tools-title { color: currentColor; font-size: 25rpx; font-weight: 700; }
.conversation-tools-copy { margin-top: 5rpx; color: var(--tt-color-pastel-butter-fg); font-size: 21rpx; line-height: 1.45; }
.conversation-tools-panel { margin-bottom: 18rpx; padding: 18rpx; border: 1rpx solid var(--tt-border); border-radius: 20rpx; background: var(--tt-surface-alt); }

.notice, .restriction-notice, .appeal-notice, .safety-exit {
  margin-bottom: 20rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.notice {
  border: 1rpx solid var(--tt-border);
}
.boundary-notice { border-color: var(--tt-color-pastel-blue-stroke); background: var(--tt-color-pastel-blue-bg); color: var(--tt-color-pastel-blue-fg); }
.text-only-notice { border-color: var(--tt-color-pastel-lavender-stroke); background: var(--tt-color-pastel-lavender-bg); color: var(--tt-color-pastel-lavender-fg); }


.message-notification-setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 16rpx;
  border: 1rpx solid var(--tt-danger-soft);
  border-radius: 14rpx;
  background: var(--tt-surface);
}

.message-notification-copy {
  min-width: 0;
  flex: 1;
}

.message-notification-title {
  color: var(--tt-accent);
  font-size: 25rpx;
  font-weight: 700;
}

.message-notification-description {
  margin-top: 5rpx;
  color: var(--tt-text-secondary);
  font-size: 21rpx;
  line-height: 1.5;
}

.message-notification-action {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid var(--tt-danger-soft);
  border-radius: 10rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-accent);
  font-size: 22rpx;
  line-height: 56rpx;
}

.message-notification-action::after {
  border: 0;
}

.future-booking-setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 16rpx;
  border: 1rpx solid var(--tt-warning-soft);
  border-radius: 14rpx;
  background: var(--tt-warning-soft);
  border-color: var(--tt-border);
  border-left: 6rpx solid var(--tt-warning);
}

.future-booking-copy {
  min-width: 0;
  flex: 1;
}

.future-booking-title {
  color: var(--tt-warning);
  font-size: 25rpx;
  font-weight: 700;
}

.future-booking-description {
  margin-top: 5rpx;
  color: var(--tt-warning);
  font-size: 21rpx;
  line-height: 1.5;
}

.future-booking-action {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid var(--tt-warning);
  border-radius: 10rpx;
  background: var(--tt-surface);
  color: var(--tt-warning);
  font-size: 22rpx;
  line-height: 56rpx;
  border-color: var(--tt-border-strong);
}

.future-booking-action::after {
  border: 0;
}

.safety-exit {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-danger-soft);
  color: var(--tt-text);
  border-color: var(--tt-border);
  border-left-color: var(--tt-danger);
}

.safety-exit-title {
  color: var(--tt-danger);
  font-size: 26rpx;
  font-weight: 700;
}

.safety-exit-copy {
  margin-top: 8rpx;
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.safety-exit-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.safety-exit-action {
  flex: 1 1 180rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 1rpx solid var(--tt-danger-soft);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 22rpx;
  line-height: 1.4;
  min-height: 72rpx;
  border-color: var(--tt-border-strong);
}

.safety-exit-report {
  border-color: var(--tt-border);
  color: var(--tt-danger);
}

.safety-exit-emergency {
  border-color: var(--tt-danger);
  background: var(--tt-danger);
  color: var(--tt-on-accent);
}

.safety-exit-block {
  border-color: var(--tt-border-strong);
  color: var(--tt-warning);
}

.safety-exit-action::after {
  border: 0;
}

.conversation-boundary {
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 1rpx solid var(--tt-warning-soft);
  border-radius: 14rpx;
  background: var(--tt-warning-soft);
  border-color: var(--tt-warning-soft);
  border-left: 6rpx solid var(--tt-warning);
}

.conversation-boundary-title {
  color: var(--tt-text);
  font-size: 27rpx;
  font-weight: 700;
}

.conversation-boundary-copy {
  margin-top: 10rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.restriction-notice {
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
}

.appeal-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  background: var(--tt-info-soft);
  color: var(--tt-info);
  border-color: var(--tt-border);
  border-left-color: var(--tt-info);
}

.appeal-notice button {
  margin: 0;
  background: var(--tt-surface);
  color: var(--tt-info);
  font-size: 22rpx;
  min-height: 64rpx;
  border: 1rpx solid var(--tt-info-soft);
}

.history-status, .sync-status {
  padding: 12rpx 0;
  color: var(--tt-text-tertiary);
  font-size: 23rpx;
  text-align: center;
}

.sync-status {
  color: var(--tt-info);
}

.message {
  margin: 18rpx 0;
}

.message.mine { text-align: right; }
.message.mine .sender { text-align: right; }
.message.mine .bubble { border-color: var(--tt-accent); background: var(--tt-accent); color: var(--tt-on-accent); text-align: left; }
.message.theirs { text-align: left; }
.message.system { text-align: center; }
.message.system .sender { display: none; }
.message.system .bubble { max-width: 94%; text-align: left; }

.sender {
  margin-bottom: 6rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  overflow-wrap: anywhere;
}

.bubble {
  display: inline-block;
  max-width: 88%;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: var(--tt-surface);
  line-height: 1.55;
  box-shadow: none;
  border: 1rpx solid var(--tt-border);
  color: var(--tt-text);
  overflow-wrap: anywhere;
}

.message-content {
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.system .bubble {
  background: var(--tt-accent-soft);
  color: var(--tt-accent-pressed);
  font-size: 26rpx;
  border-color: var(--tt-border);
}

.message-emergency-help {
  width: fit-content;
  margin: 10rpx 0 0;
  padding: 0 18rpx;
  border: 1rpx solid var(--tt-danger);
  background: var(--tt-surface);
  color: var(--tt-danger);
  font-size: 22rpx;
  line-height: 1.4;
  min-height: 72rpx;
  border-color: var(--tt-danger-soft);
}

.message-emergency-help::after {
  border: 0;
}

.held .bubble {
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  border-color: var(--tt-border);
}
.message.mine.held .bubble { border-color: var(--tt-warning); background: var(--tt-warning-soft); color: var(--tt-warning); }

.delivery-status {
  margin-top: 7rpx;
  color: var(--tt-warning);
  font-size: 22rpx;
  font-weight: 600;
}

.delivery-status.blocked {
  color: var(--tt-danger);
}

.attachment {
  margin-top: 12rpx;
}

.attachment-image {
  display: block;
  width: 360rpx;
  max-width: 100%;
  border-radius: 14rpx;
  border: 1rpx solid var(--tt-border);
}

.attachment-placeholder {
  min-width: 240rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 24rpx;
  border: 1rpx solid var(--tt-border);
  overflow-wrap: anywhere;
}

.audio-play {
  margin: 0;
  background: var(--tt-accent-soft);
  color: var(--tt-accent);
  font-size: 24rpx;
  min-height: 72rpx;
  border-color: var(--tt-border-strong);
}

.composer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: var(--tt-surface);
  box-shadow: none;
  z-index: 20;
  border-top: 1rpx solid var(--tt-border);
}

.composer input {
  min-width: 0;
  flex: 1;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--tt-bg);
  min-height: 80rpx;
  border: 1rpx solid var(--tt-border);
  color: var(--tt-text);
}

.send, .media {
  margin: 0;
  font-size: 25rpx;
  min-height: 80rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
}

.send {
  background: var(--tt-accent);
  color: var(--tt-on-accent);
  border-color: var(--tt-accent);
}

.media {
  padding: 0 14rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
  border-color: var(--tt-border-strong);
}

.recording {
  background: var(--tt-danger);
  color: var(--tt-on-accent);
  border-color: var(--tt-danger);
}

.notice, .restriction-notice, .appeal-notice, .safety-exit {
  margin-bottom: 16rpx;
  border: 1rpx solid var(--tt-border);
  border-left-width: 6rpx;
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-text-secondary);
  overflow-wrap: anywhere;
}

.restriction-notice {
  border-color: var(--tt-border);
  border-left-color: var(--tt-warning);
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
}

.message-notification-setting, .future-booking-setting {
  margin-bottom: 16rpx;
  padding: 18rpx;
  border: 1rpx solid var(--tt-border);
  border-radius: 14rpx;
  background: var(--tt-surface);
}

.message-notification-title, .future-booking-title {
  color: var(--tt-text);
  font-weight: 700;
}

.message-notification-description, .future-booking-description {
  color: var(--tt-text-secondary);
  overflow-wrap: anywhere;
}

.message-notification-action, .future-booking-action {
  min-height: 72rpx;
  padding: 0 16rpx;
  border-color: var(--tt-border-strong);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
  line-height: 1.4;
}

.initial-load-error button {
  min-height: 72rpx;
  margin-top: 16rpx;
  border-color: var(--tt-border-strong);
  background: var(--tt-surface);
  color: var(--tt-accent);
}

.conversation-read-only {
  border-color: var(--tt-border);
  border-left-color: var(--tt-info);
  background: var(--tt-info-soft);
}
