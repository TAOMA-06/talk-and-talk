.companion-error-safety { min-height: 72rpx; margin: 14rpx 0 0; padding: 10rpx; border: 0; background: transparent; color: var(--tt-danger); font-size: 22rpx; font-weight: 650; }
.companion-error-retry::after,.companion-error-safety::after { border: 0; }
.service-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; color: var(--tt-text); font-size: 30rpx; font-weight: 700; }
.service-lock { max-width: 280rpx; color: var(--tt-text-secondary); font-size: 22rpx; font-weight: 400; line-height: 1.45; text-align: right; }
.service-list { margin-top: 18rpx; }
