:host { display: block; min-width: 0; }
.scene-card { position: relative; display: flex; min-height: 152rpx; flex-direction: column; }
.scene-prop { position: absolute; top: -10rpx; right: -8rpx; pointer-events: none; }
.scene-label { color: inherit; font-size: 21rpx; font-weight: 700; letter-spacing: 1.5rpx; }
.scene-title { margin-top: auto; font-size: 32rpx; font-weight: 700; letter-spacing: -.5rpx; line-height: 1.3; }
.scene-description { margin-top: 8rpx; font-size: 23rpx; line-height: 1.5; }
.scene-selected { display: flex; margin-top: 18rpx; align-items: center; gap: 8rpx; font-size: 21rpx; font-weight: 700; }
.selected-mark { display: inline-flex; width: 32rpx; height: 32rpx; align-items: center; justify-content: center; border: 1rpx solid currentColor; border-radius: 999rpx; }
