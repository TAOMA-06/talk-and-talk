.recommendation-unavailable-title { color: var(--tt-text); font-size: 25rpx; font-weight: 700; }
.rebooking-notice { margin: 22rpx 32rpx 0; padding: 18rpx; border: 1rpx solid var(--tt-color-pastel-blue-stroke); border-left: 6rpx solid var(--tt-color-pastel-blue-fg); border-radius: 16rpx; background: var(--tt-color-pastel-blue-bg); text-align: left; }
.rebooking-notice-heading { display: flex; justify-content: space-between; gap: 16rpx; color: var(--tt-text); font-size: 24rpx; font-weight: 700; letter-spacing: 1rpx; }
