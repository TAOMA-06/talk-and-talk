.segmented { display: flex; min-height: 88rpx; padding: 6rpx; border: 1rpx solid var(--tt-border); border-radius: 18rpx; background: var(--tt-surface-alt); }
.segment { display: flex; min-width: 0; min-height: 74rpx; flex: 1; align-items: center; justify-content: center; padding: 12rpx 16rpx; border: 1rpx solid transparent; border-radius: 13rpx; color: var(--tt-text-secondary); font-size: 24rpx; font-weight: 600; }
.segment:focus { outline: 3rpx solid var(--tt-color-focus-ring); outline-offset: 3rpx; }
.segment-selected { border-color: var(--tt-border-strong); background: var(--tt-surface); color: var(--tt-text); }
