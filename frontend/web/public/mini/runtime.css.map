.service-section,.service-intent-section,.availability-section { margin: 28rpx 32rpx 0; padding: 24rpx; border: 1rpx solid var(--tt-border); border-radius: 26rpx; background: var(--tt-surface); text-align: left; }
.service-deck-section { position: relative; isolation: isolate; }
.service-deck-section::before { content: ""; position: absolute; z-index: 0; right: 18rpx; bottom: -12rpx; left: 18rpx; height: 80rpx; border: 1rpx solid var(--tt-color-pastel-apricot-stroke); border-radius: 22rpx; background: var(--tt-color-pastel-apricot-bg); }
