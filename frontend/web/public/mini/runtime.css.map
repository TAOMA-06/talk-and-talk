.review-card-1 { border-color: var(--tt-color-pastel-blue-stroke); background: var(--tt-color-pastel-blue-bg); transform: translateX(4rpx) rotate(.36deg); }
.review-card-2 { border-color: var(--tt-color-pastel-lavender-stroke); background: var(--tt-color-pastel-lavender-bg); transform: translateX(-2rpx) rotate(-.2deg); }
.row { display: flex; justify-content: space-between; gap: 16rpx; }
.rating { flex: 0 0 auto; color: var(--tt-accent); font-weight: 700; }
.review { margin-top: 14rpx; color: var(--tt-text); line-height: 1.7; overflow-wrap: anywhere; white-space: pre-wrap; }
