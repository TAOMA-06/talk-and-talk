.recommendation-control { margin: 14rpx 32rpx 0; padding: 18rpx; border: 1rpx solid var(--tt-color-pastel-butter-stroke); border-left: 7rpx solid var(--tt-color-pastel-butter-fg); border-radius: 16rpx; background: var(--tt-color-pastel-butter-bg); text-align: left; }
.recommendation-control-excluded { border-color: var(--tt-border); border-left-color: var(--tt-text-secondary); background: var(--tt-surface-alt); }
.recommendation-control-unavailable { border-color: var(--tt-border); border-left-color: var(--tt-text-tertiary); background: var(--tt-bg); }
.recommendation-toggle { width: 100%; min-height: 64rpx; margin: 0; padding: 0; border: 0; background: transparent; color: var(--tt-warning); font-size: 26rpx; font-weight: 700; line-height: 1.55; text-align: left; }
