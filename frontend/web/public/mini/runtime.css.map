.earnings-page { padding-top: 24rpx; }
.hero {
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--tt-surface);
  box-shadow: none;
  border: 2rpx solid var(--tt-border-strong);
}

.hero-ledger { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 24rpx; color: var(--tt-text-tertiary); font-size: 19rpx; font-weight: 800; letter-spacing: 1.7rpx; }

.eyebrow {
  color: var(--tt-success);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 6rpx;
  color: var(--tt-success);
  font-size: 48rpx;
  font-weight: 700;
}

.hero-label { margin-top: 22rpx; color: var(--tt-text-secondary); font-size: 22rpx; }
.money-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; margin-top: 22rpx; }
.money-fact { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; padding: 16rpx; border: 1rpx solid var(--tt-border); border-radius: 14rpx; background: var(--tt-surface-alt); color: var(--tt-text-secondary); font-size: 20rpx; line-height: 1.35; }
.money-fact text:last-child { color: var(--tt-text); font-size: 25rpx; font-weight: 700; }

.hero-copy {
  margin-top: 14rpx;
  color: var(--tt-text-secondary);
  font-size: 25rpx;
  line-height: 1.6;
}

.source {
  margin-top: 18rpx;
  color: var(--tt-text-tertiary);
  font-size: 22rpx;
  line-height: 1.5;
}

.blocked {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  font-size: 24rpx;
  line-height: 1.55;
}

.link {
  color: var(--tt-accent);
  font-weight: 700;
}

.inline-error {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 24rpx;
}

.section-title {
  margin: 34rpx 4rpx 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-card {
  color: var(--tt-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.earning-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  border: 2rpx solid transparent;
}

.earning-card.selected {
  border-color: var(--tt-accent);
  background: var(--tt-accent-soft);
}

.check {
  width: 36rpx;
  color: var(--tt-accent);
  font-size: 31rpx;
  font-weight: 700;
  text-align: center;
}

.earning-main {
  flex: 1;
  min-width: 0;
}

.earning-head, .withdrawal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.amount {
  color: var(--tt-success);
  font-size: 32rpx;
  font-weight: 700;
}

.status {
  flex: none;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 21rpx;
}

.status-held, .status-card-rejected .status {
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.status-paid, .status-card-paid .status {
  background: var(--tt-success-soft);
  color: var(--tt-success);
}

.meta, .fee, .recipient {
  margin-top: 10rpx;
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.hold, .rejection {
  margin-top: 14rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  font-size: 22rpx;
  line-height: 1.5;
}

.selection-bar {
  position: static;
  z-index: auto;
  bottom: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: var(--tt-surface);
  box-shadow: none;
  border: 1rpx solid var(--tt-border);
}

.selection-label {
  color: var(--tt-text-secondary);
  font-size: 22rpx;
}

.selection-value {
  margin-top: 5rpx;
  color: var(--tt-success);
  font-size: 30rpx;
  font-weight: 700;
}

.request-button {
  margin: 0;
  min-width: 220rpx;
  min-height: 88rpx;
}

.withdrawal-card {
  padding: 26rpx;
}

.next-step {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: var(--tt-info-soft);
  color: var(--tt-info);
  font-size: 24rpx;
  line-height: 1.55;
}

.secondary-button {
  margin-top: 18rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
  min-height: 80rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
}

.empty-title {
  margin-bottom: 14rpx;
  color: var(--tt-danger);
  font-size: 34rpx;
  font-weight: 700;
}

.retry {
  margin-top: 28rpx;
}

.page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.primary-button {
  min-height: 88rpx;
}

.eyebrow, .link {
  color: var(--tt-accent);
}

.hero-title, .section-title, .amount, .selection-value, .empty-title {
  color: var(--tt-text);
  font-weight: 700;
}

.hero-copy, .meta, .fee, .recipient, .selection-label, .empty-card {
  color: var(--tt-text-secondary);
}

.blocked, .hold {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
}

.inline-error, .rejection {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.earning-card, .withdrawal-card {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
}

.primary-button.button-hover {
  background: var(--tt-accent-pressed);
}

.primary-button[disabled], .secondary-button[disabled] {
  opacity: 0.52;
}
