.bio { margin: 18rpx 26rpx 26rpx; padding: 18rpx 20rpx; border: 1rpx solid var(--tt-color-pastel-rose-stroke); border-radius: 18rpx; background: var(--tt-color-pastel-rose-bg); color: var(--tt-color-pastel-rose-fg); text-align: left; line-height: 1.62; overflow-wrap: anywhere; white-space: pre-wrap; }
.public-profile-section { margin: 24rpx 32rpx 0; padding: 26rpx; border: 1rpx solid var(--tt-border); border-radius: 28rpx; background: var(--tt-surface); text-align: left; }
.public-profile-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.public-profile-heading > view:first-child { min-width: 0; flex: 1; }
