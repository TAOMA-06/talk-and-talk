.workbench-page { padding-top: 22rpx; overflow-x: hidden; }
.workbench-ready { min-width: 0; }
.studio-stage { position: relative; margin: 0 -8rpx 18rpx; padding: 8rpx 8rpx 0; }
.studio-stage::before { content: ""; position: absolute; top: 78rpx; right: -108rpx; width: 318rpx; height: 318rpx; border: 1rpx solid var(--tt-color-pastel-mint-stroke); border-radius: 50%; opacity: .42; pointer-events: none; }
.studio-sign { position: relative; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin: 0 10rpx 2rpx; color: var(--tt-text-tertiary); font-size: 19rpx; font-weight: 800; letter-spacing: 1.8rpx; }
.studio-live { flex: none; padding: 6rpx 13rpx; border: 1rpx solid var(--tt-color-pastel-mint-stroke); border-radius: 999rpx; background: var(--tt-color-pastel-mint-bg); color: var(--tt-color-pastel-mint-fg); letter-spacing: 0; }
.studio-layer { width: 100%; }
.studio-card,.hero-card { box-sizing: border-box; min-height: 330rpx; padding: 32rpx; border: 1rpx solid; border-radius: 32rpx; overflow: hidden; }
.studio-card { position: relative; display: flex; flex-direction: column; justify-content: flex-end; }
.studio-card-service { border-color: var(--tt-color-pastel-apricot-stroke); background: var(--tt-color-pastel-apricot-bg); color: var(--tt-color-pastel-apricot-fg); }
.studio-card-growth { border-color: var(--tt-color-pastel-mint-stroke); background: var(--tt-color-pastel-mint-bg); color: var(--tt-color-pastel-mint-fg); }
.hero-card { border-color: var(--tt-color-pastel-blue-stroke); background: var(--tt-color-pastel-blue-bg); color: var(--tt-color-pastel-blue-fg); }
.studio-fallback { min-height: 0; border-color: var(--tt-color-status-unknown-stroke); background: var(--tt-color-status-unknown-bg); color: var(--tt-color-status-unknown-fg); }
.studio-index { position: absolute; top: 28rpx; right: 30rpx; font-size: 19rpx; font-weight: 800; letter-spacing: 1.6rpx; }
.studio-card-title { width: 70%; font-size: 30rpx; font-weight: 750; line-height: 1.3; }
.studio-card-copy { width: 70%; margin-top: 10rpx; font-size: 21rpx; line-height: 1.45; }
.studio-props { display: flex; align-items: flex-end; gap: 2rpx; }
.hero-title { max-width: 560rpx; margin-top: 14rpx; color: currentColor; font-size: 42rpx; font-weight: 750; letter-spacing: -1rpx; line-height: 1.16; }
.hero-copy { max-width: 560rpx; margin-top: 13rpx; color: currentColor; font-size: 24rpx; line-height: 1.58; }
.updated-at { margin-top: 20rpx; color: currentColor; font-size: 20rpx; }
.profile-media-card { overflow: hidden; margin-top: 18rpx; border: 1rpx solid var(--tt-border); border-radius: 24rpx; background: var(--tt-surface); }
.profile-media-cover { display: block; width: 100%; height: 248rpx; background: var(--tt-surface-alt); }
.profile-media-main { display: flex; align-items: flex-end; gap: 18rpx; margin-top: -42rpx; padding: 0 22rpx; }
.profile-media-copy { min-width: 0; flex: 1; padding-bottom: 8rpx; }
.profile-media-title { color: var(--tt-text); font-size: 27rpx; font-weight: 700; }
.profile-media-note { margin-top: 5rpx; color: var(--tt-text-secondary); font-size: 21rpx; line-height: 1.48; }
.profile-media-actions,.profile-media-remove { display: flex; gap: 12rpx; padding: 18rpx 22rpx 0; }
.profile-media-actions button,.profile-media-remove button { min-width: 0; min-height: 68rpx; flex: 1; padding: 10rpx; font-size: 22rpx; }
.profile-media-actions button { border-color: var(--tt-accent); background: var(--tt-accent-soft); color: var(--tt-accent); }
.profile-media-remove { padding-top: 10rpx; }
.profile-media-remove button { border-color: var(--tt-border); background: var(--tt-surface); color: var(--tt-danger); }
.profile-media-message { margin: 14rpx 22rpx 20rpx; padding: 12rpx 14rpx; border-radius: 14rpx; background: var(--tt-surface-alt); color: var(--tt-text-secondary); font-size: 21rpx; }
.access-empty { line-height: 1.68; }
.access-title { color: var(--tt-text); font-size: 34rpx; font-weight: 700; }
.retry-button { width: 100%; margin-top: 22rpx; }
.attention-card { display: flex; align-items: center; gap: 18rpx; margin-top: 18rpx; padding: 22rpx; border: 2rpx solid var(--tt-warning); border-radius: 20rpx; background: var(--tt-warning-soft); color: var(--tt-warning); }
.attention-icon { display: flex; width: 42rpx; height: 42rpx; flex: none; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--tt-warning); color: var(--tt-on-accent); font-size: 27rpx; font-weight: 700; }
.attention-body { min-width: 0; flex: 1; }
.attention-title { font-size: 27rpx; font-weight: 700; }
.attention-copy { margin-top: 5rpx; font-size: 22rpx; line-height: 1.5; }
.attention-link { flex: none; color: var(--tt-warning); font-size: 23rpx; font-weight: 700; }
.section-heading { margin: 42rpx 4rpx 16rpx; color: var(--tt-text); font-size: 32rpx; font-weight: 700; }
.overview-grid,.lifecycle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.overview-card,.lifecycle-card { position: relative; min-height: 176rpx; padding: 22rpx; border: 1rpx solid; border-radius: 22rpx; overflow: hidden; transition: transform var(--tt-motion-press) var(--tt-ease-standard), opacity var(--tt-motion-press) var(--tt-ease-standard); }
.overview-card:active,.lifecycle-card:active { transform: translateY(3rpx) scale(.985); }
.overview-card.earnings-card { grid-column: 1 / -1; min-height: 146rpx; }
.overview-card:nth-child(1) { border-color: var(--tt-color-pastel-apricot-stroke); background: var(--tt-color-pastel-apricot-bg); color: var(--tt-color-pastel-apricot-fg); }
.overview-card:nth-child(2) { border-color: var(--tt-color-pastel-butter-stroke); background: var(--tt-color-pastel-butter-bg); color: var(--tt-color-pastel-butter-fg); }
.overview-card.earnings-card { border-color: var(--tt-color-pastel-mint-stroke); background: var(--tt-color-pastel-mint-bg); color: var(--tt-color-pastel-mint-fg); }
.overview-label { color: currentColor; font-size: 22rpx; }
.overview-value,.overview-unavailable { margin-top: 12rpx; color: currentColor; font-size: 36rpx; font-weight: 750; line-height: 1.15; }
.overview-unavailable { font-size: 29rpx; }
.overview-unit { margin-left: 5rpx; color: currentColor; font-size: 20rpx; font-weight: 400; }
.overview-note { margin-top: 13rpx; overflow: hidden; color: currentColor; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.lifecycle-card:nth-child(1) { border-color: var(--tt-color-pastel-rose-stroke); background: var(--tt-color-pastel-rose-bg); color: var(--tt-color-pastel-rose-fg); }
.lifecycle-card:nth-child(2) { border-color: var(--tt-color-pastel-lavender-stroke); background: var(--tt-color-pastel-lavender-bg); color: var(--tt-color-pastel-lavender-fg); }
.lifecycle-card:nth-child(3) { border-color: var(--tt-color-pastel-blue-stroke); background: var(--tt-color-pastel-blue-bg); color: var(--tt-color-pastel-blue-fg); }
.lifecycle-card:nth-child(4) { border-color: var(--tt-color-pastel-butter-stroke); background: var(--tt-color-pastel-butter-bg); color: var(--tt-color-pastel-butter-fg); }
.lifecycle-title { color: currentColor; font-size: 25rpx; font-weight: 700; line-height: 1.4; }
.lifecycle-state,.lifecycle-link { margin-top: 12rpx; color: currentColor; font-size: 21rpx; line-height: 1.45; }
.schedule-card { padding: 26rpx; border: 1rpx solid var(--tt-color-pastel-blue-stroke); background: var(--tt-surface); }
.today-service-card + .today-service-card { margin-top: 14rpx; }
.schedule-head { display: flex; align-items: flex-start; gap: 14rpx; }
.schedule-title { min-width: 0; flex: 1; color: var(--tt-text); font-size: 28rpx; font-weight: 700; }
.status-chip { flex: none; padding: 6rpx 12rpx; border-radius: 999rpx; background: var(--tt-info-soft); color: var(--tt-info); font-size: 20rpx; }
.schedule-time { margin-top: 18rpx; color: var(--tt-text); font-size: 27rpx; font-weight: 600; }
.schedule-meta,.schedule-link { margin-top: 9rpx; color: var(--tt-text-secondary); font-size: 23rpx; line-height: 1.5; }
.schedule-link { color: var(--tt-accent); font-weight: 700; }
.empty-schedule { line-height: 1.6; }
.empty-actions { display: flex; gap: 12rpx; margin-top: 20rpx; }
.plain-button { min-height: 72rpx; margin: 0; padding: 10rpx 18rpx; border-color: var(--tt-border-strong); background: var(--tt-surface); color: var(--tt-accent); font-size: 23rpx; }
.schedule-action { margin-top: 18rpx; }
.empty-actions .schedule-action { min-width: 0; flex: 1; margin-top: 0; }
.workbench-tip { margin: 22rpx 8rpx 8rpx; padding-left: 18rpx; border-left: 4rpx solid var(--tt-color-pastel-butter-stroke); color: var(--tt-text-tertiary); font-size: 21rpx; line-height: 1.55; }
.card-hover { transform: translateY(2rpx) scale(.99); }
.tt-motion-off .overview-card,.tt-motion-off .lifecycle-card { transition: none; }
.tt-motion-off .overview-card:active,.tt-motion-off .lifecycle-card:active,.tt-motion-off .card-hover { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) {
  .studio-stage::before { display: none; }
  .overview-card,.lifecycle-card { transition: none; }
  .overview-card:active,.lifecycle-card:active,.card-hover { opacity: 1; transform: none; }
}
