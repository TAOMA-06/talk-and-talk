.crisis-page {
  padding-top: 24rpx;
  padding-bottom: 80rpx;
}

.crisis-hero {
  padding: 32rpx;
  border: 2rpx solid var(--tt-danger);
  border-radius: 24rpx;
  background: var(--tt-danger-soft);
  border-color: var(--tt-danger);
}

.crisis-ledger { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 24rpx; color: var(--tt-danger); font-size: 18rpx; font-weight: 800; letter-spacing: 1.6rpx; }

.crisis-kicker {
  color: var(--tt-danger);
  font-size: 23rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.crisis-title {
  margin-top: 12rpx;
  color: var(--tt-text);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.crisis-copy {
  margin-top: 16rpx;
  color: var(--tt-danger);
  font-size: 25rpx;
  line-height: 1.7;
}

.crisis-copy.strong {
  color: var(--tt-danger);
  font-weight: 700;
}

.coverage-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--tt-warning-soft);
  border: 1rpx solid var(--tt-border);
}

.coverage-label {
  color: var(--tt-text);
  font-size: 25rpx;
  font-weight: 800;
}

.coverage-copy, .load-notice {
  margin-top: 10rpx;
  color: var(--tt-warning);
  font-size: 23rpx;
  line-height: 1.65;
}

.load-notice {
  color: var(--tt-warning);
}

.resource-card {
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: var(--tt-surface);
  box-shadow: none;
  border: 2rpx solid var(--tt-border-strong);
}

.resource-sequence { margin-bottom: 20rpx; color: var(--tt-text-tertiary); font-size: 18rpx; font-weight: 800; letter-spacing: 1.6rpx; }

.resource-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.resource-name {
  color: var(--tt-text);
  font-size: 29rpx;
  font-weight: 800;
}

.resource-phone {
  margin-top: 5rpx;
  color: var(--tt-danger);
  font-size: 46rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.call-button {
  flex: 0 0 auto;
  margin: 0;
  border-radius: 14rpx;
  background: var(--tt-danger);
  color: var(--tt-on-accent);
  font-size: 25rpx;
  font-weight: 700;
  min-height: 88rpx;
}

.resource-copy {
  margin-top: 16rpx;
  color: var(--tt-text);
  font-size: 23rpx;
  line-height: 1.6;
}

.source-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 21rpx;
  line-height: 1.65;
}

.source-button {
  margin-top: 10rpx;
  padding: 0;
  background: transparent;
  color: var(--tt-info);
  font-size: 22rpx;
  text-align: left;
}

.safety-note {
  margin-top: 24rpx;
  padding: 22rpx;
  border-left: 6rpx solid var(--tt-danger);
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  font-size: 23rpx;
  line-height: 1.7;
  border-left-color: var(--tt-warning);
}

.completion-error {
  margin-top: 18rpx;
  color: var(--tt-danger);
  font-size: 23rpx;
  text-align: center;
}

.complete-button {
  margin-top: 24rpx;
  border-radius: 14rpx;
  background: var(--tt-accent);
  color: var(--tt-on-accent);
  font-size: 27rpx;
  font-weight: 750;
  min-height: 88rpx;
}

.call-button::after, .source-button::after, .complete-button::after {
  border: 0;
}

.crisis-kicker, .crisis-copy.strong {
  color: var(--tt-danger);
}

.crisis-copy, .resource-copy {
  color: var(--tt-text-secondary);
}

.resource-phone, .completion-error {
  color: var(--tt-danger);
}

.call-button.button-hover, .complete-button.button-hover {
  background: var(--tt-accent-pressed);
}

.call-button[disabled], .complete-button[disabled] {
  opacity: 0.52;
}
