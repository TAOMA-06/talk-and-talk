.context-copy { width: 66%; margin-top: 14rpx; color: currentColor; font-size: 23rpx; line-height: 1.55; }
.profile-person-card { border-color: var(--tt-color-pastel-blue-stroke); background: var(--tt-surface); }
.profile-cover { display: block; width: 100%; height: 286rpx; margin: 0; border-radius: 32rpx 32rpx 0 0; background: var(--tt-surface-alt); }
.profile-main { display: flex; align-items: flex-end; gap: 20rpx; margin-top: -60rpx; padding: 0 26rpx; }
.profile-copy { min-width: 0; flex: 1; padding-bottom: 10rpx; }
