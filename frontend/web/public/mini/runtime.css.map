.public-profile-title { margin-top: 8rpx; color: var(--tt-text); font-size: 31rpx; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
.public-profile-safe { flex: 0 0 auto; max-width: 210rpx; padding: 8rpx 12rpx; border: 1rpx solid var(--tt-color-pastel-blue-stroke); border-radius: 999rpx; background: var(--tt-color-pastel-blue-bg); color: var(--tt-color-pastel-blue-fg); font-size: 20rpx; line-height: 1.45; text-align: center; }
.public-profile-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 20rpx; }
