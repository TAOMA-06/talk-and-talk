.voice-intro-card { display: flex; gap: 14rpx; margin-top: 16rpx; padding: 16rpx; border: 1rpx solid var(--tt-color-pastel-lavender-stroke); border-radius: 14rpx; background: var(--tt-color-pastel-lavender-bg); }
