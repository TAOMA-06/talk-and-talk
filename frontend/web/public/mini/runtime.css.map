.service-intent-list { margin-top: 14rpx; }
.service-intent-option { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 10rpx; padding: 18rpx 16rpx; border: 2rpx solid var(--tt-color-pastel-lavender-stroke); border-radius: 16rpx; background: var(--tt-color-pastel-lavender-bg); }
.service-intent-option.is-selected { border-color: var(--tt-accent); background: var(--tt-accent-soft); }
.service-intent-copy { min-width: 0; flex: 1; }
.service-intent-title { color: var(--tt-text); font-size: 26rpx; font-weight: 700; overflow-wrap: anywhere; }
.service-intent-description { margin-top: 6rpx; color: var(--tt-text-secondary); font-size: 22rpx; line-height: 1.55; overflow-wrap: anywhere; }
.booking-intent-summary { border-left-color: var(--tt-info); background: var(--tt-info-soft); color: var(--tt-info); }
.availability-section { margin-top: 22rpx; }
.availability-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; color: var(--tt-text); font-size: 30rpx; font-weight: 700; }
.availability-timezone { color: var(--tt-text-secondary); font-size: 22rpx; font-weight: 400; }
.availability-note { margin-top: 14rpx; color: var(--tt-text-secondary); font-size: 24rpx; line-height: 1.6; }
.availability-list { margin-top: 6rpx; }
