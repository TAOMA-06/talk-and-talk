.availability-date-group:first-child { margin-top: 16rpx; }
.availability-date { color: var(--tt-text); font-size: 25rpx; font-weight: 700; }
.availability-slot-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
