TALKTALK_API_BASE_URL=https://api.talkandtalk.app/api/v1

# Public legal-consent definition. These must exactly match the backend's
# LEGAL_CONSENT_VERSION, LEGAL_PRIVACY_URL and LEGAL_TERMS_URL at release time.
NEXT_PUBLIC_LEGAL_CONSENT_VERSION=2.2-2026-08-01
NEXT_PUBLIC_LEGAL_PRIVACY_URL=https://api.talkandtalk.app/legal/privacy.html
NEXT_PUBLIC_LEGAL_TERMS_URL=https://api.talkandtalk.app/legal/terms.html

# Official-site public disclosures. Populate only with facts that have been
# legally verified for public display; leave blank to retain the safe fallback.
# Mirror the corresponding backend LEGAL_* values for a production release.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_CONTACT_PHONE=
NEXT_PUBLIC_LEGAL_COMPLAINT_CHANNEL=
# Optional public ICP/filing record and its official verification link.
NEXT_PUBLIC_ICP_RECORD=
NEXT_PUBLIC_ICP_RECORD_URL=

# Official site → WeChat miniprogram CTA (optional)
# Public URL of the miniprogram QR image shown on the marketing site
NEXT_PUBLIC_MINIPROGRAM_QR_URL=
# Optional deep link / URL Link; when empty, UI shows “微信搜索 Talk&Talk”
NEXT_PUBLIC_MINIPROGRAM_PATH=


# Official-site surface policy (G0)
# production|candidate: public marketing only; deferred Web App + BFF/session refused
# development|open: local/build surfaces; still require flags for deferred BFF against prod API
WEB_SURFACE_MODE=
# Opt-in private /business and /demo on a locked candidate
WEB_ENABLE_PRIVATE_SURFACES=
# Opt-in deferred trade pages + BFF/session (requires non-production API allowlist)
WEB_ENABLE_DEFERRED_SURFACES=
WEB_ALLOW_PRODUCTION_API=
NEXT_PUBLIC_MINIPROGRAM_SEARCH_NAME=Talk&Talk
