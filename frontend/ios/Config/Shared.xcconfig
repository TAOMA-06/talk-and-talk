PRODUCT_BUNDLE_IDENTIFIER = com.talkandtalk.app
// Fill before TestFlight / App Store. Empty → Release shows a clear pay error (not crash).
WECHAT_APP_ID =
WECHAT_UNIVERSAL_LINK = https:/$()/api.talkandtalk.app/wechat/
// Phone SMS login: YES for Debug/Staging (mock SMS); NO for production Release (Apple-only).
ENABLE_PHONE_LOGIN = YES
// Optional: set DEVELOPMENT_TEAM in Xcode target or a local xcconfig (do not commit Team secrets).
// DEVELOPMENT_TEAM = YOUR_TEAM_ID