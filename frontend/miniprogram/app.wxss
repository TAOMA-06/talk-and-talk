page {
  --tt-bg: #f7f5f2;
  --tt-surface: #ffffff;
  --tt-surface-alt: #f0eeeb;
  --tt-surface-raised: #fffcf9;
  --tt-text: #171717;
  --tt-text-secondary: #64615d;
  --tt-text-tertiary: #8a857f;
  --tt-border: #e2dfda;
  --tt-border-strong: #cbc6c0;
  --tt-accent: #c65345;
  --tt-accent-pressed: #a94439;
  --tt-accent-soft: #f8e8e4;
  --tt-on-accent: #ffffff;
  --tt-success: #2f6b55;
  --tt-success-soft: #eaf4ef;
  --tt-warning: #8a6426;
  --tt-warning-soft: #f8f0df;
  --tt-danger: #a33d45;
  --tt-danger-soft: #f8e8e9;
  --tt-info: #466a7f;
  --tt-info-soft: #e8f0f4;
  min-height: 100%;
  background: #f7f5f2;
  background: var(--tt-bg);
  color: #171717;
  color: var(--tt-text);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  text-rendering: optimizeLegibility;
}

@media (prefers-color-scheme: dark) {
  page {
    --tt-bg: #0e0f10;
    --tt-surface: #17191b;
    --tt-surface-alt: #202326;
    --tt-surface-raised: #1d2022;
    --tt-text: #f5f3f0;
    --tt-text-secondary: #a6a29d;
    --tt-text-tertiary: #7d7f82;
    --tt-border: #2b2e31;
    --tt-border-strong: #3b3f43;
    --tt-accent: #ff8a78;
    --tt-accent-pressed: #ff9d8e;
    --tt-accent-soft: #3a2421;
    --tt-on-accent: #23100d;
    --tt-success: #74b596;
    --tt-success-soft: #1d3028;
    --tt-warning: #d9b36c;
    --tt-warning-soft: #342b1d;
    --tt-danger: #ff858a;
    --tt-danger-soft: #3a2225;
    --tt-info: #83b0c8;
    --tt-info-soft: #1f3038;
    background: #0e0f10;
    color: #f5f3f0;
  }
}

view,
text,
button,
input,
textarea,
picker,
scroll-view,
image {
  box-sizing: border-box;
}

button {
  min-height: 88rpx;
  margin: 0;
  padding: 18rpx 28rpx;
  border: 1rpx solid var(--tt-border);
  border-radius: 16rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow-wrap: anywhere;
  transition: transform 160ms ease, opacity 160ms ease, background-color 160ms ease;
}

button::after { border: 0; }
button.button-hover,
button:active { opacity: .86; transform: scale(.985); }
button[loading] { opacity: .68; }
button[disabled] {
  border-color: var(--tt-border);
  background: var(--tt-surface-alt);
  color: var(--tt-text-tertiary);
  opacity: 1;
  transform: none;
}

input,
textarea {
  min-height: 88rpx;
  border: 1rpx solid var(--tt-border);
  border-radius: 16rpx;
  background: var(--tt-surface);
  color: var(--tt-text);
  font-size: 28rpx;
}

.page,
.tt-page {
  min-height: 100vh;
  padding: 28rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  color: var(--tt-text);
}

.tt-display,
.title {
  color: var(--tt-text);
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.16;
  overflow-wrap: anywhere;
}

.tt-title,
.section-title {
  color: var(--tt-text);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -.4rpx;
  line-height: 1.3;
}

.tt-subtitle { color: var(--tt-text); font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.tt-body { color: var(--tt-text); font-size: 28rpx; line-height: 1.6; }
.tt-caption,
.muted,
.section-copy {
  color: var(--tt-text-secondary);
  font-size: 25rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.tt-meta { color: var(--tt-text-tertiary); font-size: 22rpx; line-height: 1.45; }
.tt-kicker {
  color: var(--tt-accent);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.card,
.tt-card,
.tt-surface {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--tt-border);
  border-radius: 22rpx;
  background: var(--tt-surface);
  color: var(--tt-text);
  overflow-wrap: anywhere;
}

.tt-surface-alt { background: var(--tt-surface-alt); }
.tt-divider { height: 1rpx; background: var(--tt-border); }
.tt-row { display: flex; align-items: center; gap: 20rpx; }
.tt-row-between { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.tt-stack { display: flex; flex-direction: column; gap: 20rpx; }

.primary-button,
.tt-button-primary {
  min-height: 88rpx;
  border-color: var(--tt-accent);
  background: var(--tt-accent);
  color: var(--tt-on-accent);
  font-weight: 700;
}
.primary-button.button-hover,
.primary-button:active,
.tt-button-primary.button-hover,
.tt-button-primary:active {
  border-color: var(--tt-accent-pressed);
  background: var(--tt-accent-pressed);
  opacity: 1;
}
.secondary-button,
.retry-button,
.resource-retry,
.tt-button-secondary {
  min-height: 88rpx;
  border-color: var(--tt-border-strong);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-weight: 600;
}
.tt-button-ghost { border-color: transparent; background: transparent; color: var(--tt-text-secondary); }
.tt-button-danger { border-color: var(--tt-danger); background: var(--tt-danger-soft); color: var(--tt-danger); }
.secondary-button.button-hover,
.secondary-button:active,
.retry-button.button-hover,
.retry-button:active,
.resource-retry.button-hover,
.resource-retry:active,
.tt-button-secondary.button-hover,
.tt-button-secondary:active { border-color: var(--tt-accent); background: var(--tt-accent-soft); opacity: 1; }
.full-button { width: 100%; }

.tt-pill,
.tt-status {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}
.tt-status-success { background: var(--tt-success-soft); color: var(--tt-success); }
.tt-status-warning { background: var(--tt-warning-soft); color: var(--tt-warning); }
.tt-status-danger { background: var(--tt-danger-soft); color: var(--tt-danger); }
.tt-status-info { background: var(--tt-info-soft); color: var(--tt-info); }

.empty,
.tt-state {
  padding: 88rpx 28rpx;
  color: var(--tt-text-secondary);
  font-size: 25rpx;
  line-height: 1.65;
  text-align: center;
  overflow-wrap: anywhere;
}

.tt-safe-bottom { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.tt-animate-in { animation: tt-fade-up 240ms ease both; }
@keyframes tt-fade-up {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  button,
  .tt-animate-in { animation: none; transition: none; transform: none; }
}
