page {
  min-height: 100%;
  background: #fff8f8;
  color: #2d2023;
  font-size: 30rpx;
}

button {
  border-radius: 16rpx;
}

button::after {
  border: 0;
}

.page {
  padding: 28rpx 28rpx 48rpx;
}

.card {
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(96, 50, 60, 0.07);
}

.title {
  font-size: 38rpx;
  font-weight: 700;
}

.muted {
  color: #8d6e73;
  font-size: 26rpx;
}

.primary-button {
  background: #b94a68;
  color: #fff;
}

.empty {
  padding: 100rpx 20rpx;
  text-align: center;
  color: #8d6e73;
}
