<tt-card-shell tone="{{tone}}" size="feature" interactive selected="{{selected}}" tilt="{{tilt}}" depth="{{depth}}" motion-level="{{motionLevel}}" entrance="{{entrance}}" stagger="{{stagger}}" motion-off="{{motionOff}}" risk="standard" aria-label="选择陪伴场景：{{title}}" bindtap="onTap">
  <view class="scene-card">
    <view class="scene-prop" aria-hidden="true"><slot name="prop" /></view>
    <view wx:if="{{label}}" class="scene-label">{{label}}</view>
    <view class="scene-title">{{title}}</view>
    <view wx:if="{{description}}" class="scene-description">{{description}}</view>
    <view wx:if="{{selected}}" class="scene-selected"><text class="selected-mark">✓</text><text>已选择</text></view>
  </view>
</tt-card-shell>
