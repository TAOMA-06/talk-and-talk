.sheet-root {
  --sheet-surface: #fffefc;
  --sheet-surface-alt: #efeeea;
  --sheet-text: #232220;
  --sheet-text-secondary: #5c5954;
  --sheet-border: #dcd8d2;
  --sheet-border-strong: #979189;
  --sheet-focus-ring: var(--sheet-text);
  --tt-overlay-scrim: rgba(14,15,16,.46);
  --tt-motion-standard: 260ms;
  --tt-motion-emphasis: 420ms;
  --tt-ease-standard: cubic-bezier(.2, .72, .24, 1);
  --tt-ease-emphasis: cubic-bezier(.16, 1, .3, 1);
  position: fixed;
  z-index: 100;
  inset: 0;
}
.sheet-mask { position: absolute; inset: 0; background: var(--tt-overlay-scrim); }
.sheet { position: absolute; right: 0; bottom: 0; left: 0; display: flex; width: 100%; height: 88vh; max-height: 88vh; flex-direction: column; overflow: hidden; border-radius: 32rpx 32rpx 0 0; background: var(--sheet-surface); color: var(--sheet-text); }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 14rpx auto 4rpx; flex: 0 0 auto; border-radius: 999rpx; background: var(--sheet-border-strong); }
.sheet-header { display: flex; flex: 0 0 auto; align-items: flex-start; gap: 20rpx; padding: 20rpx 28rpx 18rpx; }
.sheet-heading { min-width: 0; flex: 1; }
.sheet-title { font-size: 34rpx; font-weight: 700; line-height: 1.3; }
.sheet-subtitle { margin-top: 8rpx; color: var(--sheet-text-secondary); font-size: 24rpx; line-height: 1.5; }
.sheet-close { display: flex; width: 64rpx; min-height: 64rpx; flex: 0 0 64rpx; align-items: center; justify-content: center; padding: 0; border: 0; border-radius: 999rpx; background: var(--sheet-surface-alt); color: var(--sheet-text-secondary); font-size: 38rpx; font-weight: 400; }
.sheet-heading:focus,
.sheet-close:focus { outline: 3rpx solid var(--sheet-focus-ring); outline-offset: 3rpx; }
.sheet-body { width: 100%; height: 0; min-height: 0; flex: 1 1 auto; padding: 0 28rpx 24rpx; overflow: hidden; }
.sheet-footer { flex: 0 0 auto; padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--sheet-border); background: var(--sheet-surface); }
.sheet-root.motion-m1:not(.motion-off) .sheet-mask { animation: sheet-fade var(--tt-motion-standard) var(--tt-ease-standard) both; }
.sheet-root.motion-m1:not(.motion-off) .sheet { animation: sheet-rise var(--tt-motion-emphasis) var(--tt-ease-emphasis) both; }
@keyframes sheet-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheet-rise { from { opacity: .76; transform: translateY(42rpx); } to { opacity: 1; transform: translateY(0); } }
.motion-off .sheet,
.motion-off .sheet-mask { animation: none; transition: none; }
@media (prefers-reduced-motion: reduce) { .sheet,.sheet-mask { animation: none !important; transition: none; } }
@media (prefers-color-scheme: dark) {
  .sheet-root {
    --sheet-surface: #1b1c1a;
    --sheet-surface-alt: #232521;
    --sheet-text: #f3f1ed;
    --sheet-text-secondary: #b9b4ac;
    --sheet-border: #343630;
    --sheet-border-strong: #6b6f67;
    --sheet-focus-ring: var(--sheet-text);
  }
}
