:host { display: inline-flex; }
.status { display: inline-flex; min-height: 44rpx; align-items: center; gap: 10rpx; padding: 6rpx 16rpx; border: 1rpx solid var(--tt-border); border-radius: 999rpx; background: var(--tt-surface-alt); color: var(--tt-text-secondary); font-size: 22rpx; font-weight: 600; line-height: 1.3; }
.status-dot { width: 10rpx; height: 10rpx; border-radius: 999rpx; background: currentColor; }
.status-success { border-color: var(--tt-color-status-success-stroke); background: var(--tt-success-soft); color: var(--tt-success); }
.status-warning { border-color: var(--tt-color-status-warning-stroke); background: var(--tt-warning-soft); color: var(--tt-warning); }
.status-danger { border-color: var(--tt-color-status-danger-stroke); background: var(--tt-danger-soft); color: var(--tt-danger); }
.status-info { border-color: var(--tt-color-status-info-stroke); background: var(--tt-info-soft); color: var(--tt-info); }
.status-unknown { border-color: var(--tt-color-status-unknown-stroke); background: var(--tt-color-status-unknown-bg); color: var(--tt-color-status-unknown-fg); }
.status-accent { border-color: var(--tt-color-pastel-apricot-stroke); background: var(--tt-color-pastel-apricot-bg); color: var(--tt-color-pastel-apricot-fg); }
