<view class="consent-page {{motionOff ? 'tt-motion-off' : ''}}">
  <view class="consent-document-stage" aria-label="开始使用前的服务与隐私确认">
  <view class="consent-paper-edge consent-paper-back" aria-hidden="true"></view>
  <view class="consent-paper-edge consent-paper-middle" aria-hidden="true"></view>
  <view class="consent-hero">
    <view class="brand-row"><view class="brand-mark"><view></view><view></view></view><view class="brand">{{brandName}}</view></view>
    <view class="title">开始前确认</view>
    <view class="summary">阅读协议，并确认年龄。</view>
  </view>
  </view>

  <view class="notice">
    <view class="notice-item notice-blue"><view class="notice-index">01</view><view class="notice-title">服务、支付与沟通留在平台内</view></view>
    <view class="notice-item notice-apricot"><view class="notice-index">02</view><view class="notice-title">原文不发送给外部生成式 AI</view></view>
    <view class="notice-item notice-mint"><view class="notice-index">03</view><view class="notice-title">首发为文字陪伴：不开放媒体上传、实时语音或 TRTC。</view></view>
  </view>

  <view class="document-links">
    <button class="document-link" bindtap="openTerms">查看《用户协议》</button>
    <button class="document-link" bindtap="openPrivacy">查看《隐私政策》</button>
  </view>

  <view class="consent-surface">
    <checkbox-group bindchange="setAgreement"><label class="agreement"><checkbox value="accepted" checked="{{agreed}}" color="#292724" />我已阅读并同意《用户协议》和《隐私政策》</label></checkbox-group>
    <checkbox-group bindchange="setAdultConfirmation"><label class="agreement"><checkbox value="adult" checked="{{adultConfirmed}}" color="#292724" />我确认本人已年满 18 周岁</label></checkbox-group>
    <button class="primary-button accept" loading="{{submitting}}" disabled="{{!agreed || !adultConfirmed || submitting}}" bindtap="accept">同意并进入</button>
  </view>
  <view class="rights-recovery">
    <view class="rights-title">不同意或已撤回同意？</view>
    <view class="rights-copy">仍可进入受限自助中心处理账号权利、申诉与注销；不会开通其他功能。</view>
    <button class="recovery-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="enterAccountRights">仅进入账号权利与申诉</button>
  </view>
  <button class="document-link customer-service" open-type="contact">联系客服或行使隐私权利</button>
</view>
