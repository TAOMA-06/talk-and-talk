.consent-page { box-sizing: border-box; min-height: 100vh; padding: 64rpx 32rpx 48rpx; background: #f7f7f5; }
.brand { color: #9b405b; font-size: 24rpx; font-weight: 700; letter-spacing: 3rpx; }
.title { margin-top: 12rpx; color: #202124; font-size: 52rpx; font-weight: 700; line-height: 1.2; }
.summary { margin-top: 24rpx; color: #646970; font-size: 28rpx; line-height: 1.7; overflow-wrap: anywhere; }
.notice { margin-top: 32rpx; padding: 24rpx; border: 1rpx solid #e4e6e8; border-radius: 20rpx; background: #f6ecef; color: #202124; font-size: 25rpx; line-height: 1.7; overflow-wrap: anywhere; }
.notice view + view { margin-top: 12rpx; }
.document-links { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.document-link { display: flex; min-width: 240rpx; min-height: 88rpx; flex: 1; align-items: center; margin: 0; padding: 0 16rpx; border: 1rpx solid #e4e6e8; background: #ffffff; color: #9b405b; font-size: 26rpx; line-height: 1.4; text-align: left; }
.agreement { display: flex; min-height: 88rpx; align-items: flex-start; gap: 12rpx; margin-top: 24rpx; padding: 16rpx 0; color: #202124; font-size: 26rpx; line-height: 1.55; overflow-wrap: anywhere; }
.agreement checkbox { flex: none; transform: scale(.82); transform-origin: top left; }
.accept { width: 100%; margin-top: 24rpx; }
.accept[disabled] { border-color: #e4e6e8; background: #f1f2f3; color: #8a9098; }
.rights-recovery { margin-top: 32rpx; padding: 24rpx; border: 1rpx solid #e4e6e8; border-radius: 20rpx; background: #ffffff; }
.rights-title { color: #202124; font-size: 28rpx; font-weight: 700; line-height: 1.4; }
.rights-copy { margin-top: 12rpx; color: #646970; font-size: 24rpx; line-height: 1.65; overflow-wrap: anywhere; }
.recovery-button { width: 100%; min-height: 88rpx; margin-top: 24rpx; border: 1rpx solid #9b405b; background: #ffffff; color: #9b405b; font-size: 26rpx; }
.recovery-button[disabled] { border-color: #e4e6e8; color: #8a9098; }
.customer-service { width: 100%; min-height: 88rpx; margin-top: 24rpx; text-align: center; }
