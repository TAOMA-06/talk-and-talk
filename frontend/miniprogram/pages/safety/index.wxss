.safety-page { padding-bottom: 56rpx; }
.safety-hero { margin: 8rpx 0 28rpx; padding: 34rpx; border-radius: 28rpx; background: linear-gradient(135deg, #fcebed, #fff8f3); }
.safety-eyebrow { color: #a43f5c; font-size: 23rpx; font-weight: 700; letter-spacing: 2rpx; }
.safety-title { margin-top: 10rpx; color: #3e2b30; font-size: 42rpx; font-weight: 700; }
.safety-copy { margin-top: 14rpx; color: #765b60; font-size: 26rpx; line-height: 1.65; }
.section-title { color: #443037; font-size: 31rpx; font-weight: 700; }
.section-copy { margin-top: 14rpx; color: #654f55; font-size: 26rpx; line-height: 1.7; }
.section-note { margin-top: 14rpx; color: #8b7077; font-size: 23rpx; line-height: 1.6; }
.urgent-card { border: 1rpx solid #e2bcc5; background: #fffafa; }
.leave-button, .primary-action, .secondary-button { width: 100%; margin-top: 22rpx; border-radius: 12rpx; font-size: 26rpx; }
.leave-button { background: #b94a68; color: #fff; }
.primary-action { background: #a43f5c; color: #fff; }
.secondary-button { border: 1rpx solid #dbbdc4; background: transparent; color: #a43f5c; }
.action-note { margin-top: 12rpx; color: #90787d; font-size: 22rpx; line-height: 1.5; text-align: center; }
.action-card { border-color: #eadfe1; }
.appeal-card { border-color: #e6d8dc; }
.appeal-subtitle { margin-top: 24rpx; color: #60464f; font-size: 25rpx; font-weight: 700; }
.history-subtitle { padding-top: 8rpx; border-top: 1rpx solid #eee2e5; }
.appeal-state { margin-top: 20rpx; padding: 22rpx; border-radius: 14rpx; background: #f8f4f5; color: #7b646b; font-size: 24rpx; text-align: center; }
.appeal-error { margin-top: 20rpx; padding: 22rpx; border-radius: 14rpx; background: #fff1f1; color: #8b414b; font-size: 24rpx; line-height: 1.6; }
.retry-button { margin: 16rpx 0 0; padding: 0; background: transparent; color: #a43f5c; font-size: 24rpx; line-height: 1.5; }
.appeal-item { margin-top: 20rpx; padding: 22rpx; border: 1rpx solid #eadfe1; border-radius: 16rpx; background: #fffdfd; }
.appeal-overdue { border-color: #d48a93; background: #fff7f7; }
.appeal-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.appeal-status { flex: 0 0 auto; padding: 6rpx 12rpx; border-radius: 999rpx; background: #f0ecee; color: #725c64; font-size: 21rpx; font-weight: 700; }
.status-pending { background: #fff0d9; color: #8b5f24; }
.status-overturned { background: #e7f4ed; color: #37715a; }
.status-upheld { background: #f3e9ec; color: #88495a; }
.appeal-id { color: #9a838a; font-size: 20rpx; word-break: break-all; text-align: right; }
.appeal-reason { margin-top: 16rpx; color: #554047; font-size: 25rpx; line-height: 1.65; word-break: break-word; }
.appeal-preview { margin-top: 12rpx; padding: 14rpx; border-radius: 10rpx; background: #f8f3f4; color: #765f67; font-size: 22rpx; line-height: 1.55; word-break: break-word; }
.appeal-deadline { margin-top: 14rpx; color: #714c59; font-size: 23rpx; font-weight: 700; line-height: 1.55; }
.appeal-meta { margin-top: 8rpx; color: #917a81; font-size: 20rpx; line-height: 1.5; }
.appeal-submit { width: 100%; margin-top: 18rpx; border-radius: 12rpx; background: #a43f5c; color: #fff; font-size: 24rpx; }
.rules-card { background: #fffdfc; }
.rule-actions { display: flex; flex-wrap: wrap; gap: 16rpx 28rpx; margin-top: 22rpx; }
.text-button { margin: 0; padding: 0; background: transparent; color: #a43f5c; font-size: 25rpx; line-height: 1.5; }
.leave-button::after, .primary-action::after, .secondary-button::after, .text-button::after, .retry-button::after, .appeal-submit::after { border: 0; }
.safety-footer { padding: 8rpx 16rpx; color: #90787d; font-size: 22rpx; line-height: 1.65; text-align: center; }
