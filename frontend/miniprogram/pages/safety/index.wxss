.safety-page {
  padding-bottom: 56rpx;
}

.safety-hero {
  margin: 8rpx 0 28rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--tt-accent-soft);
  border: 1rpx solid var(--tt-border);
}

.safety-eyebrow {
  color: var(--tt-accent);
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.safety-title {
  margin-top: 10rpx;
  color: var(--tt-accent);
  font-size: 42rpx;
  font-weight: 700;
}

.safety-copy {
  margin-top: 14rpx;
  color: var(--tt-text);
  font-size: 26rpx;
  line-height: 1.65;
}

.section-title {
  color: var(--tt-accent);
  font-size: 31rpx;
  font-weight: 700;
}

.section-copy {
  margin-top: 14rpx;
  color: var(--tt-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.section-note {
  margin-top: 14rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.6;
}

.urgent-card {
  border: 1rpx solid var(--tt-border-strong);
  background: var(--tt-danger-soft);
  border-color: var(--tt-border);
}

.leave-button, .primary-action, .secondary-button {
  width: 100%;
  margin-top: 22rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.leave-button {
  background: var(--tt-danger);
  color: var(--tt-on-accent);
  font-weight: 700;
}

.primary-action {
  background: var(--tt-accent);
  color: var(--tt-on-accent);
}

.secondary-button {
  border: 1rpx solid var(--tt-border-strong);
  background: var(--tt-surface);
  color: var(--tt-accent);
  min-height: 80rpx;
  border-color: var(--tt-accent-soft);
}

.action-note {
  margin-top: 12rpx;
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.action-card {
  border-color: var(--tt-border);
}

.appeal-card {
  border-color: var(--tt-border);
}

.appeal-subtitle {
  margin-top: 24rpx;
  color: var(--tt-accent);
  font-size: 25rpx;
  font-weight: 700;
}

.history-subtitle {
  padding-top: 8rpx;
  border-top: 1rpx solid var(--tt-accent-soft);
  border-color: var(--tt-border);
}

.appeal-state {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-text-secondary);
  font-size: 24rpx;
  text-align: center;
}

.appeal-error {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 24rpx;
  line-height: 1.6;
}

.retry-button {
  margin: 16rpx 0 0;
  padding: 0;
  background: transparent;
  color: var(--tt-accent);
  font-size: 24rpx;
  line-height: 1.5;
}

.appeal-item {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid var(--tt-danger-soft);
  border-radius: 16rpx;
  background: var(--tt-danger-soft);
}

.appeal-overdue {
  border-color: var(--tt-border-strong);
  background: var(--tt-border);
}

.appeal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.appeal-status {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 21rpx;
  font-weight: 700;
}

.status-pending {
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
}

.status-overturned {
  background: var(--tt-success-soft);
  color: var(--tt-success);
}

.status-upheld {
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.appeal-id {
  color: var(--tt-text-secondary);
  font-size: 20rpx;
  word-break: break-all;
  text-align: right;
}

.appeal-reason {
  margin-top: 16rpx;
  color: var(--tt-text);
  font-size: 25rpx;
  line-height: 1.65;
  word-break: break-word;
}

.appeal-preview {
  margin-top: 12rpx;
  padding: 14rpx;
  border-radius: 10rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-text);
  font-size: 22rpx;
  line-height: 1.55;
  word-break: break-word;
}

.appeal-deadline {
  margin-top: 14rpx;
  color: var(--tt-accent);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.55;
}

.appeal-meta {
  margin-top: 8rpx;
  color: var(--tt-text-secondary);
  font-size: 20rpx;
  line-height: 1.5;
}

.appeal-submit {
  width: 100%;
  margin-top: 18rpx;
  border-radius: 12rpx;
  background: var(--tt-accent);
  color: var(--tt-on-accent);
  font-size: 24rpx;
}

.rules-card {
  background: var(--tt-surface);
  border: 1rpx solid var(--tt-border);
}

.rule-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 28rpx;
  margin-top: 22rpx;
}

.text-button {
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--tt-accent);
  font-size: 25rpx;
  line-height: 1.5;
}

.leave-button::after, .primary-action::after, .secondary-button::after, .text-button::after, .retry-button::after, .appeal-submit::after {
  border: 0;
}

.safety-footer {
  padding: 8rpx 16rpx;
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  line-height: 1.65;
  text-align: center;
}

.safety-title, .section-title, .appeal-subtitle {
  color: var(--tt-text);
  font-weight: 700;
}

.safety-copy, .section-copy {
  color: var(--tt-text-secondary);
}

.section-note, .action-note, .appeal-meta, .appeal-id, .safety-footer {
  color: var(--tt-text-tertiary);
}

.leave-button, .primary-action, .appeal-submit {
  min-height: 88rpx;
  border-radius: 14rpx;
  background: var(--tt-accent);
  color: var(--tt-on-accent);
}

.action-card, .appeal-card, .appeal-item {
  border-color: var(--tt-border);
  background: var(--tt-surface);
}

.appeal-state, .appeal-preview {
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
}

.appeal-error, .appeal-overdue {
  border-color: var(--tt-border);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.appeal-deadline, .retry-button, .text-button {
  color: var(--tt-accent);
}

.leave-button.button-hover {
  background: var(--tt-accent-pressed);
}

.primary-action.button-hover, .appeal-submit.button-hover {
  background: var(--tt-accent-pressed);
}

.leave-button[disabled], .primary-action[disabled], .appeal-submit[disabled] {
  opacity: 0.52;
}
