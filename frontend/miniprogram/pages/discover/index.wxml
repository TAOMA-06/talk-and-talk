<view class="page">
  <view class="hero">
    <view class="hero-title">找一位合适的陪伴者</view>
    <view class="hero-copy">所有沟通都在平台内完成，守住边界也守住安心。</view>
  </view>
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{error}}" class="empty">{{error}}</view>
  <view wx:elif="{{!companions.length}}" class="empty">暂时还没有可预约的陪伴者，稍后再来看看。</view>
  <view wx:else>
    <view class="recommendation-note" wx:if="{{!recommendationFallback}}">根据你的设置、当前场景与服务状态推荐；可在“我的”中关闭。</view>
    <view id="discover-recommendation-{{item.impressionId}}" class="card companion" wx:for="{{companions}}" wx:key="id" bindtap="openCompanion" data-id="{{item.id}}" data-impression-id="{{item.impressionId}}" data-theme-id="{{item.topicIds[0]}}">
      <view class="avatar">{{item.initials}}</view>
      <view class="content">
        <view class="row"><text class="name">{{item.name}}</text><text wx:if="{{item.isVerified}}" class="verified">已认证</text></view>
        <view class="muted">{{item.role}} · {{item.availability}}</view>
        <view wx:if="{{item.reasonText}}" class="reason">{{item.reasonText}}</view>
        <view class="bio">{{item.bio}}</view>
        <view class="row footer"><text>★ {{item.rating}}（{{item.reviewCount}}）</text><text>¥{{item.pricePerHalfHour}} / 30 分钟</text></view>
      </view>
    </view>
  </view>
</view>
