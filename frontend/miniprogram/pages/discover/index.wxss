.hero { margin: 0 0 24rpx; padding: 32rpx; border: 1rpx solid #e4e6e8; border-radius: 20rpx; background: #f6ecef; }
.hero-title { color: #202124; font-size: 44rpx; font-weight: 700; line-height: 1.25; overflow-wrap: anywhere; }
.hero-copy { margin-top: 12rpx; color: #646970; font-size: 26rpx; line-height: 1.6; overflow-wrap: anywhere; }
.recovery-notice { margin: 0 0 24rpx; padding: 20rpx 24rpx; border-left: 6rpx solid #8a6426; border-radius: 14rpx; background: #faf4e8; }
.recovery-heading { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 12rpx 16rpx; color: #8a6426; font-size: 24rpx; font-weight: 800; overflow-wrap: anywhere; }
.recovery-heading button { flex: 0 0 auto; min-height: 88rpx; margin: -16rpx 0; padding: 0 16rpx; border: 0; background: transparent; color: #8a6426; font-size: 21rpx; line-height: 1.4; }
.recovery-heading button::after { border: 0; }
.recovery-copy { margin-top: 8rpx; color: #646970; font-size: 23rpx; line-height: 1.65; overflow-wrap: anywhere; }
.filter-panel { margin: 0 0 24rpx; padding: 24rpx; border: 1rpx solid #e4e6e8; border-radius: 20rpx; background: #ffffff; }
.search-heading { color: #202124; font-size: 30rpx; font-weight: 700; }
.search-row { display: flex; margin-top: 16rpx; align-items: center; gap: 12rpx; }
.search-input { min-width: 0; height: 88rpx; flex: 1; padding: 0 18rpx; border: 1rpx solid #e4e6e8; border-radius: 14rpx; background: #ffffff; color: #202124; font-size: 25rpx; }
.search-submit { flex: 0 0 auto; min-width: 128rpx; height: 88rpx; margin: 0; padding: 0 20rpx; border: 1rpx solid #9b405b; border-radius: 14rpx; background: #9b405b; color: #ffffff; font-size: 25rpx; line-height: 86rpx; }
.search-submit::after { border: 0; }
.search-copy { margin-top: 10rpx; color: #646970; font-size: 22rpx; line-height: 1.5; }
.filter-heading { margin-top: 32rpx; color: #202124; font-size: 30rpx; font-weight: 700; }
.filter-copy { margin-top: 8rpx; color: #646970; font-size: 22rpx; line-height: 1.5; }
.filter-group { margin-top: 20rpx; }
.filter-group-last { margin-bottom: 2rpx; }
.filter-label { margin-bottom: 12rpx; color: #202124; font-size: 23rpx; font-weight: 600; }
.sort-copy { margin-top: 12rpx; color: #8a9098; font-size: 21rpx; line-height: 1.5; }
.filter-scroll { width: 100%; white-space: nowrap; }
.filter-resource-state { color: #646970; font-size: 22rpx; line-height: 1.6; }
.filter-resource-error { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12rpx 16rpx; padding: 16rpx; border: 1rpx solid #a33d45; border-radius: 14rpx; background: #faeeee; color: #a33d45; font-size: 22rpx; line-height: 1.5; }
.filter-resource-retry { flex: 0 0 auto; min-height: 88rpx; margin: 0; padding: 0 20rpx; border: 1rpx solid #a33d45; border-radius: 999rpx; background: #ffffff; color: #a33d45; font-size: 21rpx; line-height: 86rpx; }
.filter-resource-retry::after { border: 0; }
.filter-options { display: flex; gap: 12rpx; width: max-content; }
.filter-group-last .filter-options { width: 100%; flex-wrap: wrap; }
.filter-chip { display: inline-flex; min-height: 88rpx; margin: 0; padding: 0 24rpx; align-items: center; justify-content: center; border: 1rpx solid #e4e6e8; border-radius: 999rpx; background: #ffffff; color: #646970; font-size: 23rpx; line-height: 1.4; }
.filter-chip::after, .filter-clear::after, .empty-clear::after { border: 0; }
.filter-chip-selected { border-color: #9b405b; background: #f6ecef; color: #9b405b; font-weight: 600; }
.filter-summary { display: flex; flex-wrap: wrap; margin-top: 20rpx; padding-top: 16rpx; align-items: center; justify-content: space-between; gap: 12rpx 16rpx; border-top: 1rpx solid #e4e6e8; color: #646970; font-size: 23rpx; }
.filter-clear, .empty-clear { flex: 0 0 auto; min-height: 88rpx; margin: -16rpx 0; padding: 0 16rpx; border: 0; background: transparent; color: #9b405b; font-size: 23rpx; line-height: 1.4; }
.filter-result-note { margin: 0 0 16rpx; color: #646970; font-size: 23rpx; line-height: 1.5; }
.filter-empty { line-height: 1.6; }
.empty-clear { display: block; margin: 8rpx auto 0; }
.recommendation-note { margin: 0 0 16rpx; color: #646970; font-size: 23rpx; line-height: 1.5; }
.companion { display: flex; gap: 20rpx; }
.avatar { display: flex; width: 88rpx; height: 88rpx; flex: 0 0 88rpx; align-items: center; justify-content: center; border-radius: 50%; background: #f6ecef; color: #9b405b; font-weight: 700; }
.content { flex: 1; min-width: 0; }
.row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8rpx 16rpx; }
.name { min-width: 0; color: #202124; font-size: 32rpx; font-weight: 700; overflow-wrap: anywhere; }
.verified { flex: 0 0 auto; padding: 4rpx 10rpx; border-radius: 999rpx; background: #edf6f1; color: #2f6b55; font-size: 21rpx; }
.bio { display: -webkit-box; margin: 12rpx 0; overflow: hidden; color: #646970; font-size: 26rpx; line-height: 1.55; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.reason { display: inline-block; margin-top: 8rpx; padding: 4rpx 10rpx; border-radius: 999rpx; background: #faf4e8; color: #8a6426; font-size: 22rpx; overflow-wrap: anywhere; }
.footer { color: #646970; font-size: 24rpx; line-height: 1.5; overflow-wrap: anywhere; }
.emergency-entry { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 16rpx 0 24rpx; padding: 24rpx; border: 1rpx solid #a33d45; border-radius: 20rpx; background: #faeeee; }
.emergency-title { color: #a33d45; font-size: 25rpx; font-weight: 800; }
.emergency-copy { margin-top: 6rpx; color: #646970; font-size: 21rpx; line-height: 1.5; overflow-wrap: anywhere; }
.emergency-arrow { flex: 0 0 auto; color: #a33d45; font-size: 42rpx; }
.companion:active { border-color: #9b405b; background: #f6ecef; }
