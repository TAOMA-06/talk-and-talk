<view class="page profile-page {{motionOff ? 'tt-motion-off' : ''}}">
  <tt-skeleton wx:if="{{profileLoading}}" rows="3" motion-off="{{motionOff}}" />
  <tt-state wx:elif="{{profileError}}" type="error" title="个人中心无法加载" description="{{profileError}}" action-text="重试" motion-off="{{motionOff}}" bindaction="load" />
  <view wx:else>
    <view class="personal-desk tt-motion-m3" wx:if="{{user}}">
      <view class="desk-sign"><text>我的</text><tt-cartoon-prop kind="folder" tone="lavender" size="sm" motion="none" motion-off="{{motionOff}}" expressive risk="standard" /></view>
      <tt-card-stage layout="assemble" min-height="350" motion-level="m3" entrance="assemble" active motion-off="{{motionOff}}" risk="standard" aria-label="个人资料卡组">
        <view slot="back" class="desk-stage-layer"><view class="desk-context-card desk-private-card"><view>书签</view></view></view>
        <view slot="middle" class="desk-stage-layer"><view class="desk-context-card desk-account-card"><view>账户</view></view></view>
        <view slot="front" class="desk-stage-layer">
          <view class="profile-hero"><tt-avatar fallback="{{userInitials}}" alt="当前账号头像" size="xl" /><view class="profile-identity"><view class="title">{{user.profile.displayName || '微信用户'}}</view><view class="muted">{{user.role === 'companion' ? '陪伴者' : '普通用户'}}</view><tt-status text="已登录" tone="success" /></view></view>
        </view>
      </tt-card-stage>
    </view>

    <view class="card profile-editor" wx:if="{{user}}">
      <view class="title small">公开资料</view>
      <input value="{{displayName}}" bindinput="setDisplayName" placeholder="显示名称" maxlength="30" />
      <picker mode="selector" range="{{genderLabels}}" value="{{genderIndex}}" bindchange="setGender" aria-label="选择性别，当前为{{genderLabel}}"><view class="picker">性别：{{genderLabel}}</view></picker>
      <button class="primary-button" loading="{{saving}}" bindtap="saveProfile">保存</button>
    </view>

    <view class="profile-hub tt-card">
      <tt-list-cell title="账户与隐私" bindtap="openAccountCenter" />
      <tt-list-cell title="通知" meta="{{unreadNotificationState === 'available' ? unreadNotificationCount + ' 条未读' : '待核对'}}" bindtap="openNotificationCenter" />
      <tt-list-cell title="案件" bindtap="openSupportCenter" />
    </view>

    <view class="card public-identity-card" aria-live="polite">
      <view class="title small">公开互动暂不可用</view>
      <view class="muted">身份核验授权未开放；新预约、支付、发帖和即时消息保持关闭。</view>
      <button class="resource-retry" bindtap="openSupportCenter">查看支持</button>
    </view>

    <view class="card resource-error-card" wx:if="{{recommendationSettingsState === 'error'}}" aria-live="polite">
      <view class="title small">推荐设置无法读取</view><view class="muted">{{recommendationSettingsError}}</view><button class="resource-retry" bindtap="load">重试</button>
    </view>
    <view class="card" wx:elif="{{recommendationSettingsState === 'available' && recommendationPreferences}}">
      <view class="recommendation-header"><view><view class="title small">个性化推荐</view><view class="muted">当前未开放</view></view><switch checked="{{false}}" disabled color="#292724" aria-label="个性化推荐未开放" /></view>
      <view wx:if="{{recommendationPreferences.behavioralTags.length}}" class="behavior-tags"><view class="recommendation-label">历史标签</view><view class="choices"><view wx:for="{{recommendationPreferences.behavioralTags}}" wx:key="id" class="behavior-tag" bindtap="deleteRecommendationTag" data-id="{{item.id}}" aria-role="button" aria-label="删除行为标签：{{item.name}}" tabindex="0">{{item.name}} ×</view></view></view>
    </view>

    <view wx:if="{{user && user.role === 'user'}}" class="card recommendation-exclusions">
      <view class="title small">停止推荐</view>
      <view wx:if="{{recommendationExclusionsUnavailable}}" class="recommendation-exclusion-empty" aria-live="polite"><view>列表无法读取，状态未知。</view><button class="resource-retry" bindtap="load">重试</button></view>
      <view wx:elif="{{excludedRecommendationCompanions.length}}" class="recommendation-exclusion-list">
        <view wx:for="{{excludedRecommendationCompanions}}" wx:key="companionId" class="recommendation-exclusion-item">
          <view class="recommendation-exclusion-main"><view class="recommendation-exclusion-avatar">{{item.companion.initials}}</view><view class="recommendation-exclusion-copy"><view class="recommendation-exclusion-name">{{item.companion.name}}</view><view class="recommendation-exclusion-state">{{item.companion.currentlyPublic ? '可手动查看' : '当前不公开'}}</view></view></view>
          <view class="recommendation-exclusion-actions"><button wx:if="{{item.companion.currentlyPublic}}" class="recommendation-exclusion-secondary" data-id="{{item.companionId}}" bindtap="openExcludedRecommendationCompanion">查看</button><button class="recommendation-exclusion-restore" data-id="{{item.companionId}}" bindtap="restoreExcludedRecommendationCompanion" loading="{{recommendationExclusionSavingId === item.companionId}}" disabled="{{recommendationExclusionSavingId !== ''}}">恢复</button></view>
        </view>
        <button wx:if="{{recommendationExclusionsPage < recommendationExclusionsTotalPages}}" class="resource-retry" loading="{{recommendationExclusionsLoadingMore}}" disabled="{{recommendationExclusionsLoadingMore}}" bindtap="loadMoreRecommendationExclusions">{{recommendationExclusionsLoadMoreError ? '重试' : '加载更多'}}</button>
      </view>
      <view wx:else class="recommendation-exclusion-empty">暂无记录</view>
    </view>

    <view wx:if="{{user && user.role === 'user'}}" class="card favorites-card">
      <view class="favorites-heading"><view class="title small">私人书签</view><view class="favorites-private">仅你可见</view></view>
      <view wx:if="{{favoriteCompanionsState === 'error'}}" class="private-resource-error" aria-live="polite"><view>{{favoriteCompanionsError}}</view><button class="resource-retry" bindtap="load">重试</button></view>
      <view wx:elif="{{favoriteCompanionsState === 'available'}}" class="favorite-list">
        <view wx:if="{{availabilityReminderChannelState === 'error'}}" class="private-resource-error">提醒状态未知，开启入口已关闭。</view>
        <view wx:elif="{{!availabilityReminderChannel.available}}" class="private-resource-error">{{availabilityReminderChannel.message}}</view>
        <view wx:for="{{favoriteCompanions}}" wx:key="id" class="favorite-item" bindtap="openFavoriteCompanion" data-id="{{item.id}}" aria-role="button" aria-label="查看书签：{{item.name}}" tabindex="0">
          <view class="favorite-item-main"><view class="favorite-item-name">{{item.name}} · {{item.role}}</view><view class="favorite-item-status">查看</view></view>
          <view class="favorite-reminder" catchtap="stopFavoriteReminderTap" aria-role="group" aria-label="{{item.name}}的可约提醒设置"><view class="favorite-reminder-copy"><view class="favorite-reminder-title">可约提醒 <text class="favorite-reminder-state">{{item.availabilityReminderEnabled ? '已开启' : availabilityReminderChannel.available ? '未开启' : '不可用'}}</text></view><view class="favorite-reminder-limit">每 {{item.availabilityReminderMinimumIntervalHours}} 小时最多一次</view></view><switch data-id="{{item.id}}" checked="{{item.availabilityReminderEnabled}}" disabled="{{favoriteReminderSavingId !== '' || (!item.availabilityReminderEnabled && !availabilityReminderChannel.available)}}" color="#292724" catchchange="setFavoriteAvailabilityReminder" aria-label="{{item.availabilityReminderEnabled ? '关闭' : '开启'}}{{item.name}}的可约提醒" /></view>
        </view>
        <button wx:if="{{favoriteCompanionsPage < favoriteCompanionsTotalPages}}" class="resource-retry" loading="{{favoriteCompanionsLoadingMore}}" disabled="{{favoriteCompanionsLoadingMore}}" bindtap="loadMoreFavoriteCompanions">{{favoriteCompanionsLoadMoreError ? '重试' : '加载更多'}}</button>
      </view>
      <view wx:elif="{{favoriteCompanionsState === 'empty'}}" class="favorites-empty">暂无书签</view>
    </view>

    <view wx:if="{{user && user.role === 'user'}}" class="card recent-views-card">
      <view class="recent-views-heading"><view class="title small">最近浏览</view><view class="recent-views-private">仅你可见</view></view>
      <view wx:if="{{recentViewsState === 'error'}}" class="private-resource-error" aria-live="polite"><view>{{recentViewsError}}</view><button class="resource-retry" bindtap="load">重试</button></view>
      <view wx:elif="{{recentViewsState === 'available'}}" class="recent-views-list"><view wx:for="{{recentlyViewedCompanions}}" wx:key="id" class="recent-view-item" bindtap="openRecentlyViewedCompanion" data-id="{{item.id}}" aria-role="button" aria-label="查看最近浏览：{{item.name}}" tabindex="0"><view class="recent-view-item-main"><view class="recent-view-item-name">{{item.name}} · {{item.role}}</view><view class="recent-view-item-status">查看</view></view></view><button class="recent-views-clear" loading="{{clearingRecentViews}}" disabled="{{clearingRecentViews}}" bindtap="clearRecentlyViewedCompanions">清空</button></view>
      <view wx:elif="{{recentViewsState === 'empty'}}" class="recent-views-empty">暂无记录</view>
    </view>

    <view wx:if="{{user && user.role === 'user'}}" class="card safety-entry"><view class="title small">安全与支持</view><button class="safety-entry-button" bindtap="openSafetyCenter">查看</button></view>
    <view wx:if="{{user && companionProfileState === 'error'}}" class="card resource-error-card" aria-live="polite"><view class="title small">陪伴者状态无法读取</view><view class="muted">{{companionProfileError}}</view><button class="resource-retry" bindtap="load">重试</button></view>
    <view wx:elif="{{user && (user.role === 'companion' || hasCompanionProfile)}}" class="card companion-workbench"><view class="title small">陪伴者工作台</view><button class="primary-button workbench-button" bindtap="openCompanionWorkbench">进入</button></view>
    <view wx:elif="{{user && companionProfileState === 'available'}}" class="card companion-onboarding-card"><view class="title small">陪伴者入驻</view><view class="muted">提交不代表获准接单。</view><button class="primary-button workbench-button" bindtap="openCompanionOnboarding">继续</button></view>

    <view class="legal-links"><button class="legal" bindtap="openTerms">用户协议</button><button class="legal" bindtap="openPrivacy">隐私政策</button><button class="legal" bindtap="openWechatPrivacy">微信隐私指引</button><button class="legal" open-type="contact">客服</button></view>
    <view class="account-actions"><button class="legal" bindtap="signOut">退出账号</button><button class="legal danger" bindtap="requestDeletion">注销账号</button><button class="legal danger" bindtap="withdrawConsent">撤回同意并退出</button></view>
  </view>
</view>
