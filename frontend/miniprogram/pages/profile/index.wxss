input, textarea, .picker { box-sizing: border-box; width: 100%; min-height: 88rpx; margin-top: 16rpx; padding: 16rpx 18rpx; border: 1rpx solid #e4e6e8; border-radius: 14rpx; background: #ffffff; color: #202124; font-size: 27rpx; line-height: 1.5; }
.profile-field-copy { margin-top: 8rpx; color: #646970; font-size: 21rpx; line-height: 1.55; overflow-wrap: anywhere; }
textarea { min-height: 160rpx; }
.row { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 8rpx 16rpx; }
.small { font-size: 32rpx; line-height: 1.35; }
.text-button, .legal { min-height: 88rpx; margin: 0; padding: 16rpx; border: 0; background: transparent; color: #9b405b; font-size: 25rpx; line-height: 1.4; }
.section-title { margin: 32rpx 0 16rpx; }
.notification-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8rpx 16rpx; }
.notification-header .section-title { min-width: 0; flex: 1; }
.compact { padding: 40rpx 10rpx; }
.notification { position: relative; margin-bottom: 16rpx; }
.notification.unread { border-left: 6rpx solid #9b405b; background: #f6ecef; }
.unread-marker { position: absolute; top: 20rpx; right: 24rpx; padding: 4rpx 10rpx; border-radius: 999rpx; background: #ffffff; color: #9b405b; font-size: 20rpx; line-height: 1.35; }
.name { color: #202124; font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; }
.legal-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 8rpx 16rpx; margin-top: 32rpx; }
.legal { display: flex; align-items: center; justify-content: center; margin: 0; color: #646970; text-align: center; }
.account-actions { display: flex; flex-direction: column; align-items: stretch; gap: 8rpx; margin-top: 24rpx; }
.danger { color: #a33d45; }
.recommendation-header { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.recommendation-header > view { min-width: 0; flex: 1; }
.recommendation-label { margin-top: 24rpx; color: #202124; font-size: 27rpx; font-weight: 700; line-height: 1.45; }
.choices { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.choice, .behavior-tag { display: inline-flex; min-height: 88rpx; align-items: center; padding: 10rpx 18rpx; border: 1rpx solid #e4e6e8; border-radius: 999rpx; background: #ffffff; color: #646970; font-size: 24rpx; line-height: 1.4; overflow-wrap: anywhere; }
.choice.selected { border-color: #9b405b; background: #f6ecef; color: #9b405b; font-weight: 600; }
.behavior-tag { border-color: #8a6426; background: #faf4e8; color: #8a6426; }
.recommendation-off { margin-top: 18rpx; line-height: 1.6; }
.behavior-tags { margin-top: 24rpx; }
.recommendation-exclusions { border: 1rpx solid #e4e6e8; background: #ffffff; }
.recommendation-exclusion-list { margin-top: 16rpx; }
.recommendation-exclusion-item { margin-top: 12rpx; padding: 16rpx; border-left: 5rpx solid #646970; border-radius: 0 14rpx 14rpx 0; background: #f1f2f3; }
.recommendation-exclusion-main { display: flex; align-items: center; gap: 14rpx; }
.recommendation-exclusion-avatar { display: flex; width: 56rpx; height: 56rpx; flex: 0 0 56rpx; align-items: center; justify-content: center; border-radius: 50%; background: #ffffff; color: #646970; font-size: 19rpx; font-weight: 800; }
.recommendation-exclusion-copy { min-width: 0; flex: 1; }
.recommendation-exclusion-name { color: #202124; font-size: 25rpx; font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; }
.recommendation-exclusion-state { margin-top: 4rpx; color: #646970; font-size: 21rpx; line-height: 1.45; overflow-wrap: anywhere; }
.recommendation-exclusion-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 12rpx; margin-top: 14rpx; }
.recommendation-exclusion-secondary, .recommendation-exclusion-restore { min-width: 176rpx; min-height: 88rpx; flex: 1; margin: 0; border-radius: 14rpx; font-size: 23rpx; }
.recommendation-exclusion-secondary { border: 1rpx solid #e4e6e8; background: #ffffff; color: #646970; }
.recommendation-exclusion-restore { border: 1rpx solid #3f647a; background: #eef3f6; color: #3f647a; }
.recommendation-exclusion-secondary::after, .recommendation-exclusion-restore::after { border: 0; }
.recommendation-exclusion-empty { margin-top: 14rpx; color: #646970; font-size: 23rpx; line-height: 1.6; overflow-wrap: anywhere; }
.recommendation-exclusion-pagination { margin-top: 16rpx; color: #8a9098; font-size: 21rpx; text-align: center; }
.favorites-card { border: 1rpx solid #e4e6e8; background: #eef3f6; }
.favorites-heading { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 8rpx 16rpx; }
.favorites-heading > view:first-child { min-width: 0; flex: 1; }
.favorites-private { flex: 0 0 auto; padding: 4rpx 10rpx; border-radius: 999rpx; background: #ffffff; color: #3f647a; font-size: 21rpx; letter-spacing: 1rpx; }
.favorite-list { margin-top: 18rpx; border-top: 1rpx solid #e4e6e8; }
.favorite-item { margin-top: 14rpx; padding: 16rpx; border: 1rpx solid #e4e6e8; border-left: 6rpx solid #3f647a; border-radius: 0 14rpx 14rpx 0; background: #ffffff; }
.favorite-item-main { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6rpx 16rpx; }
.favorite-item-name { min-width: 0; color: #202124; font-size: 27rpx; font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; }
.favorite-item-status { flex: 0 0 auto; color: #3f647a; font-size: 23rpx; }
.favorite-item-meta { margin-top: 8rpx; color: #646970; font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.favorite-reminder { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid #e4e6e8; }
.favorite-reminder-copy { min-width: 0; flex: 1; }
.favorite-reminder-title { color: #202124; font-size: 24rpx; font-weight: 700; line-height: 1.45; }
.favorite-reminder-state { margin-left: 8rpx; color: #3f647a; font-size: 21rpx; font-weight: 400; }
.favorite-reminder-description { margin-top: 5rpx; color: #646970; font-size: 21rpx; line-height: 1.5; overflow-wrap: anywhere; }
.favorite-reminder-limit { margin-top: 5rpx; color: #3f647a; font-size: 20rpx; line-height: 1.45; }
.favorite-pagination { margin-top: 16rpx; color: #646970; font-size: 21rpx; line-height: 1.5; text-align: center; }
.favorite-pagination-error { margin: 8rpx 0; color: #a33d45; line-height: 1.5; overflow-wrap: anywhere; }
.favorites-empty { margin-top: 18rpx; padding: 16rpx; border-left: 4rpx solid #3f647a; border-radius: 0 14rpx 14rpx 0; background: #ffffff; color: #3f647a; font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.recent-views-card { border: 1rpx solid #e4e6e8; background: #faf4e8; }
.recent-views-heading { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 8rpx 16rpx; }
.recent-views-heading > view:first-child { min-width: 0; flex: 1; }
.recent-views-private { flex: 0 0 auto; padding: 4rpx 10rpx; border-radius: 999rpx; background: #ffffff; color: #8a6426; font-size: 21rpx; letter-spacing: 1rpx; }
.recent-views-list { margin-top: 18rpx; border-top: 1rpx solid #e4e6e8; }
.recent-view-item { margin-top: 14rpx; padding: 16rpx; border: 1rpx solid #e4e6e8; border-left: 6rpx solid #8a6426; border-radius: 0 14rpx 14rpx 0; background: #ffffff; }
.recent-view-item-main { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6rpx 16rpx; }
.recent-view-item-name { min-width: 0; color: #202124; font-size: 27rpx; font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; }
.recent-view-item-status { flex: 0 0 auto; color: #8a6426; font-size: 23rpx; }
.recent-view-item-meta { margin-top: 8rpx; color: #646970; font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.recent-views-empty { margin-top: 18rpx; padding: 16rpx; border-left: 4rpx solid #8a6426; border-radius: 0 14rpx 14rpx 0; background: #ffffff; color: #8a6426; font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.recent-views-clear { width: 100%; min-height: 88rpx; margin-top: 18rpx; border: 1rpx solid #8a6426; border-radius: 14rpx; background: #ffffff; color: #8a6426; font-size: 25rpx; }
.safety-entry { border: 1rpx solid #e4e6e8; background: #f6ecef; }
.safety-entry-button { width: 100%; min-height: 88rpx; margin-top: 20rpx; border: 1rpx solid #9b405b; border-radius: 14rpx; background: #ffffff; color: #9b405b; font-size: 26rpx; }
.companion-workbench { border: 1rpx solid #e4e6e8; background: #f6ecef; }
.workbench-button { width: 100%; min-height: 88rpx; margin-top: 22rpx; font-size: 28rpx; }
.profile-hub { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-bottom: 20rpx; }
.profile-hub-item { box-sizing: border-box; min-width: 0; min-height: 144rpx; padding: 20rpx 14rpx; border: 1rpx solid #e4e6e8; border-radius: 20rpx; background: #ffffff; }
.profile-hub-title { color: #202124; font-size: 23rpx; font-weight: 800; line-height: 1.4; overflow-wrap: anywhere; }
.profile-hub-copy { margin-top: 8rpx; color: #646970; font-size: 19rpx; line-height: 1.45; overflow-wrap: anywhere; }
.notification-center-entry { width: 100%; min-height: 88rpx; margin: 4rpx 0 22rpx; border: 1rpx solid #e4e6e8; border-radius: 14rpx; background: #ffffff; color: #9b405b; font-size: 24rpx; }
.notification-center-entry::after { border: 0; }
.resource-error-card, .private-resource-error { border-color: #a33d45; border-left: 6rpx solid #a33d45; background: #faeeee; color: #a33d45; }
.private-resource-error { margin-top: 16rpx; padding: 16rpx; border-radius: 0 14rpx 14rpx 0; font-size: 23rpx; line-height: 1.65; overflow-wrap: anywhere; }
.resource-retry { width: 100%; min-height: 88rpx; margin: 14rpx 0 0; border: 1rpx solid #e4e6e8; border-radius: 14rpx; background: #ffffff; color: #9b405b; font-size: 24rpx; }
.resource-retry::after { border: 0; }
.notification .name { padding-right: 72rpx; }
.profile-hub-item:active, .favorite-item:active, .recent-view-item:active, .notification:active { border-color: #9b405b; }
.choice:active, .behavior-tag:active { opacity: 0.78; }
