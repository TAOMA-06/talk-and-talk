.voice-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--tt-bg);
}

.voice-native-node {
  position: fixed;
  left: -200rpx;
  top: -200rpx;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.preflight-card {
  box-sizing: border-box;
  padding: 32rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: none;
}

.preflight-title {
  margin-top: 12rpx;
  color: var(--tt-text);
  font-size: 40rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.preflight-copy {
  margin-top: 14rpx;
  color: var(--tt-text-secondary);
  font-size: 24rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.device-status {
  margin-top: 26rpx;
  padding: 10rpx 20rpx;
  border-radius: 14rpx;
  background: var(--tt-surface-alt);
  border: 1rpx solid var(--tt-border);
}

.device-status-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 13rpx 0;
  border-bottom: 1rpx solid var(--tt-accent-soft);
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  border-bottom-color: var(--tt-border);
}

.device-status-row:last-child {
  border-bottom: 0;
}

.device-status-row text:last-child {
  text-align: right;
  min-width: 0;
  color: var(--tt-text);
  overflow-wrap: anywhere;
}

.preflight-check {
  width: 100%;
  margin-top: 16rpx;
  padding: 19rpx;
  border: 2rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.55;
  text-align: left;
  min-height: 88rpx;
  border-color: var(--tt-border);
  overflow-wrap: anywhere;
}

.preflight-check.checked {
  border-color: var(--tt-accent);
  background: var(--tt-accent-soft);
  color: var(--tt-accent-pressed);
  font-weight: 600;
}

.trtc-boundary {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--tt-info-soft);
  color: var(--tt-info);
  font-size: 22rpx;
  line-height: 1.65;
  border: 1rpx solid var(--tt-border);
  overflow-wrap: anywhere;
}

.disclosure-link {
  margin-top: 8rpx;
  padding: 0;
  background: transparent;
  color: var(--tt-accent);
  font-size: 22rpx;
  line-height: 60rpx;
  text-decoration: underline;
  min-height: 72rpx;
}

.enter-button {
  width: 100%;
  margin-top: 24rpx;
}

.preflight-back {
  width: 100%;
  margin-top: 12rpx;
}

.voice-card {
  min-height: 760rpx;
  box-sizing: border-box;
  padding: 48rpx 32rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  text-align: center;
  box-shadow: none;
}

.eyebrow {
  color: var(--tt-accent);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.participant-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  margin: 50rpx auto 22rpx;
  border-radius: 50%;
  background: var(--tt-accent-soft);
  color: var(--tt-accent);
  font-size: 42rpx;
  font-weight: 700;
}

.participant-name {
  color: var(--tt-text);
  font-size: 40rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.participant-role {
  margin-top: 14rpx;
  color: var(--tt-text-secondary);
  font-size: 24rpx;
}

.state {
  margin-top: 58rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: var(--tt-info-soft);
  color: var(--tt-info);
  font-size: 27rpx;
  line-height: 1.6;
  border: 1rpx solid var(--tt-border);
  overflow-wrap: anywhere;
}

.state-connected {
  background: var(--tt-success-soft);
  color: var(--tt-success);
  border-color: var(--tt-border);
}

.state-error {
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  border-color: var(--tt-border);
}

.state-ended {
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  border-color: var(--tt-border);
}

.service-end {
  margin-top: 20rpx;
  color: var(--tt-text-secondary);
  font-size: 24rpx;
}

.remaining-time, .network-status {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--tt-bg);
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  border: 1rpx solid var(--tt-border);
}

.remaining-time text:last-child {
  color: var(--tt-accent);
  font-size: 28rpx;
  font-weight: 800;
}

.network-good {
  color: var(--tt-success) !important;
}

.network-warning {
  color: var(--tt-warning) !important;
}

.network-error {
  color: var(--tt-danger) !important;
}

.boundary {
  margin-top: 48rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid var(--tt-danger-soft);
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.7;
  text-align: left;
  border-top-color: var(--tt-border);
  overflow-wrap: anywhere;
}

.voice-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 58rpx;
}

.primary, .secondary, .danger {
  flex: 1;
  margin-top: 58rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
  line-height: 1.4;
  min-height: 88rpx;
}

.voice-actions .secondary, .voice-actions .danger {
  margin-top: 0;
}

.safety-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.safety-report, .support-link {
  flex: 1;
  margin: 0;
  border-radius: 14rpx;
  font-size: 23rpx;
  line-height: 1.4;
  min-height: 80rpx;
}

.safety-report {
  background: var(--tt-danger);
  color: var(--tt-on-accent);
  border-color: var(--tt-danger);
}

.support-link {
  border: 1rpx solid var(--tt-border-strong);
  background: var(--tt-surface);
  color: var(--tt-accent);
  border-color: var(--tt-border-strong);
}

.primary {
  background: var(--tt-accent);
  color: var(--tt-on-accent);
  border-color: var(--tt-accent);
}

.secondary {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
  color: var(--tt-accent);
  border-color: var(--tt-border-strong);
}

.danger {
  background: var(--tt-danger);
  color: var(--tt-on-accent);
  border-color: var(--tt-danger);
}

.primary::after, .secondary::after, .danger::after, .preflight-check::after, .safety-report::after, .support-link::after, .disclosure-link::after {
  border: 0;
}

.preflight-card, .voice-card {
  border: 1rpx solid var(--tt-border);
  border-radius: 28rpx;
  background: var(--tt-surface);
  box-shadow: none;
}

.enter-button, .preflight-back {
  min-height: 88rpx;
}

.participant-role, .service-end {
  color: var(--tt-text-secondary);
  overflow-wrap: anywhere;
}
