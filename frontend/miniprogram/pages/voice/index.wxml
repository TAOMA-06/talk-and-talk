<view class="voice-page {{motionOff ? 'tt-motion-off' : ''}}">
  <view wx:if="{{!voiceFeatureAvailable}}" class="voice-unavailable-card">
    <view class="eyebrow">能力关闭</view>
    <view class="voice-unavailable-title">实时语音未开放</view>
    <view class="voice-unavailable-copy">{{statusText}}</view>
    <view class="voice-unavailable-boundary">不加载 RTC、不请求麦克风、不连接语音网络。订单与账号权利不受影响。</view>
    <button class="secondary voice-unavailable-back" bindtap="leaveVoice">返回订单</button>
  </view>
  <block wx:else>
  <!-- Native RTC components must remain mounted for audio transport. They are
       visually hidden because this service is deliberately audio-only. -->
  <live-pusher
    id="voice-pusher"
    class="voice-native-node"
    url="{{pusher.url}}"
    mode="{{pusher.mode}}"
    autopush="{{pusher.autopush}}"
    enable-camera="{{pusher.enableCamera}}"
    enable-mic="{{pusher.enableMic}}"
    bindstatechange="pusherStateChange"
    bindnetstatus="pusherNetStatus"
    binderror="pusherError"
    bindaudiovolumenotify="pusherAudioVolumeNotify"
  ></live-pusher>
  <live-player
    wx:for="{{playerList}}"
    wx:key="id"
    class="voice-native-node"
    id="{{item.id}}"
    src="{{item.src}}"
    mode="RTC"
    autoplay="{{true}}"
    mute-video="{{true}}"
    mute-audio="{{item.muteAudio}}"
    data-userid="{{item.userID}}"
    data-streamid="{{item.streamID}}"
    data-streamtype="{{item.streamType}}"
    bindstatechange="playerStateChange"
    bindfullscreenchange="playerFullscreenChange"
    bindnetstatus="playerNetStatus"
    binderror="playerError"
    bindaudiovolumenotify="playerAudioVolumeNotify"
  ></live-player>

  <view wx:if="{{preflightVisible}}" class="preflight-card">
    <view class="eyebrow">通话前检查</view>
    <view class="preflight-title">通话前确认</view>
    <view class="preflight-copy">完成确认后才会初始化 TRTC 并请求麦克风。</view>
    <view class="device-status">
      <view class="device-status-row"><text>网络</text><text class="network-{{networkTone}}">{{networkTypeText}}</text></view>
      <view class="device-status-row"><text>麦克风</text><text>{{microphoneStatusText}}</text></view>
    </view>
    <button class="preflight-check {{environmentConfirmed ? 'checked' : ''}}" bindtap="toggleEnvironmentConfirmation">{{environmentConfirmed ? '已确认 · ' : '待确认 · '}}环境适合通话并注意周围隐私</button>
    <button class="preflight-check {{boundaryConfirmed ? 'checked' : ''}}" bindtap="toggleBoundaryConfirmation">{{boundaryConfirmed ? '已确认 · ' : '待确认 · '}}仅限本单，不录音、不私下转账，不提供医疗或紧急救助</button>
    <button class="preflight-check {{trtcDisclosureConfirmed ? 'checked' : ''}}" bindtap="toggleTrtcDisclosureConfirmation">{{trtcDisclosureConfirmed ? '已确认 · ' : '待确认 · '}}深圳市腾讯计算机系统有限公司提供的 TRTC 将处理麦克风音频、IP、网络及设备系统基础信息，用于实时音频传输和连接保障</button>
    <view class="trtc-boundary">纯音频，不启用摄像头、云端录制或 AI 转写。</view>
    <button class="disclosure-link" bindtap="openPrivacyPolicy">查看隐私政策</button>
    <button class="primary enter-button" disabled="{{!environmentConfirmed || !boundaryConfirmed || !trtcDisclosureConfirmed || preflightChecking}}" loading="{{preflightChecking}}" bindtap="confirmPreflight">检查权限并进入</button>
    <button class="secondary preflight-back" bindtap="leaveVoice">暂不进入</button>
  </view>

  <view wx:else class="voice-card">
    <view class="eyebrow">订单内实时语音</view>
    <view class="participant-avatar">{{participantInitials}}</view>
    <view class="participant-name">{{participantName}}</view>
    <view class="participant-role">{{participantRole === 'companion' ? '你正在作为陪伴者服务' : '你正在接受本次陪伴服务'}}</view>
    <view class="state state-{{roomState}}">{{statusText}}</view>
    <view wx:if="{{serviceEndsAtText}}" class="service-end">本次服务预计于 {{serviceEndsAtText}} 结束</view>
    <view wx:if="{{serviceRemainingText}}" class="remaining-time"><text>剩余服务时间</text><text>{{serviceRemainingText}}</text></view>
    <view class="network-status network-{{networkTone}}"><text>网络状态</text><text>{{networkQualityText}}</text></view>
    <view class="boundary">仅限本单服务时间；平台不录音。安全或争议事实请退出后以文字提交。</view>

    <view wx:if="{{roomState === 'connected'}}" class="voice-actions">
      <button class="secondary" bindtap="toggleMute">{{muted ? '打开麦克风' : '静音麦克风'}}</button>
      <button class="danger" bindtap="leaveVoice">结束并退出</button>
    </view>
    <view wx:if="{{roomState === 'connected' || roomState === 'error'}}" class="safety-actions">
      <button class="safety-report" bindtap="leaveAndReport">安全退出并举报</button>
      <button class="support-link" bindtap="leaveAndOpenSupport">连接或履约帮助</button>
    </view>
    <button wx:elif="{{canRetry}}" class="primary" bindtap="retry">重新连接</button>
    <button wx:elif="{{roomState === 'ended'}}" class="secondary" bindtap="leaveVoice">返回订单</button>
  </view>
  </block>
</view>
