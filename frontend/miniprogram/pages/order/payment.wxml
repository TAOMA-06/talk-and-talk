<view class="page payment-page {{motionOff ? 'tt-motion-off' : ''}}">
  <view class="payment-state state-{{paymentState}} tt-state-transition" aria-live="polite" aria-busy="{{paymentState === 'loading' || paymentState === 'processing' || paymentState === 'pending'}}">
    <view class="state-symbol">{{paymentState === 'success' ? '已确认' : paymentState === 'error' ? '异常' : paymentState === 'cancelled' ? '已取消' : paymentState === 'ready' ? '待确认' : paymentState === 'unavailable' ? '已暂停' : paymentState === 'loading' ? '核对中' : paymentState === 'pending' ? '待同步' : '正在支付'}}</view>
    <view class="state-title">{{stateTitle}}</view>
    <view class="state-message">{{stateMessage}}</view>
  </view>

  <view wx:if="{{view}}" class="card authority-flat order-summary">
    <view class="summary-title">{{view.serviceName}}</view>
    <view class="summary-row"><text>服务对象</text><text>{{view.companionName}}</text></view>
    <view class="summary-row"><text>预约时间</text><text>{{view.scheduleText}}（北京时间）</text></view>
    <view class="summary-row"><text>服务时长</text><text>{{view.durationText}}</text></view>
    <view class="summary-row total"><text>支付金额</text><text>{{view.amountText}}</text></view>
  </view>

  <view wx:if="{{paymentState === 'ready'}}" class="card authority-flat rules-card tt-state-transition">
    <view class="rules-title">付款确认</view>
    <view class="rule">微信支付 · 不接受私下转账</view>
    <view class="rule">未开始可原路退款；服务中或完成后转人工审核</view>
    <view class="rule policy-rule">完成后 {{view.refundRequestWindowHours}} 小时内可自助申请；逾期可联系平台客服</view>
    <view class="policy-version">规则 {{view.refundPolicyVersion}} · 本单已固定</view>
    <button class="policy-link" bindtap="openRefundTerms">用户协议与完整退款条款</button>
    <view class="rule">结果以服务端同步为准，请勿重复付款</view>
    <button class="terms-check {{termsConfirmed ? 'checked' : ''}}" bindtap="toggleTerms">{{termsConfirmed ? '已确认 · ' : '待确认 · '}}金额、服务、退款窗口与规则版本</button>
    <button class="primary-button pay-button" disabled="{{!termsConfirmed}}" bindtap="pay">调起微信支付</button>
  </view>

  <button wx:if="{{paymentState === 'pending' || paymentState === 'cancelled' || paymentState === 'error'}}" class="primary-button full-button" bindtap="queryResult">查询支付结果</button>
  <button wx:if="{{paymentState === 'success' || paymentState === 'unavailable'}}" class="primary-button full-button" bindtap="openOrderDetail">返回订单详情</button>
  <button wx:if="{{paymentState !== 'loading' && paymentState !== 'processing'}}" class="support-button full-button" bindtap="openPaymentSupport">支付帮助</button>

  <view class="authority-note">最终支付状态以服务端查询结果为准。</view>
</view>
