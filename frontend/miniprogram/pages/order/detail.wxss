.order-detail-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.status-hero {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--tt-accent-soft);
  border: 1rpx solid var(--tt-accent-soft);
  border-left: 8rpx solid var(--tt-accent);
}

.status-paid, .status-inService, .status-completed {
  background: var(--tt-success-soft);
  border-color: var(--tt-border);
  border-left-color: var(--tt-success);
}

.status-cancelled, .status-refunded {
  background: var(--tt-surface-alt);
  border-color: var(--tt-border);
  border-left-color: var(--tt-text-secondary);
}

.status-kicker {
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  word-break: break-all;
  line-height: 1.55;
}

.status-title {
  margin-top: 10rpx;
  color: var(--tt-text);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.status-copy {
  margin-top: 14rpx;
  color: var(--tt-text);
  font-size: 25rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.section-title {
  margin-bottom: 16rpx;
  color: var(--tt-text);
  font-size: 30rpx;
  font-weight: 700;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--tt-danger-soft);
  color: var(--tt-text);
  font-size: 25rpx;
  line-height: 1.55;
  border-bottom-color: var(--tt-border);
}

.detail-row text:first-child {
  flex: 0 0 120rpx;
  color: var(--tt-text-secondary);
}

.detail-row text:last-child {
  flex: 1;
  text-align: right;
  min-width: 0;
  color: var(--tt-text);
  overflow-wrap: anywhere;
}

.detail-row.total text:last-child {
  color: var(--tt-accent);
  font-size: 31rpx;
  font-weight: 700;
}

.snapshot-note {
  margin-top: 18rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.refund-policy-card {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
  border-color: var(--tt-border);
  border-left: 6rpx solid var(--tt-accent);
}

.refund-policy-copy {
  margin-top: 17rpx;
  color: var(--tt-text);
  font-size: 23rpx;
  line-height: 1.72;
}

.refund-policy-error {
  padding: 16rpx;
  border-left: 5rpx solid var(--tt-danger);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 23rpx;
  line-height: 1.65;
}

.refund-policy-link {
  width: 100%;
  margin-top: 16rpx;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 24rpx;
}

.refund-card {
  border-left: 7rpx solid var(--tt-warning);
  border-left-color: var(--tt-warning);
  background: var(--tt-warning-soft);
}

.refund-copy {
  margin-top: 16rpx;
  color: var(--tt-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.payment-dispute-card {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
  border-color: var(--tt-border);
  border-left: 6rpx solid var(--tt-info);
}

.payment-dispute-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.payment-dispute-kicker {
  color: var(--tt-text-secondary);
  font-size: 21rpx;
  line-height: 1.5;
}

.payment-dispute-badge {
  flex: 0 0 auto;
  max-width: 220rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text);
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  border: 1rpx solid var(--tt-border);
  overflow-wrap: anywhere;
}

.payment-dispute-waiting {
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  border-color: var(--tt-border);
}

.payment-dispute-active {
  background: var(--tt-info-soft);
  color: var(--tt-info);
  border-color: var(--tt-border);
}

.payment-dispute-resolved {
  background: var(--tt-success-soft);
  color: var(--tt-success);
  border-color: var(--tt-border);
}

.payment-dispute-attention {
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  border-color: var(--tt-border);
}

.payment-dispute-copy, .payment-dispute-summary {
  margin-top: 20rpx;
  color: var(--tt-text);
  font-size: 23rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.payment-dispute-error {
  color: var(--tt-danger);
}

.timeline-resource-state {
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.65;
}

.timeline-resource-error {
  padding: 16rpx;
  border-left: 5rpx solid var(--tt-danger);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.resource-retry {
  width: 100%;
  margin: 14rpx 0 0;
  padding: 10rpx 14rpx;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 24rpx;
  line-height: 1.5;
}

.payment-dispute-boundary {
  margin-top: 18rpx;
  padding: 15rpx 17rpx;
  border-radius: 13rpx;
  background: var(--tt-info-soft);
  color: var(--tt-info);
  font-size: 21rpx;
  line-height: 1.65;
  border: 1rpx solid var(--tt-border);
}

.payment-dispute-guide {
  width: 100%;
  margin-top: 16rpx;
  border: 1rpx solid var(--tt-success-soft);
  background: var(--tt-surface);
  color: var(--tt-info);
  font-size: 24rpx;
  min-height: 88rpx;
  border-color: var(--tt-info-soft);
}

.attendance-dispute-card {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
  border-color: var(--tt-border);
  border-left: 6rpx solid var(--tt-warning);
}

.attendance-dispute-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.attendance-dispute-copy {
  color: var(--tt-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.attendance-dispute-badge {
  flex: 0 0 auto;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  font-size: 20rpx;
  font-weight: 700;
  border: 1rpx solid var(--tt-border);
}

.action-card {
  background: var(--tt-surface);
  border-color: var(--tt-border);
}

.replacement-notice {
  margin: 4rpx 0 18rpx;
  padding: 18rpx;
  border-left: 6rpx solid var(--tt-info);
  background: var(--tt-info-soft);
  border: 1rpx solid var(--tt-border);
  border-radius: 14rpx;
}

.replacement-title {
  color: var(--tt-text);
  font-size: 26rpx;
  font-weight: 700;
}

.replacement-copy {
  margin-top: 8rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.replacement-action {
  width: 100%;
  margin: 14rpx 0 0;
  border: 1rpx solid var(--tt-warning);
  background: var(--tt-surface);
  color: var(--tt-info);
  font-size: 24rpx;
  min-height: 88rpx;
  border-color: var(--tt-info-soft);
}

.replacement-action::after {
  border: 0;
}

.action-button {
  width: 100%;
  margin-top: 16rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  min-height: 88rpx;
}

.service-action-notice {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.6;
  border: 1rpx solid var(--tt-border);
  overflow-wrap: anywhere;
}

.secondary-button {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
  color: var(--tt-accent);
  border-color: var(--tt-border-strong);
}

.danger-button {
  border: 1rpx solid var(--tt-border-strong);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  border-color: var(--tt-border);
}

.safety-button {
  background: var(--tt-danger);
  color: var(--tt-on-accent);
  border-color: var(--tt-danger);
}

.timeline-item {
  display: flex;
  gap: 18rpx;
  padding: 14rpx 0;
}

.timeline-dot {
  width: 14rpx;
  height: 14rpx;
  flex: 0 0 14rpx;
  margin-top: 11rpx;
  border: 5rpx solid var(--tt-accent-soft);
  border-radius: 50%;
  background: var(--tt-accent);
  border-color: var(--tt-accent-soft);
}

.timeline-copy {
  min-width: 0;
  flex: 1;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--tt-danger-soft);
  border-bottom-color: var(--tt-border);
}

.timeline-heading {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  color: var(--tt-text);
  font-size: 25rpx;
  font-weight: 700;
}

.timeline-heading text:last-child {
  flex: 0 0 auto;
  color: var(--tt-text-tertiary);
  font-size: 20rpx;
  font-weight: 400;
}

.timeline-description {
  margin-top: 8rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.order-meta {
  color: var(--tt-text-tertiary);
  font-size: 21rpx;
  text-align: center;
}

.retry-button {
  margin-top: 24rpx;
  background: var(--tt-accent);
  color: var(--tt-on-accent);
  font-size: 25rpx;
  min-height: 88rpx;
  border-color: var(--tt-accent);
}

.secondary-button::after, .danger-button::after, .safety-button::after, .retry-button::after, .payment-dispute-guide::after, .resource-retry::after, .refund-policy-link::after {
  border: 0;
}

.status-pending {
  border-color: var(--tt-border);
  border-left-color: var(--tt-warning);
  background: var(--tt-warning-soft);
}

.refund-policy-copy, .refund-copy {
  color: var(--tt-text);
  overflow-wrap: anywhere;
}

.refund-policy-error, .payment-dispute-error, .timeline-resource-error {
  border-left-color: var(--tt-danger);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.refund-policy-link, .resource-retry {
  min-height: 88rpx;
  border-color: var(--tt-border-strong);
  background: var(--tt-surface);
  color: var(--tt-accent);
}

.payment-dispute-heading > view:first-child, .attendance-dispute-heading > view:first-child {
  min-width: 0;
  flex: 1;
}
