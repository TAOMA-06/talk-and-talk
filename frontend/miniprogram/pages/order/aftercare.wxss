.aftercare-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.aftercare-story-stage { position: relative; margin: 0 -8rpx 12rpx; padding: 6rpx 8rpx 0; }
.aftercare-story-stage::before { content: ""; position: absolute; top: 72rpx; right: -96rpx; width: 290rpx; height: 290rpx; border: 1rpx solid var(--tt-color-pastel-mint-stroke); border-radius: 50%; opacity: .4; pointer-events: none; }
.story-stage-label { position: relative; z-index: 5; display: flex; align-items: center; justify-content: space-between; min-height: 72rpx; padding: 0 10rpx; color: var(--tt-text-tertiary); font-size: 19rpx; font-weight: 800; letter-spacing: 2rpx; }
.story-stage-layer { width: 100%; }
.story-side-card { display: flex; min-height: 250rpx; align-items: flex-end; padding: 32rpx; border: 1rpx solid; border-radius: 30rpx; font-size: 28rpx; font-weight: 750; }
.story-private { border-color: var(--tt-color-pastel-blue-stroke); background: var(--tt-color-pastel-blue-bg); color: var(--tt-color-pastel-blue-fg); }
.story-public { border-color: var(--tt-color-pastel-apricot-stroke); background: var(--tt-color-pastel-apricot-bg); color: var(--tt-color-pastel-apricot-fg); }

.aftercare-hero {
  min-height: 250rpx;
  margin: 0;
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--tt-color-pastel-rose-bg);
  border: 1rpx solid var(--tt-color-pastel-rose-stroke);
}

.hero-kicker {
  color: var(--tt-color-pastel-rose-fg);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 10rpx;
  color: var(--tt-color-pastel-rose-fg);
  font-size: 36rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.hero-copy {
  margin-top: 13rpx;
  color: var(--tt-color-pastel-rose-fg);
  font-size: 24rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.section-title {
  color: var(--tt-text);
  font-size: 29rpx;
  font-weight: 700;
}

.section-copy {
  margin-top: 10rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.rating-row {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.rating {
  flex: 1;
  margin: 0;
  padding: 0;
  border: 2rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-text-secondary);
  font-size: 28rpx;
  line-height: 80rpx;
  min-height: 80rpx;
  border-color: var(--tt-border);
  transition: transform var(--tt-motion-press) var(--tt-ease-standard);
}

.rating.selected {
  border-color: var(--tt-accent);
  background: var(--tt-accent-soft);
  color: var(--tt-accent);
  font-weight: 700;
}

.heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.private-card {
  border-left: 7rpx solid var(--tt-info);
  border-left-color: var(--tt-info);
  border-radius: 24rpx;
}

.public-card {
  border-left: 7rpx solid var(--tt-accent);
  border-left-color: var(--tt-accent);
  border-radius: 24rpx;
}

.rating-card { border-radius: 24rpx; }

.private-badge, .public-badge {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.private-badge {
  background: var(--tt-info-soft);
  color: var(--tt-info);
}

.public-badge {
  background: var(--tt-accent-soft);
  color: var(--tt-accent);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  margin: 0;
  padding: 6rpx 18rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 999rpx;
  background: var(--tt-surface);
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  line-height: 52rpx;
  min-height: 64rpx;
  border-color: var(--tt-border);
}

.tag.selected {
  border-color: var(--tt-accent);
  background: var(--tt-accent-soft);
  color: var(--tt-accent);
  font-weight: 600;
}

.feedback-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
  background: var(--tt-bg);
  color: var(--tt-text);
  font-size: 25rpx;
  line-height: 1.6;
  border-color: var(--tt-border);
  overflow-wrap: anywhere;
}

.full-button {
  width: 100%;
  margin-top: 16rpx;
  font-size: 26rpx;
  min-height: 88rpx;
}

.secondary-button {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
  color: var(--tt-accent);
  border-color: var(--tt-border-strong);
}

.safety-button {
  background: var(--tt-danger);
  color: var(--tt-on-accent);
  border-color: var(--tt-danger);
}

.submitted-note {
  margin-top: 18rpx;
  padding: 17rpx;
  border-radius: 13rpx;
  background: var(--tt-success-soft);
  color: var(--tt-success);
  font-size: 23rpx;
  line-height: 1.6;
  border: 1rpx solid var(--tt-border);
  overflow-wrap: anywhere;
}

.resource-state {
  margin-top: 18rpx;
  padding: 17rpx;
  border-radius: 13rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.65;
  border: 1rpx solid var(--tt-border);
  overflow-wrap: anywhere;
}

.resource-error {
  border-left: 5rpx solid var(--tt-danger);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  border-color: var(--tt-border);
  border-left-color: var(--tt-danger);
}

.retry-button {
  width: 100%;
  margin-top: 18rpx;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 23rpx;
  min-height: 88rpx;
  border-color: var(--tt-border-strong);
}

.rating::after, .tag::after, .secondary-button::after, .safety-button::after, .retry-button::after {
  border: 0;
}

.aftercare-page.tt-motion-off .aftercare-story-stage,
.aftercare-page.tt-motion-off .rating,
.aftercare-page.tt-motion-off .private-card,
.aftercare-page.tt-motion-off .public-card { animation: none; transition: none; transform: none; }

@media (prefers-reduced-motion: reduce) {
  .aftercare-story-stage::before { display: none; }
  .rating { transition: none; }
}
