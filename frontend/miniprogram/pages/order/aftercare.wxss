.aftercare-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.aftercare-hero {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--tt-success-soft);
  border: 1rpx solid var(--tt-success-soft);
  border-left: 8rpx solid var(--tt-success);
}

.hero-kicker {
  color: var(--tt-success);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 10rpx;
  color: var(--tt-text);
  font-size: 36rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.hero-copy {
  margin-top: 13rpx;
  color: var(--tt-text);
  font-size: 24rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.section-title {
  color: var(--tt-text);
  font-size: 29rpx;
  font-weight: 700;
}

.section-copy {
  margin-top: 10rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.rating-row {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.rating {
  flex: 1;
  margin: 0;
  padding: 0;
  border: 2rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-text-secondary);
  font-size: 28rpx;
  line-height: 80rpx;
  min-height: 80rpx;
  border-color: var(--tt-border);
}

.rating.selected {
  border-color: var(--tt-accent);
  background: var(--tt-accent-soft);
  color: var(--tt-accent);
  font-weight: 700;
}

.heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.private-card {
  border-left: 7rpx solid var(--tt-info);
  border-left-color: var(--tt-info);
}

.public-card {
  border-left: 7rpx solid var(--tt-accent);
  border-left-color: var(--tt-accent);
}

.private-badge, .public-badge {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.private-badge {
  background: var(--tt-info-soft);
  color: var(--tt-info);
}

.public-badge {
  background: var(--tt-accent-soft);
  color: var(--tt-accent);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  margin: 0;
  padding: 6rpx 18rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 999rpx;
  background: var(--tt-surface);
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  line-height: 52rpx;
  min-height: 64rpx;
  border-color: var(--tt-border);
}

.tag.selected {
  border-color: var(--tt-accent);
  background: var(--tt-accent-soft);
  color: var(--tt-accent);
  font-weight: 600;
}

.feedback-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
  background: var(--tt-bg);
  color: var(--tt-text);
  font-size: 25rpx;
  line-height: 1.6;
  border-color: var(--tt-border);
  overflow-wrap: anywhere;
}

.full-button {
  width: 100%;
  margin-top: 16rpx;
  font-size: 26rpx;
  min-height: 88rpx;
}

.secondary-button {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
  color: var(--tt-accent);
  border-color: var(--tt-border-strong);
}

.safety-button {
  background: var(--tt-danger);
  color: var(--tt-on-accent);
  border-color: var(--tt-danger);
}

.submitted-note {
  margin-top: 18rpx;
  padding: 17rpx;
  border-radius: 13rpx;
  background: var(--tt-success-soft);
  color: var(--tt-success);
  font-size: 23rpx;
  line-height: 1.6;
  border: 1rpx solid var(--tt-border);
  overflow-wrap: anywhere;
}

.resource-state {
  margin-top: 18rpx;
  padding: 17rpx;
  border-radius: 13rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.65;
  border: 1rpx solid var(--tt-border);
  overflow-wrap: anywhere;
}

.resource-error {
  border-left: 5rpx solid var(--tt-danger);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  border-color: var(--tt-border);
  border-left-color: var(--tt-danger);
}

.retry-button {
  width: 100%;
  margin-top: 18rpx;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 23rpx;
  min-height: 88rpx;
  border-color: var(--tt-border-strong);
}

.rating::after, .tag::after, .secondary-button::after, .safety-button::after, .retry-button::after {
  border: 0;
}
