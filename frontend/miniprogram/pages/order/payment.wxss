.payment-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.payment-state {
  padding: 40rpx 30rpx;
  border-radius: 28rpx;
  background: var(--tt-accent-soft);
  text-align: left;
  border: 1rpx solid var(--tt-accent-soft);
  border-left: 8rpx solid var(--tt-accent);
  transition: opacity var(--tt-motion-press) var(--tt-ease-standard), transform var(--tt-motion-standard) var(--tt-ease-standard);
}

.authority-flat {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
  box-shadow: none;
  transform: none;
}

.authority-label,
.authority-note-label {
  display: inline-flex;
  min-height: 38rpx;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 0 12rpx;
  border: 1rpx solid var(--tt-border);
  border-radius: 999rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-tertiary);
  font-size: 19rpx;
  font-weight: 700;
}

.state-success {
  background: var(--tt-success-soft);
  border-color: var(--tt-border);
  border-left-color: var(--tt-success);
}

.state-error {
  background: var(--tt-danger-soft);
  border-color: var(--tt-border);
  border-left-color: var(--tt-danger);
}

.state-cancelled {
  background: var(--tt-surface-alt);
  border-color: var(--tt-border);
  border-left-color: var(--tt-text-tertiary);
}

.state-processing {
  background: var(--tt-warning-soft);
  border-color: var(--tt-border);
  border-left-color: var(--tt-warning);
}

.state-pending {
  background: var(--tt-color-pastel-lavender-bg);
  border-color: var(--tt-color-pastel-lavender-stroke);
  border-left-color: var(--tt-info);
}

.state-loading {
  background: var(--tt-surface-alt);
  border-color: var(--tt-border);
  border-left-color: var(--tt-info);
}

.state-ready {
  background: var(--tt-color-pastel-blue-bg);
  border-color: var(--tt-color-pastel-blue-stroke);
  border-left-color: var(--tt-info);
}

.state-symbol {
  display: flex;
  width: fit-content;
  min-width: 104rpx;
  height: 52rpx;
  margin: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 20rpx;
  font-weight: 700;
  box-shadow: none;
  border: 1rpx solid var(--tt-accent-soft);
}

.state-success .state-symbol {
  color: var(--tt-success);
  border-color: var(--tt-border);
}

.state-title {
  margin-top: 18rpx;
  color: var(--tt-text);
  font-size: 38rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.state-message {
  margin-top: 12rpx;
  color: var(--tt-text);
  font-size: 24rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.order-summary {
  margin-top: 24rpx;
  border-color: var(--tt-border);
  border-top: 5rpx solid var(--tt-color-pastel-blue-stroke);
}

.summary-title {
  margin-bottom: 14rpx;
  color: var(--tt-accent);
  font-size: 31rpx;
  font-weight: 800;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--tt-danger-soft);
  color: var(--tt-text);
  font-size: 24rpx;
  line-height: 1.55;
  border-bottom-color: var(--tt-border);
}

.summary-row text:first-child {
  flex: 0 0 120rpx;
  color: var(--tt-text-secondary);
}

.summary-row text:last-child {
  flex: 1;
  text-align: right;
  min-width: 0;
  color: var(--tt-text);
  overflow-wrap: anywhere;
}

.summary-row.total text:last-child {
  color: var(--tt-accent);
  font-size: 32rpx;
  font-weight: 700;
}

.rules-title {
  color: var(--tt-accent);
  font-size: 29rpx;
  font-weight: 800;
}

.rule {
  margin-top: 13rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.policy-rule {
  color: var(--tt-text);
  font-weight: 600;
}

.policy-version {
  margin-top: 16rpx;
  padding: 15rpx 17rpx;
  border-radius: 12rpx;
  background: var(--tt-info-soft);
  color: var(--tt-info);
  font-size: 21rpx;
  line-height: 1.65;
  border: 1rpx solid var(--tt-border);
  overflow-wrap: anywhere;
}

.policy-link {
  width: 100%;
  margin-top: 14rpx;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 23rpx;
  min-height: 88rpx;
  border-color: var(--tt-border-strong);
}

.terms-check {
  width: 100%;
  margin-top: 22rpx;
  padding: 18rpx;
  border: 2rpx solid var(--tt-danger-soft);
  background: var(--tt-surface);
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  text-align: left;
  min-height: 88rpx;
  border-color: var(--tt-border);
  line-height: 1.55;
}

.terms-check.checked {
  border-color: var(--tt-accent);
  background: var(--tt-accent-soft);
  color: var(--tt-accent-pressed);
  font-weight: 600;
}

.pay-button, .full-button {
  width: 100%;
  margin-top: 18rpx;
  font-size: 27rpx;
  min-height: 88rpx;
}

.support-button {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
  color: var(--tt-accent);
  border-color: var(--tt-border-strong);
}

.authority-note {
  margin-top: 28rpx;
  padding: 16rpx 18rpx;
  color: var(--tt-info);
  font-size: 21rpx;
  line-height: 1.65;
  text-align: left;
  border: 1rpx solid var(--tt-info-soft);
  border-radius: 14rpx;
  background: var(--tt-info-soft);
  overflow-wrap: anywhere;
}

.authority-note-label {
  margin: 0 12rpx 0 0;
  border-color: var(--tt-color-status-info-stroke);
  background: var(--tt-surface);
  color: var(--tt-info);
  vertical-align: middle;
}

.terms-check::after, .support-button::after, .policy-link::after {
  border: 0;
}

.state-unavailable {
  border-color: var(--tt-border);
  border-left-color: var(--tt-info);
  background: var(--tt-info-soft);
}

.state-error .state-symbol {
  border-color: var(--tt-border);
  color: var(--tt-danger);
}

.state-cancelled .state-symbol {
  border-color: var(--tt-border);
  color: var(--tt-text-secondary);
}

.state-pending .state-symbol, .state-processing .state-symbol {
  border-color: var(--tt-border);
  color: var(--tt-warning);
}

.summary-title, .rules-title {
  color: var(--tt-text);
  font-weight: 700;
  overflow-wrap: anywhere;
}

.rules-card {
  border-color: var(--tt-border);
  border-top: 5rpx solid var(--tt-color-pastel-butter-stroke);
}

@media (prefers-reduced-motion: reduce) {
  .payment-state,
  .rules-card,
  .state-symbol,
  .terms-check { animation: none !important; transition: none !important; transform: none !important; }
}

.payment-page.tt-motion-off .payment-state,
.payment-page.tt-motion-off .rules-card,
.payment-page.tt-motion-off .state-symbol,
.payment-page.tt-motion-off .terms-check {
  animation: none !important;
  transition: none !important;
  transform: none !important;
}
