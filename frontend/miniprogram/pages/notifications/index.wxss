.notifications-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.notification-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: var(--tt-accent-soft);
  border: 1rpx solid var(--tt-accent-soft);
  border-left: 8rpx solid var(--tt-accent);
}

.hero-title {
  color: var(--tt-text);
  font-size: 36rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.hero-copy {
  margin-top: 10rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.unread-count {
  flex: 0 0 auto;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: var(--tt-accent);
  color: var(--tt-on-accent);
  font-size: 21rpx;
  border: 1rpx solid var(--tt-accent);
  font-weight: 700;
}

.toolbar {
  display: flex;
  gap: 14rpx;
  margin: 20rpx 0;
}

.toolbar-button {
  flex: 1;
  margin: 0;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 22rpx;
  line-height: 1.4;
  min-height: 88rpx;
  border-color: var(--tt-border-strong);
  border-radius: 14rpx;
}

.notification-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-left: 7rpx solid var(--tt-text-tertiary);
  border-radius: 20rpx;
  background: var(--tt-surface);
  box-shadow: none;
  border: 1rpx solid var(--tt-border);
}

.notification-card.unread {
  border-left-color: var(--tt-accent);
  background: var(--tt-accent-soft);
  border-color: var(--tt-border);
}

.notification-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.type {
  color: var(--tt-text-secondary);
  font-size: 21rpx;
  font-weight: 700;
}

.time {
  color: var(--tt-text-tertiary);
  font-size: 20rpx;
  text-align: right;
}

.notification-title {
  margin-top: 11rpx;
  color: var(--tt-text);
  font-size: 28rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.notification-body {
  margin-top: 8rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.notification-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 13rpx;
  color: var(--tt-text-tertiary);
  font-size: 20rpx;
}

.unread-marker {
  color: var(--tt-accent);
  font-weight: 700;
}

.retry-button {
  width: 100%;
  margin-top: 18rpx;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 23rpx;
}

.toolbar-button::after, .retry-button::after {
  border: 0;
}

.unread-count-unknown {
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  border-color: var(--tt-border);
}

.unread-error {
  margin: 0 0 18rpx;
  padding: 15rpx;
  border-left: 5rpx solid var(--tt-danger);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 23rpx;
  line-height: 1.6;
  border: 1rpx solid var(--tt-border);
  overflow-wrap: anywhere;
}

.unread-retry {
  width: 100%;
  margin: 12rpx 0 0;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 23rpx;
}

.unread-retry::after {
  border: 0;
}

.notification-hero > view:first-child {
  min-width: 0;
  flex: 1;
}

.toolbar-button:first-child {
  border-color: var(--tt-accent);
  background: var(--tt-accent);
  color: var(--tt-on-accent);
}

.toolbar-button[disabled] {
  border-color: var(--tt-border);
  background: var(--tt-surface-alt);
  color: var(--tt-text-tertiary);
  opacity: 1;
}

.unread .type {
  color: var(--tt-accent);
}

.open-hint {
  color: var(--tt-accent);
  font-weight: 600;
}

.pagination-note {
  color: var(--tt-text-tertiary);
  font-size: 22rpx;
  line-height: 1.55;
  text-align: center;
}

.retry-button, .unread-retry {
  min-height: 88rpx;
  border-color: var(--tt-border-strong);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
}
