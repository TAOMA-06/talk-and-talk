.notifications-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.notification-post-stage { position: relative; margin: 0 -8rpx 8rpx; padding: 6rpx 8rpx 0; }
.notification-post-stage::before { content: ""; position: absolute; top: 68rpx; right: -98rpx; width: 280rpx; height: 280rpx; border: 1rpx solid var(--tt-color-pastel-apricot-stroke); border-radius: 50%; opacity: .42; pointer-events: none; }
.notification-post-label { position: relative; z-index: 5; display: flex; align-items: center; justify-content: space-between; min-height: 72rpx; padding: 0 10rpx; color: var(--tt-text-tertiary); font-size: 19rpx; font-weight: 800; letter-spacing: 2rpx; }
.notification-stage-layer { width: 100%; }
.notification-back-card { display: flex; min-height: 250rpx; align-items: flex-end; padding: 32rpx; border: 1rpx solid; border-radius: 30rpx; font-size: 27rpx; font-weight: 750; }
.notification-back-order { border-color: var(--tt-color-pastel-blue-stroke); background: var(--tt-color-pastel-blue-bg); color: var(--tt-color-pastel-blue-fg); }
.notification-back-support { border-color: var(--tt-color-pastel-mint-stroke); background: var(--tt-color-pastel-mint-bg); color: var(--tt-color-pastel-mint-fg); }

.notification-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: var(--tt-color-pastel-apricot-bg);
  border: 1rpx solid var(--tt-color-pastel-apricot-stroke);
}

.hero-title {
  color: var(--tt-color-pastel-apricot-fg);
  font-size: 36rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.hero-copy {
  margin-top: 10rpx;
  color: var(--tt-color-pastel-apricot-fg);
  font-size: 23rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.unread-count {
  flex: 0 0 auto;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: var(--tt-accent);
  color: var(--tt-on-accent);
  font-size: 21rpx;
  border: 1rpx solid var(--tt-accent);
  font-weight: 700;
}

.toolbar {
  display: flex;
  gap: 14rpx;
  margin: 20rpx 0;
}

.toolbar-button {
  flex: 1;
  margin: 0;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 22rpx;
  line-height: 1.4;
  min-height: 88rpx;
  border-color: var(--tt-border-strong);
  border-radius: 14rpx;
}

.notification-card {
  position: relative;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-left: 7rpx solid var(--tt-text-tertiary);
  border-radius: 20rpx;
  background: var(--tt-surface);
  border: 1rpx solid var(--tt-border);
}

.notification-card::after { content: ""; position: absolute; top: 18rpx; right: 20rpx; width: 38rpx; height: 38rpx; border: 2rpx solid currentColor; border-radius: 8rpx; opacity: .12; transform: rotate(8deg); }
.notification-card-0 { transform: rotate(-.2deg); }
.notification-card-1 { transform: translateX(3rpx) rotate(.28deg); }
.notification-card-2 { transform: translateX(-2rpx) rotate(-.12deg); }

.notification-card.unread {
  border-left-color: var(--tt-color-status-info-fg);
  background: var(--tt-color-status-info-bg);
  border-color: var(--tt-color-status-info-stroke);
}

.notification-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.type {
  color: var(--tt-text-secondary);
  font-size: 21rpx;
  font-weight: 700;
}

.time {
  color: var(--tt-text-tertiary);
  font-size: 20rpx;
  text-align: right;
}

.notification-title {
  margin-top: 11rpx;
  color: var(--tt-text);
  font-size: 28rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.notification-body {
  margin-top: 8rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.notification-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 13rpx;
  color: var(--tt-text-tertiary);
  font-size: 20rpx;
}

.unread-marker {
  color: var(--tt-accent);
  font-weight: 700;
}

.retry-button {
  width: 100%;
  margin-top: 18rpx;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 23rpx;
}

.toolbar-button::after, .retry-button::after {
  border: 0;
}

.unread-count-unknown {
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  border-color: var(--tt-border);
}

.unread-error {
  margin: 0 0 18rpx;
  padding: 15rpx;
  border-left: 5rpx solid var(--tt-danger);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 23rpx;
  line-height: 1.6;
  border: 1rpx solid var(--tt-border);
  overflow-wrap: anywhere;
}

.unread-retry {
  width: 100%;
  margin: 12rpx 0 0;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 23rpx;
}

.unread-retry::after {
  border: 0;
}

.notification-hero > view:first-child {
  min-width: 0;
  flex: 1;
}

.toolbar-button:first-child {
  border-color: var(--tt-accent);
  background: var(--tt-accent);
  color: var(--tt-on-accent);
}

.toolbar-button[disabled] {
  border-color: var(--tt-border);
  background: var(--tt-surface-alt);
  color: var(--tt-text-tertiary);
  opacity: 1;
}

.unread .type {
  color: var(--tt-color-status-info-fg);
}

.open-hint {
  color: var(--tt-text);
  font-weight: 600;
}

.pagination-note {
  color: var(--tt-text-tertiary);
  font-size: 22rpx;
  line-height: 1.55;
  text-align: center;
}

.retry-button, .unread-retry {
  min-height: 88rpx;
  border-color: var(--tt-border-strong);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
}

.notifications-page.tt-motion-off .notification-post-label,
.notifications-page.tt-motion-off .toolbar-button,
.notifications-page.tt-motion-off .notification-card { animation: none; transition: none; transform: none; }

@media (prefers-reduced-motion: reduce) {
  .notification-post-stage::before { display: none; }
  .notification-card-0,.notification-card-1,.notification-card-2 { transform: none; }
}
