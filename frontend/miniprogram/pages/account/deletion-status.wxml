<view class="page unavailable-page">
  <view class="status-mark">!</view>
  <view class="title">登录暂不可用</view>
  <view class="message">{{message}}</view>

  <view class="privacy-card">
    <view class="privacy-title">隐私保护说明</view>
    <view class="privacy-copy">为保护账号隐私，本页不会显示该标识关联的历史账号状态、处理日期或其他资料，也不会在后台继续请求需要登录的接口。</view>
  </view>

  <button class="primary-button" open-type="contact">联系微信客服</button>
  <button class="secondary-button" bindtap="retryLogin">重新尝试登录</button>
</view>
