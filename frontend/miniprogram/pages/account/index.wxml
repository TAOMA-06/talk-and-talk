<view class="page account-page {{motionOff ? 'tt-motion-off' : ''}}">
  <tt-skeleton wx:if="{{loading}}" rows="3" motion-off="{{motionOff}}" />
  <tt-state wx:elif="{{error && !limitedAccountMode}}" type="error" title="账户信息暂时无法读取" description="{{error}}" action-text="重新读取" motion-off="{{motionOff}}" bindaction="load" />
  <view wx:else>
    <block wx:if="{{user && !limitedAccountMode}}">
    <view class="account-hero tt-enter-soft">
      <tt-avatar fallback="{{avatarText}}" alt="当前账号头像" size="lg" />
      <view class="identity">
        <view class="identity-name">{{displayName}}</view>
        <view class="identity-meta">{{maskedPhone}} · {{verificationText}}</view>
      </view>
      <button class="edit-button" bindtap="openProfile">编辑资料</button>
    </view>

    <view class="quick-grid tt-card account-index-card">
      <tt-list-cell title="通知" bindtap="openNotificationCenter" />
      <tt-list-cell title="案件" bindtap="openSupportCenter" />
      <tt-list-cell title="成年资格" meta="查看" bindtap="openAdultEligibility" />
    </view>
    <view wx:if="{{partialWarning}}" class="partial-warning">{{partialWarning}}</view>
    </block>

    <view wx:if="{{limitedAccountMode}}" class="account-hero locked-hero tt-enter-soft">
      <view class="avatar locked-avatar">!</view>
      <view class="identity">
        <view class="identity-name">{{legalRecoveryMode ? '账号权利与申诉中心' : '受限账号自助中心'}}</view>
        <view class="identity-meta">{{limitedAccountMessage}}</view>
      </view>
      <button class="edit-button" bindtap="signOut">退出</button>
    </view>

    <view wx:if="{{legalRecoveryMode}}" class="card account-folder folder-recovery legal-recovery-card">
      <view class="section-title">受限恢复通道</view>
      <view class="section-copy">不记录新的协议同意；仅可处理申诉、数据权利和注销。</view>
    </view>

    <view class="card account-folder folder-appeals account-action-card">
      <view wx:if="{{focusAccountActionId || focusAccountAppealId}}" class="partial-warning">
        正在显示这条通知对应的正式记录。
        <button class="text-button" bindtap="clearAccountActionFocus">查看全部处置</button>
      </view>
      <view class="section-heading">
        <view><view class="section-title">账号处置与申诉</view></view>
        <view class="capability {{accountActionsState === 'error' ? 'unavailable' : 'available'}}">{{accountActionsState === 'error' ? '读取失败' : '正式记录'}}</view>
      </view>
      <view wx:if="{{accountActionsState === 'loading'}}" class="empty compact">正在读取…</view>
      <view wx:elif="{{accountActionsState === 'error'}}" class="state-panel error-panel">
        <view>{{accountActionsError}}</view>
        <button class="retry-button" bindtap="loadAccountActions">重新读取</button>
      </view>
      <view wx:elif="{{accountActionsState === 'empty'}}" class="empty compact">暂无账号处置</view>
      <view wx:else class="request-list">
        <view class="request-item" wx:for="{{accountActions}}" wx:key="id">
          <view class="request-top"><view class="request-title">{{item.kindText}}</view><view class="status">{{item.stateText}}</view></view>
          <view class="action-message">{{item.message}}</view>
          <view class="request-copy">理由代码：{{item.reasonCode}} · 规则版本：{{item.policyVersion}}</view>
          <view class="request-meta">生效：{{item.startsText}}<text wx:if="{{item.endsAt}}"> · 预计结束：{{item.endsText}}</text></view>
          <view class="appeal-deadline">申诉截止：{{item.appealDeadlineText}}</view>
          <view wx:if="{{item.appeal}}" class="appeal-result">
            <view class="request-copy">申诉状态：{{item.stateText}}</view>
            <view class="request-copy">我的说明：{{item.appeal.statement}}</view>
            <view wx:if="{{!accountAppealTextOnly && item.appeal.evidenceAttachments.length}}" class="appeal-evidence-list">
              <button
                wx:for="{{item.appeal.evidenceAttachments}}"
                wx:key="id"
                wx:for-item="attachment"
                class="text-button appeal-evidence-button"
                data-action-id="{{item.id}}"
                data-id="{{attachment.id}}"
                bindtap="openAccountAppealEvidence"
              >查看{{attachment.kind === 'image' ? '图片' : '音频'}}证据</button>
            </view>
            <view wx:if="{{item.appeal.resolution}}" class="status-reason">复核结论：{{item.appeal.resolution}}</view>
            <view class="request-meta">复核目标时间：{{item.appealReviewDueText}}<text wx:if="{{item.appeal.overdue}}" class="overdue-text"> · 已超期</text><text wx:if="{{item.appeal.resolvedAt}}"> · 完成：{{item.appealResolvedText}}</text></view>
          </view>
          <button wx:if="{{item.canAppeal && !item.appeal && !item.revokedAt && accountAppealActionId !== item.id}}" class="follow-up-button" data-id="{{item.id}}" bindtap="openAccountAppeal">提交正式申诉</button>
          <view wx:if="{{accountAppealActionId === item.id}}" class="inline-form follow-up-form {{index < 3 ? 'tt-state-transition' : ''}}">
            <view class="form-title">提交申诉</view>
            <textarea class="form-textarea" value="{{accountAppealStatement}}" maxlength="1000" placeholder="填写可核验事实（10–1000 字），勿写密码或验证码" bindinput="setAccountAppealStatement"></textarea>
            <view wx:if="{{accountAppealTextOnly}}" class="form-note">当前仅接收文字。</view>
            <block wx:else>
              <view class="evidence-toolbar">
                <button class="text-button" disabled="{{accountAppealEvidenceUploading || accountAppealEvidenceDrafts.length >= 3}}" bindtap="addAccountAppealEvidenceImage">添加图片</button>
                <button class="text-button" disabled="{{accountAppealEvidenceUploading || accountAppealEvidenceDrafts.length >= 3}}" bindtap="addAccountAppealEvidenceAudio">添加音频</button>
                <button wx:if="{{accountAppealEvidenceDrafts.length}}" class="text-button" disabled="{{accountAppealEvidenceUploading}}" bindtap="refreshAccountAppealEvidence">刷新审核</button>
              </view>
              <view wx:for="{{accountAppealEvidenceDrafts}}" wx:key="assetId" class="evidence-draft">
                <text>{{item.kind === 'image' ? '图片' : '音频'}} · {{item.statusText}}</text>
                <button class="text-button" data-id="{{item.assetId}}" bindtap="removeAccountAppealEvidence">移除</button>
              </view>
            </block>
            <view class="form-note">提交后进入复核；原处置仍有效。</view>
            <button class="primary-button full-button" loading="{{accountAppealSubmitting}}" disabled="{{accountAppealSubmitting}}" bindtap="submitAccountAppeal">提交申诉</button>
            <button class="text-button" disabled="{{accountAppealSubmitting}}" bindtap="closeAccountAppeal">取消</button>
          </view>
        </view>
      </view>
      <view wx:if="{{accountActionsTotalPages > 1}}" class="request-meta">
        <button class="text-button" disabled="{{accountActionsPage <= 1}}" bindtap="previousAccountActionsPage">上一页</button>
        <text>共 {{accountActionsTotal}} 条 · 第 {{accountActionsPage}} / {{accountActionsTotalPages}} 页</text>
        <button class="text-button" disabled="{{accountActionsPage >= accountActionsTotalPages}}" bindtap="nextAccountActionsPage">下一页</button>
      </view>
    </view>

    <view wx:if="{{!limitedAccountMode}}" class="card account-folder folder-security session-card">
      <view class="section-heading">
        <view><view class="section-title">登录设备</view></view>
        <view class="capability {{sessionState === 'error' ? 'unavailable' : 'available'}}">{{sessionState === 'error' ? '读取失败' : '已接入'}}</view>
      </view>
      <view wx:if="{{sessionState === 'loading'}}" class="empty compact">正在读取…</view>
      <view wx:elif="{{sessionState === 'error'}}" class="state-panel error-panel">
        <view>{{sessionError}}</view>
        <button class="retry-button" bindtap="loadSessions">重新读取</button>
      </view>
      <view wx:elif="{{sessionState === 'empty'}}" class="empty compact">未返回会话，其他设备状态未知。</view>
      <view wx:else class="session-list">
        <view class="session-item" wx:for="{{sessions}}" wx:key="id">
          <view class="session-top">
            <view>
              <view class="session-title">{{item.sessionLabel || '登录会话'}}</view>
              <view class="session-platform">{{item.clientPlatform || '未知平台'}}</view>
            </view>
            <view wx:if="{{item.current}}" class="current-badge">当前设备</view>
            <button wx:else class="small-danger" data-id="{{item.id}}" loading="{{revokingSessionId === item.id}}" disabled="{{!!revokingSessionId}}" bindtap="revokeSession">下线</button>
          </view>
          <view class="session-copy">最近使用：{{item.lastUsedText}}</view>
          <view class="session-copy">创建：{{item.createdText}} · 到期：{{item.expiresText}}</view>
        </view>
        <button wx:if="{{sessionHasMore}}" class="secondary-button full-button" loading="{{sessionLoadingMore}}" disabled="{{sessionLoadingMore}}" bindtap="loadMoreSessions">加载更多</button>
      </view>
      <button wx:if="{{otherSessionCount > 0}}" class="secondary-button full-button" loading="{{revokingOtherSessions}}" disabled="{{revokingOtherSessions || !!revokingSessionId}}" bindtap="revokeOtherSessions">下线其他所有设备（{{otherSessionCount}}）</button>
      <button class="secondary-button full-button" bindtap="signOut">退出账号</button>
    </view>

    <view class="card account-folder folder-rights data-rights-card">
      <view class="section-heading">
        <view><view class="section-title">隐私与数据权利</view></view>
        <view class="capability {{dataRightsState === 'error' ? 'unavailable' : 'available'}}">{{dataRightsState === 'error' ? '读取失败' : '自助申请'}}</view>
      </view>
      <button wx:if="{{!limitedAccountMode}}" class="row-button" bindtap="openProfile"><text>更正资料</text><text>›</text></button>
      <button class="row-button" bindtap="openPrivacyRequest"><text>新建权利请求</text><text>›</text></button>
      <button class="row-button" bindtap="openPrivacy"><text>查看隐私政策</text><text>›</text></button>
      <button class="row-button" bindtap="openTerms"><text>查看用户协议</text><text>›</text></button>

      <view wx:if="{{dataRightFormOpen}}" class="inline-form tt-state-transition">
        <view class="form-title">数据权利请求</view>
        <picker mode="selector" range="{{dataRightTypeLabels}}" value="{{dataRightTypeIndex}}" bindchange="selectDataRightType">
          <view class="picker-field"><text class="picker-label">{{dataRightTypeLabels[dataRightTypeIndex]}}</text><text>⌄</text></view>
        </picker>
        <textarea class="form-textarea" value="{{dataRightDescription}}" maxlength="500" placeholder="说明数据范围（5–500 字）" bindinput="setDataRightDescription"></textarea>
        <view class="form-note">提交仅表示已收讫，不代表处理完成。</view>
        <button class="primary-button full-button" loading="{{dataRightSubmitting}}" disabled="{{dataRightSubmitting}}" bindtap="submitDataRightRequest">提交请求</button>
        <button class="text-button" bindtap="toggleDataRightForm">取消</button>
      </view>

      <view wx:if="{{dataRightsState === 'loading'}}" class="empty compact">正在读取…</view>
      <view wx:elif="{{dataRightsState === 'error'}}" class="state-panel error-panel">
        <view>{{dataRightsError}}</view>
        <button class="retry-button" bindtap="loadDataRights">重新读取</button>
      </view>
      <view wx:elif="{{dataRightsState === 'empty'}}" class="empty compact">暂无请求</view>
      <view wx:else class="request-list">
        <view class="request-item" wx:for="{{dataRights}}" wx:key="id">
          <view class="request-top"><view class="request-title">{{item.typeText}}</view><view class="status status-{{item.status}}">{{item.statusText}}</view></view>
          <view class="request-copy">{{item.description}}</view>
          <view wx:if="{{item.statusReason}}" class="status-reason">{{item.statusReason}}</view>
          <view wx:if="{{item.followUps.length}}" class="follow-up-list">
            <view class="follow-up-item" wx:for="{{item.followUps}}" wx:for-item="followUp" wx:key="id">
              <view wx:if="{{followUp.requestedInformation}}" class="follow-up-copy"><text class="follow-up-label">平台需要：</text>{{followUp.requestedInformation}}</view>
              <view wx:if="{{followUp.statement}}" class="follow-up-copy"><text class="follow-up-label">我的补充：</text>{{followUp.statement}}</view>
              <view class="request-meta">{{followUp.createdText}}</view>
            </view>
          </view>
          <view class="request-meta">更新：{{item.updatedText}}<text wx:if="{{item.resolvedAt}}"> · 完成：{{item.resolvedText}}</text></view>
          <button wx:if="{{item.status === 'needsInformation' && dataRightFollowUpRequestId !== item.id}}" class="follow-up-button" data-id="{{item.id}}" bindtap="openDataRightFollowUp">补充处理所需信息</button>
          <view wx:if="{{dataRightFollowUpRequestId === item.id}}" class="inline-form follow-up-form {{index < 3 ? 'tt-state-transition' : ''}}">
            <view class="form-title">补充这条请求</view>
            <textarea class="form-textarea" value="{{dataRightFollowUpStatement}}" maxlength="500" placeholder="补充可核验说明（5–500 字）" bindinput="setDataRightFollowUpStatement"></textarea>
            <button class="primary-button full-button" loading="{{dataRightFollowUpSubmitting}}" disabled="{{dataRightFollowUpSubmitting}}" bindtap="submitDataRightFollowUp">提交补充信息</button>
            <button class="text-button" disabled="{{dataRightFollowUpSubmitting}}" bindtap="closeDataRightFollowUp">取消</button>
          </view>
          <view wx:if="{{item.status === 'completed' && item.type === 'export'}}" class="delivery-note">
            <view wx:if="{{item.canDownload}}">数据副本已生成，可安全下载。</view>
            <view wx:else>处理已完成，但数据包尚不可下载；请联系客服。</view>
          </view>
          <button
            wx:if="{{item.canDownload}}"
            class="download-export-button"
            data-id="{{item.id}}"
            loading="{{downloadingDataRightId === item.id}}"
            disabled="{{!!downloadingDataRightId}}"
            bindtap="downloadDataRightExport"
          >下载数据副本</button>
        </view>
      </view>
      <view wx:if="{{dataRightsTotalPages > 1}}" class="request-meta">
        <button class="text-button" disabled="{{dataRightsPage <= 1}}" bindtap="previousDataRightsPage">上一页</button>
        <text>共 {{dataRightsTotal}} 条 · 第 {{dataRightsPage}} / {{dataRightsTotalPages}} 页</text>
        <button class="text-button" disabled="{{dataRightsPage >= dataRightsTotalPages}}" bindtap="nextDataRightsPage">下一页</button>
      </view>
    </view>

    <view wx:if="{{!limitedAccountMode}}" class="card account-folder folder-billing billing-card">
      <view class="section-heading">
        <view><view class="section-title">账单与发票</view></view>
        <view class="capability {{invoiceState === 'error' ? 'unavailable' : 'available'}}">{{invoiceState === 'error' ? '读取失败' : '自助申请'}}</view>
      </view>
      <block wx:if="{{bills.length}}">
        <view class="bill-item" wx:for="{{bills}}" wx:key="id" bindtap="openBill" data-id="{{item.id}}" aria-role="button" aria-label="查看账单：{{item.serviceName}}，{{item.amountText}}，{{item.statusText}}" tabindex="0">
          <view class="bill-main"><view class="bill-name">{{item.serviceName}}</view><view class="bill-amount {{item.refunded ? 'refunded' : ''}}">{{item.amountText}}</view></view>
          <view class="bill-meta"><text>{{item.statusText}}</text><text>{{item.timeText}}</text></view>
        </view>
      </block>
      <view wx:else class="empty compact">暂无订单支付记录</view>
      <view wx:if="{{bills.length}}" class="account-load-more">
        <view>{{bills.length}} / {{billTotal}}</view>
        <view wx:if="{{billsLoadMoreError}}" class="load-more-error">{{billsLoadMoreError}}</view>
        <button wx:if="{{billPage < billTotalPages}}" class="text-button" loading="{{billsLoadingMore}}" disabled="{{billsLoadingMore}}" bindtap="loadMoreBills">{{billsLoadMoreError ? '重试读取更多账单' : '读取更多账单'}}</button>
      </view>
      <button class="secondary-button full-button" bindtap="openInvoiceRequest">{{invoiceFormOpen ? '收起发票申请' : '申请发票'}}</button>
      <view class="account-load-more">
        <view>可开票范围 {{invoiceCandidatePage >= invoiceCandidateTotalPages ? invoiceCandidateTotal : invoiceCandidatePage * 20}} / {{invoiceCandidateTotal}}</view>
        <view wx:if="{{invoiceCandidatesLoadMoreError}}" class="load-more-error">{{invoiceCandidatesLoadMoreError}}</view>
        <button wx:if="{{invoiceCandidatePage < invoiceCandidateTotalPages}}" class="text-button" loading="{{invoiceCandidatesLoadingMore}}" disabled="{{invoiceCandidatesLoadingMore}}" bindtap="loadMoreInvoiceCandidates">{{invoiceCandidatesLoadMoreError ? '重试核对更多订单' : '核对更多可开票订单'}}</button>
      </view>

      <view wx:if="{{invoiceFormOpen}}" class="inline-form tt-state-transition">
        <view class="form-title">选择已支付订单</view>
        <picker mode="selector" range="{{invoiceOrderLabels}}" value="{{invoiceOrderIndex}}" bindchange="selectInvoiceOrder">
          <view class="picker-field"><text class="picker-label">{{invoiceOrderLabels[invoiceOrderIndex]}}</text><text>⌄</text></view>
        </picker>
        <input class="form-input" value="{{invoiceTitle}}" maxlength="100" placeholder="发票抬头（2–100 字）" bindinput="setInvoiceTitle" />
        <view class="form-note">提交不代表已开具。</view>
        <button class="primary-button full-button" loading="{{invoiceSubmitting}}" disabled="{{invoiceSubmitting}}" bindtap="submitInvoiceRequest">提交发票申请</button>
      </view>

      <view wx:if="{{invoiceState === 'loading'}}" class="empty compact">正在读取…</view>
      <view wx:elif="{{invoiceState === 'error'}}" class="state-panel error-panel">
        <view>{{invoiceError}}</view>
        <button class="retry-button" bindtap="loadInvoices">重新读取</button>
      </view>
      <view wx:elif="{{invoiceState === 'empty'}}" class="empty compact">暂无发票申请</view>
      <view wx:else class="request-list">
        <view class="request-item" wx:for="{{invoices}}" wx:key="id">
          <view class="request-top"><view class="request-title">{{item.invoiceTitle}}</view><view class="status status-{{item.status}}">{{item.statusText}}</view></view>
          <view class="request-copy">{{item.serviceText}}</view>
          <view class="request-copy">金额：{{item.amountText}}</view>
          <view wx:if="{{item.statusReason}}" class="status-reason">{{item.statusReason}}</view>
          <view class="request-meta">更新：{{item.updatedText}}<text wx:if="{{item.issuedAt}}"> · 开具：{{item.issuedText}}</text><text wx:if="{{item.voidedAt}}"> · 作废：{{item.voidedText}}</text><text wx:if="{{item.cancelledAt}}"> · 撤回：{{item.cancelledText}}</text></view>
          <button wx:if="{{item.status === 'submitted'}}" class="follow-up-button" data-id="{{item.id}}" loading="{{cancellingInvoiceId === item.id}}" disabled="{{!!cancellingInvoiceId}}" bindtap="cancelInvoiceRequest">撤回发票申请</button>
          <view wx:if="{{item.status === 'issued'}}" class="delivery-note">已开具，按已验证渠道交付。</view>
          <view wx:if="{{item.status === 'voided'}}" class="voided-note">已作废，原票据无效。</view>
          <view wx:if="{{item.status === 'cancelled'}}" class="voided-note">已撤回，订单与支付状态不变。</view>
        </view>
      </view>
      <view wx:if="{{invoiceTotalPages > 1}}" class="request-meta">
        <button class="text-button" disabled="{{invoicePage <= 1}}" bindtap="previousInvoicePage">上一页</button>
        <text>共 {{invoiceTotal}} 条 · 第 {{invoicePage}} / {{invoiceTotalPages}} 页</text>
        <button class="text-button" disabled="{{invoicePage >= invoiceTotalPages}}" bindtap="nextInvoicePage">下一页</button>
      </view>
    </view>

    <view wx:if="{{!limitedAccountMode}}" class="card account-folder folder-conversations blocked-card">
      <view class="section-title">已拉黑会话</view>
      <view class="section-copy">仅影响消息收发，不取消订单或案件。</view>
      <block wx:if="{{blockedConversations.length}}">
        <view class="blocked-item" wx:for="{{blockedConversations}}" wx:key="id" bindtap="openBlockedConversation" data-id="{{item.id}}" aria-role="button" aria-label="管理已拉黑会话：{{item.name}}" tabindex="0">
          <text>{{item.name}}</text><text>管理或解除 ›</text>
        </view>
      </block>
      <view wx:else class="empty compact">暂无拉黑会话</view>
      <view wx:if="{{blockedConversations.length}}" class="account-load-more">
        <view>{{blockedConversations.length}} / {{blockedConversationTotal}}</view>
        <view wx:if="{{blockedConversationsLoadMoreError}}" class="load-more-error">{{blockedConversationsLoadMoreError}}</view>
        <button wx:if="{{blockedConversationPage < blockedConversationTotalPages}}" class="text-button" loading="{{blockedConversationsLoadingMore}}" disabled="{{blockedConversationsLoadingMore}}" bindtap="loadMoreBlockedConversations">{{blockedConversationsLoadMoreError ? '重试读取更多' : '读取更多已拉黑会话'}}</button>
      </view>
    </view>

    <view class="card account-folder folder-deletion danger-zone">
      <view class="section-title">账号重要操作</view>
      <view wx:if="{{deletionPolicy}}" class="deletion-policy">
        注销处理目标为 {{deletionPolicy.businessDays}} 个工作日（{{deletionPolicy.timezone}}）。{{deletionPolicy.calendarRule}}{{deletionPolicy.holidayNotice}}
      </view>
      <view wx:if="{{deletionMessage}}" class="deletion-message">{{deletionMessage}}</view>
      <view wx:if="{{deletionState === 'loading'}}" class="empty compact">正在读取注销申请状态…</view>
      <view wx:elif="{{deletionState === 'error'}}" class="state-panel error-panel">
        <view>{{deletionError}}</view>
        <button class="retry-button" bindtap="loadDeletionRequest">重新读取</button>
      </view>
      <view wx:elif="{{deletionRequest}}" class="deletion-status {{deletionRequest.overdue ? 'overdue' : ''}}">
        <view class="request-top"><view class="request-title">注销申请：{{deletionRequest.statusText}}</view><view wx:if="{{deletionRequest.overdue}}" class="status status-rejected">已超期</view></view>
        <view class="request-copy">规则版本：{{deletionRequest.policyVersion}}</view>
        <view class="request-meta">提交：{{deletionRequest.createdText}} · 目标完成：{{deletionRequest.dueText}}</view>
        <view wx:if="{{deletionRequest.completedAt}}" class="request-meta">完成：{{deletionRequest.completedText}}</view>
        <view wx:if="{{deletionRequest.cancelledAt}}" class="request-meta">取消：{{deletionRequest.cancelledText}}</view>
        <view wx:if="{{deletionRequest.reactivationMessage}}" class="request-copy">{{deletionRequest.reactivationMessage}}</view>
      </view>
      <button wx:if="{{deletionRequest && deletionRequest.canCancel}}" class="secondary-button full-button" loading="{{deletionCancelling}}" disabled="{{deletionCancelling}}" bindtap="cancelDeletionRequest">取消注销申请</button>
      <button wx:if="{{deletionCanRequest}}" class="danger-button full-button" loading="{{deletionSubmitting}}" disabled="{{deletionSubmitting}}" bindtap="requestDeletion">申请注销账号</button>
      <button wx:if="{{!legalRecoveryMode}}" class="danger-button full-button" bindtap="withdrawConsent">撤回协议同意并退出</button>
    </view>
  </view>
</view>
