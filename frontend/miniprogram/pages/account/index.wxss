.account-page { padding-bottom: 66rpx; }
.account-hero { display: flex; align-items: center; gap: 18rpx; padding: 28rpx; border-radius: 26rpx; background: linear-gradient(135deg, #fff0f3, #f2f7fa); }
.locked-hero { margin-bottom: 20rpx; border: 1rpx solid #e5c7ce; background: linear-gradient(135deg, #fff5f5, #f6f1f2); }
.locked-avatar { background: #a3435d; color: #fff; }
.avatar { display: flex; width: 82rpx; height: 82rpx; flex: 0 0 82rpx; align-items: center; justify-content: center; border-radius: 50%; background: #fff; color: #a3435d; font-size: 31rpx; font-weight: 800; }
.identity { min-width: 0; flex: 1; }
.identity-name { color: #48343a; font-size: 32rpx; font-weight: 800; }
.identity-meta { margin-top: 7rpx; color: #806a71; font-size: 21rpx; line-height: 1.5; }
.edit-button { flex: 0 0 auto; margin: 0; border: 1rpx solid #ddc8ce; background: #fff; color: #88475a; font-size: 22rpx; line-height: 64rpx; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin: 20rpx 0; }
.quick-card { padding: 22rpx; border-radius: 19rpx; background: #fff; box-shadow: 0 7rpx 18rpx rgba(83, 48, 58, 0.05); }
.quick-title { color: #4c363d; font-size: 27rpx; font-weight: 800; }
.quick-copy { margin-top: 7rpx; color: #947d84; font-size: 20rpx; line-height: 1.5; }
.adult-eligibility-entry { position: relative; margin: -6rpx 0 20rpx; padding-right: 150rpx; border: 1rpx solid #ead8dc; box-shadow: none; }
.entry-arrow { position: absolute; right: 22rpx; top: 50%; color: #955169; font-size: 21rpx; font-weight: 700; transform: translateY(-50%); }
.section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.section-title { color: #49343a; font-size: 29rpx; font-weight: 800; }
.section-copy { margin-top: 7rpx; color: #826d74; font-size: 22rpx; line-height: 1.55; }
.capability { flex: 0 0 auto; padding: 5rpx 10rpx; border-radius: 9rpx; font-size: 19rpx; }
.capability.unavailable { background: #f3eeeb; color: #846f64; }
.capability.available { background: #eaf4ef; color: #3d775e; }
.partial-warning { margin: 0 0 18rpx; padding: 15rpx 18rpx; border-radius: 14rpx; background: #fff7e8; color: #835f31; font-size: 21rpx; line-height: 1.55; }
.account-action-card { border: 1rpx solid #ead8dc; }
.action-message { margin-top: 12rpx; padding: 14rpx; border-radius: 12rpx; background: #f8f3f4; color: #5f474f; font-size: 22rpx; line-height: 1.6; word-break: break-all; }
.appeal-deadline { margin-top: 10rpx; color: #8d4d5d; font-size: 21rpx; font-weight: 700; }
.appeal-result { margin-top: 12rpx; padding: 14rpx; border-radius: 12rpx; background: #f6f8f7; }
.overdue-text { color: #a13f53; font-weight: 700; }
.current-session { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; padding: 18rpx; border-radius: 14rpx; background: #f6f2f3; }
.session-title { color: #543d44; font-size: 25rpx; font-weight: 700; }
.session-copy { margin-top: 6rpx; color: #877179; font-size: 21rpx; line-height: 1.5; }
.current-badge { flex: 0 0 auto; color: #3d775e; font-size: 21rpx; font-weight: 700; }
.session-list, .request-list { margin-top: 14rpx; }
.session-item, .request-item { padding: 18rpx 0; border-bottom: 1rpx solid #eee3e6; }
.session-top, .request-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.session-platform { margin-top: 4rpx; color: #927a82; font-size: 20rpx; }
.small-danger { flex: 0 0 auto; margin: 0; padding: 0 18rpx; border: 1rpx solid #d8afb7; border-radius: 12rpx; background: #fff5f5; color: #9b3e50; font-size: 21rpx; line-height: 58rpx; }
.state-panel { margin-top: 14rpx; padding: 18rpx; border-radius: 14rpx; font-size: 22rpx; line-height: 1.55; }
.error-panel { background: #fff5f4; color: #8a4b50; }
.retry-button { width: 100%; margin-top: 12rpx; border: 1rpx solid #ddc8ce; background: #fff; color: #88475a; font-size: 22rpx; }
.row-button { display: flex; width: 100%; justify-content: space-between; margin: 8rpx 0 0; padding: 19rpx 0; border-bottom: 1rpx solid #eee3e6; border-radius: 0; background: transparent; color: #604950; font-size: 24rpx; text-align: left; }
.row-button text:last-child { color: #a68c94; }
.full-button { width: 100%; margin-top: 16rpx; font-size: 25rpx; }
.secondary-button { border: 1rpx solid #ddc8ce; background: #fff; color: #88475a; }
.primary-button { background: #a3435d; color: #fff; }
.inline-form { margin-top: 18rpx; padding: 20rpx; border-radius: 16rpx; background: #faf7f8; }
.form-title { color: #543d44; font-size: 25rpx; font-weight: 800; }
.picker-field, .form-input, .form-textarea { box-sizing: border-box; width: 100%; margin-top: 14rpx; border: 1rpx solid #dfd0d4; border-radius: 12rpx; background: #fff; color: #5c454c; font-size: 23rpx; }
.picker-field { display: flex; justify-content: space-between; padding: 18rpx; }
.picker-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.form-input { height: 76rpx; padding: 0 18rpx; }
.form-textarea { min-height: 180rpx; padding: 16rpx 18rpx; line-height: 1.6; }
.form-note, .delivery-note, .voided-note { margin-top: 12rpx; color: #826d74; font-size: 20rpx; line-height: 1.6; }
.text-button { margin: 10rpx auto 0; padding: 0; background: transparent; color: #846b73; font-size: 22rpx; }
.request-title { min-width: 0; color: #543d44; font-size: 24rpx; font-weight: 800; overflow-wrap: anywhere; }
.status { flex: 0 0 auto; padding: 4rpx 9rpx; border-radius: 8rpx; background: #f0eced; color: #776269; font-size: 19rpx; }
.status-inReview, .status-submitted { background: #edf2f6; color: #557182; }
.status-needsInformation { background: #fff2db; color: #8a622e; }
.status-completed, .status-issued { background: #eaf4ef; color: #3d775e; }
.status-rejected { background: #f8e9eb; color: #9b4354; }
.status-voided { background: #eee9ea; color: #705e63; }
.status-cancelled { background: #f0eced; color: #776269; }
.request-copy { margin-top: 9rpx; color: #6f575f; font-size: 22rpx; line-height: 1.6; word-break: break-all; }
.status-reason { margin-top: 10rpx; padding: 11rpx 13rpx; border-radius: 10rpx; background: #f8f3f4; color: #775f67; font-size: 21rpx; line-height: 1.55; }
.request-meta { margin-top: 8rpx; color: #988188; font-size: 19rpx; line-height: 1.5; }
.delivery-note { padding: 12rpx; border-left: 4rpx solid #668c78; background: #f2f8f5; color: #587063; }
.download-export-button { width: 100%; margin-top: 12rpx; border: 1rpx solid #b8d4c5; background: #f6fbf8; color: #376a53; font-size: 22rpx; }
.voided-note { padding: 12rpx; border-left: 4rpx solid #8b757b; background: #f4f1f2; color: #705e63; }
.follow-up-list { margin-top: 12rpx; border-radius: 12rpx; background: #faf7f8; }
.follow-up-item { padding: 13rpx 15rpx; border-bottom: 1rpx solid #eee3e6; }
.follow-up-item:last-child { border-bottom: 0; }
.follow-up-copy { color: #6f575f; font-size: 21rpx; line-height: 1.6; word-break: break-all; }
.follow-up-label { color: #8a5363; font-weight: 700; }
.follow-up-button { width: 100%; margin-top: 12rpx; border: 1rpx solid #dcc8ce; background: #fff; color: #88475a; font-size: 22rpx; }
.follow-up-form { margin-top: 12rpx; }
.bill-item { padding: 16rpx 0; border-bottom: 1rpx solid #eee3e6; }
.bill-main, .bill-meta { display: flex; justify-content: space-between; gap: 16rpx; }
.bill-name { min-width: 0; color: #543d44; font-size: 25rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bill-amount { flex: 0 0 auto; color: #a53f5b; font-size: 26rpx; font-weight: 800; }
.bill-amount.refunded { color: #6f7c75; text-decoration: line-through; }
.bill-meta { margin-top: 7rpx; color: #967f87; font-size: 20rpx; }
.blocked-item { display: flex; justify-content: space-between; gap: 18rpx; padding: 18rpx 0; border-bottom: 1rpx solid #eee3e6; color: #674f57; font-size: 24rpx; }
.blocked-item text:last-child { color: #955169; }
.compact { padding: 34rpx 10rpx; }
.danger-zone { border: 1rpx solid #eccfd5; }
.danger-button { border: 1rpx solid #d8afb7; background: #fff5f5; color: #9b3e50; }
.deletion-message { margin-top: 15rpx; padding: 15rpx; border-radius: 12rpx; background: #f4f1f2; color: #755e65; font-size: 22rpx; line-height: 1.6; }
.deletion-policy { margin-top: 12rpx; color: #806a71; font-size: 20rpx; line-height: 1.6; }
.deletion-status { margin-top: 15rpx; padding: 16rpx; border-radius: 12rpx; background: #f6f3f4; }
.deletion-status.overdue { border: 1rpx solid #e3b7bf; background: #fff5f5; }
.edit-button::after, .row-button::after, .secondary-button::after, .primary-button::after, .danger-button::after, .small-danger::after, .retry-button::after, .text-button::after, .follow-up-button::after, .download-export-button::after { border: 0; }
.account-load-more { margin: 14rpx 0; padding: 14rpx; border-radius: 14rpx; background: #f7f4f5; color: #75666b; font-size: 21rpx; text-align: center; }
.load-more-error { margin-top: 8rpx; color: #9b4b48; line-height: 1.5; }
