.unavailable-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 112rpx 40rpx 56rpx;
  background: #fffafa;
  color: #2d2527;
  text-align: center;
}

.status-mark {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 36rpx;
  border-radius: 52rpx;
  background: #f4e6e9;
  color: #9e405b;
  font-size: 58rpx;
  line-height: 104rpx;
  font-weight: 600;
}

.title {
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 650;
}

.message {
  margin-top: 24rpx;
  color: #65575b;
  font-size: 30rpx;
  line-height: 1.7;
}

.privacy-card {
  margin: 56rpx 0 48rpx;
  padding: 32rpx;
  border: 1rpx solid #eadfe2;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: left;
}

.privacy-title {
  font-size: 28rpx;
  font-weight: 600;
}

.privacy-copy {
  margin-top: 14rpx;
  color: #76686c;
  font-size: 26rpx;
  line-height: 1.65;
}

.primary-button,
.secondary-button {
  width: 100%;
  height: 92rpx;
  margin-top: 20rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  line-height: 92rpx;
}

.primary-button {
  background: #a3435d;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid #dfd2d6;
  background: #ffffff;
  color: #514448;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

/* Restrained redesign */
.unavailable-page { padding: 112rpx 32rpx calc(56rpx + env(safe-area-inset-bottom)); background: #F7F7F5; color: #202124; }
.status-mark { margin-bottom: 32rpx; border: 1rpx solid #E4E6E8; border-radius: 999rpx; background: #F6ECEF; color: #9B405B; }
.title { color: #202124; font-weight: 700; }
.message, .privacy-copy { color: #646970; }
.privacy-card { margin: 48rpx 0 40rpx; border-color: #E4E6E8; border-radius: 20rpx; background: #FFFFFF; }
.privacy-title { color: #202124; font-weight: 700; }
.primary-button, .secondary-button { min-height: 88rpx; height: auto; padding: 20rpx 24rpx; border-radius: 14rpx; line-height: 1.35; }
.primary-button { background: #9B405B; color: #FFFFFF; }
.secondary-button { border-color: #E4E6E8; background: #FFFFFF; color: #202124; }
.primary-button.button-hover { background: #7F3248; }
.secondary-button.button-hover { background: #F1F2F3; }
