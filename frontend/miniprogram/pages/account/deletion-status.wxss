.unavailable-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 112rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  background: var(--tt-bg);
  color: var(--tt-text);
  text-align: center;
}

.status-mark {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 36rpx;
  border-radius: 999rpx;
  background: var(--tt-accent-soft);
  color: var(--tt-accent);
  font-size: 58rpx;
  line-height: 104rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
  border: 1rpx solid var(--tt-border);
}

.title {
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 700;
  color: var(--tt-text);
}

.message {
  margin-top: 24rpx;
  color: var(--tt-text);
  font-size: 30rpx;
  line-height: 1.7;
}

.privacy-card {
  margin: 48rpx 0 40rpx;
  padding: 32rpx;
  border: 1rpx solid var(--tt-border);
  border-radius: 20rpx;
  background: var(--tt-surface);
  text-align: left;
  border-color: var(--tt-border);
}

.privacy-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--tt-text);
}

.privacy-copy {
  margin-top: 14rpx;
  color: var(--tt-text-secondary);
  font-size: 26rpx;
  line-height: 1.65;
}

.primary-button, .secondary-button {
  width: 100%;
  height: auto;
  margin-top: 20rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  line-height: 1.35;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
}

.primary-button {
  background: var(--tt-accent);
  color: var(--tt-on-accent);
}

.secondary-button {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
  color: var(--tt-text);
  border-color: var(--tt-border);
}

.primary-button::after, .secondary-button::after {
  border: 0;
}

.message, .privacy-copy {
  color: var(--tt-text-secondary);
}

.primary-button.button-hover {
  background: var(--tt-accent-pressed);
}

.secondary-button.button-hover {
  background: var(--tt-surface-alt);
}
