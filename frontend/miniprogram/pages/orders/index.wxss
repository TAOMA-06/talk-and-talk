.orders-page { padding-top: 36rpx; }
.orders-heading { padding: 4rpx 4rpx 30rpx; }
.orders-title { margin-top: 12rpx; color: var(--tt-text); font-size: 46rpx; font-weight: 700; letter-spacing: -1.2rpx; line-height: 1.16; }
.orders-copy { margin-top: 12rpx; color: var(--tt-text-secondary); font-size: 24rpx; line-height: 1.58; }
.section-title { margin: 44rpx 4rpx 16rpx; font-size: 34rpx; }
.order-view-tabs { display: flex; gap: 8rpx; margin-bottom: 18rpx; padding: 6rpx; border: 1rpx solid var(--tt-border); border-radius: 18rpx; background: var(--tt-surface-alt); }
.order-view-tab { min-width: 0; min-height: 66rpx; flex: 1; padding: 10rpx; border: 0; border-radius: 13rpx; background: transparent; color: var(--tt-text-secondary); font-size: 24rpx; }
.order-view-tab.is-active { background: var(--tt-surface); color: var(--tt-text); font-weight: 700; }
.card { padding: 26rpx; border-radius: 24rpx; }
.row,.fulfillment-heading-row,.refund-heading-row,.experience-feedback-heading-row,.rebook-heading-row,.service-guidelines-heading-row,.timeline-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.name { color: var(--tt-text); font-size: 31rpx; font-weight: 700; line-height: 1.35; }
.status { flex: none; padding: 6rpx 14rpx; border-radius: 999rpx; background: var(--tt-accent-soft); color: var(--tt-accent); font-size: 21rpx; font-weight: 700; }
.schedule { margin-top: 16rpx; color: var(--tt-text); font-size: 26rpx; font-weight: 600; }
.status-explanation { margin-top: 12rpx; color: var(--tt-text-secondary); font-size: 23rpx; line-height: 1.55; }
.order-summary-actions { display: flex; gap: 12rpx; margin-top: 20rpx; }
.order-detail-entry,.order-expand { min-width: 0; min-height: 72rpx; flex: 1; padding: 12rpx 16rpx; font-size: 23rpx; }
.order-detail-entry { border-color: var(--tt-accent); background: var(--tt-accent); color: var(--tt-on-accent); }
.order-expand { border-color: var(--tt-border-strong); background: var(--tt-surface); color: var(--tt-text-secondary); }
.order-expanded { margin-top: 22rpx; padding-top: 22rpx; border-top: 1rpx solid var(--tt-border); animation: reveal 220ms ease both; }
@keyframes reveal { from { opacity: 0; transform: translateY(-8rpx); } }
.resource-state,.notification-note,.filter-result-note { margin-bottom: 16rpx; padding: 20rpx; border-radius: 16rpx; background: var(--tt-surface-alt); color: var(--tt-text-secondary); font-size: 23rpx; line-height: 1.55; }
.resource-error,.pagination-error,.reschedule-response-error { background: var(--tt-danger-soft); color: var(--tt-danger); }
.resource-empty { text-align: center; }
.resource-retry { width: 100%; margin-top: 14rpx; }
.plain { border-color: var(--tt-border-strong); background: var(--tt-surface); color: var(--tt-text-secondary); }
.actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.action { min-width: 210rpx; flex: 1; }
.fulfillment-panel,.refund-panel,.experience-feedback-panel,.experience-feedback-record,.rebook-panel,.service-guidelines-panel,.reschedule-panel,.reschedule-response,.reschedule-pending { margin-top: 18rpx; padding: 20rpx; border-radius: 18rpx; background: var(--tt-surface-alt); color: var(--tt-text); }
.fulfillment-panel-ready,.fulfillment-panel-active { background: var(--tt-info-soft); }
.fulfillment-panel-complete,.refund-panel-resolved { background: var(--tt-success-soft); }
.fulfillment-panel-overdue,.refund-panel-attention { background: var(--tt-danger-soft); }
.refund-panel-review,.reschedule-pending,.reschedule-response { background: var(--tt-warning-soft); }
.fulfillment-kicker,.refund-kicker,.experience-feedback-kicker,.rebook-kicker,.service-guidelines-kicker { color: var(--tt-text-tertiary); font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx; }
.fulfillment-heading,.refund-heading,.rebook-heading,.reschedule-heading { color: var(--tt-text); font-size: 27rpx; font-weight: 700; }
.fulfillment-detail,.refund-explanation,.experience-feedback-intro,.experience-feedback-record-copy,.rebook-copy,.service-guidelines-summary,.reschedule-state,.reschedule-response-note { margin-top: 10rpx; color: var(--tt-text-secondary); font-size: 23rpx; line-height: 1.58; }
.fulfillment-countdown { display: flex; justify-content: space-between; gap: 16rpx; margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid var(--tt-border); }
.fulfillment-countdown-label,.reschedule-response-label,.refund-detail-label { color: var(--tt-text-tertiary); font-size: 21rpx; }
.fulfillment-countdown-value,.refund-amount,.rebook-live,.service-guidelines-progress { color: var(--tt-accent); font-size: 23rpx; font-weight: 700; }
.fulfillment-chat,.refund-support,.experience-feedback-support,.experience-feedback-toggle,.rebook-action,.service-guidelines-action,.timeline-toggle,.reschedule-refresh { width: 100%; min-height: 72rpx; margin-top: 14rpx; border-color: var(--tt-border-strong); background: var(--tt-surface); color: var(--tt-accent); font-size: 23rpx; }
.refund-detail { margin-top: 12rpx; }
.refund-detail-content { margin-top: 5rpx; color: var(--tt-text); font-size: 23rpx; line-height: 1.5; }
.refund-failure-detail { color: var(--tt-danger); }
.service-guidelines-status-list { margin-top: 12rpx; }
.service-guidelines-status { display: flex; justify-content: space-between; gap: 16rpx; padding: 10rpx 0; border-bottom: 1rpx solid var(--tt-border); color: var(--tt-text-secondary); font-size: 22rpx; }
.experience-feedback-form { margin-top: 16rpx; }
.experience-feedback-private { color: var(--tt-text-tertiary); font-size: 20rpx; }
.experience-feedback-prompt { margin-top: 18rpx; color: var(--tt-text); font-size: 23rpx; font-weight: 700; }
.experience-feedback-rating-scale,.experience-feedback-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.experience-feedback-rating,.experience-feedback-tag { min-width: 96rpx; min-height: 64rpx; flex: 1; padding: 10rpx 12rpx; border-color: var(--tt-border); background: var(--tt-surface); color: var(--tt-text-secondary); font-size: 21rpx; }
.experience-feedback-rating-value { font-weight: 700; }
.experience-feedback-rating-label { margin-top: 4rpx; font-size: 18rpx; }
.experience-feedback-note { width: 100%; min-height: 150rpx; margin-top: 14rpx; padding: 16rpx; }
.experience-feedback-submit { width: 100%; margin-top: 14rpx; }
.order-timeline { margin-top: 16rpx; }
.timeline-event { display: flex; gap: 16rpx; padding: 12rpx 0; }
.timeline-rail { width: 20rpx; flex: none; padding-top: 8rpx; }
.timeline-dot { width: 14rpx; height: 14rpx; border-radius: 999rpx; background: var(--tt-text-tertiary); }
.timeline-dot-active { background: var(--tt-accent); }
.timeline-dot-resolved { background: var(--tt-success); }
.timeline-dot-closed { background: var(--tt-danger); }
.timeline-content { min-width: 0; flex: 1; }
.timeline-title { color: var(--tt-text); font-size: 23rpx; font-weight: 700; }
.timeline-time { color: var(--tt-text-tertiary); font-size: 20rpx; }
.timeline-description,.timeline-loading { margin-top: 5rpx; color: var(--tt-text-secondary); font-size: 22rpx; line-height: 1.5; }
.reschedule-response-row { display: flex; justify-content: space-between; gap: 16rpx; padding: 10rpx 0; color: var(--tt-text); font-size: 22rpx; }
.reschedule-response-actions,.reschedule-submit-row { display: flex; gap: 12rpx; margin-top: 14rpx; }
.reschedule-response-button,.reschedule-submit { flex: 1; }
.reschedule-date-group { margin-top: 16rpx; }
.reschedule-date { color: var(--tt-text); font-size: 23rpx; font-weight: 700; }
.reschedule-slot-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; margin-top: 10rpx; }
.reschedule-slot { padding: 14rpx; border: 1rpx solid var(--tt-border); border-radius: 14rpx; background: var(--tt-surface); }
.reschedule-slot.is-selected { border-color: var(--tt-accent); background: var(--tt-accent-soft); }
.reschedule-slot-time { color: var(--tt-text); font-size: 22rpx; font-weight: 700; }
.reschedule-slot-capacity { margin-top: 4rpx; color: var(--tt-text-tertiary); font-size: 20rpx; }
.reschedule-picker-row { display: flex; gap: 12rpx; margin-top: 12rpx; }
.reschedule-picker { padding: 16rpx 20rpx; border: 1rpx solid var(--tt-border); border-radius: 14rpx; background: var(--tt-surface); color: var(--tt-text); }
.reschedule-summary { margin-top: 12rpx; color: var(--tt-accent); font-size: 22rpx; }
.commercial-pagination { margin: 18rpx 0 34rpx; color: var(--tt-text-secondary); font-size: 22rpx; line-height: 1.55; text-align: center; }
.support-facts { margin-top: 14rpx; }
.support-facts-heading { color: var(--tt-text); font-size: 24rpx; font-weight: 700; }
.support-fact { margin-top: 12rpx; padding: 14rpx; border-radius: 14rpx; background: var(--tt-surface-alt); }
.support-fact-statement { color: var(--tt-text); font-size: 22rpx; line-height: 1.5; }
.support-fact-meta,.support-fact-boundary { margin-top: 6rpx; color: var(--tt-text-tertiary); font-size: 20rpx; }
.support-fact-action { width: 100%; margin-top: 12rpx; }
.followup-section { margin-top: 40rpx; }
.recommendation-card { margin-top: 14rpx; }
@media (prefers-reduced-motion: reduce) { .order-expanded { animation: none; } }
