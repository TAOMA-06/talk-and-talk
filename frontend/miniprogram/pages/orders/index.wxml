<view class="page orders-page {{motionOff ? 'tt-motion-off' : ''}}">
  <view class="orders-heading"><view class="tt-kicker">订单</view><view class="orders-title">当前状态与下一步</view></view>
  <view wx:if="{{loading}}" class="empty">正在加载订单…</view>
  <view wx:elif="{{error}}" class="empty" aria-live="polite"><view>{{error}}</view><button class="resource-retry" bindtap="load">重新加载</button></view>
  <view wx:else>
    <view class="section-title">我的预约</view>
    <view class="order-view-tabs" aria-role="tablist" aria-label="我的预约范围">
      <button class="order-view-tab {{customerOrderView === 'active' ? 'is-active' : ''}}" bindtap="changeCustomerOrderView" data-view="active" aria-role="tab" aria-selected="{{customerOrderView === 'active'}}">进行中</button>
      <button class="order-view-tab {{customerOrderView === 'history' ? 'is-active' : ''}}" bindtap="changeCustomerOrderView" data-view="history" aria-role="tab" aria-selected="{{customerOrderView === 'history'}}">历史</button>
    </view>
    <view wx:if="{{ordersState === 'loading'}}" class="resource-state" aria-live="polite">正在读取…</view>
    <view wx:elif="{{ordersState === 'error'}}" class="resource-state resource-error" aria-live="polite"><view>{{ordersError}}</view><button class="resource-retry" bindtap="retryCustomerOrders">重试</button></view>
    <view wx:elif="{{ordersState === 'empty'}}" class="empty">暂无订单</view>
    <button wx:if="{{ordersState === 'available'}}" class="plain action" bindtap="enableCustomerNotifications">订单提醒</button>

    <view class="card order-ticket order-ticket-customer {{index < 3 ? 'tt-enter-rise' : ''}}" wx:for="{{orders}}" wx:key="id">
      <view class="row"><text class="name">{{item.displayName}}</text><text class="status">{{item.statusText}}</text></view>
      <view class="schedule">{{item.scheduledAtText}}</view>
      <view class="muted">{{item.durationMinutes}} 分钟 · {{item.amountText}}</view>
      <view class="status-explanation">{{item.statusExplanation}}</view>
      <view wx:if="{{item.refund}}" class="refund-panel refund-panel-{{item.refundTone}}">
        <view class="refund-heading-row"><view class="refund-heading">{{item.refundStatusText}}</view><view class="refund-amount">{{item.refundAmountText}}</view></view>
        <view class="refund-explanation">{{item.refundStatusExplanation}}</view>
        <view wx:if="{{item.refundFailureText}}" class="refund-detail refund-failure-detail"><view class="refund-detail-label">未完成原因</view><view class="refund-detail-content">{{item.refundFailureText}}</view></view>
      </view>
      <view wx:if="{{item.pendingReschedule}}" class="reschedule-pending">{{item.pendingRescheduleText}}</view>
      <view wx:if="{{item.canRespondToReschedule && item.pendingReschedule}}" class="reschedule-response">
        <view class="reschedule-response-row"><text class="reschedule-response-label">原预约</text><text>{{item.pendingRescheduleOriginalText}}</text></view>
        <view class="reschedule-response-row"><text class="reschedule-response-label">新提议</text><text>{{item.pendingRescheduleRequestedText}}</text></view>
        <view class="reschedule-response-row"><text class="reschedule-response-label">截止</text><text>{{item.pendingRescheduleDeadlineText}}</text></view>
        <view class="reschedule-response-actions"><button wx:if="{{item.canAcceptReschedule}}" class="primary-button reschedule-response-button" disabled="{{item.rescheduleResponseAction !== ''}}" loading="{{item.rescheduleResponseAction === 'accept'}}" bindtap="respondReschedule" data-id="{{item.id}}" data-action="accept">接受改期</button><button class="plain reschedule-response-button" disabled="{{item.rescheduleResponseAction !== ''}}" loading="{{item.rescheduleResponseAction === 'reject'}}" bindtap="respondReschedule" data-id="{{item.id}}" data-action="reject">保持原预约</button></view>
        <view wx:if="{{item.rescheduleResponseError}}" class="reschedule-response-error">{{item.rescheduleResponseError}}</view>
      </view>
      <view wx:if="{{(item.status === 'pending' || item.status === 'paying') && item.companionConfirmedAt && !publicInteractionIdentityAvailable}}" class="muted">身份核验授权未开放，暂不能支付。</view>
      <view wx:if="{{item.status === 'completed' && item.refundRequestDeadlineAt}}" class="muted">自助售后截止：{{item.refundDeadlineText}}</view>
      <view class="actions">
        <button wx:if="{{publicInteractionIdentityAvailable && (item.status === 'pending' || item.status === 'paying') && item.companionConfirmedAt}}" class="primary-button action" bindtap="pay" data-id="{{item.id}}" aria-label="进入安全支付与结果页">去支付</button>
        <button wx:if="{{item.status === 'pending' || item.status === 'paying'}}" class="plain action" bindtap="cancel" data-id="{{item.id}}">取消订单</button>
        <button wx:if="{{item.canInitiateReschedule && !item.pendingReschedule && !item.isTextOnlyHistoricalVoiceOrder}}" class="plain action" bindtap="openOrderDetail" data-id="{{item.id}}">改期</button>
        <button wx:if="{{item.canRequestRefund}}" class="plain action" bindtap="refund" data-id="{{item.id}}">{{item.refundActionText}}</button>
        <button wx:if="{{item.status === 'completed' || item.status === 'refunded'}}" class="plain action" bindtap="openAftercare" data-id="{{item.id}}">评价与售后</button>
        <button class="order-detail-entry" bindtap="openOrderDetail" data-id="{{item.id}}">查看详情</button>
      </view>
    </view>
    <view wx:if="{{ordersState === 'available'}}" class="commercial-pagination">
      <view>{{orders.length}} / {{customerOrderTotal}}</view>
      <view wx:if="{{customerOrdersLoadMoreError}}" class="pagination-error">{{customerOrdersLoadMoreError}}</view>
      <button wx:if="{{customerOrderPage < customerOrderTotalPages}}" class="resource-retry" loading="{{customerOrdersLoadingMore}}" disabled="{{customerOrdersLoadingMore}}" bindtap="loadMoreCustomerOrders">{{customerOrdersLoadMoreError ? '重试' : '加载更多'}}</button>
    </view>

    <view class="section-title">客服案件</view>
    <view wx:if="{{supportTicketsState === 'loading'}}" class="resource-state" aria-live="polite">正在读取…</view>
    <view wx:elif="{{supportTicketsState === 'error'}}" class="resource-state resource-error" aria-live="polite"><view>{{supportTicketsError}}</view><button class="resource-retry" bindtap="retrySupportTickets">重试</button></view>
    <view wx:elif="{{supportTicketsState === 'empty'}}" class="resource-state resource-empty">暂无案件</view>
    <view class="card authority-ticket support-ticket" wx:for="{{supportTickets}}" wx:key="id">
      <view class="row"><text class="name">{{item.subject}}</text><text class="status">{{item.statusText}}</text></view>
      <view class="muted">{{item.updatedAtText}} · {{item.orderId || '未关联订单'}}</view>
      <view wx:if="{{item.resolution}}" class="muted">结论：{{item.resolution}}</view>
    </view>
    <view wx:if="{{supportTicketsState === 'available'}}" class="commercial-pagination">
      <view>{{supportTickets.length}} / {{supportTicketTotal}}</view>
      <button wx:if="{{supportTicketPage < supportTicketTotalPages}}" class="resource-retry" loading="{{supportTicketsLoadingMore}}" disabled="{{supportTicketsLoadingMore}}" bindtap="loadMoreSupportTickets">{{supportTicketsLoadMoreError ? '重试' : '加载更多'}}</button>
    </view>

    <view class="section-title">作为陪伴者</view>
    <view class="order-view-tabs" aria-role="tablist" aria-label="陪伴者订单范围">
      <button class="order-view-tab {{serviceOrderView === 'active' ? 'is-active' : ''}}" bindtap="changeServiceOrderView" data-view="active" aria-role="tab" aria-selected="{{serviceOrderView === 'active'}}">待处理</button>
      <button class="order-view-tab {{serviceOrderView === 'history' ? 'is-active' : ''}}" bindtap="changeServiceOrderView" data-view="history" aria-role="tab" aria-selected="{{serviceOrderView === 'history'}}">历史</button>
    </view>
    <view wx:if="{{serviceOrdersState === 'loading'}}" class="resource-state" aria-live="polite">正在读取…</view>
    <view wx:elif="{{serviceOrdersState === 'error'}}" class="resource-state resource-error" aria-live="polite"><view>{{serviceOrdersError}}</view><button class="resource-retry" bindtap="retryServiceOrders">重试</button></view>
    <view wx:elif="{{serviceOrdersState === 'empty'}}" class="resource-state resource-empty">暂无待处理订单</view>
    <button wx:if="{{serviceOrdersState === 'available'}}" class="plain action" bindtap="enableCompanionNotifications">接单提醒</button>

    <view class="card order-ticket order-ticket-companion {{index < 3 ? 'tt-enter-rise' : ''}}" wx:for="{{serviceOrders}}" wx:key="id">
      <view class="row"><text class="name">{{item.displayName}}</text><text class="status">{{item.statusText}}</text></view>
      <view class="schedule">{{item.scheduledAtText}}</view>
      <view class="muted">{{item.durationMinutes}} 分钟 · {{item.amountText}}</view>
      <view class="status-explanation">{{item.statusExplanation}}</view>
      <view wx:if="{{item.refund}}" class="refund-panel refund-panel-{{item.refundTone}}">
        <view class="refund-heading-row"><view class="refund-heading">{{item.refundStatusText}}</view><view class="refund-amount">{{item.refundAmountText}}</view></view>
        <view class="refund-explanation">{{item.refundStatusExplanation}}</view>
        <view wx:if="{{item.refundFailureText}}" class="refund-detail refund-failure-detail"><view class="refund-detail-label">未完成原因</view><view class="refund-detail-content">{{item.refundFailureText}}</view></view>
      </view>
      <view wx:if="{{item.pendingReschedule}}" class="reschedule-pending">{{item.pendingRescheduleText}}</view>
      <view wx:if="{{item.canRespondToReschedule && item.pendingReschedule}}" class="reschedule-response">
        <view class="reschedule-response-row"><text class="reschedule-response-label">原预约</text><text>{{item.pendingRescheduleOriginalText}}</text></view>
        <view class="reschedule-response-row"><text class="reschedule-response-label">新提议</text><text>{{item.pendingRescheduleRequestedText}}</text></view>
        <view class="reschedule-response-row"><text class="reschedule-response-label">截止</text><text>{{item.pendingRescheduleDeadlineText}}</text></view>
        <view class="reschedule-response-actions"><button wx:if="{{item.canAcceptReschedule}}" class="primary-button reschedule-response-button" disabled="{{item.rescheduleResponseAction !== ''}}" loading="{{item.rescheduleResponseAction === 'accept'}}" bindtap="respondReschedule" data-id="{{item.id}}" data-action="accept">接受改期</button><button class="plain reschedule-response-button" disabled="{{item.rescheduleResponseAction !== ''}}" loading="{{item.rescheduleResponseAction === 'reject'}}" bindtap="respondReschedule" data-id="{{item.id}}" data-action="reject">保持原预约</button></view>
        <view wx:if="{{item.rescheduleResponseError}}" class="reschedule-response-error">{{item.rescheduleResponseError}}</view>
      </view>
      <view class="actions">
        <button wx:if="{{item.canInitiateReschedule && !item.pendingReschedule && !item.isTextOnlyHistoricalVoiceOrder}}" class="plain action" bindtap="openOrderDetail" data-id="{{item.id}}">改期</button>
        <button wx:if="{{item.status === 'pending' && !item.companionConfirmedAt && !item.isTextOnlyHistoricalVoiceOrder}}" class="primary-button action" bindtap="confirmServiceOrder" data-id="{{item.id}}">确认预约</button>
        <button wx:if="{{item.status === 'pending' && !item.companionConfirmedAt}}" class="plain action" bindtap="rejectServiceOrder" data-id="{{item.id}}">无法接单</button>
        <button wx:if="{{item.status === 'paid' && item.canStartService && !item.isTextOnlyHistoricalVoiceOrder}}" class="primary-button action" bindtap="startService" data-id="{{item.id}}">开始服务</button>
        <button wx:if="{{item.status === 'inService' && item.canCompleteService}}" class="primary-button action" bindtap="completeService" data-id="{{item.id}}">完成服务</button>
        <view wx:if="{{item.status === 'inService' && !item.canCompleteService}}" class="muted">{{item.completionEligibleAtText}} 后可完成</view>
        <button wx:if="{{item.attendanceDispute}}" class="plain action" bindtap="openAttendanceDispute" data-id="{{item.id}}" data-dispute-id="{{item.attendanceDispute.id}}">查看争议</button>
        <button class="order-detail-entry" bindtap="openOrderDetail" data-id="{{item.id}}">查看详情</button>
      </view>
    </view>
    <view wx:if="{{serviceOrdersState === 'available'}}" class="commercial-pagination">
      <view>{{serviceOrders.length}} / {{serviceOrderTotal}}</view>
      <view wx:if="{{serviceOrdersLoadMoreError}}" class="pagination-error">{{serviceOrdersLoadMoreError}}</view>
      <button wx:if="{{serviceOrderPage < serviceOrderTotalPages}}" class="resource-retry" loading="{{serviceOrdersLoadingMore}}" disabled="{{serviceOrdersLoadingMore}}" bindtap="loadMoreServiceOrders">{{serviceOrdersLoadMoreError ? '重试' : '加载更多'}}</button>
    </view>
  </view>
</view>
