<view class="page chat-page">
  <view class="notice">请在平台内完成沟通，勿交换私人联系方式、线下见面或私下转账。</view>
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{error}}" class="empty">{{error}}</view>
  <view wx:else class="messages">
    <view wx:for="{{messages}}" wx:key="id" class="message {{item.type === 'system' || item.type === 'safety' ? 'system' : ''}}">
      <view class="sender">{{item.senderName || item.senderId}}</view>
      <view class="bubble">{{item.content}}</view>
    </view>
  </view>
  <view class="composer">
    <input value="{{draft}}" bindinput="setDraft" maxlength="2000" placeholder="输入消息…" confirm-type="send" bindconfirm="send" />
    <button class="send" loading="{{sending}}" bindtap="send">发送</button>
  </view>
  <button class="report" bindtap="report">举报此会话</button>
</view>
