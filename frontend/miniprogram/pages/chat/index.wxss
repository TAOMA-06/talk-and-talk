.chat-page { padding-bottom: 164rpx; }
.notice, .restriction-notice, .appeal-notice, .safety-exit { margin-bottom: 20rpx; padding: 16rpx; border-radius: 14rpx; font-size: 24rpx; line-height: 1.5; }
.notice { background: #fce8ed; color: #9b3d58; }
.message-notification-setting { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; padding: 16rpx; border: 1rpx solid #e7dfe1; border-radius: 14rpx; background: #fff; }
.message-notification-copy { min-width: 0; flex: 1; }
.message-notification-title { color: #5f454d; font-size: 25rpx; font-weight: 700; }
.message-notification-description { margin-top: 5rpx; color: #856871; font-size: 21rpx; line-height: 1.5; }
.message-notification-action { flex: 0 0 auto; margin: 0; padding: 0 16rpx; border: 1rpx solid #e1c5cc; border-radius: 10rpx; background: #fffafa; color: #914158; font-size: 22rpx; line-height: 56rpx; }
.message-notification-action::after { border: 0; }
.safety-exit { border: 1rpx solid #ead8dc; background: #fffafa; color: #765b60; }
.safety-exit-title { color: #7e334a; font-size: 26rpx; font-weight: 700; }
.safety-exit-copy { margin-top: 8rpx; color: #795f66; font-size: 22rpx; line-height: 1.55; }
.safety-exit-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.safety-exit-action { flex: 1 1 180rpx; margin: 0; padding: 0 14rpx; border: 1rpx solid #e1c5cc; border-radius: 10rpx; background: #fff; color: #914158; font-size: 22rpx; line-height: 56rpx; }
.safety-exit-report { border-color: #c8798c; color: #8d344d; }
.safety-exit-block { border-color: #b9966d; color: #805c32; }
.safety-exit-action::after { border: 0; }
.conversation-boundary { margin-bottom: 20rpx; padding: 20rpx; border: 1rpx solid #d9c8b9; border-radius: 14rpx; background: #fffaf4; }
.conversation-boundary-title { color: #725032; font-size: 27rpx; font-weight: 700; }
.conversation-boundary-copy { margin-top: 10rpx; color: #765f4c; font-size: 23rpx; line-height: 1.65; }
.restriction-notice { background: #fff4d8; color: #8a5d08; }
.appeal-notice { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; background: #eef3ff; color: #3d5a9b; }
.appeal-notice button { margin: 0; background: #fff; color: #3d5a9b; font-size: 22rpx; }
.history-status, .sync-status { padding: 12rpx 0; color: #8d6e73; font-size: 23rpx; text-align: center; }
.sync-status { color: #a45168; }
.message { margin: 18rpx 0; }
.sender { margin-bottom: 6rpx; color: #8d6e73; font-size: 23rpx; }
.bubble { display: inline-block; max-width: 88%; padding: 18rpx 22rpx; border-radius: 18rpx; background: #fff; line-height: 1.55; box-shadow: 0 4rpx 12rpx rgba(96, 50, 60, 0.06); }
.message-content { white-space: pre-wrap; word-break: break-word; }
.system .bubble { background: #f5e7ec; color: #7a4857; font-size: 26rpx; }
.held .bubble { background: #f6f1f2; color: #8a6871; }
.delivery-status { margin-top: 7rpx; color: #9a7480; font-size: 22rpx; }
.delivery-status.blocked { color: #b24b64; }
.attachment { margin-top: 12rpx; }
.attachment-image { display: block; width: 360rpx; max-width: 100%; border-radius: 12rpx; }
.attachment-placeholder { min-width: 240rpx; padding: 20rpx; border-radius: 12rpx; background: #efe7e9; color: #866871; font-size: 24rpx; }
.audio-play { margin: 0; background: #f7e7ed; color: #93445d; font-size: 24rpx; }
.composer { position: fixed; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 10rpx; padding: 16rpx 24rpx; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(96, 50, 60, 0.08); }
.composer input { min-width: 0; flex: 1; padding: 16rpx; border-radius: 16rpx; background: #f9edef; }
.send, .media { margin: 0; font-size: 25rpx; }
.send { background: #b94a68; color: #fff; }
.media { padding: 0 14rpx; background: #f7e7ed; color: #93445d; }
.recording { background: #d9536f; color: #fff; }
