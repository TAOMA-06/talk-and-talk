.workbench-page { padding-top: 36rpx; }
.hero-card { padding: 32rpx; border: 1rpx solid var(--tt-border); border-radius: 26rpx; background: var(--tt-surface); }
.hero-title { max-width: 620rpx; margin-top: 12rpx; color: var(--tt-text); font-size: 44rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1.17; }
.hero-copy { margin-top: 13rpx; color: var(--tt-text-secondary); font-size: 25rpx; line-height: 1.6; }
.updated-at { margin-top: 22rpx; color: var(--tt-text-tertiary); font-size: 21rpx; }
.profile-media-card { overflow: hidden; margin-top: 18rpx; border: 1rpx solid var(--tt-border); border-radius: 24rpx; background: var(--tt-surface); }
.profile-media-cover { display: block; width: 100%; height: 248rpx; background: var(--tt-surface-alt); }
.profile-media-main { display: flex; align-items: flex-end; gap: 18rpx; margin-top: -42rpx; padding: 0 22rpx; }
.profile-media-copy { min-width: 0; flex: 1; padding-bottom: 8rpx; }
.profile-media-title { color: var(--tt-text); font-size: 27rpx; font-weight: 700; }
.profile-media-note { margin-top: 5rpx; color: var(--tt-text-secondary); font-size: 21rpx; line-height: 1.48; }
.profile-media-actions,.profile-media-remove { display: flex; gap: 12rpx; padding: 18rpx 22rpx 0; }
.profile-media-actions button,.profile-media-remove button { min-width: 0; min-height: 68rpx; flex: 1; padding: 10rpx; font-size: 22rpx; }
.profile-media-actions button { border-color: var(--tt-accent); background: var(--tt-accent-soft); color: var(--tt-accent); }
.profile-media-remove { padding-top: 10rpx; }
.profile-media-remove button { border-color: var(--tt-border); background: var(--tt-surface); color: var(--tt-danger); }
.profile-media-message { margin: 14rpx 22rpx 20rpx; padding: 12rpx 14rpx; border-radius: 14rpx; background: var(--tt-surface-alt); color: var(--tt-text-secondary); font-size: 21rpx; }
.access-empty { line-height: 1.68; }
.access-title { color: var(--tt-text); font-size: 34rpx; font-weight: 700; }
.retry-button { width: 100%; margin-top: 22rpx; }
.attention-card { display: flex; align-items: center; gap: 18rpx; margin-top: 18rpx; padding: 22rpx; border: 1rpx solid var(--tt-warning); border-radius: 20rpx; background: var(--tt-warning-soft); color: var(--tt-warning); }
.attention-icon { display: flex; width: 42rpx; height: 42rpx; flex: none; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--tt-warning); color: var(--tt-on-accent); font-size: 27rpx; font-weight: 700; }
.attention-body { min-width: 0; flex: 1; }
.attention-title { font-size: 27rpx; font-weight: 700; }
.attention-copy { margin-top: 5rpx; font-size: 22rpx; line-height: 1.5; }
.attention-link { flex: none; color: var(--tt-warning); font-size: 23rpx; font-weight: 700; }
.section-heading { margin: 42rpx 4rpx 16rpx; color: var(--tt-text); font-size: 32rpx; font-weight: 700; }
.overview-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.overview-card { min-height: 178rpx; padding: 22rpx; border: 1rpx solid var(--tt-border); border-radius: 22rpx; background: var(--tt-surface); }
.overview-card.earnings-card { grid-column: 1 / -1; min-height: 142rpx; }
.overview-label { color: var(--tt-text-secondary); font-size: 23rpx; }
.overview-value { margin-top: 12rpx; color: var(--tt-text); font-size: 38rpx; font-weight: 700; line-height: 1.15; }
.overview-unit { margin-left: 5rpx; color: var(--tt-text-secondary); font-size: 21rpx; font-weight: 400; }
.earnings-value { color: var(--tt-accent); }
.overview-unavailable { margin-top: 12rpx; color: var(--tt-text); font-size: 30rpx; font-weight: 700; }
.overview-note { margin-top: 13rpx; overflow: hidden; color: var(--tt-text-tertiary); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.lifecycle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.lifecycle-card { min-height: 168rpx; padding: 22rpx; border: 1rpx solid var(--tt-border); border-radius: 22rpx; background: var(--tt-surface); }
.lifecycle-title { color: var(--tt-text); font-size: 25rpx; font-weight: 700; line-height: 1.4; }
.lifecycle-state { margin-top: 12rpx; color: var(--tt-text-secondary); font-size: 22rpx; line-height: 1.45; }
.lifecycle-link { margin-top: 12rpx; color: var(--tt-accent); font-size: 21rpx; font-weight: 700; }
.schedule-card { padding: 26rpx; }
.today-service-card + .today-service-card { margin-top: 14rpx; }
.schedule-head { display: flex; align-items: flex-start; gap: 14rpx; }
.schedule-title { min-width: 0; flex: 1; color: var(--tt-text); font-size: 28rpx; font-weight: 700; }
.status-chip { flex: none; padding: 6rpx 12rpx; border-radius: 999rpx; background: var(--tt-accent-soft); color: var(--tt-accent); font-size: 20rpx; }
.schedule-time { margin-top: 18rpx; color: var(--tt-text); font-size: 27rpx; font-weight: 600; }
.schedule-meta,.schedule-link { margin-top: 9rpx; color: var(--tt-text-secondary); font-size: 23rpx; line-height: 1.5; }
.schedule-link { color: var(--tt-accent); font-weight: 700; }
.empty-schedule { line-height: 1.6; }
.empty-actions { display: flex; gap: 12rpx; margin-top: 20rpx; }
.plain-button { min-height: 72rpx; margin: 0; padding: 10rpx 18rpx; border-color: var(--tt-border-strong); background: var(--tt-surface); color: var(--tt-accent); font-size: 23rpx; }
.schedule-action { margin-top: 18rpx; }
.empty-actions .schedule-action { min-width: 0; flex: 1; margin-top: 0; }
.workbench-tip { margin: 22rpx 8rpx 8rpx; color: var(--tt-text-tertiary); font-size: 21rpx; line-height: 1.55; }
.card-hover { opacity: .78; }
