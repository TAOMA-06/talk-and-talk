<view class="page" wx:if="{{companion}}">
  <view class="emergency-entry" bindtap="openEmergencyHelp" aria-role="button" aria-label="查看紧急帮助与官方电话号码" tabindex="0">
    <view>
      <view class="emergency-title">即时危险不适合继续预约</view>
      <view class="emergency-copy">先查看官方紧急资源并一键拨号；平台不会代你报警或救援</view>
    </view>
    <view class="emergency-arrow">›</view>
  </view>
  <view class="card profile">
    <view class="avatar">{{companion.initials}}</view>
    <view class="title">{{companion.name}}</view>
    <view class="muted">{{companion.role}} · {{companion.availability}} · ★ {{companion.rating}}</view>
    <view class="bio">{{companion.bio}}</view>
    <view wx:if="{{publicProfile}}" class="public-profile-section" aria-role="group" aria-label="陪伴者公开信任资料">
      <view class="public-profile-heading">
        <view>
          <view class="public-profile-kicker">公开信任资料</view>
          <view class="public-profile-title" aria-role="heading" aria-level="2">先了解，再决定是否预约</view>
        </view>
        <view class="public-profile-safe">不展示证件或审核备注</view>
      </view>
      <view class="public-profile-metrics">
        <view class="public-profile-metric">
          <view class="public-profile-metric-value">{{publicProfile.completedOrdersText}}</view>
          <view class="public-profile-metric-label">平台履约记录</view>
        </view>
        <view class="public-profile-metric">
          <view class="public-profile-metric-value">{{publicProfile.responseTimeText}}</view>
          <view class="public-profile-metric-label">公开响应表现</view>
        </view>
      </view>
      <view class="public-profile-group">
        <view class="public-profile-label">沟通语言</view>
        <view wx:if="{{publicProfile.languages.length}}" class="public-profile-chips">
          <text wx:for="{{publicProfile.languages}}" wx:key="*this" class="public-profile-chip">{{item}}</text>
        </view>
        <view wx:else class="public-profile-empty">暂未填写</view>
      </view>
      <view class="public-profile-group">
        <view class="public-profile-label">擅长与互动方式</view>
        <view wx:if="{{publicProfile.specialties.length}}" class="public-profile-chips">
          <text wx:for="{{publicProfile.specialties}}" wx:key="*this" class="public-profile-chip public-profile-chip-accent">{{item}}</text>
        </view>
        <view wx:else class="public-profile-empty">暂未填写</view>
      </view>
      <view class="public-profile-group">
        <view class="public-profile-label">公开经历说明</view>
        <view class="public-profile-copy">{{publicProfile.livedExperience}}</view>
      </view>
      <view class="public-profile-group">
        <view class="public-profile-label">服务边界</view>
        <view wx:if="{{publicProfile.serviceBoundaries.length}}" class="boundary-list">
          <view wx:for="{{publicProfile.serviceBoundaries}}" wx:key="*this" class="boundary-item">
            <text class="boundary-marker">✓</text><text>{{item}}</text>
          </view>
        </view>
        <view wx:else class="public-profile-empty">除平台通用边界外，暂未填写个性化边界。</view>
      </view>
      <view class="public-status-grid">
        <view class="public-status-card {{publicProfile.trainingCurrent ? 'is-current' : 'is-due'}}" aria-label="{{publicProfile.trainingStatusText}}，{{publicProfile.trainingDetailText}}">
          <view class="public-status-title">{{publicProfile.trainingStatusText}}</view>
          <view class="public-status-detail">{{publicProfile.trainingDetailText}}</view>
        </view>
        <view class="public-status-card {{publicProfile.reviewCurrent ? 'is-current' : 'is-due'}}" aria-label="{{publicProfile.reviewStatusText}}，{{publicProfile.reviewDetailText}}">
          <view class="public-status-title">{{publicProfile.reviewStatusText}}</view>
          <view class="public-status-detail">{{publicProfile.reviewDetailText}}</view>
        </view>
      </view>
      <view wx:if="{{publicProfile.voiceIntroPlayable}}" class="voice-intro-card is-approved" bindtap="playVoiceIntro" aria-role="button" tabindex="0" aria-label="语音介绍，{{publicProfile.voiceIntroMetaText}}，{{publicProfile.voiceIntroPlaybackText}}">
        <view class="voice-intro-icon">声</view>
        <view class="voice-intro-copy">
          <view class="voice-intro-title">语音介绍 · {{publicProfile.voiceIntroMetaText}}</view>
          <view class="voice-intro-note">{{publicProfile.voiceIntroPlaybackText}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{trustFacts.length}}" class="trust-section">
      <view class="trust-heading"><text>下单前确认</text><text>当前规则</text></view>
      <view wx:for="{{trustFacts}}" wx:key="tone" class="trust-fact trust-fact-{{item.tone}}">
        <view class="trust-marker"></view>
        <view class="trust-copy">
          <view class="trust-title">{{item.title}}</view>
          <view class="trust-description">{{item.description}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{canManageFavorites}}" class="favorite-control">
      <view wx:if="{{favoriteState === 'loading'}}" class="favorite-state" aria-live="polite">正在核对私人书签状态…</view>
      <view wx:elif="{{favoriteState === 'error'}}" class="favorite-state favorite-state-error" aria-live="polite">
        <view>{{favoriteError}}</view>
        <button class="favorite-state-retry" bindtap="retryFavoriteState" aria-label="重新读取私人书签状态">重新读取书签状态</button>
      </view>
      <block wx:else>
        <button class="favorite-toggle {{isFavorite ? 'favorite-toggle-saved' : ''}}" loading="{{favoriteSaving}}" disabled="{{favoriteSaving}}" bindtap="toggleFavorite">{{isFavorite ? '已保存到我的书签' : '保存到我的书签'}}</button>
        <view class="favorite-privacy">仅你可见；不会通知陪伴者，也不会改变订单或推荐排序。</view>
      </block>
    </view>
    <view wx:if="{{canManageFavorites && recommendationExclusionAvailable}}" class="recommendation-control {{isRecommendationExcluded ? 'recommendation-control-excluded' : ''}}">
      <button
        wx:if="{{isRecommendationExcluded}}"
        class="recommendation-toggle"
        loading="{{recommendationExclusionSaving}}"
        disabled="{{recommendationExclusionSaving}}"
        bindtap="restoreToRecommendations"
        aria-label="恢复向我推荐这位陪伴者"
      >已停止推荐 · 点击恢复</button>
      <button
        wx:else
        class="recommendation-toggle"
        loading="{{recommendationExclusionSaving}}"
        disabled="{{recommendationExclusionSaving}}"
        bindtap="excludeFromRecommendations"
        aria-label="不再向我推荐这位陪伴者"
      >不再向我推荐这位陪伴者</button>
      <view class="recommendation-privacy">只影响推荐和匹配；不等于拉黑或举报，也不影响订单、书签与公开搜索。</view>
    </view>
    <view wx:elif="{{canManageFavorites}}" class="recommendation-control recommendation-control-unavailable">
      <view class="recommendation-unavailable-title">推荐偏好暂时无法读取</view>
      <view class="recommendation-privacy">请稍后刷新；当前不会据此改变拉黑、举报、订单、书签或公开资料。</view>
    </view>
    <view wx:if="{{rebookingNotice}}" class="rebooking-notice">
      <view class="rebooking-notice-heading"><text>再次预约</text><text>重新核对</text></view>
      <view class="rebooking-notice-copy">{{rebookingNotice}}</view>
    </view>
    <view class="service-section">
      <view class="service-heading">
        <view>选择服务</view>
        <view class="service-lock">下单时锁定价格、时长与时段</view>
      </view>
      <view wx:if="{{serviceCatalogStatus === 'loading'}}" class="service-state">正在加载可预约服务…</view>
      <view wx:elif="{{serviceCatalogStatus === 'available'}}" class="service-list">
        <view
          wx:for="{{serviceOfferings}}"
          wx:key="id"
          class="service-offering {{selectedServiceOfferingId === item.id ? 'is-selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectServiceOffering"
          aria-role="radio"
          aria-checked="{{selectedServiceOfferingId === item.id}}"
          aria-label="选择服务：{{item.title}}，{{item.deliveryMode === 'voice' ? '语音陪伴' : '文字陪伴'}}，{{item.durationMinutes}} 分钟，价格 {{item.priceCents / 100}} 元"
          tabindex="0"
        >
          <view class="service-choice {{selectedServiceOfferingId === item.id ? 'is-selected' : ''}}"></view>
          <view class="service-copy">
            <view class="service-title-row">
              <view class="service-title">{{item.title}}</view>
              <view class="service-price">¥{{item.priceCents / 100}}</view>
            </view>
            <view class="service-meta">{{item.deliveryMode === 'voice' ? '语音陪伴' : '文字陪伴'}} · {{item.durationMinutes}} 分钟</view>
            <view wx:if="{{item.description}}" class="service-description">{{item.description}}</view>
          </view>
        </view>
        <view class="service-catalog-pagination">已显示 {{serviceOfferings.length}} / {{serviceCatalogTotal}} 项服务</view>
        <view wx:if="{{serviceCatalogLoadMoreError}}" class="service-catalog-pagination-error" aria-live="polite">{{serviceCatalogLoadMoreError}}</view>
        <button wx:if="{{serviceCatalogPage < serviceCatalogTotalPages}}" class="service-catalog-load-more" loading="{{serviceCatalogLoadingMore}}" disabled="{{serviceCatalogLoadingMore}}" bindtap="loadMoreServiceOfferings">{{serviceCatalogLoadMoreError ? '重试加载更多' : '加载更多服务'}}</button>
      </view>
      <view wx:else class="service-state">{{serviceCatalogMessage}}</view>
    </view>
    <view wx:if="{{selectedServiceOffering}}" class="booking-summary">已选：{{selectedServiceOffering.title}} · ¥{{selectedServiceOffering.priceCents / 100}} / {{selectedServiceOffering.durationMinutes}} 分钟</view>
    <view wx:if="{{serviceCatalogStatus === 'available'}}" class="service-intent-section" aria-role="radiogroup" aria-label="选择本次希望的陪伴方式">
      <view class="service-heading">
        <view>本次希望怎样聊</view>
        <view class="service-lock">会锁定到订单</view>
      </view>
      <view class="service-intent-note">请选择最接近的一项，帮助双方提前对齐；这不是诊断，也不保证特定结果。</view>
      <view class="service-intent-list">
        <view
          wx:for="{{serviceIntentOptions}}"
          wx:key="code"
          class="service-intent-option {{selectedServiceIntent === item.code ? 'is-selected' : ''}}"
          data-code="{{item.code}}"
          bindtap="selectServiceIntent"
          aria-role="radio"
          aria-checked="{{selectedServiceIntent === item.code}}"
          aria-label="{{item.title}}，{{item.description}}"
          tabindex="0"
        >
          <view class="service-choice {{selectedServiceIntent === item.code ? 'is-selected' : ''}}"></view>
          <view class="service-intent-copy">
            <view class="service-intent-title">{{item.title}}</view>
            <view class="service-intent-description">{{item.description}}</view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{selectedServiceIntentLabel}}" class="booking-summary booking-intent-summary">本次陪伴方式：{{selectedServiceIntentLabel}}</view>
    <view wx:if="{{serviceCatalogStatus === 'available'}}" class="availability-section">
      <view class="availability-heading">
        <view>选择时段</view>
        <view class="availability-timezone">北京时间</view>
      </view>
      <view wx:if="{{availabilityStatus === 'loading'}}" class="availability-state">正在读取可预约时段…</view>
      <view wx:elif="{{availabilityStatus === 'structured'}}" class="availability-list">
        <view class="availability-note">{{availabilityMessage}}</view>
        <view wx:for="{{availabilityDateGroups}}" wx:for-item="group" wx:key="key" class="availability-date-group">
          <view class="availability-date">{{group.label}}</view>
          <view class="availability-slot-grid">
            <view
              wx:for="{{group.items}}"
              wx:for-item="slot"
              wx:key="id"
              class="availability-slot {{selectedAvailabilityCandidateId === slot.id ? 'is-selected' : ''}}"
              data-id="{{slot.id}}"
              bindtap="selectAvailabilityCandidate"
              aria-role="radio"
              aria-checked="{{selectedAvailabilityCandidateId === slot.id}}"
              aria-label="选择时段：{{group.label}} {{slot.timeLabel}} 到 {{slot.endTimeLabel}}，还可约 {{slot.availableCapacity}} 位"
              tabindex="0"
            >
              <view class="availability-slot-time">{{slot.timeLabel}}–{{slot.endTimeLabel}}</view>
              <view wx:if="{{slot.availableCapacity > 1}}" class="availability-slot-capacity">还可约 {{slot.availableCapacity}} 位</view>
              <view wx:else class="availability-slot-capacity">可预约</view>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="availability-state availability-unavailable">{{availabilityMessage}}</view>
    </view>
    <view wx:if="{{selectedAvailabilityCandidate}}" class="booking-summary booking-slot-summary">已选时段：{{selectedAvailabilityCandidate.dateLabel}} {{selectedAvailabilityCandidate.timeLabel}}–{{selectedAvailabilityCandidate.endTimeLabel}}（北京时间）</view>
    <button class="primary-button" disabled="{{!canBook || booking}}" loading="{{booking}}" bindtap="book">{{bookingButtonText}}</button>
  </view>
  <view class="title section-title">用户评价</view>
  <view wx:if="{{!reviews.length}}" class="empty">暂时还没有评价</view>
  <view class="card" wx:for="{{reviews}}" wx:key="id">
    <view class="row"><text>{{item.userName}}</text><text class="rating">★ {{item.rating}}</text></view>
    <view class="review">{{item.content}}</view>
  </view>
  <view wx:if="{{reviewsError}}" class="empty">{{reviewsError}}</view>
  <button wx:if="{{reviewPage < reviewTotalPages}}" class="plain-button" loading="{{reviewsLoadingMore}}" disabled="{{reviewsLoadingMore}}" bindtap="loadMoreReviews">加载更多评价（已显示 {{reviews.length}} / {{reviewTotal}}）</button>
  <view wx:if="{{bookingConfirmationVisible && bookingPreview}}" class="booking-overlay">
    <view class="booking-confirmation">
      <view class="confirmation-kicker">创建订单前最后确认</view>
      <view class="confirmation-title">请核对这次预约</view>
      <view class="confirmation-row"><text>服务对象</text><text>{{bookingPreview.companionName}}</text></view>
      <view class="confirmation-row"><text>服务商品</text><text>{{bookingPreview.serviceTitle}}</text></view>
      <view class="confirmation-row"><text>本次意图</text><text>{{bookingPreview.serviceIntentText}}</text></view>
      <view class="confirmation-row"><text>服务方式</text><text>{{bookingPreview.deliveryModeText}}</text></view>
      <view class="confirmation-row"><text>预约时间</text><text>{{bookingPreview.scheduleText}}</text></view>
      <view class="confirmation-row"><text>时长</text><text>{{bookingPreview.durationText}}</text></view>
      <view class="confirmation-row total"><text>订单金额</text><text>{{bookingPreview.priceText}}</text></view>
      <view class="confirmation-note">本次操作只创建待确认订单，不会立即扣款。陪伴者确认后，你仍需在订单中主动完成微信支付。</view>
      <button class="confirmation-check {{bookingAccuracyConfirmed ? 'checked' : ''}}" bindtap="toggleBookingAccuracy">{{bookingAccuracyConfirmed ? '✓' : '○'}} 我已核对对象、商品、金额和北京时间</button>
      <button class="confirmation-check {{bookingBoundaryConfirmed ? 'checked' : ''}}" bindtap="toggleBookingBoundary">{{bookingBoundaryConfirmed ? '✓' : '○'}} 我理解仅限平台内沟通，不含医疗、治疗或紧急救助</button>
      <view class="confirmation-actions">
        <button class="confirmation-cancel" disabled="{{booking}}" bindtap="closeBookingConfirmation">返回修改</button>
        <button class="confirmation-submit" disabled="{{booking || !bookingAccuracyConfirmed || !bookingBoundaryConfirmed}}" loading="{{booking}}" bindtap="confirmBooking">确认创建订单</button>
      </view>
    </view>
  </view>
</view>
<view wx:elif="{{loading}}" class="empty">正在加载…</view>
<view wx:else class="empty">{{error}}</view>
