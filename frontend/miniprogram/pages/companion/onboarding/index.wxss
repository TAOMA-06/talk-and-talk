.hero {
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--tt-accent-soft);
  box-shadow: none;
  border: 1rpx solid var(--tt-border);
}

.eyebrow {
  color: var(--tt-accent);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-copy {
  margin-top: 14rpx;
  color: var(--tt-text);
  font-size: 26rpx;
  line-height: 1.6;
}

.warning {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  font-size: 24rpx;
  border: 1rpx solid var(--tt-border);
}

.section-title {
  margin: 34rpx 4rpx 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.form-card {
  padding: 32rpx;
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
}

.field-label {
  margin: 22rpx 0 10rpx;
  color: var(--tt-text);
  font-size: 24rpx;
  font-weight: 600;
}

.field {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--tt-danger-soft);
  border-radius: 16rpx;
  background: var(--tt-danger-soft);
  font-size: 27rpx;
}

.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 220rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--tt-danger-soft);
  border-radius: 16rpx;
  background: var(--tt-danger-soft);
  font-size: 27rpx;
  line-height: 1.55;
}

.textarea.compact {
  min-height: 150rpx;
}

.two-column {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.subsection {
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid var(--tt-danger-soft);
  font-size: 28rpx;
  font-weight: 700;
  border-color: var(--tt-border);
}

.status-line, .hint {
  margin-top: 12rpx;
  color: var(--tt-text);
  font-size: 24rpx;
  line-height: 1.55;
}

.hint {
  color: var(--tt-text-tertiary);
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.status-title {
  font-size: 30rpx;
  font-weight: 700;
}

.status-badge {
  flex: none;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 22rpx;
}

.status-verified {
  background: var(--tt-success-soft);
  color: var(--tt-success);
}

.status-suspended {
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.privacy-notice {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
  border: 1rpx solid var(--tt-border);
}

.form-error {
  margin-top: 20rpx;
  color: var(--tt-danger);
  font-size: 24rpx;
  line-height: 1.5;
}

.submit {
  margin-top: 28rpx;
  min-height: 88rpx;
}

.secondary-button {
  margin-top: 16rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
  min-height: 80rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
}

.empty-title {
  margin-bottom: 14rpx;
  color: var(--tt-danger);
  font-size: 34rpx;
  font-weight: 700;
}

.retry {
  margin-top: 28rpx;
}

.primary-button {
  min-height: 88rpx;
}

.hero-title, .section-title, .status-title, .empty-title, .subsection {
  color: var(--tt-text);
  font-weight: 700;
}

.hero-copy, .field-label, .status-line {
  color: var(--tt-text-secondary);
}

.field, .textarea {
  border: 1rpx solid var(--tt-border);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-text);
}

.primary-button.button-hover {
  background: var(--tt-accent-pressed);
}

.primary-button[disabled], .secondary-button[disabled] {
  opacity: 0.52;
}
