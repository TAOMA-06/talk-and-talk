<view class="page">
  <view wx:if="{{loading}}" class="empty">正在核对入驻状态…</view>

  <view wx:elif="{{state === 'error'}}" class="empty">
    <view class="empty-title">资料暂时无法加载</view>
    <view class="muted">{{error}}</view>
    <button class="primary-button retry" bindtap="retry">重新加载</button>
  </view>

  <block wx:elif="{{state === 'application'}}">
    <view class="hero">
      <view class="eyebrow">第一步 · 基础申请</view>
      <view class="hero-title">成为 Talk&amp;Talk 陪伴者</view>
      <view class="hero-copy">基础资料只会进入待审核状态，不会自动获得商用资格或公开展示。</view>
    </view>
    <view class="card form-card">
      <view class="field-label">公开身份/角色</view>
      <input class="field" value="{{application.role}}" data-field="role" bindinput="setApplicationField" placeholder="例如：生活陪伴者" />
      <view class="field-label">自我介绍</view>
      <textarea class="textarea" value="{{application.bio}}" data-field="bio" bindinput="setApplicationField" maxlength="500" placeholder="介绍你的陪伴方式、经验和边界" />
      <view class="two-column">
        <view>
          <view class="field-label">每30分钟价格（元）</view>
          <input class="field" type="digit" value="{{application.priceYuan}}" data-field="priceYuan" bindinput="setApplicationField" />
        </view>
        <view>
          <view class="field-label">所在城市/区域</view>
          <input class="field" value="{{application.cityDistrict}}" data-field="cityDistrict" bindinput="setApplicationField" />
        </view>
      </view>
      <view class="field-label">标签（逗号分隔）</view>
      <input class="field" value="{{application.tags}}" data-field="tags" bindinput="setApplicationField" placeholder="耐心，夜间可约" />
      <view class="field-label">擅长话题（逗号分隔）</view>
      <input class="field" value="{{application.specialties}}" data-field="specialties" bindinput="setApplicationField" placeholder="职场，人际关系" />
      <view class="field-label">语言（逗号分隔）</view>
      <input class="field" value="{{application.languages}}" data-field="languages" bindinput="setApplicationField" />
      <view class="field-label">大致可服务时间（逗号分隔）</view>
      <input class="field" value="{{application.availableTimes}}" data-field="availableTimes" bindinput="setApplicationField" placeholder="工作日晚间，周末" />
      <view wx:if="{{error}}" class="form-error">{{error}}</view>
      <button class="primary-button submit" loading="{{saving}}" disabled="{{saving}}" bindtap="submitApplication">提交基础申请</button>
    </view>
  </block>

  <block wx:else>
    <view class="hero">
      <view class="eyebrow">陪伴者生命周期</view>
      <view class="hero-title">{{overview.companion.name}}</view>
      <view class="hero-copy">公开状态：{{overview.companion.isPublished ? '已发布' : '未发布'}} · {{statusText}}</view>
      <view wx:if="{{overview.commercialProfile.suspendedReason}}" class="warning">
        暂停原因：{{overview.commercialProfile.suspendedReason}}
      </view>
      <view class="muted">
        成年资格：
        {{overview.commercialProfile.adultEligibility.verdict === 'adult' ? '已核验成年' : overview.commercialProfile.adultEligibility.verdict === 'ineligible' ? '不满足成年资格' : '待独立核验'}}
        <text wx:if="{{overview.commercialProfile.adultEligibility.validUntil}}"> · 有效至 {{overview.commercialProfile.adultEligibility.validUntil}}</text>
      </view>
    </view>

    <view class="section-title">公开资料</view>
    <view class="card form-card">
      <view class="field-label">公开身份/角色</view>
      <input class="field" value="{{profile.role}}" data-field="role" bindinput="setProfileField" />
      <view class="field-label">自我介绍</view>
      <textarea class="textarea" value="{{profile.bio}}" data-field="bio" bindinput="setProfileField" maxlength="500" />
      <view class="field-label">真实经历（可选，不得包含第三方隐私）</view>
      <textarea class="textarea compact" value="{{profile.livedExperience}}" data-field="livedExperience" bindinput="setProfileField" maxlength="500" />
      <view class="field-label">明确不能提供的服务（逗号分隔）</view>
      <input class="field" value="{{profile.serviceBoundaries}}" data-field="serviceBoundaries" bindinput="setProfileField" placeholder="医疗诊断，紧急救援，站外交易" />
      <view class="field-label">语言</view>
      <input class="field" value="{{profile.languages}}" data-field="languages" bindinput="setProfileField" />
      <view class="field-label">擅长话题</view>
      <input class="field" value="{{profile.specialties}}" data-field="specialties" bindinput="setProfileField" />
      <view class="field-label">城市/区域</view>
      <input class="field" value="{{profile.cityDistrict}}" data-field="cityDistrict" bindinput="setProfileField" />

      <view class="subsection">语音介绍元数据</view>
      <view class="status-line">审核状态：{{overview.companion.voiceIntro.status}}</view>
      <view class="hint">这里只接受受控媒体服务生成的外部引用；不会把本地路径或未审核音频当作已上线内容。</view>
      <input class="field" value="{{profile.voiceIntroAssetRef}}" data-field="voiceIntroAssetRef" bindinput="setProfileField" placeholder="外部媒体引用，例如 media/audio/..." />
      <input class="field" type="number" value="{{profile.voiceIntroDurationSeconds}}" data-field="voiceIntroDurationSeconds" bindinput="setProfileField" placeholder="时长（秒，1–600）" />
      <button class="primary-button submit" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">保存并提交资料审核</button>
    </view>

    <view class="section-title">身份、协议与结算资料</view>
    <view class="card form-card">
      <view class="status-row">
        <view>
          <view class="status-title">{{statusText}}</view>
          <view class="muted">协议：{{overview.commercialProfile.serviceAgreementVersion || '未提交'}}</view>
        </view>
        <view class="status-badge status-{{overview.commercialProfile.status}}">{{overview.commercialProfile.status}}</view>
      </view>
      <view class="privacy-notice">
        不要填写身份证号、出生日期、证件照片、银行卡号或税务原文。平台只保存真实 KYC 的成年结论、有效期、签约/结算供应商返回的不可猜测外部引用，以及可展示的掩码。
      </view>
      <view class="field-label">结算接收方外部引用</view>
      <input class="field" password value="{{commercial.settlementRecipientRef}}" data-field="settlementRecipientRef" bindinput="setCommercialField" placeholder="供应商生成的 recipient reference" />
      <view class="field-label">结算接收方掩码</view>
      <input class="field" value="{{commercial.settlementRecipientMasked}}" data-field="settlementRecipientMasked" bindinput="setCommercialField" placeholder="例如：微信账户 **1234" />
      <view class="field-label">税务档案外部引用</view>
      <input class="field" password value="{{commercial.taxProfileRef}}" data-field="taxProfileRef" bindinput="setCommercialField" />
      <view class="field-label">实名核验外部证据引用</view>
      <input class="field" password value="{{commercial.identityEvidenceRef}}" data-field="identityEvidenceRef" bindinput="setCommercialField" />
      <view class="field-label">服务协议版本</view>
      <input class="field" value="{{commercial.serviceAgreementVersion}}" data-field="serviceAgreementVersion" bindinput="setCommercialField" placeholder="例如：2026.1" />
      <view class="field-label">协议签署外部证据引用</view>
      <input class="field" password value="{{commercial.serviceAgreementEvidenceRef}}" data-field="serviceAgreementEvidenceRef" bindinput="setCommercialField" />
      <view wx:if="{{error}}" class="form-error">{{error}}</view>
      <button class="primary-button submit" loading="{{saving}}" disabled="{{saving}}" bindtap="submitCommercialProfile">提交人工复核</button>
      <button class="secondary-button" bindtap="openTraining">继续培训与考试</button>
    </view>
  </block>
</view>
