.intro-card { margin-bottom: 20rpx; padding: 30rpx; border-radius: 24rpx; background: linear-gradient(135deg, #fff, #fff0f3); box-shadow: 0 8rpx 24rpx rgba(96, 50, 60, 0.07); }
.create-button { margin-top: 22rpx; font-size: 28rpx; }
.workbench-actions { display: flex; gap: 16rpx; margin-top: 22rpx; }
.workbench-actions .create-button { flex: 1; margin-top: 0; }
.availability-button { flex: 1; margin-top: 0; line-height: 84rpx; }
.access-empty { line-height: 1.7; }
.access-title { color: #4b353a; font-size: 34rpx; font-weight: 700; }
.retry-button { margin-top: 28rpx; }
.catalog-empty { padding-top: 62rpx; padding-bottom: 62rpx; line-height: 1.7; }
.offering-card { margin-bottom: 18rpx; }
.offering-head { display: flex; align-items: flex-start; gap: 18rpx; }
.offering-main { flex: 1; min-width: 0; }
.offering-title { color: #2d2023; font-size: 33rpx; font-weight: 700; word-break: break-all; }
.status-chip { flex: none; padding: 8rpx 14rpx; border-radius: 999rpx; font-size: 23rpx; }
.status-chip.active { background: #e8f7ef; color: #258256; }
.status-chip.paused { background: #f5eef0; color: #8d6e73; }
.description { margin-top: 18rpx; color: #4b353a; font-size: 28rpx; line-height: 1.65; white-space: pre-wrap; }
.topic-line { margin-top: 16rpx; color: #8d6e73; font-size: 25rpx; line-height: 1.5; }
.offering-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.plain-button { margin: 0; padding: 0 20rpx; background: #f9edef; color: #a43f5c; font-size: 26rpx; line-height: 64rpx; }
.plain-button[disabled] { color: #bca4aa; background: #f5f0f1; }
.action-button { min-width: 104rpx; }
.direction-button { min-width: 92rpx; }
.editor-mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; background: rgba(45, 32, 35, 0.42); }
.editor-sheet { box-sizing: border-box; width: 100%; max-height: 90vh; padding: 30rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #fff8f8; }
.editor-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.small { font-size: 34rpx; }
.close-button { margin: 0; padding: 0; background: transparent; color: #8d6e73; font-size: 27rpx; }
.editor-tip { margin-top: 16rpx; padding: 16rpx 18rpx; border-radius: 14rpx; background: #fff0d6; color: #855f25; font-size: 24rpx; line-height: 1.55; }
.field-label { margin-top: 28rpx; color: #584147; font-size: 28rpx; font-weight: 700; }
.compact-label { margin-top: 0; }
input, textarea, .picker { box-sizing: border-box; width: 100%; margin-top: 14rpx; padding: 18rpx; border: 1rpx solid #edd7dc; border-radius: 14rpx; background: #fff; color: #2d2023; font-size: 28rpx; }
textarea { min-height: 172rpx; line-height: 1.55; }
.field-hint { margin-top: 10rpx; color: #8d6e73; font-size: 23rpx; line-height: 1.5; }
.mode-options { display: flex; gap: 16rpx; margin-top: 14rpx; }
.mode-button { flex: 1; margin: 0; padding: 0; border: 1rpx solid #ead4d9; background: #fff; color: #765b60; font-size: 27rpx; line-height: 76rpx; }
.mode-button.selected { border-color: #b94a68; background: #fce8ed; color: #a43f5c; }
.topic-choices { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.topic-choice { padding: 10rpx 16rpx; border: 1rpx solid #ead4d9; border-radius: 999rpx; color: #765b60; font-size: 25rpx; }
.topic-choice.selected { border-color: #b94a68; background: #fce8ed; color: #a43f5c; }
.publish-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 32rpx; padding: 22rpx 0; border-top: 1rpx solid #f0dfe3; border-bottom: 1rpx solid #f0dfe3; }
.publish-row > view { flex: 1; }
.form-error { margin-top: 22rpx; padding: 16rpx; border-radius: 12rpx; background: #fff0f2; color: #a53c55; font-size: 25rpx; line-height: 1.55; }
.editor-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.cancel-button, .save-button { flex: 1; margin: 0; }
.cancel-button { line-height: 84rpx; }
