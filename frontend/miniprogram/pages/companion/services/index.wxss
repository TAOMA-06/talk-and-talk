.intro-card {
  margin-bottom: 20rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--tt-accent-soft);
  box-shadow: none;
  border: 1rpx solid var(--tt-border);
}

.create-button {
  margin-top: 22rpx;
  font-size: 28rpx;
}

.workbench-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.workbench-actions .create-button {
  flex: 1;
  margin-top: 0;
}

.availability-button {
  flex: 1;
  margin-top: 0;
  line-height: 84rpx;
}

.access-empty {
  line-height: 1.7;
}

.access-title {
  color: var(--tt-danger);
  font-size: 34rpx;
  font-weight: 700;
}

.retry-button {
  margin-top: 28rpx;
}

.catalog-empty {
  padding-top: 62rpx;
  padding-bottom: 62rpx;
  line-height: 1.7;
}

.offering-card {
  margin-bottom: 18rpx;
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
}

.offering-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.offering-main {
  flex: 1;
  min-width: 0;
}

.offering-title {
  color: var(--tt-danger);
  font-size: 33rpx;
  font-weight: 700;
  word-break: break-all;
}

.status-chip {
  flex: none;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.status-chip.active {
  background: var(--tt-success-soft);
  color: var(--tt-success);
}

.status-chip.paused {
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
}

.description {
  margin-top: 18rpx;
  color: var(--tt-text);
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.topic-line {
  margin-top: 16rpx;
  color: var(--tt-text-secondary);
  font-size: 25rpx;
  line-height: 1.5;
}

.offering-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.plain-button {
  margin: 0;
  padding: 0 20rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-accent);
  font-size: 26rpx;
  line-height: 64rpx;
}

.plain-button[disabled] {
  color: var(--tt-text-tertiary);
  background: var(--tt-surface-alt);
  border-color: var(--tt-border);
}

.action-button {
  min-width: 104rpx;
}

.direction-button {
  min-width: 92rpx;
}

.catalog-pagination {
  margin: 18rpx 0 10rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  text-align: center;
}

.catalog-pagination-error {
  margin: 12rpx 0;
  color: var(--tt-danger);
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}

.load-more-button {
  width: 100%;
  margin: 14rpx 0 24rpx;
}

.editor-mask {
  position: fixed;
  z-index: 10;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(32, 33, 36, 0.48);
}

.editor-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 90vh;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--tt-surface);
}

.editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.small {
  font-size: 34rpx;
}

.close-button {
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--tt-text-secondary);
  font-size: 27rpx;
}

.editor-tip {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  font-size: 24rpx;
  line-height: 1.55;
}

.field-label {
  margin-top: 28rpx;
  color: var(--tt-accent);
  font-size: 28rpx;
  font-weight: 700;
}

.compact-label {
  margin-top: 0;
}

input, textarea, .picker {
  box-sizing: border-box;
  width: 100%;
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid var(--tt-danger-soft);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-text);
  font-size: 28rpx;
  border-color: var(--tt-border);
}

textarea {
  min-height: 172rpx;
  line-height: 1.55;
}

.field-hint {
  margin-top: 10rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.mode-options {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.mode-button {
  flex: 1;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--tt-danger-soft);
  background: var(--tt-surface);
  color: var(--tt-text-secondary);
  font-size: 27rpx;
  line-height: 76rpx;
  min-height: 80rpx;
  border-color: var(--tt-border);
}

.mode-button.selected {
  border-color: var(--tt-accent);
  background: var(--tt-border);
  color: var(--tt-accent);
}

.topic-choices {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.topic-choice {
  padding: 10rpx 16rpx;
  border: 1rpx solid var(--tt-danger-soft);
  border-radius: 999rpx;
  color: var(--tt-text-secondary);
  font-size: 25rpx;
  border-color: var(--tt-border);
}

.topic-choice.selected {
  border-color: var(--tt-accent);
  background: var(--tt-border);
  color: var(--tt-accent);
}

.publish-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 32rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--tt-danger-soft);
  border-bottom: 1rpx solid var(--tt-danger-soft);
  border-color: var(--tt-border);
}

.publish-row > view {
  flex: 1;
}

.form-error {
  margin-top: 22rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 25rpx;
  line-height: 1.55;
}

.editor-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.cancel-button, .save-button {
  flex: 1;
  margin: 0;
  min-height: 88rpx;
  border-radius: 14rpx;
}

.cancel-button {
  line-height: 84rpx;
}

.topic-state-error {
  margin-top: 10rpx;
  padding: 14rpx;
  border-left: 5rpx solid var(--tt-danger);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 23rpx;
  line-height: 1.6;
}

.topic-retry {
  width: 100%;
  margin: 12rpx 0 0;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 23rpx;
}

.topic-retry::after {
  border: 0;
}

.primary-button {
  min-height: 88rpx;
}

.access-title, .offering-title, .field-label, .small {
  color: var(--tt-text);
  font-weight: 700;
}

.topic-line, .catalog-pagination, .field-hint, .close-button {
  color: var(--tt-text-tertiary);
}

.plain-button, .availability-button, .topic-retry {
  min-height: 72rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
}

.catalog-pagination-error, .form-error, .topic-state-error {
  border-color: var(--tt-border);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.load-more-button, .create-button {
  min-height: 88rpx;
}

.mode-button.selected, .topic-choice.selected {
  border-color: var(--tt-accent);
  background: var(--tt-accent-soft);
  color: var(--tt-accent);
}

.save-button.button-hover, .primary-button.button-hover {
  background: var(--tt-accent-pressed);
}

.save-button[disabled], .primary-button[disabled], .plain-button[disabled] {
  opacity: 0.52;
}
