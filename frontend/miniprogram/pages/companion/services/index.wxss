.services-page { padding-top: 22rpx; overflow-x: hidden; }
.service-studio { position: relative; margin: 0 -8rpx 22rpx; padding: 8rpx 8rpx 0; }
.service-studio::before { content: ""; position: absolute; top: 80rpx; left: -112rpx; width: 320rpx; height: 320rpx; border: 1rpx solid var(--tt-color-pastel-apricot-stroke); border-radius: 50%; opacity: .4; pointer-events: none; }
.service-sign { position: relative; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0 10rpx 2rpx; color: var(--tt-text-tertiary); font-size: 19rpx; font-weight: 800; letter-spacing: 1.8rpx; }
.service-count { flex: none; padding: 6rpx 13rpx; border: 1rpx solid var(--tt-color-pastel-blue-stroke); border-radius: 999rpx; background: var(--tt-color-pastel-blue-bg); color: var(--tt-color-pastel-blue-fg); letter-spacing: 0; }
.service-layer { width: 100%; }
.service-stage-card,.intro-card { box-sizing: border-box; min-height: 320rpx; padding: 32rpx; border: 1rpx solid; border-radius: 32rpx; overflow: hidden; }
.service-stage-card { position: relative; display: flex; flex-direction: column; justify-content: flex-end; }
.service-stage-draft { border-color: var(--tt-color-pastel-mint-stroke); background: var(--tt-color-pastel-mint-bg); color: var(--tt-color-pastel-mint-fg); }
.service-stage-calendar { border-color: var(--tt-color-pastel-butter-stroke); background: var(--tt-color-pastel-butter-bg); color: var(--tt-color-pastel-butter-fg); }
.stage-index { position: absolute; top: 28rpx; right: 30rpx; font-size: 19rpx; font-weight: 800; letter-spacing: 1.6rpx; }
.stage-title { width: 68%; font-size: 29rpx; font-weight: 750; line-height: 1.34; }
.stage-copy { width: 68%; margin-top: 10rpx; font-size: 21rpx; }
.service-props { display: flex; align-items: flex-end; gap: 2rpx; }
.intro-card {
  padding: 32rpx;
  background: var(--tt-color-pastel-blue-bg);
  border: 1rpx solid var(--tt-color-pastel-blue-stroke);
  color: var(--tt-color-pastel-blue-fg);
}

.create-button {
  margin-top: 22rpx;
  font-size: 28rpx;
}

.workbench-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.workbench-actions .create-button {
  flex: 1;
  margin-top: 0;
}

.availability-button {
  flex: 1;
  margin-top: 0;
  line-height: 84rpx;
}

.access-empty {
  line-height: 1.7;
}

.access-title {
  color: var(--tt-danger);
  font-size: 34rpx;
  font-weight: 700;
}

.retry-button {
  margin-top: 28rpx;
}

.catalog-empty {
  padding-top: 62rpx;
  padding-bottom: 62rpx;
  line-height: 1.7;
}

.offering-card {
  min-width: 0;
}
.offering-item { margin-bottom: 20rpx; }

.offering-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.offering-main {
  flex: 1;
  min-width: 0;
}

.offering-title {
  color: currentColor;
  font-size: 33rpx;
  font-weight: 700;
  word-break: break-all;
}

.status-chip {
  flex: none;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.status-chip.active {
  background: var(--tt-success-soft);
  color: var(--tt-success);
}

.status-chip.paused {
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
}

.description {
  margin-top: 18rpx;
  color: currentColor;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.topic-line {
  margin-top: 16rpx;
  color: currentColor;
  font-size: 25rpx;
  line-height: 1.5;
}
.offering-card .muted,.offering-card .topic-line,.offering-card .description { color: currentColor; }

.offering-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.plain-button {
  margin: 0;
  padding: 0 20rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-accent);
  font-size: 26rpx;
  line-height: 64rpx;
}

.plain-button[disabled] {
  color: var(--tt-text-tertiary);
  background: var(--tt-surface-alt);
  border-color: var(--tt-border);
}

.action-button {
  min-width: 104rpx;
}

.direction-button {
  min-width: 92rpx;
}

.catalog-pagination {
  margin: 18rpx 0 10rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  text-align: center;
}

.catalog-pagination-error {
  margin: 12rpx 0;
  color: var(--tt-danger);
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}

.load-more-button {
  width: 100%;
  margin: 14rpx 0 24rpx;
}

.editor-mask {
  position: fixed;
  z-index: 10;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: var(--tt-overlay-scrim);
}

.editor-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 90vh;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--tt-surface);
}

.editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.small {
  font-size: 34rpx;
}

.close-button {
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--tt-text-secondary);
  font-size: 27rpx;
}

.editor-tip {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  font-size: 24rpx;
  line-height: 1.55;
}

.field-label {
  margin-top: 28rpx;
  color: var(--tt-accent);
  font-size: 28rpx;
  font-weight: 700;
}

.compact-label {
  margin-top: 0;
}

input, textarea, .picker {
  box-sizing: border-box;
  width: 100%;
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid var(--tt-danger-soft);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-text);
  font-size: 28rpx;
  border-color: var(--tt-border);
}

textarea {
  min-height: 172rpx;
  line-height: 1.55;
}

.field-hint {
  margin-top: 10rpx;
  color: var(--tt-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.mode-options {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.mode-button {
  flex: 1;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--tt-danger-soft);
  background: var(--tt-surface);
  color: var(--tt-text-secondary);
  font-size: 27rpx;
  line-height: 76rpx;
  min-height: 80rpx;
  border-color: var(--tt-border);
}

.mode-button.selected {
  border-color: var(--tt-accent);
  background: var(--tt-border);
  color: var(--tt-accent);
}

.topic-choices {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.topic-choice {
  padding: 10rpx 16rpx;
  border: 1rpx solid var(--tt-danger-soft);
  border-radius: 999rpx;
  color: var(--tt-text-secondary);
  font-size: 25rpx;
  border-color: var(--tt-border);
}

.topic-choice.selected {
  border-color: var(--tt-accent);
  background: var(--tt-border);
  color: var(--tt-accent);
}

.publish-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 32rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--tt-danger-soft);
  border-bottom: 1rpx solid var(--tt-danger-soft);
  border-color: var(--tt-border);
}

.publish-row > view {
  flex: 1;
}

.form-error {
  margin-top: 22rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 25rpx;
  line-height: 1.55;
}

.editor-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.cancel-button, .save-button {
  flex: 1;
  margin: 0;
  min-height: 88rpx;
  border-radius: 14rpx;
}

.cancel-button {
  line-height: 84rpx;
}

.topic-state-error {
  margin-top: 10rpx;
  padding: 14rpx;
  border-left: 5rpx solid var(--tt-danger);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 23rpx;
  line-height: 1.6;
}

.topic-retry {
  width: 100%;
  margin: 12rpx 0 0;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 23rpx;
}

.topic-retry::after {
  border: 0;
}

.primary-button {
  min-height: 88rpx;
}

.access-title, .offering-title, .field-label, .small {
  color: var(--tt-text);
  font-weight: 700;
}

.topic-line, .catalog-pagination, .field-hint, .close-button {
  color: var(--tt-text-tertiary);
}

.plain-button, .availability-button, .topic-retry {
  min-height: 72rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
}

.catalog-pagination-error, .form-error, .topic-state-error {
  border-color: var(--tt-border);
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.load-more-button, .create-button {
  min-height: 88rpx;
}

.mode-button.selected, .topic-choice.selected {
  border-color: var(--tt-accent);
  background: var(--tt-accent-soft);
  color: var(--tt-accent);
}

.save-button.button-hover, .primary-button.button-hover {
  background: var(--tt-accent-pressed);
}

.save-button[disabled], .primary-button[disabled], .plain-button[disabled] {
  opacity: 0.52;
}

.intro-card .tt-kicker,.intro-card .title,.intro-card .muted { color: currentColor; }

@media (prefers-reduced-motion: reduce) {
  .service-studio::before { display: none; }
}
