<view class="page services-page {{motionOff ? 'tt-motion-off' : ''}}">
  <view wx:if="{{loading}}" class="empty">正在加载服务商品…</view>

  <view wx:elif="{{accessState === 'ineligible'}}" class="empty access-empty">
    <view class="access-title">暂不能管理服务商品</view>
    <view>{{loadError}}</view>
    <view class="muted">身份或资料审核未完成。</view>
    <button class="plain-button retry-button" bindtap="retry">重新检查</button>
  </view>

  <view wx:elif="{{accessState === 'error'}}" class="empty access-empty">
    <view class="access-title">加载失败</view>
    <view>{{loadError}}</view>
    <button class="primary-button retry-button" bindtap="retry">重新加载</button>
  </view>

  <view wx:else class="services-ready">
    <view class="service-studio tt-motion-m3">
      <view class="service-sign"><text>服务商品</text><text class="service-count">{{offeringTotal}} / 50</text></view>
      <tt-card-stage layout="deck" min-height="430" motion-level="m3" entrance="deal" active motion-off="{{motionOff}}" risk="standard" aria-label="服务草稿、可约时段与上架规则卡组">
        <view slot="back" class="service-layer">
          <view class="service-stage-card service-stage-draft"><view class="stage-index">02</view><view class="stage-title">草稿</view></view>
        </view>
        <view slot="middle" class="service-layer" bindtap="openAvailabilityWindows" aria-role="button" aria-label="查看可约时段" tabindex="0">
          <view class="service-stage-card service-stage-calendar"><view class="stage-index">03</view><view class="stage-title">可约时段</view></view>
        </view>
        <view slot="front" class="service-layer">
          <view class="intro-card">
            <view class="tt-kicker">01</view>
            <view class="title">服务管理</view>
            <view class="muted">仅已上架服务对客户可见。</view>
            <view class="workbench-actions">
              <button class="primary-button create-button" disabled="{{offeringTotal >= 50}}" bindtap="openCreate">{{offeringTotal >= 50 ? '已达 50 项上限' : '新建服务'}}</button>
              <button class="plain-button availability-button" bindtap="openAvailabilityWindows">查看可约时段</button>
            </view>
          </view>
        </view>
        <view slot="prop" class="service-props"><tt-cartoon-prop kind="folder" tone="apricot" size="lg" expressive motion-off="{{motionOff}}" risk="standard" /><tt-cartoon-prop kind="calendar" tone="butter" size="md" expressive motion-off="{{motionOff}}" risk="standard" /></view>
      </tt-card-stage>
    </view>

    <view wx:if="{{!offerings.length}}" class="empty catalog-empty">
      <view class="access-title">暂无服务商品</view>
    </view>

    <view wx:for="{{offerings}}" wx:key="id" class="offering-item">
      <tt-card-shell tone="{{index % 3 === 0 ? 'apricot' : index % 3 === 1 ? 'blue' : 'mint'}}" size="standard" depth="mid" motion-level="m1" entrance="none" motion-off="{{motionOff}}" risk="standard">
      <view class="offering-card">
      <view class="offering-head">
        <view class="offering-main">
          <view class="offering-title">{{item.title}}</view>
          <view class="muted">{{item.deliveryModeText}} · {{item.durationMinutes}} 分钟 · {{item.priceText}}</view>
        </view>
        <view class="status-chip {{item.isActive ? 'active' : 'paused'}}">{{item.statusText}}</view>
      </view>
      <view wx:if="{{item.description}}" class="description">{{item.description}}</view>
      <view class="topic-line">关联主题：{{item.topicText}}</view>
      <view class="offering-actions">
        <button class="plain-button action-button" bindtap="editOffering" data-id="{{item.id}}">编辑</button>
        <button wx:if="{{item.isActive || item.deliveryMode === 'text' || voiceDeliveryModeAvailable}}" class="plain-button action-button" loading="{{changingOfferingId === item.id}}" bindtap="toggleOfferingActive" data-id="{{item.id}}">{{item.isActive ? '暂停' : '上架'}}</button>
        <view wx:else class="muted">首发仅开放文字服务，历史语音服务不能上架。</view>
        <button class="plain-button direction-button" disabled="{{!item.canMoveUp || reorderingId !== '' || offerings.length < offeringTotal}}" loading="{{reorderingId === item.id}}" bindtap="moveOffering" data-id="{{item.id}}" data-direction="-1">上移</button>
        <button class="plain-button direction-button" disabled="{{!item.canMoveDown || reorderingId !== '' || offerings.length < offeringTotal}}" loading="{{reorderingId === item.id}}" bindtap="moveOffering" data-id="{{item.id}}" data-direction="1">下移</button>
      </view>
      </view>
      </tt-card-shell>
    </view>
    <view wx:if="{{offerings.length}}" class="catalog-pagination">{{offerings.length}} / {{offeringTotal}}</view>
    <view wx:if="{{offeringsLoadMoreError}}" class="catalog-pagination-error" aria-live="polite">{{offeringsLoadMoreError}}</view>
    <button wx:if="{{offeringPage < offeringTotalPages}}" class="plain-button load-more-button" loading="{{offeringsLoadingMore}}" disabled="{{offeringsLoadingMore}}" bindtap="loadMoreOfferings">{{offeringsLoadMoreError ? '重试加载更多' : '加载更多服务商品'}}</button>
  </view>

  <view wx:if="{{editorVisible}}" class="editor-mask">
    <scroll-view scroll-y="true" class="editor-sheet">
      <view class="editor-header">
        <view class="title small">{{editingId ? '编辑服务' : '新建服务'}}</view>
        <button class="close-button" disabled="{{saving}}" bindtap="closeEditor">关闭</button>
      </view>
      <view class="editor-tip">仅描述平台内可履约服务。</view>

      <view class="field-label">服务名称</view>
      <input value="{{formTitle}}" maxlength="80" placeholder="例如：30 分钟文字倾听" bindinput="setFormTitle" />

      <view class="field-label">服务介绍（可选）</view>
      <textarea value="{{formDescription}}" maxlength="500" placeholder="说明服务形式、适合的场景和边界" bindinput="setFormDescription" />

      <view class="field-label">服务方式</view>
      <view class="mode-options">
        <button class="mode-button {{formDeliveryMode === 'text' ? 'selected' : ''}}" bindtap="setFormDeliveryMode" data-mode="text">文字服务</button>
        <button wx:if="{{voiceDeliveryModeAvailable}}" class="mode-button {{formDeliveryMode === 'voice' ? 'selected' : ''}}" bindtap="setFormDeliveryMode" data-mode="voice">语音服务</button>
      </view>

      <view class="field-label">服务时长</view>
      <picker mode="selector" range="{{durationOptions}}" value="{{formDurationIndex}}" bindchange="setFormDuration">
        <view class="picker">{{durationOptions[formDurationIndex]}} 分钟</view>
      </picker>

      <view class="field-label">价格（元）</view>
      <input value="{{formPriceYuan}}" type="digit" placeholder="例如 39 或 39.90" bindinput="setFormPrice" />
      <view class="field-hint">¥1.00–¥20,000.00</view>

      <view class="field-label">关联主题（可选，最多 6 个）</view>
      <view wx:if="{{topicsState === 'loading'}}" class="field-hint" aria-live="polite">正在读取服务主题…</view>
      <view wx:elif="{{topicsState === 'error'}}" class="topic-state-error" aria-live="polite">
        <view>{{topicsError}}</view>
        <button class="topic-retry" bindtap="retryTopics" aria-label="重新读取服务主题">重新读取主题</button>
      </view>
      <view wx:elif="{{topicsState === 'available'}}" class="topic-choices">
        <view wx:for="{{topicChoices}}" wx:key="id" class="topic-choice {{item.selected ? 'selected' : ''}}" bindtap="toggleFormTopic" data-id="{{item.id}}" aria-role="checkbox" aria-checked="{{item.selected}}" aria-label="服务主题：{{item.name}}" tabindex="0">{{item.name}}</view>
      </view>
      <view wx:else class="field-hint">暂无可选主题</view>

      <view class="publish-row">
        <view><view class="field-label compact-label">立即上架</view><view class="field-hint">关闭则保存为草稿，客户不可见。</view></view>
        <switch checked="{{formActive}}" color="#292724" bindchange="setFormActive" aria-label="{{formActive ? '停用' : '启用'}}当前服务商品" />
      </view>

      <view wx:if="{{formError}}" class="form-error">{{formError}}</view>
      <view class="editor-actions">
        <button class="plain-button cancel-button" disabled="{{saving}}" bindtap="closeEditor">取消</button>
        <button class="primary-button save-button" loading="{{saving}}" bindtap="saveEditor">{{formActive ? '保存并上架' : '保存草稿'}}</button>
      </view>
    </scroll-view>
  </view>
</view>
