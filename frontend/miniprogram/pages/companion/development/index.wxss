.hero {
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--tt-accent-soft);
  box-shadow: none;
  border: 1rpx solid var(--tt-border);
}

.eyebrow {
  color: var(--tt-accent);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.hero-copy {
  margin-top: 14rpx;
  color: var(--tt-accent);
  font-size: 25rpx;
  line-height: 1.6;
}

.restriction {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  font-size: 24rpx;
  line-height: 1.55;
  border: 1rpx solid var(--tt-border);
}

.section-title {
  margin: 34rpx 4rpx 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.inline-error {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 24rpx;
  border: 1rpx solid var(--tt-border);
}

.module-card {
  padding: 28rpx;
}

.module-head, .action-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.module-main {
  flex: 1;
  min-width: 0;
}

.module-title, .action-title {
  font-size: 30rpx;
  font-weight: 700;
}

.module-summary, .action-message {
  margin-top: 10rpx;
  color: var(--tt-text);
  font-size: 24rpx;
  line-height: 1.55;
}

.module-status, .action-state {
  flex: none;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 22rpx;
}

.status-passed {
  background: var(--tt-success-soft);
  color: var(--tt-success);
}

.status-expired, .action-state.active {
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.module-meta, .module-score, .action-time, .action-code {
  margin-top: 14rpx;
  color: var(--tt-accent);
  font-size: 22rpx;
  line-height: 1.5;
}

.questions {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--tt-accent-soft);
  border-color: var(--tt-border);
}

.question + .question {
  margin-top: 28rpx;
}

.question-title {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.option {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
  color: var(--tt-text);
  font-size: 25rpx;
  line-height: 1.45;
}

.quality-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.quality-card {
  padding: 24rpx;
  border-radius: 22rpx;
  background: var(--tt-surface);
  box-shadow: none;
}

.quality-label {
  color: var(--tt-text-secondary);
  font-size: 23rpx;
}

.quality-value {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.quality-note {
  margin-top: 8rpx;
  color: var(--tt-danger);
  font-size: 21rpx;
}

.quality-detail {
  color: var(--tt-text);
  font-size: 24rpx;
  line-height: 1.75;
}

.limitation {
  margin-top: 10rpx;
  color: var(--tt-danger);
  line-height: 1.55;
}

.empty-card {
  color: var(--tt-text-secondary);
  font-size: 25rpx;
  line-height: 1.6;
}

.action-title {
  text-transform: capitalize;
}

.appeal-result {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: var(--tt-accent-soft);
  color: var(--tt-accent);
  font-size: 23rpx;
  line-height: 1.55;
}

.appeal-evidence-list, .evidence-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.evidence-open, .evidence-toolbar .secondary-button {
  width: auto;
  margin: 0;
}

.evidence-draft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: var(--tt-accent-soft);
  color: var(--tt-accent);
  font-size: 22rpx;
}

.evidence-draft .secondary-button {
  flex: 0 0 auto;
  width: auto;
  margin: 0;
}

.secondary-button {
  margin-top: 18rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
  min-height: 80rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(32, 33, 36, 0.48);
}

.modal {
  box-sizing: border-box;
  width: 100%;
  max-height: 88vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 28rpx 28rpx 0 0;
  background: var(--tt-surface);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
}

.modal-copy {
  margin: 14rpx 0 24rpx;
  color: var(--tt-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 220rpx;
  margin-bottom: 18rpx;
  padding: 20rpx;
  border: 1rpx solid var(--tt-border);
  border-radius: 14rpx;
  background: var(--tt-surface);
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--tt-text);
}

.textarea.compact {
  min-height: 150rpx;
}

.empty-title {
  margin-bottom: 14rpx;
  color: var(--tt-danger);
  font-size: 34rpx;
  font-weight: 700;
}

.retry {
  margin-top: 28rpx;
}

.primary-button {
  min-height: 88rpx;
}

.hero-title, .section-title, .module-title, .action-title, .question-title, .quality-value, .empty-title, .modal-title {
  color: var(--tt-text);
  font-weight: 700;
}

.hero-copy, .module-summary, .action-message, .quality-detail, .modal-copy {
  color: var(--tt-text-secondary);
}

.module-meta, .module-score, .action-time, .action-code, .quality-label, .quality-note, .limitation, .empty-card {
  color: var(--tt-text-tertiary);
}

.module-card, .quality-card {
  border: 1rpx solid var(--tt-border);
  border-radius: 20rpx;
  background: var(--tt-surface);
  box-shadow: none;
}

.appeal-result, .evidence-draft {
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
}

.primary-button.button-hover {
  background: var(--tt-accent-pressed);
}

.primary-button[disabled], .secondary-button[disabled] {
  opacity: 0.52;
}
