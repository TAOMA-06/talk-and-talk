.intro-card { margin-bottom: 24rpx; padding: 30rpx; border-radius: 24rpx; background: linear-gradient(135deg, #fff, #fff0f3); box-shadow: 0 8rpx 24rpx rgba(96, 50, 60, 0.07); }
.summary { margin-top: 18rpx; color: #8d6e73; font-size: 24rpx; line-height: 1.55; }
.create-button { margin-top: 22rpx; font-size: 28rpx; }
.section-title { margin: 30rpx 0 16rpx; color: #4b353a; font-size: 33rpx; font-weight: 700; }
.window-card { margin-bottom: 16rpx; }
.window-card.subdued { background: #fdfafb; }
.window-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.date-label { color: #584147; font-size: 29rpx; font-weight: 700; }
.time-label { margin-top: 10rpx; color: #2d2023; font-size: 34rpx; font-weight: 700; }
.window-meta { margin-top: 18rpx; color: #8d6e73; font-size: 25rpx; }
.window-actions { display: flex; gap: 12rpx; margin-top: 22rpx; }
.edit-button { min-width: 104rpx; line-height: 68rpx; font-size: 25rpx; }
.retire-button { min-width: 142rpx; line-height: 68rpx; font-size: 25rpx; }
.status-chip { flex: none; padding: 8rpx 14rpx; border-radius: 999rpx; font-size: 23rpx; }
.status-chip.active { background: #e8f7ef; color: #258256; }
.status-chip.inProgress { background: #fff1d6; color: #94651e; }
.status-chip.expired, .status-chip.retired { background: #f3ecee; color: #8d6e73; }
.access-empty { line-height: 1.7; }
.access-title { color: #4b353a; font-size: 34rpx; font-weight: 700; }
.retry-button { margin-top: 28rpx; }
.plain-button { margin: 0; padding: 0 22rpx; background: #f9edef; color: #a43f5c; font-size: 27rpx; line-height: 82rpx; }
.calendar-empty { padding-top: 62rpx; padding-bottom: 62rpx; line-height: 1.7; }
.action-error { margin: 0 0 22rpx; padding: 18rpx; border-radius: 16rpx; background: #fff0f2; color: #a53c55; font-size: 25rpx; line-height: 1.6; }
.editor-mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; background: rgba(45, 32, 35, 0.42); }
.editor-sheet { box-sizing: border-box; width: 100%; max-height: 90vh; padding: 30rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #fff8f8; }
.editor-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.small { font-size: 34rpx; }
.close-button { margin: 0; padding: 0; background: transparent; color: #8d6e73; font-size: 27rpx; }
.editor-tip { margin-top: 16rpx; padding: 16rpx 18rpx; border-radius: 14rpx; background: #fff0d6; color: #855f25; font-size: 24rpx; line-height: 1.55; }
.field-label { margin-top: 28rpx; color: #584147; font-size: 28rpx; font-weight: 700; }
.compact-label { margin-top: 0; }
input, .picker { box-sizing: border-box; width: 100%; margin-top: 14rpx; padding: 18rpx; border: 1rpx solid #edd7dc; border-radius: 14rpx; background: #fff; color: #2d2023; font-size: 28rpx; }
.field-hint { margin-top: 10rpx; color: #8d6e73; font-size: 23rpx; line-height: 1.5; }
.publish-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 32rpx; padding: 22rpx 0; border-top: 1rpx solid #f0dfe3; border-bottom: 1rpx solid #f0dfe3; }
.publish-row > view { flex: 1; }
.form-error { margin-top: 22rpx; padding: 16rpx; border-radius: 12rpx; background: #fff0f2; color: #a53c55; font-size: 25rpx; line-height: 1.55; }
.editor-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.cancel-button, .save-button { flex: 1; margin: 0; }
.cancel-button { line-height: 84rpx; }

/* Restrained redesign */
.primary-button { min-height: 88rpx; }
.intro-card { padding: 32rpx; border: 1rpx solid #E4E6E8; border-radius: 28rpx; background: #F6ECEF; box-shadow: none; }
.summary, .window-meta, .field-hint, .close-button { color: #8A9098; }
.section-title, .date-label, .time-label, .access-title, .field-label, .small { color: #202124; font-weight: 700; }
.window-card { border: 1rpx solid #E4E6E8; background: #FFFFFF; }
.window-card.subdued { background: #F7F7F5; }
.status-chip { border-radius: 999rpx; }
.status-chip.active { background: #EDF6F1; color: #2F6B55; }
.status-chip.inProgress { background: #FAF4E8; color: #8A6426; }
.status-chip.expired, .status-chip.retired { background: #F1F2F3; color: #646970; }
.plain-button, .edit-button, .retire-button { min-height: 72rpx; border: 1rpx solid #D7BEC6; border-radius: 14rpx; background: #FFFFFF; color: #9B405B; }
.retire-button { border-color: #DFAEB3; background: #FAEEEE; color: #A33D45; }
.action-error, .form-error { border: 1rpx solid #E8C9CD; background: #FAEEEE; color: #A33D45; }
.create-button { min-height: 88rpx; }
.editor-mask { background: rgba(32, 33, 36, 0.48); }
.editor-sheet { max-height: 90vh; padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #FFFFFF; }
.editor-tip { background: #FAF4E8; color: #8A6426; }
input, .picker { border-color: #E4E6E8; background: #FFFFFF; color: #202124; }
.publish-row { border-color: #E4E6E8; }
.cancel-button, .save-button { min-height: 88rpx; border-radius: 14rpx; }
.save-button.button-hover, .primary-button.button-hover { background: #7F3248; }
.save-button[disabled], .primary-button[disabled], .plain-button[disabled], .retire-button[disabled] { opacity: 0.52; }
