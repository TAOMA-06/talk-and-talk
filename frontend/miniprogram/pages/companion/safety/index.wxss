.hero {
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--tt-accent-soft);
  box-shadow: none;
  border: 1rpx solid var(--tt-border);
}

.eyebrow {
  color: var(--tt-accent);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.hero-copy {
  margin-top: 14rpx;
  color: var(--tt-warning);
  font-size: 25rpx;
  line-height: 1.65;
}

.suspended {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  font-size: 24rpx;
  line-height: 1.55;
  border: 1rpx solid var(--tt-border);
}

.inline-error {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 24rpx;
  border: 1rpx solid var(--tt-border);
}

.section-title {
  margin: 34rpx 4rpx 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.form-card {
  padding: 28rpx;
}

.field {
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  margin-bottom: 16rpx;
  padding: 19rpx 20rpx;
  border: 2rpx solid var(--tt-warning-soft);
  border-radius: 15rpx;
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  font-size: 25rpx;
}

.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 210rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 2rpx solid var(--tt-warning-soft);
  border-radius: 15rpx;
  background: var(--tt-warning-soft);
  font-size: 25rpx;
  line-height: 1.55;
}

.textarea.compact {
  min-height: 140rpx;
}

.hint {
  margin: 4rpx 2rpx 22rpx;
  color: var(--tt-warning);
  font-size: 22rpx;
  line-height: 1.55;
}

.empty-card {
  color: var(--tt-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.incident-card, .ticket-card {
  padding: 26rpx;
}

.card-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.card-title {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
}

.status-chip {
  flex: none;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 21rpx;
}

.status-resolved .status-chip, .status-closed .status-chip {
  background: var(--tt-success-soft);
  color: var(--tt-success);
}

.card-meta, .evidence, .facts {
  margin-top: 11rpx;
  color: var(--tt-warning);
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.card-body {
  margin-top: 16rpx;
  color: var(--tt-warning);
  font-size: 25rpx;
  line-height: 1.6;
}

.resolution, .pending-note {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 13rpx;
  background: var(--tt-success-soft);
  color: var(--tt-success);
  font-size: 23rpx;
  line-height: 1.55;
}

.pending-note {
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
}

.secondary-button {
  margin-top: 18rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
  min-height: 80rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(32, 33, 36, 0.48);
}

.modal {
  box-sizing: border-box;
  width: 100%;
  padding: 32rpx 32rpx 48rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: var(--tt-surface);
  max-height: 88vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
}

.modal-copy {
  margin: 14rpx 0 24rpx;
  color: var(--tt-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-title {
  margin-bottom: 14rpx;
  color: var(--tt-danger);
  font-size: 34rpx;
  font-weight: 700;
}

.retry {
  margin-top: 28rpx;
}

.evidence-toolbar, .evidence-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 14rpx 0;
}

.evidence-toolbar button, .evidence-list button, .evidence-draft button {
  margin: 0;
}

.evidence-draft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 14rpx;
  margin: 8rpx 0;
  border-radius: 14rpx;
  background: var(--tt-surface-alt);
  font-size: 24rpx;
  border: 1rpx solid var(--tt-border);
  color: var(--tt-text-secondary);
}

.primary-button {
  min-height: 88rpx;
}

.hero-title, .section-title, .card-title, .empty-title, .modal-title {
  color: var(--tt-text);
  font-weight: 700;
}

.hero-copy, .card-body, .modal-copy {
  color: var(--tt-text-secondary);
}

.card-meta, .evidence, .facts, .hint, .empty-card {
  color: var(--tt-text-tertiary);
}

.form-card, .incident-card, .ticket-card {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
}

.field, .textarea {
  border: 1rpx solid var(--tt-border);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-text);
}

.status-resolved .status-chip, .status-closed .status-chip, .resolution {
  background: var(--tt-success-soft);
  color: var(--tt-success);
}

.primary-button.button-hover {
  background: var(--tt-accent-pressed);
}

.primary-button[disabled], .secondary-button[disabled] {
  opacity: 0.52;
}
