.schedule-page { padding-top: 22rpx; overflow-x: hidden; }
.schedule-studio { position: relative; margin: 0 -8rpx 22rpx; padding: 8rpx 8rpx 0; }
.schedule-studio::before { content: ""; position: absolute; top: 78rpx; left: -112rpx; width: 320rpx; height: 320rpx; border: 1rpx solid var(--tt-color-pastel-lavender-stroke); border-radius: 50%; opacity: .42; pointer-events: none; }
.schedule-sign { position: relative; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin: 0 10rpx 2rpx; color: var(--tt-text-tertiary); font-size: 19rpx; font-weight: 800; letter-spacing: 1.7rpx; }
.schedule-zone { flex: none; padding: 6rpx 12rpx; border: 1rpx solid var(--tt-color-pastel-butter-stroke); border-radius: 999rpx; background: var(--tt-color-pastel-butter-bg); color: var(--tt-color-pastel-butter-fg); letter-spacing: 0; }
.schedule-layer { width: 100%; }
.schedule-stage-card,.hero { box-sizing: border-box; min-height: 320rpx; padding: 32rpx; border: 1rpx solid; border-radius: 32rpx; overflow: hidden; }
.schedule-stage-card { position: relative; display: flex; flex-direction: column; justify-content: flex-end; }
.schedule-stage-rule { border-color: var(--tt-color-pastel-blue-stroke); background: var(--tt-color-pastel-blue-bg); color: var(--tt-color-pastel-blue-fg); }
.schedule-stage-draft { border-color: var(--tt-color-pastel-butter-stroke); background: var(--tt-color-pastel-butter-bg); color: var(--tt-color-pastel-butter-fg); }
.stage-index { position: absolute; top: 28rpx; right: 30rpx; font-size: 19rpx; font-weight: 800; letter-spacing: 1.6rpx; }
.stage-title { width: 68%; font-size: 29rpx; font-weight: 750; line-height: 1.34; }
.stage-copy { width: 68%; margin-top: 10rpx; font-size: 21rpx; line-height: 1.45; }
.schedule-props { display: flex; align-items: flex-end; gap: 2rpx; }
.hero {
  padding: 32rpx;
  background: var(--tt-color-pastel-lavender-bg);
  border: 1rpx solid var(--tt-color-pastel-lavender-stroke);
  color: var(--tt-color-pastel-lavender-fg);
}
.schedule-warning-hero { min-height: 0; border-color: var(--tt-color-status-unknown-stroke); background: var(--tt-color-status-unknown-bg); color: var(--tt-color-status-unknown-fg); }

.eyebrow {
  color: var(--tt-accent);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.hero-copy {
  margin-top: 14rpx;
  color: var(--tt-text-secondary);
  font-size: 25rpx;
  line-height: 1.6;
}

.suspended {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  font-size: 24rpx;
  line-height: 1.55;
  border: 1rpx solid var(--tt-border);
}

.inline-error {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 24rpx;
  border: 1rpx solid var(--tt-border);
}

.section-title {
  margin: 34rpx 4rpx 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.form-card {
  padding: 26rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.picker-field {
  box-sizing: border-box;
  min-height: 76rpx;
  padding: 18rpx;
  border: 1rpx solid var(--tt-border);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-text);
  font-size: 24rpx;
  line-height: 38rpx;
}

.row-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}
.schedule-row-item { margin-bottom: 18rpx; }

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  color: var(--tt-info);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.45;
}

.row-note {
  margin-top: 8rpx;
  color: var(--tt-info);
  font-size: 22rpx;
  line-height: 1.5;
}

.small-button {
  flex: none;
  margin: 0;
  padding: 0 18rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 23rpx;
  line-height: 62rpx;
  min-height: 64rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
}

.small-button.approve {
  background: var(--tt-success-soft);
  color: var(--tt-success);
  border-color: var(--tt-border-strong);
}

.empty-card {
  color: var(--tt-info);
  font-size: 24rpx;
  line-height: 1.6;
}

.draft-control {
  padding: 26rpx;
}

.secondary-button {
  margin-top: 18rpx;
  background: var(--tt-surface);
  color: var(--tt-accent);
  min-height: 80rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
}

.empty-title {
  margin-bottom: 14rpx;
  color: var(--tt-danger);
  font-size: 34rpx;
  font-weight: 700;
}

.retry {
  margin-top: 28rpx;
}

.primary-button {
  min-height: 88rpx;
}

.hero-title, .section-title, .row-title, .empty-title {
  color: var(--tt-text);
  font-weight: 700;
}

.row-note, .empty-card {
  color: var(--tt-text-tertiary);
}

.form-card, .row-card, .draft-control {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
}

.primary-button.button-hover {
  background: var(--tt-accent-pressed);
}

.primary-button[disabled], .secondary-button[disabled], .small-button[disabled] {
  opacity: 0.52;
}

.hero .eyebrow,.hero .hero-title,.hero .hero-copy { color: currentColor; }
.schedule-row-item .row-card { border: 0; background: transparent; }

@media (prefers-reduced-motion: reduce) {
  .schedule-studio::before { display: none; }
}
