.home-page { padding-bottom: 72rpx; }
.hero { margin: 0 0 24rpx; padding: 32rpx; border: 1rpx solid #e4e6e8; border-radius: 20rpx; background: #f6ecef; }
.eyebrow { color: #9b405b; font-size: 22rpx; font-weight: 700; letter-spacing: 3rpx; }
.hero-title { margin-top: 12rpx; color: #202124; font-size: 46rpx; font-weight: 800; line-height: 1.25; overflow-wrap: anywhere; }
.hero-copy { margin-top: 12rpx; color: #646970; font-size: 24rpx; line-height: 1.65; overflow-wrap: anywhere; }
.intent-input { box-sizing: border-box; width: 100%; min-height: 168rpx; margin-top: 24rpx; padding: 20rpx; border: 1rpx solid #e4e6e8; border-radius: 14rpx; background: #ffffff; color: #202124; font-size: 27rpx; line-height: 1.6; }
.risk-card { margin: 0 0 24rpx; padding: 24rpx; border: 1rpx solid #a33d45; border-radius: 20rpx; background: #faeeee; }
.risk-kicker { color: #a33d45; font-size: 22rpx; font-weight: 800; letter-spacing: 2rpx; }
.risk-title { margin-top: 8rpx; color: #202124; font-size: 32rpx; font-weight: 800; line-height: 1.35; }
.risk-copy { margin-top: 12rpx; color: #646970; font-size: 25rpx; line-height: 1.7; overflow-wrap: anywhere; }
.risk-primary, .risk-secondary { width: 100%; min-height: 88rpx; margin-top: 16rpx; border-radius: 14rpx; font-size: 26rpx; }
.risk-primary { border-color: #a33d45; background: #a33d45; color: #ffffff; }
.risk-secondary { border: 1rpx solid #e4e6e8; background: #ffffff; color: #a33d45; }
.risk-text { min-height: 88rpx; margin-top: 8rpx; padding: 16rpx; border: 0; background: transparent; color: #646970; font-size: 23rpx; line-height: 1.5; }
.risk-acknowledged { margin-top: 12rpx; color: #2f6b55; font-size: 23rpx; text-align: center; }
.section-heading { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 8rpx 16rpx; margin: 32rpx 0 16rpx; }
.section-title { color: #202124; font-size: 32rpx; font-weight: 800; line-height: 1.35; }
.section-subtitle { margin-top: 6rpx; color: #646970; font-size: 22rpx; line-height: 1.5; }
.scenario-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.scenario { box-sizing: border-box; min-height: 136rpx; padding: 20rpx; border: 1rpx solid #e4e6e8; border-radius: 20rpx; background: #ffffff; }
.scenario:active { border-color: #9b405b; background: #f6ecef; }
.scenario.selected { border-color: #9b405b; background: #f6ecef; }
.scenario-title { color: #202124; font-size: 26rpx; font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; }
.scenario-description { margin-top: 8rpx; color: #646970; font-size: 21rpx; line-height: 1.45; overflow-wrap: anywhere; }
.match-button { width: 100%; min-height: 88rpx; margin-top: 24rpx; font-size: 28rpx; font-weight: 700; }
.browse-all { min-height: 88rpx; margin-top: 8rpx; border: 0; background: transparent; color: #9b405b; font-size: 25rpx; }
.boundary-strip { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 24rpx; padding: 16rpx; border-radius: 14rpx; background: #f1f2f3; }
.boundary-item { display: flex; min-width: 180rpx; flex: 1; align-items: center; justify-content: center; gap: 8rpx; color: #646970; font-size: 20rpx; line-height: 1.4; }
.boundary-mark { display: flex; width: 36rpx; height: 36rpx; flex: 0 0 36rpx; align-items: center; justify-content: center; border-radius: 50%; background: #ffffff; color: #9b405b; font-size: 19rpx; font-weight: 800; }
.emergency-entry { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; padding: 24rpx; border: 1rpx solid #a33d45; border-radius: 20rpx; background: #faeeee; }
.emergency-title { color: #a33d45; font-size: 27rpx; font-weight: 800; }
.emergency-copy { margin-top: 6rpx; color: #646970; font-size: 21rpx; line-height: 1.55; overflow-wrap: anywhere; }
.recommendations-heading { margin-top: 40rpx; }
.recommendation-card { display: flex; gap: 20rpx; margin-bottom: 16rpx; padding: 24rpx; border: 1rpx solid #e4e6e8; border-radius: 20rpx; background: #ffffff; }
.recommendation-card:active { border-color: #9b405b; background: #f6ecef; }
.avatar { display: flex; width: 80rpx; height: 80rpx; flex: 0 0 80rpx; align-items: center; justify-content: center; border-radius: 50%; background: #f6ecef; color: #9b405b; font-size: 24rpx; font-weight: 800; }
.recommendation-copy { min-width: 0; flex: 1; }
.recommendation-title-row { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 8rpx 14rpx; }
.recommendation-name { min-width: 0; color: #202124; font-size: 29rpx; font-weight: 800; line-height: 1.4; overflow-wrap: anywhere; }
.verified { flex: 0 0 auto; padding: 4rpx 10rpx; border-radius: 999rpx; background: #edf6f1; color: #2f6b55; font-size: 20rpx; }
.recommendation-role, .recommendation-reason, .recommendation-meta { margin-top: 8rpx; color: #646970; font-size: 22rpx; line-height: 1.5; overflow-wrap: anywhere; }
.recommendation-reason { color: #9b405b; }
.community-entry { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 32rpx; padding: 24rpx; border: 1rpx solid #e4e6e8; border-radius: 20rpx; background: #eef3f6; }
.community-title { color: #3f647a; font-size: 27rpx; font-weight: 800; }
.community-copy { margin-top: 6rpx; color: #646970; font-size: 21rpx; line-height: 1.5; overflow-wrap: anywhere; }
.community-arrow { flex: 0 0 auto; color: #3f647a; font-size: 44rpx; }
.compact { padding: 40rpx 20rpx; }
.retry-button { width: 100%; min-height: 88rpx; margin-top: 16rpx; border: 1rpx solid #e4e6e8; background: #ffffff; color: #9b405b; font-size: 23rpx; }
.risk-primary::after, .risk-secondary::after, .risk-text::after, .browse-all::after, .retry-button::after { border: 0; }
