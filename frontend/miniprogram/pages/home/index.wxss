.home-page { padding-top: 36rpx; }
.home-intro { padding: 4rpx 4rpx 26rpx; }
.eyebrow { color: var(--tt-accent); font-size: 21rpx; font-weight: 700; letter-spacing: 2.5rpx; text-transform: uppercase; }
.hero-title { max-width: 620rpx; margin-top: 14rpx; color: var(--tt-text); font-size: 50rpx; font-weight: 700; letter-spacing: -1.5rpx; line-height: 1.14; }
.hero-copy { max-width: 620rpx; margin-top: 14rpx; color: var(--tt-text-secondary); font-size: 25rpx; line-height: 1.62; }
.hero-visual { display: block; width: 100%; height: 370rpx; border-radius: 28rpx; background: var(--tt-surface-alt); }
.intent-card { margin-top: -38rpx; margin-right: 20rpx; margin-left: 20rpx; padding: 22rpx; border: 1rpx solid var(--tt-border); border-radius: 22rpx; background: var(--tt-surface-raised); }
.intent-input { width: 100%; min-height: 156rpx; padding: 18rpx; border: 0; background: transparent; line-height: 1.6; }
.intent-foot { display: flex; justify-content: space-between; gap: 16rpx; padding: 8rpx 12rpx 0; color: var(--tt-text-tertiary); font-size: 21rpx; }
.risk-card { margin-top: 24rpx; padding: 26rpx; border: 1rpx solid var(--tt-danger); border-radius: 22rpx; background: var(--tt-danger-soft); }
.risk-kicker { color: var(--tt-danger); font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }
.risk-title { margin-top: 8rpx; color: var(--tt-text); font-size: 32rpx; font-weight: 700; line-height: 1.35; }
.risk-copy { margin-top: 12rpx; color: var(--tt-text-secondary); font-size: 25rpx; line-height: 1.68; }
.risk-primary,.risk-secondary { width: 100%; margin-top: 16rpx; }
.risk-primary { border-color: var(--tt-danger); background: var(--tt-danger); color: var(--tt-on-accent); }
.risk-secondary { background: var(--tt-surface); color: var(--tt-danger); }
.risk-text { width: 100%; margin-top: 8rpx; border: 0; background: transparent; color: var(--tt-text-secondary); font-size: 23rpx; }
.risk-acknowledged { margin-top: 12rpx; color: var(--tt-success); font-size: 23rpx; text-align: center; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 16rpx; margin: 48rpx 4rpx 18rpx; }
.section-title { font-size: 34rpx; }
.section-subtitle { margin-top: 6rpx; color: var(--tt-text-secondary); font-size: 22rpx; line-height: 1.5; }
.scenes-heading { margin-top: 42rpx; }
.scenario-scroll { width: calc(100% + 32rpx); margin-right: -32rpx; }
.scenario-grid { display: flex; width: max-content; gap: 14rpx; padding-right: 32rpx; }
.scenario { width: 250rpx; min-height: 128rpx; padding: 20rpx; border: 1rpx solid var(--tt-border); border-radius: 20rpx; background: var(--tt-surface); transition: transform 160ms ease, background-color 160ms ease; }
.scenario:active { transform: scale(.98); }
.scenario.selected { border-color: var(--tt-accent); background: var(--tt-accent-soft); }
.scenario-title { color: var(--tt-text); font-size: 26rpx; font-weight: 700; line-height: 1.42; }
.scenario-description { margin-top: 7rpx; color: var(--tt-text-secondary); font-size: 22rpx; }
.match-button { width: 100%; margin-top: 24rpx; }
.browse-all { width: 100%; margin-top: 8rpx; border-color: transparent; background: transparent; color: var(--tt-accent); }
.boundary-strip { display: flex; gap: 8rpx; margin-top: 26rpx; padding: 16rpx; border-radius: 18rpx; background: var(--tt-surface-alt); }
.boundary-item { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: center; gap: 7rpx; color: var(--tt-text-secondary); font-size: 19rpx; text-align: center; }
.boundary-mark { display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--tt-surface); color: var(--tt-accent); font-size: 18rpx; font-weight: 700; }
.emergency-entry { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 16rpx; padding: 22rpx 24rpx; border: 1rpx solid var(--tt-danger); border-radius: 20rpx; background: var(--tt-danger-soft); }
.emergency-title { color: var(--tt-danger); font-size: 26rpx; font-weight: 700; }
.emergency-copy { margin-top: 5rpx; color: var(--tt-text-secondary); font-size: 21rpx; line-height: 1.5; }
.recommendations-heading { margin-top: 52rpx; }
.recommendations-surface,.safety-surface { padding: 0 24rpx; border: 1rpx solid var(--tt-border); border-radius: 24rpx; background: var(--tt-surface); }
.safety-surface { margin-top: 28rpx; }
.community-arrow { flex: none; color: var(--tt-text-tertiary); font-size: 40rpx; }
@media (prefers-reduced-motion: reduce) { .scenario { transition: none; } }
