.support-page {
  padding-bottom: 66rpx;
}

.support-hero {
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--tt-color-pastel-lavender-bg);
  border: 1rpx solid var(--tt-color-pastel-lavender-stroke);
}

.hero-kicker {
  color: var(--tt-color-pastel-lavender-fg);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 10rpx;
  color: var(--tt-color-pastel-lavender-fg);
  font-size: 40rpx;
  font-weight: 800;
}

.hero-copy {
  margin-top: 13rpx;
  color: var(--tt-color-pastel-lavender-fg);
  font-size: 24rpx;
  line-height: 1.65;
}

.hero-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.hero-button, .hero-link {
  flex: 1;
  margin: 0;
  border-radius: 14rpx;
  font-size: 24rpx;
  min-height: 88rpx;
}

.hero-button {
  background: var(--tt-accent);
  color: var(--tt-on-accent);
}

.hero-link {
  border: 1rpx solid var(--tt-border-strong);
  background: var(--tt-surface);
  color: var(--tt-accent);
  border-color: var(--tt-border-strong);
}

.public-support-card {
  margin-top: 22rpx;
  border: 1rpx solid var(--tt-color-pastel-mint-stroke);
  background: var(--tt-color-pastel-mint-bg);
}

.public-support-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.public-support-copy {
  margin-top: 8rpx;
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

.public-badge {
  flex: 0 0 auto;
  padding: 5rpx 10rpx;
  border-radius: 9rpx;
  background: var(--tt-success-soft);
  color: var(--tt-success);
  font-size: 19rpx;
}

.public-operator {
  margin-top: 18rpx;
  color: var(--tt-accent);
  font-size: 25rpx;
  font-weight: 800;
}

.public-meta {
  margin-top: 8rpx;
  color: var(--tt-text);
  font-size: 22rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.public-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 17rpx;
}

.public-action {
  width: 100%;
  margin: 0;
  border: 1rpx solid var(--tt-success-soft);
  background: var(--tt-info-soft);
  color: var(--tt-info);
  font-size: 22rpx;
  min-height: 80rpx;
  border-color: var(--tt-info-soft);
  border-radius: 14rpx;
}

.emergency-boundary {
  margin-top: 16rpx;
  padding: 13rpx 15rpx;
  border-radius: 12rpx;
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
  font-size: 20rpx;
  line-height: 1.6;
}

.public-support-error {
  margin-top: 14rpx;
  color: var(--tt-danger);
  font-size: 22rpx;
  line-height: 1.55;
}

.wechat-complaint-card {
  margin-top: 22rpx;
  border: 1rpx solid var(--tt-color-pastel-butter-stroke);
  background: var(--tt-color-pastel-butter-bg);
}

.wechat-complaint-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--tt-text);
  font-size: 27rpx;
  font-weight: 800;
}

.wechat-complaint-heading text:last-child {
  padding: 5rpx 10rpx;
  border-radius: 9rpx;
  background: var(--tt-success-soft);
  color: var(--tt-success);
  font-size: 19rpx;
}

.wechat-complaint-copy {
  margin-top: 14rpx;
  color: var(--tt-text);
  font-size: 23rpx;
  line-height: 1.7;
}

.wechat-complaint-boundary {
  margin-top: 15rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: var(--tt-surface);
  color: var(--tt-text-secondary);
  font-size: 21rpx;
  line-height: 1.65;
}

.wechat-complaint-state {
  margin-top: 18rpx;
  color: var(--tt-text);
  font-size: 22rpx;
  line-height: 1.65;
}

.wechat-complaint-error {
  color: var(--tt-danger);
}

.wechat-complaint-retry, .wechat-complaint-order-link {
  width: 100%;
  margin-top: 14rpx;
  border: 1rpx solid var(--tt-success-soft);
  background: var(--tt-info-soft);
  color: var(--tt-info);
  font-size: 22rpx;
  min-height: 80rpx;
  border-color: var(--tt-info-soft);
  border-radius: 14rpx;
}

.wechat-complaint-list {
  margin-top: 18rpx;
}

.wechat-complaint-item {
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid var(--tt-border);
  border-radius: 15rpx;
  background: var(--tt-surface);
  border-color: var(--tt-border);
}

.wechat-complaint-item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.wechat-complaint-order {
  min-width: 0;
  overflow: hidden;
  color: var(--tt-text);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wechat-complaint-status {
  flex: 0 0 auto;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
  font-size: 19rpx;
  font-weight: 800;
}

.wechat-complaint-waiting {
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
}

.wechat-complaint-active {
  background: var(--tt-info-soft);
  color: var(--tt-info);
}

.wechat-complaint-resolved {
  background: var(--tt-success-soft);
  color: var(--tt-success);
}

.wechat-complaint-attention {
  background: var(--tt-danger-soft);
  color: var(--tt-danger);
}

.wechat-complaint-summary {
  margin-top: 12rpx;
  color: var(--tt-text);
  font-size: 22rpx;
  line-height: 1.65;
}

.wechat-complaint-meta {
  margin-top: 8rpx;
  color: var(--tt-text-secondary);
  font-size: 20rpx;
  line-height: 1.55;
}

.form-card {
  margin-top: 22rpx;
  border: 2rpx solid var(--tt-danger-soft);
}

.section-title {
  color: var(--tt-accent);
  font-size: 29rpx;
  font-weight: 800;
}

.picker, .form-input, .form-textarea {
  box-sizing: border-box;
  width: 100%;
  margin-top: 17rpx;
  border: 1rpx solid var(--tt-accent-soft);
  border-radius: 14rpx;
  background: var(--tt-surface);
  color: var(--tt-text);
  font-size: 25rpx;
  border-color: var(--tt-border);
}

.picker, .form-input {
  padding: 20rpx;
}

.form-textarea {
  min-height: 220rpx;
  padding: 20rpx;
  line-height: 1.6;
}

.order-link {
  margin-top: 16rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  background: var(--tt-surface);
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  word-break: break-all;
}

.form-boundary {
  margin-top: 14rpx;
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

.submit-button {
  width: 100%;
  margin-top: 20rpx;
  font-size: 26rpx;
  min-height: 88rpx;
  border-radius: 14rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 4rpx 16rpx;
}

.section-hint {
  color: var(--tt-text-secondary);
  font-size: 21rpx;
}

.partial-warning {
  margin-bottom: 16rpx;
  padding: 16rpx;
  border-left: 6rpx solid var(--tt-warning);
  background: var(--tt-warning-soft);
  color: var(--tt-warning);
  font-size: 22rpx;
  line-height: 1.6;
  border-left-color: var(--tt-warning);
}

.case-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-left: 6rpx solid var(--tt-info);
  border-radius: 20rpx;
  background: var(--tt-surface);
  box-shadow: none;
  border: 1rpx solid var(--tt-border);
}

.case-resolved {
  border-left-color: var(--tt-success);
}

.case-attention {
  border-left-color: var(--tt-danger);
}

.case-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.case-kind {
  color: var(--tt-text-secondary);
  font-size: 21rpx;
}

.case-status {
  flex: 0 0 auto;
  color: var(--tt-accent);
  font-size: 22rpx;
  font-weight: 800;
}

.case-title {
  margin-top: 11rpx;
  color: var(--tt-accent);
  font-size: 28rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.case-summary {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--tt-text);
  font-size: 23rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.case-meta {
  margin-top: 13rpx;
  color: var(--tt-text-secondary);
  font-size: 20rpx;
}

.pagination-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin: 18rpx 0;
  color: var(--tt-text-secondary);
  font-size: 20rpx;
  text-align: center;
}

.pagination-row button {
  flex: 0 0 auto;
  margin: 0;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 21rpx;
}

.pagination-row text {
  flex: 1;
}

.compact {
  padding: 46rpx 20rpx;
}

.receipt-note {
  padding: 16rpx;
  border-radius: 13rpx;
  background: var(--tt-warning-soft);
  color: var(--tt-text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

.receipt-row {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid var(--tt-danger-soft);
  color: var(--tt-text-secondary);
  font-size: 21rpx;
}

.receipt-row text:first-child {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.receipt-row text:last-child {
  flex: 0 0 auto;
}

.community-button {
  width: 100%;
  margin-top: 16rpx;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 24rpx;
}

.retry-button {
  width: 100%;
  margin-top: 16rpx;
  border: 1rpx solid var(--tt-accent-soft);
  background: var(--tt-surface);
  color: var(--tt-accent);
  font-size: 23rpx;
}

.hero-button::after, .hero-link::after, .community-button::after, .retry-button::after, .public-action::after, .wechat-complaint-retry::after, .wechat-complaint-order-link::after {
  border: 0;
}

.hero-title, .section-title, .public-operator, .wechat-complaint-heading, .case-title {
  color: var(--tt-text);
  font-weight: 700;
}

.hero-copy, .public-support-copy, .public-meta, .wechat-complaint-copy, .wechat-complaint-state, .case-summary {
  color: var(--tt-text-secondary);
}

.public-support-card, .wechat-complaint-card, .form-card {
  border: 1rpx solid var(--tt-border);
  background: var(--tt-surface);
}

.public-badge, .wechat-complaint-heading text:last-child {
  border-radius: 999rpx;
  background: var(--tt-success-soft);
  color: var(--tt-success);
}

.public-support-error, .wechat-complaint-error, .catalog-pagination-error {
  color: var(--tt-danger);
}

.wechat-complaint-boundary, .order-link, .receipt-note {
  background: var(--tt-surface-alt);
  color: var(--tt-text-secondary);
}

.wechat-complaint-order, .wechat-complaint-meta, .case-kind, .case-meta, .section-hint {
  color: var(--tt-text-tertiary);
}

.case-status, .pagination-row button, .community-button, .retry-button {
  color: var(--tt-accent);
}

.pagination-row, .receipt-row {
  color: var(--tt-text-secondary);
}

.pagination-row button, .community-button, .retry-button {
  min-height: 80rpx;
  border-color: var(--tt-accent-soft);
  border-radius: 14rpx;
  background: var(--tt-surface);
}

.hero-button.button-hover {
  background: var(--tt-accent-pressed);
}

.hero-button[disabled], .submit-button[disabled], .public-action[disabled] {
  opacity: 0.52;
}

.support-hero .hero-title,
.support-hero .hero-copy { color: var(--tt-color-pastel-lavender-fg); }
.public-support-card { border-color: var(--tt-color-pastel-mint-stroke); background: var(--tt-color-pastel-mint-bg); }
.wechat-complaint-card { border-color: var(--tt-color-pastel-butter-stroke); background: var(--tt-color-pastel-butter-bg); }

/* UI4 restrained case folders. Serious case/status cards remain flat and static. */
.support-page { overflow-x: hidden; }
.support-hero-stack { position: relative; margin-bottom: 30rpx; padding-bottom: 16rpx; }
.support-stack-card { position: absolute; right: 18rpx; bottom: 0; left: 18rpx; min-height: 100%; padding: 18rpx 26rpx; border: 1rpx solid; border-radius: 28rpx; font-size: 19rpx; font-weight: 750; text-align: right; pointer-events: none; }
.support-stack-safety { bottom: 0; border-color: var(--tt-color-pastel-rose-stroke); background: var(--tt-color-pastel-rose-bg); color: var(--tt-color-pastel-rose-fg); }
.support-stack-service { right: 9rpx; bottom: 8rpx; left: 9rpx; border-color: var(--tt-color-pastel-blue-stroke); background: var(--tt-color-pastel-blue-bg); color: var(--tt-color-pastel-blue-fg); }
.support-hero { position: relative; z-index: 2; }
.public-support-card { border-radius: 24rpx; }
.wechat-complaint-card,.form-card { border-radius: 24rpx; box-shadow: none; }
.case-card { box-shadow: none; }
.support-page.tt-motion-off .public-support-card,
.support-page.tt-motion-off .hero-button,
.support-page.tt-motion-off .hero-link,
.support-page.tt-motion-off .public-action,
.support-page.tt-motion-off .case-card { animation: none; transition: none; transform: none; }
