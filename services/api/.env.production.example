# Production deployment — copy to .env.production and fill secrets before deploy.
NODE_ENV=production
APP_ENV=production
PORT=3000
API_PREFIX=api/v1
APP_VERSION=0.1.0

DATABASE_URL=postgres://talk:CHANGE_ME@postgres:5432/talk_and_talk
REDIS_URL=redis://redis:6379
CORS_ORIGINS=https://api.talkandtalk.app

JWT_ACCESS_SECRET=CHANGE_ME_PRODUCTION_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_PRODUCTION_REFRESH
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SMS_CODE_TTL_SECONDS=300

DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat_private_key.pem
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_NOTIFY_BASE_URL=https://api.talkandtalk.app

APPLE_SIGN_IN_BUNDLE_ID=com.talkandtalk.app

# Use aliyun or tencent in production — mock is rejected when APP_ENV=production.
SMS_PROVIDER=none
RATE_LIMIT_PER_MINUTE=120
BODY_SIZE_LIMIT=1mb

SEED_ON_STARTUP=false