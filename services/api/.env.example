NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_VERSION=0.1.0

DATABASE_URL=postgres://talk:talk@localhost:5432/talk_and_talk
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth configuration (Day 2 will wire these into login/token flows)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Moderation provider configuration
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# WeChat Pay configuration
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_CERT_SERIAL_NO=

# Apple Sign-In configuration
APPLE_SIGN_IN_BUNDLE_ID=

# SMS configuration, e.g. none, aliyun, tencent
SMS_PROVIDER=none
