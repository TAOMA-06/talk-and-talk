generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  companion
  moderator
  admin
}

enum AuthProvider {
  phone
  apple
}

enum AccountStatus {
  active
  restricted
  banned
}

enum Availability {
  online
  available
  busy
}

enum MessageType {
  text
  system
  safety
}

enum ModerationDecision {
  allow
  warn
  block
  review
}

enum RiskLevel {
  low
  medium
  high
}

enum ModerationSource {
  chat
  community
  report
  profile
}

enum ModerationCaseStatus {
  pending
  autoReviewing
  humanReview
  resolved
  dismissed
}

model User {
  id            String        @id @default(uuid())
  role          UserRole      @default(user)
  accountStatus AccountStatus @default(active)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  identities    AuthIdentity[]
  profile       UserProfile?
  refreshTokens RefreshToken[]
  conversations Conversation[]
  readStates    MessageReadState[]
}

model AuthIdentity {
  id         String       @id @default(uuid())
  userId     String
  provider   AuthProvider
  providerId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model UserProfile {
  userId      String  @id
  displayName String?
  phone       String?
  age         Int?
  gender      String?
  isVerified  Boolean @default(false)
  safetyScore Int     @default(80)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanionProfile {
  id               String       @id
  name             String
  role             String
  initials         String
  rating           Float        @default(0)
  reviewCount      Int          @default(0)
  pricePerHalfHour Int
  isOnline         Boolean      @default(false)
  isVerified       Boolean      @default(false)
  bio              String
  availableTimes   String[]
  languages        String[]
  specialties      String[]
  completedOrders  Int          @default(0)
  responseTime     String
  distanceKm       Float        @default(0)
  availability     Availability @default(available)
  cityDistrict     String
  isPublished      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  serviceTags      CompanionServiceTag[]
  conversations    Conversation[]

  @@index([isPublished, availability])
  @@index([isOnline])
}

model Conversation {
  id          String   @id @default(uuid())
  externalId  String
  userId      String
  companionId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion CompanionProfile   @relation(fields: [companionId], references: [id], onDelete: Cascade)
  messages  Message[]
  readStates MessageReadState[]

  @@unique([userId, externalId])
  @@unique([userId, companionId])
  @@index([userId, updatedAt])
  @@index([companionId])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  senderName     String?
  content        String
  type           MessageType @default(text)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@index([senderId])
}

model MessageReadState {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  readAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ModerationCase {
  id           String               @id @default(uuid())
  title        String
  category     String
  riskLevel    RiskLevel
  status       ModerationCaseStatus @default(pending)
  source       ModerationSource
  content      String
  targetId     String?
  messageId    String?
  aiScore      Float
  aiReason     String
  decision     ModerationDecision
  matchedRules String[]
  usedAI       Boolean              @default(false)
  resolvedAt   DateTime?
  createdAt    DateTime             @default(now())
  evidences    ModerationEvidence[]
  actionLogs   ModerationActionLog[]

  @@index([source, status])
  @@index([targetId])
  @@index([status, createdAt])
  @@index([riskLevel, createdAt])
  @@index([createdAt])
}

model ModerationEvidence {
  id        String   @id @default(uuid())
  caseId    String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model ModerationActionLog {
  id        String   @id @default(uuid())
  caseId    String
  actorId   String?
  action    String
  note      String?
  createdAt DateTime @default(now())

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model ModerationLabel {
  id               String              @id @default(uuid())
  text             String
  expectedDecision ModerationDecision
  actualDecision   ModerationDecision
  note             String?
  caseId           String?
  actorId          String?
  source           ModerationSource?
  createdAt        DateTime            @default(now())

  @@index([createdAt])
  @@index([caseId])
}

model ServiceTag {
  id         String   @id @default(uuid())
  name       String   @unique
  createdAt  DateTime @default(now())
  companions CompanionServiceTag[]
}

model CompanionServiceTag {
  companionId String
  tagId       String

  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)
  tag       ServiceTag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companionId, tagId])
  @@index([tagId])
}

model VerificationCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
