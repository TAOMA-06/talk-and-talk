{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talkandtalk.local/schemas/practical-demo-shot-manifest-v1.json",
  "title": "Talk&Talk practical demo shot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "video", "timing", "cards", "shots", "footer"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "codec", "averageBitRate"],
      "properties": {
        "width": { "const": 1920 },
        "height": { "const": 1080 },
        "fps": { "const": 30 },
        "codec": { "const": "h264" },
        "averageBitRate": { "type": "integer", "minimum": 4000000, "maximum": 30000000 }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titleSeconds", "boundarySeconds", "resultSeconds", "crossfadeSeconds"],
      "properties": {
        "titleSeconds": { "type": "number", "minimum": 1, "maximum": 30 },
        "boundarySeconds": { "type": "number", "minimum": 1, "maximum": 30 },
        "resultSeconds": { "type": "number", "minimum": 1, "maximum": 30 },
        "crossfadeSeconds": { "type": "number", "minimum": 0, "maximum": 1.5 }
      }
    },
    "cards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "boundary", "result"],
      "properties": {
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kicker", "title", "subtitle", "meta"],
          "properties": {
            "kicker": { "type": "string", "minLength": 1, "maxLength": 30 },
            "title": { "type": "string", "minLength": 1, "maxLength": 60 },
            "subtitle": { "type": "string", "minLength": 1, "maxLength": 120 },
            "meta": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 30 } }
          }
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "subtitle", "items"],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 60 },
            "subtitle": { "type": "string", "minLength": 1, "maxLength": 120 },
            "items": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 100 } }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "headline", "details", "evidenceRefs"],
          "properties": {
            "status": { "enum": ["passed", "failed", "blocked", "not_run"] },
            "headline": { "type": "string", "minLength": 1, "maxLength": 80 },
            "details": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
            "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 100 } }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "image", "sourceKind", "evidenceRef", "label", "caption", "durationSeconds", "fit", "motion"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
          "image": { "type": "string", "pattern": "^/" },
          "sourceKind": { "enum": ["evidence", "synthetic-placeholder"] },
          "evidenceRef": { "type": "string", "minLength": 1, "maxLength": 120 },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "caption": { "type": "string", "minLength": 1, "maxLength": 120 },
          "durationSeconds": { "type": "number", "minimum": 1, "maximum": 30 },
          "fit": { "enum": ["contain", "cover"] },
          "motion": { "enum": ["none", "zoomIn", "zoomOut", "panLeft", "panRight"] }
        }
      }
    },
    "footer": { "type": "string", "minLength": 1, "maxLength": 140 }
  }
}
