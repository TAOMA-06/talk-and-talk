.review-page { padding: 28rpx 24rpx 0; }
.hero { position: relative; overflow: hidden; padding: 42rpx 36rpx 34rpx; border: 2rpx solid rgba(41, 39, 36, .12); border-radius: 42rpx; background: #1f2c26; color: #fff; box-shadow: 0 18rpx 44rpx rgba(30, 43, 37, .18); }
.hero-orbit { position: absolute; border: 2rpx solid rgba(255, 255, 255, .18); border-radius: 999rpx; }
.orbit-one { top: -80rpx; right: -40rpx; width: 280rpx; height: 280rpx; }
.orbit-two { top: 10rpx; right: 34rpx; width: 150rpx; height: 150rpx; }
.review-badge { position: relative; display: inline-flex; padding: 10rpx 18rpx; border: 1rpx solid rgba(255, 255, 255, .24); border-radius: 999rpx; background: rgba(255, 255, 255, .1); font-size: 22rpx; font-weight: 600; letter-spacing: 1rpx; }
.hero-title { position: relative; width: 100%; margin-top: 30rpx; font-size: 52rpx; font-weight: 750; line-height: 1.12; letter-spacing: -2rpx; }
.hero-title text { color: #d9e8df; }
.hero-copy { position: relative; width: 88%; margin-top: 20rpx; color: rgba(255, 255, 255, .72); font-size: 25rpx; line-height: 1.7; }
.hero-facts { position: relative; display: flex; gap: 12rpx; margin-top: 34rpx; }
.hero-facts view { display: flex; flex: 1; flex-direction: column; gap: 5rpx; padding: 18rpx; border-radius: 24rpx; background: rgba(255, 255, 255, .1); }
.hero-facts text { font-size: 34rpx; font-weight: 760; }
.hero-facts label { color: rgba(255, 255, 255, .62); font-size: 20rpx; }
.truth-note { display: flex; gap: 18rpx; align-items: flex-start; margin: 24rpx 4rpx 6rpx; padding: 24rpx; border: 2rpx solid #ded8cf; border-radius: 28rpx; background: #fffdf9; }
.truth-dot { flex: 0 0 auto; width: 14rpx; height: 14rpx; margin-top: 10rpx; border-radius: 50%; background: #b96e59; box-shadow: 0 0 0 8rpx #f4e1da; }
.truth-note view:last-child { display: flex; flex-direction: column; gap: 8rpx; }
.truth-note text { font-size: 26rpx; font-weight: 700; }
.truth-note label { color: #746f68; font-size: 22rpx; line-height: 1.55; }
.group-strip { position: sticky; z-index: 3; top: 0; width: calc(100% + 48rpx); margin: 20rpx -24rpx 0; padding: 16rpx 0; background: rgba(248, 246, 241, .96); white-space: nowrap; }
.group-row { display: inline-flex; gap: 12rpx; padding: 0 24rpx; }
.group-chip { min-width: 104rpx; height: 68rpx; padding: 0 24rpx; border: 2rpx solid #d8d2ca; border-radius: 999rpx; background: #fff; color: #6e6962; font-size: 23rpx; font-weight: 650; }
.group-chip.is-active { border-color: #293a32; background: #293a32; color: #fff; box-shadow: 0 8rpx 18rpx rgba(41, 58, 50, .16); }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; padding: 32rpx 4rpx 20rpx; }
.section-heading > view:first-child { display: flex; flex-direction: column; gap: 6rpx; }
.section-heading text { font-size: 36rpx; font-weight: 760; }
.section-heading label { color: #827d76; font-size: 22rpx; }
.section-mark { padding: 8rpx 14rpx; border-radius: 14rpx; background: #e6dfef; color: #594f69; font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }
.screen-grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20rpx 0; }
.screen-card { position: relative; width: calc(50% - 10rpx); padding: 14rpx; border: 2rpx solid rgba(70, 65, 58, .12); border-radius: 30rpx; text-align: left; box-shadow: 0 12rpx 24rpx rgba(60, 54, 48, .08); transition: transform 120ms ease, box-shadow 120ms ease; }
.screen-card-pressed { transform: translateY(4rpx) scale(.985); box-shadow: 0 5rpx 12rpx rgba(60, 54, 48, .08); }
.tone-blue { background: #dfeaf3; }
.tone-apricot { background: #f1e2d5; }
.tone-mint { background: #dfece5; }
.tone-lavender { background: #e8e1ee; }
.tone-butter { background: #f2ead1; }
.tone-rose { background: #f1e0e3; }
.thumb-shell { position: relative; overflow: hidden; height: 320rpx; border: 2rpx solid rgba(41, 39, 36, .12); border-radius: 22rpx; background: #f7f4ee; }
.screen-thumb { width: 100%; height: 100%; }
.screen-number { position: absolute; top: 12rpx; left: 12rpx; min-width: 48rpx; height: 48rpx; padding: 0 10rpx; border-radius: 14rpx; background: rgba(31, 44, 38, .9); color: #fff; font-size: 20rpx; font-weight: 760; line-height: 48rpx; text-align: center; }
.screen-copy { display: flex; min-width: 0; flex-direction: column; gap: 7rpx; padding: 18rpx 6rpx 10rpx; }
.screen-label { overflow: hidden; font-size: 27rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.screen-route { overflow: hidden; color: #716b64; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.screen-open { padding: 0 6rpx 8rpx; color: #384b42; font-size: 22rpx; font-weight: 700; }
.review-footer { display: flex; flex-direction: column; gap: 8rpx; margin-top: 28rpx; padding: 34rpx 30rpx; border-radius: 30rpx; background: #eee9e1; }
.review-footer view { font-size: 26rpx; font-weight: 740; }
.review-footer text { color: #7c766f; font-size: 21rpx; letter-spacing: 1rpx; }
