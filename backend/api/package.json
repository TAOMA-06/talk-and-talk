{
  "name": "talk-and-talk-api",
  "version": "0.1.0",
  "private": true,
  "description": "Talk&Talk production API",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json && node scripts/copy-public-assets.mjs",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:prod": "node dist/src/main.js",
    "verify:prod-artifacts": "npm run build && node scripts/verify-production-artifacts.mjs",
    "test": "npm run prisma:generate && jest --runInBand",
    "test:preflight": "node --test scripts/deployment-preflight.test.mjs scripts/voice-release-artifacts.test.mjs scripts/cloudbase-template.test.mjs scripts/admin-review-static-assets.test.mjs scripts/staff-offboarding-static-assets.test.mjs scripts/staff-offboarding-concurrency.test.mjs scripts/notification-delivery-claim-concurrency.test.mjs scripts/openapi-controller-contract.test.mjs scripts/finance-terminal-audit-controls.test.mjs scripts/availability-capacity-worker-scale.test.mjs scripts/account-deletion-phased-erasure-scale.test.mjs scripts/account-deletion-auth-tombstone-concurrency.test.mjs scripts/order-refund-policy-snapshots.test.mjs scripts/future-booking-boundary.test.mjs ../../infra/nginx/assert-commercial-surface.mjs",
    "test:e2e": "npm run prisma:generate && jest --config test/jest-e2e.json --runInBand",
    "test:integration": "npm run test:e2e",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node src/database/seed.ts",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node src/database/seed.ts",
    "staff:bootstrap": "node dist/src/database/bootstrap-staff.js",
    "staff:bootstrap:dev": "npm run build && npm run staff:bootstrap",
    "staff:totp-secret": "node scripts/generate-totp-secret.mjs",
    "review:bootstrap": "node dist/src/database/bootstrap-review-staff.js",
    "review:bootstrap:dev": "npm run build && npm run review:bootstrap",
    "review:totp-secret": "node scripts/generate-totp-secret.mjs",
    "preflight:deployment": "node scripts/deployment-preflight.mjs",
    "verify:voice-release-artifacts": "node scripts/voice-release-artifacts.mjs",
    "verify:cloudbase-template": "node scripts/validate-cloudbase-template.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.9",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "prisma": "7.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tls-sig-api-v2": "1.0.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "find-my-way": "9.7.0",
    "valibot": "1.4.2"
  }
}
