NODE_ENV=development
APP_ENV=development
HOST=127.0.0.1
PORT=3000
API_PREFIX=api/v1
APP_VERSION=0.1.0

DATABASE_URL=postgres://talk:talk@localhost:5432/talk_and_talk
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth configuration
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SMS_CODE_TTL_SECONDS=300

# Moderation provider configuration
# Development/staging only: leave empty for rule-only moderation. Production
# startup and deployment preflight require a real key and HTTPS provider URL.
# When set, DeepSeek is used after rules unless the rule decision is already high-risk block.
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Chat image / voice moderation. Disabled by default. The bundled mock adapter
# is only for development/test; production requires a registered storage +
# image/OCR + voice-transcription adapter with verified uploads and encryption.
MEDIA_FEATURE_ENABLED=false
MEDIA_PROVIDER=disabled

# WeChat Pay configuration
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
# CloudBase: inject the PEM as an environment secret; literal \\n is supported.
WECHAT_PAY_PRIVATE_KEY=
# Local/container alternative: mount the PEM and use an absolute path.
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_NOTIFY_BASE_URL=

# WeChat Mini Program login / JSAPI Pay configuration
# Keep AppSecret on the API server only; never place it in frontend/miniprogram.
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=

# Apple Sign-In configuration (must match iOS bundle id)
APPLE_SIGN_IN_BUNDLE_ID=com.talkandtalk.app

# SMS configuration: mock (dev/test), none, aliyun, tencent
SMS_PROVIDER=mock
# Encrypts staff TOTP seeds at rest. Use a unique secret of 32+ characters in production.
STAFF_TOTP_ENCRYPTION_KEY=development-staff-totp-key-not-for-production
RATE_LIMIT_PER_MINUTE=120
BODY_SIZE_LIMIT=1mb
SEED_ON_STARTUP=false

# Database-driven cleanup for expired confirmation holds and paid orders whose
# service window has ended. Leave enabled outside isolated tests.
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=60
PAYMENT_RECONCILIATION_BATCH_SIZE=50

# Durable transactional notification delivery. The WeChat subscription channel
# stays off locally until real approved template IDs are configured server-side.
NOTIFICATION_DELIVERY_ENABLED=true
NOTIFICATION_DELIVERY_INTERVAL_SECONDS=30
NOTIFICATION_DELIVERY_BATCH_SIZE=20
WECHAT_SUBSCRIBE_MESSAGES_ENABLED=false
WECHAT_SUBSCRIBE_TEMPLATES_JSON=

# Commercial pilot controls. Development uses a zero-fee internal mode by default.
COMMERCIAL_RELEASE_MODE=internal
PLATFORM_FEE_BPS=0
COMPANION_SETTLEMENT_HOLD_HOURS=96
REFUND_REQUEST_WINDOW_HOURS=72
ORDER_RESPONSE_WINDOW_MINUTES=10
ORDER_MAX_SCHEDULE_DAYS=30
ORDER_INTAKE_ENABLED=true
ORDER_MAX_OPEN_TOTAL=500
ORDER_MAX_OPEN_PER_USER=3
ORDER_MAX_PENDING_PER_COMPANION=20
PAYOUT_CLAIMS_ENABLED=true
SUPPORT_RESPONSE_HOURS=24
SUPPORT_MAX_OPEN_PER_USER=5

# Bearer token for /metrics. Production requires at least 32 characters.
METRICS_TOKEN=

# Server-authoritative legal document definition; keep aligned with Mini Program release config.
LEGAL_CONSENT_VERSION=2.0-2026-07-20
LEGAL_CONSENT_EFFECTIVE_DATE=2026-07-20
LEGAL_PRIVACY_URL=https://api.talkandtalk.app/legal/privacy.html
LEGAL_TERMS_URL=https://api.talkandtalk.app/legal/terms.html
LEGAL_PLATFORM_RULES_URL=https://api.talkandtalk.app/api/v1/legal/platform-rules
LEGAL_OPERATOR_NAME=Talk&Talk 开发环境运营方（不可用于对外发布）
LEGAL_CONTACT_EMAIL=dev@example.invalid
LEGAL_CONTACT_PHONE=000-0000-0000
LEGAL_COMPLAINT_CHANNEL=开发环境客服渠道（不可用于对外发布）
LEGAL_PRIVACY_RETENTION_DAYS=1095
