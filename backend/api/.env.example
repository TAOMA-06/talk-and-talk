NODE_ENV=development
APP_ENV=development
HOST=127.0.0.1
PORT=3000
API_PREFIX=api/v1
APP_VERSION=0.1.0

DATABASE_URL=postgres://talk:talk@localhost:5432/talk_and_talk
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth configuration
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
AUTH_IDENTITY_TOMBSTONE_HMAC_KEYS={"dev-v1":"dGFsay1hbmQtdGFsay1kZXZlbG9wbWVudC1hdXRoLXRvbWJzdG9uZS1rZXktdjE="}
AUTH_IDENTITY_TOMBSTONE_ACTIVE_KEY_ID=dev-v1
AUTH_IDENTITY_REREGISTRATION_POLICY=after_tombstone_expiry
# Canonical duration format: <positive integer><s|m|h|d>. Access must be 5m-1h;
# refresh must be 1h-90d and strictly longer than access.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
REVIEW_JWT_ACCESS_SECRET=dev-review-access-secret
REVIEW_JWT_REFRESH_SECRET=dev-review-refresh-secret
REVIEW_JWT_ACCESS_TTL=15m
REVIEW_JWT_REFRESH_TTL=8h
SMS_CODE_TTL_SECONDS=300

# User-authored text stays inside the local rule and human-review boundary.
# The current release has no approved external generative-AI content path;
# setting this true or supplying a stale DEEPSEEK_API_KEY fails startup.
EXTERNAL_AI_USER_CONTENT_ENABLED=false

# Chat image / voice moderation. Disabled by default. The bundled mock adapter
# is only for development/test; production requires a registered storage +
# image/OCR + voice-transcription adapter with verified uploads and encryption.
MEDIA_FEATURE_ENABLED=false
MEDIA_PROVIDER=disabled

# Order-scoped real-time voice (TRTC). Keep false until the Mini Program has
# approved live-pusher/live-player permissions and TRTC PrivateMapKey room
# restriction is enabled in the provider console. The secret is server-only.
TRTC_ENABLED=false
TRTC_SDK_APP_ID=
TRTC_SDK_SECRET_KEY=
# Tencent console callback key (16-32 ASCII letters/digits). Required whenever TRTC is enabled.
TRTC_CALLBACK_SIGNING_KEY=
TRTC_PRIVATE_MAP_KEY_ENABLED=false
TRTC_USER_SIG_TTL_SECONDS=300
# Must reference the completed operator privacy-policy/WeChat privacy-guide
# review. This is a non-secret approval or ticket identifier, never legal text.
TRTC_PRIVACY_DISCLOSURE_APPROVED=false
TRTC_PRIVACY_DISCLOSURE_REFERENCE=
# Server-only room closure for refunds, service completion, and elapsed voice
# windows. The CAM principal must be restricted to this TRTC SDKAppId and the
# DismissRoomByStrRoomId action; never expose these credentials to the client.
TRTC_ROOM_CONTROL_ENABLED=false
# Temporary incident drain only: refuse new room credentials and make the
# server close every recorded room before the normal flags are turned off.
TRTC_EMERGENCY_STOP_ENABLED=false
TRTC_CONTROL_REGION=ap-guangzhou
TRTC_CONTROL_TIMEOUT_MS=5000
TRTC_ROOM_CONTROL_INTERVAL_SECONDS=15
TRTC_ROOM_CONTROL_BATCH_SIZE=10
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# Set only when the deployment uses temporary Tencent Cloud credentials.
TENCENTCLOUD_SECURITY_TOKEN=

# WeChat Pay configuration
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
# CloudBase: inject the PEM as an environment secret; literal \\n is supported.
WECHAT_PAY_PRIVATE_KEY=
# Local/container alternative: mount the PEM and use an absolute path.
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_NOTIFY_BASE_URL=

# WeChat Mini Program login / JSAPI Pay configuration
# Keep AppSecret on the API server only; never place it in frontend/miniprogram.
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=

# Apple Sign-In configuration (must match iOS bundle id)
APPLE_SIGN_IN_BUNDLE_ID=com.talkandtalk.app

# SMS configuration: mock (dev/test), none, aliyun, tencent
SMS_PROVIDER=mock
# Encrypts staff TOTP seeds at rest. Use a unique secret of 32+ characters in production.
STAFF_TOTP_ENCRYPTION_KEY=development-staff-totp-key-not-for-production
REVIEW_TOTP_ENCRYPTION_KEY=development-review-totp-key-not-for-production
RATE_LIMIT_PER_MINUTE=120
BODY_SIZE_LIMIT=1mb
SEED_ON_STARTUP=false

# Database-driven cleanup for expired confirmation holds and paid orders whose
# service window has ended. Leave enabled outside isolated tests.
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=60
PAYMENT_RECONCILIATION_BATCH_SIZE=50
# Official WeChat T+1 trade/fund bill import is a separate finance gate. It
# stays disabled until the merchant account and daily operating SOP are signed.
WECHAT_DAILY_BILL_RECONCILIATION_ENABLED=false
WECHAT_DAILY_BILL_RECONCILIATION_APPROVED=false
WECHAT_DAILY_BILL_RECONCILIATION_APPROVAL_REFERENCE=
WECHAT_DAILY_BILL_RECONCILIATION_START_DATE=
WECHAT_DAILY_BILL_RECONCILIATION_HOUR=10
WECHAT_DAILY_BILL_RECONCILIATION_BATCH_SIZE=4
WECHAT_PAY_COMPLAINTS_ENABLED=true
WECHAT_PAY_COMPLAINT_POLL_INTERVAL_SECONDS=300
WECHAT_PAY_COMPLAINT_BATCH_SIZE=50

# Durable transactional notification delivery. The WeChat subscription channel
# stays off locally until real approved template IDs are configured server-side.
# A commercial deployment must include every required logical key, including
# messageReceived for user-authorized, unmuted platform conversations.
NOTIFICATION_DELIVERY_ENABLED=true
NOTIFICATION_DELIVERY_INTERVAL_SECONDS=30
NOTIFICATION_DELIVERY_BATCH_SIZE=20
WECHAT_SUBSCRIBE_MESSAGES_ENABLED=false
WECHAT_SUBSCRIBE_TEMPLATES_JSON=

# Optional, server-only preparation for availability-reminder candidates. This
# only records internal preflight/handoff state; it never calls WeChat, consumes
# a subscription authorization, or creates a user-visible notification. Keep
# it false until operations deliberately enables and observes the bounded run.
AVAILABILITY_REMINDER_PREPARATION_ENABLED=false
AVAILABILITY_REMINDER_PREPARATION_INTERVAL_SECONDS=60
AVAILABILITY_REMINDER_PREPARATION_BATCH_SIZE=20
# Fanout expands one durable window job in keyset pages. These limits bound
# every transaction/pass; leases recover crashes and retries back off before a
# terminal failure is surfaced by the admin readiness endpoint.
AVAILABILITY_REMINDER_FANOUT_BATCH_SIZE=200
AVAILABILITY_REMINDER_FANOUT_BATCHES_PER_RUN=20
AVAILABILITY_REMINDER_FANOUT_LEASE_SECONDS=120
AVAILABILITY_REMINDER_FANOUT_MAX_FAILURES=8
AVAILABILITY_REMINDER_FANOUT_RETRY_BASE_SECONDS=30

# Real availability-reminder delivery remains separately disabled by default.
# Enabling it requires the WeChat channel above and an approved
# availabilityReminder template; it only sends freshly consumed leases and
# quarantines expired ones rather than retrying an unknown provider boundary.
AVAILABILITY_REMINDER_DELIVERY_ENABLED=false
AVAILABILITY_REMINDER_DELIVERY_INTERVAL_SECONDS=60
AVAILABILITY_REMINDER_DELIVERY_BATCH_SIZE=20

# Commercial pilot controls. Development uses a zero-fee internal mode by default.
COMMERCIAL_RELEASE_MODE=internal
# Controlled voice-intro evidence viewer. Configure URL and secret together.
# Leaving both blank keeps listening unavailable and approval fails closed.
COMPANION_VOICE_EVIDENCE_VIEWER_URL=
COMPANION_VOICE_EVIDENCE_SIGNING_SECRET=
COMPANION_VOICE_EVIDENCE_URL_TTL_SECONDS=300
PLATFORM_FEE_BPS=0
COMPANION_SETTLEMENT_HOLD_HOURS=96
# Current policy is copied into each new order. Commercial mode additionally
# requires an external approval flag and a non-secret approval reference.
REFUND_POLICY_VERSION=development-v1
REFUND_POLICY_APPROVED=false
REFUND_POLICY_APPROVAL_REFERENCE=
REFUND_REQUEST_WINDOW_HOURS=72
REFUND_REVIEW_SLA_HOURS=24
REFUND_RESOLUTION_SLA_HOURS=72
ORDER_RESPONSE_WINDOW_MINUTES=10
# Order chat is only available shortly before and through a paid service, with
# a brief wrap-up period. Completed orders remain history-only.
ORDER_CHAT_PRE_SERVICE_WINDOW_MINUTES=15
ORDER_CHAT_POST_SERVICE_WINDOW_MINUTES=15
ORDER_RESCHEDULE_RESPONSE_WINDOW_MINUTES=720
# Database-driven expiry for unresolved reschedule negotiations. Keep enabled
# outside isolated tests; setting it false is an explicit operational pause.
ORDER_RESCHEDULE_EXPIRY_ENABLED=true
ORDER_RESCHEDULE_EXPIRY_INTERVAL_SECONDS=60
ORDER_RESCHEDULE_EXPIRY_BATCH_SIZE=50
ORDER_MAX_SCHEDULE_DAYS=30
ORDER_INTAKE_ENABLED=true
ORDER_MAX_OPEN_TOTAL=500
ORDER_MAX_OPEN_PER_USER=3
ORDER_MAX_PENDING_PER_COMPANION=20
PAYOUT_CLAIMS_ENABLED=true
SUPPORT_RESPONSE_HOURS=24
SUPPORT_MAX_OPEN_PER_USER=5
SUPPORT_PUBLIC_SERVICE_HOURS=工作日 09:00-18:00（北京时间）
SUPPORT_PUBLIC_STATUS_URL=https://status.example.invalid
DATA_EXPORT_DELIVERY_BASE_URL=https://vault.example.invalid
DATA_EXPORT_DELIVERY_API_KEY=dev-data-export-provider-key
DATA_EXPORT_DELIVERY_TIMEOUT_MS=10000
DATA_EXPORT_MAX_BYTES=52428800
COMPANION_APPEAL_SUBMISSION_DAYS=30
COMPANION_APPEAL_RESPONSE_HOURS=72
COMPANION_REMEDIATION_OVERDUE_WORKER_ENABLED=true
COMPANION_REMEDIATION_OVERDUE_WORKER_INTERVAL_SECONDS=60
COMPANION_REMEDIATION_OVERDUE_WORKER_BATCH_SIZE=50

# Bearer token for /metrics. Staging and production require at least 32 characters.
METRICS_TOKEN=

# Mock WeChat notify shared secret (development/test only; >=32 chars). Staging/production never enable Mock.
MOCK_WECHAT_NOTIFY_SECRET=dev-only-mock-wechat-notify-secret-32b

# Server-authoritative legal document definition; keep aligned with Mini Program release config.
LEGAL_CONSENT_VERSION=2.2-2026-08-01
LEGAL_CONSENT_EFFECTIVE_DATE=2026-08-01
LEGAL_PRIVACY_URL=https://api.talkandtalk.app/legal/privacy.html
LEGAL_TERMS_URL=https://api.talkandtalk.app/legal/terms.html
LEGAL_PLATFORM_RULES_URL=https://api.talkandtalk.app/api/v1/legal/platform-rules
LEGAL_OPERATOR_NAME=Talk&Talk 开发环境运营方（不可用于对外发布）
LEGAL_CONTACT_EMAIL=dev@example.invalid
LEGAL_CONTACT_PHONE=000-0000-0000
LEGAL_COMPLAINT_CHANNEL=开发环境客服渠道（不可用于对外发布）
LEGAL_PRIVACY_RETENTION_DAYS=1095
ACCOUNT_DELETION_RETENTION_POLICY_APPROVED=false
ACCOUNT_DELETION_RETENTION_POLICY_APPROVAL_REFERENCE=
ACCOUNT_DATA_RETENTION_LEGAL_HOLD_POLICY_APPROVED=false
ACCOUNT_DATA_RETENTION_LEGAL_HOLD_POLICY_VERSION=development-v1
ACCOUNT_DATA_RETENTION_LEGAL_HOLD_POLICY_APPROVAL_REFERENCE=
ACCOUNT_DATA_RETENTION_LEGAL_HOLD_REASON_CODES_JSON=[]
# Deliberate No-Go default. The app still shows the embedded 110/120 baseline,
# but must not claim an approved broader crisis-resource directory.
CRISIS_RESOURCES_APPROVED=false
CRISIS_RESOURCES_APPROVAL_REFERENCE=
