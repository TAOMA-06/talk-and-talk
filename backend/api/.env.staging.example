# Staging deployment — copy to .env.staging and fill secrets before deploy.
NODE_ENV=production
APP_ENV=staging
HOST=0.0.0.0
PORT=3000
API_PREFIX=api/v1
APP_VERSION=0.1.0-staging

# Compose interpolation variables. Deploy with --env-file backend/api/.env.staging.
DEPLOY_ENV_FILE=../backend/api/.env.staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASSWORD
WECHAT_PAY_PRIVATE_KEY_HOST_PATH=./secrets/mock-private-key.txt

DATABASE_URL=postgres://talk:CHANGE_ME_STAGING_POSTGRES_PASSWORD@postgres:5432/talk_and_talk
# Must match REDIS_PASSWORD above.
REDIS_URL=redis://:CHANGE_ME_STAGING_REDIS_PASSWORD@redis:6379
CORS_ORIGINS=https://api-staging.talkandtalk.app

JWT_ACCESS_SECRET=CHANGE_ME_STAGING_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_REFRESH
AUTH_IDENTITY_TOMBSTONE_HMAC_KEYS={"staging-v1":"Q0hBTkdFX01FX1NUQUdJTkdfQVVUSF9UT01CU1RPTkVfS0VZXzMyX0JZVEVT"}
AUTH_IDENTITY_TOMBSTONE_ACTIVE_KEY_ID=staging-v1
AUTH_IDENTITY_REREGISTRATION_POLICY=after_tombstone_expiry
# Canonical duration format: <positive integer><s|m|h|d>. Access must be 5m-1h;
# refresh must be 1h-90d and strictly longer than access.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
REVIEW_JWT_ACCESS_SECRET=CHANGE_ME_STAGING_REVIEW_ACCESS
REVIEW_JWT_REFRESH_SECRET=CHANGE_ME_STAGING_REVIEW_REFRESH
REVIEW_JWT_ACCESS_TTL=15m
REVIEW_JWT_REFRESH_TTL=8h
SMS_CODE_TTL_SECONDS=300

# Staging uses the same privacy boundary as production: no user-authored text
# is transmitted to a generic external AI service.
EXTERNAL_AI_USER_CONTENT_ENABLED=false

# Keep disabled until a real, registered storage + analysis adapter is deployed.
# mock is acceptable only for non-customer development tests.
MEDIA_FEATURE_ENABLED=false
MEDIA_PROVIDER=disabled

# Enable only after staging has completed a two-party true-device voice test.
TRTC_ENABLED=false
TRTC_SDK_APP_ID=
TRTC_SDK_SECRET_KEY=
TRTC_CALLBACK_SIGNING_KEY=
TRTC_PRIVATE_MAP_KEY_ENABLED=false
TRTC_USER_SIG_TTL_SECONDS=300
TRTC_PRIVACY_DISCLOSURE_APPROVED=false
TRTC_PRIVACY_DISCLOSURE_REFERENCE=
TRTC_ROOM_CONTROL_ENABLED=false
# Temporary incident drain only. Keep both primary TRTC flags true while this
# is true so the server can reject new entry and close existing rooms.
TRTC_EMERGENCY_STOP_ENABLED=false
TRTC_CONTROL_REGION=ap-guangzhou
TRTC_CONTROL_TIMEOUT_MS=5000
TRTC_ROOM_CONTROL_INTERVAL_SECONDS=15
TRTC_ROOM_CONTROL_BATCH_SIZE=10
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SECURITY_TOKEN=

WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
# CloudBase alternative: inject the PEM through WECHAT_PAY_PRIVATE_KEY.
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat_private_key.pem
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_NOTIFY_BASE_URL=https://api-staging.talkandtalk.app
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=

APPLE_SIGN_IN_BUNDLE_ID=com.talkandtalk.app

SMS_PROVIDER=mock
STAFF_TOTP_ENCRYPTION_KEY=CHANGE_ME_STAGING_STAFF_TOTP_KEY_32_CHARS_MINIMUM
REVIEW_TOTP_ENCRYPTION_KEY=CHANGE_ME_STAGING_REVIEW_TOTP_KEY_32_CHARS_MINIMUM
RATE_LIMIT_PER_MINUTE=120
BODY_SIZE_LIMIT=1mb
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=60
PAYMENT_RECONCILIATION_BATCH_SIZE=50
WECHAT_DAILY_BILL_RECONCILIATION_ENABLED=false
WECHAT_DAILY_BILL_RECONCILIATION_APPROVED=false
WECHAT_DAILY_BILL_RECONCILIATION_APPROVAL_REFERENCE=
WECHAT_DAILY_BILL_RECONCILIATION_START_DATE=
WECHAT_DAILY_BILL_RECONCILIATION_HOUR=10
WECHAT_DAILY_BILL_RECONCILIATION_BATCH_SIZE=4
WECHAT_PAY_COMPLAINTS_ENABLED=true
WECHAT_PAY_COMPLAINT_POLL_INTERVAL_SECONDS=300
WECHAT_PAY_COMPLAINT_BATCH_SIZE=50
METRICS_TOKEN=CHANGE_ME_STAGING_METRICS_TOKEN_32CHARS
LEGAL_CONSENT_VERSION=2.2-2026-08-01
LEGAL_CONSENT_EFFECTIVE_DATE=2026-08-01
LEGAL_PRIVACY_URL=https://api-staging.talkandtalk.app/legal/privacy.html
LEGAL_TERMS_URL=https://api-staging.talkandtalk.app/legal/terms.html
LEGAL_PLATFORM_RULES_URL=https://api-staging.talkandtalk.app/api/v1/legal/platform-rules
LEGAL_OPERATOR_NAME=Talk&Talk Staging（不可用于对外发布）
LEGAL_CONTACT_EMAIL=staging@example.invalid
LEGAL_CONTACT_PHONE=000-0000-0000
LEGAL_COMPLAINT_CHANNEL=Staging 工单（不可用于对外发布）
LEGAL_PRIVACY_RETENTION_DAYS=1095
ACCOUNT_DELETION_RETENTION_POLICY_APPROVED=false
ACCOUNT_DELETION_RETENTION_POLICY_APPROVAL_REFERENCE=
ACCOUNT_DATA_RETENTION_LEGAL_HOLD_POLICY_APPROVED=false
ACCOUNT_DATA_RETENTION_LEGAL_HOLD_POLICY_VERSION=2026.08-staging-v1
ACCOUNT_DATA_RETENTION_LEGAL_HOLD_POLICY_APPROVAL_REFERENCE=
ACCOUNT_DATA_RETENTION_LEGAL_HOLD_REASON_CODES_JSON=[]
CRISIS_RESOURCES_APPROVED=false
CRISIS_RESOURCES_APPROVAL_REFERENCE=

COMMERCIAL_RELEASE_MODE=paidPilot
COMPANION_VOICE_EVIDENCE_VIEWER_URL=https://evidence-staging.talkandtalk.app/voice-intro
COMPANION_VOICE_EVIDENCE_SIGNING_SECRET=CHANGE_ME_STAGING_VOICE_EVIDENCE_SECRET
COMPANION_VOICE_EVIDENCE_URL_TTL_SECONDS=300
PLATFORM_FEE_BPS=1200
COMPANION_SETTLEMENT_HOLD_HOURS=96
REFUND_POLICY_VERSION=2026.08-staging-v1
REFUND_POLICY_APPROVED=false
REFUND_POLICY_APPROVAL_REFERENCE=
REFUND_REQUEST_WINDOW_HOURS=72
REFUND_REVIEW_SLA_HOURS=24
REFUND_RESOLUTION_SLA_HOURS=72
ORDER_RESPONSE_WINDOW_MINUTES=10
# Keep the same bounded chat window as production during two-party acceptance:
# paid-service logistics before start, then a short wrap-up; history remains readable.
ORDER_CHAT_PRE_SERVICE_WINDOW_MINUTES=15
ORDER_CHAT_POST_SERVICE_WINDOW_MINUTES=15
ORDER_MAX_SCHEDULE_DAYS=30
ORDER_INTAKE_ENABLED=true
ORDER_MAX_OPEN_TOTAL=500
ORDER_MAX_OPEN_PER_USER=3
ORDER_MAX_PENDING_PER_COMPANION=20
PAYOUT_CLAIMS_ENABLED=true
SUPPORT_RESPONSE_HOURS=24
SUPPORT_MAX_OPEN_PER_USER=5
SUPPORT_PUBLIC_SERVICE_HOURS=工作日 09:00-18:00（北京时间）
SUPPORT_PUBLIC_STATUS_URL=https://status-staging.example.invalid
DATA_EXPORT_DELIVERY_BASE_URL=https://vault-staging.example.invalid
DATA_EXPORT_DELIVERY_API_KEY=REPLACE_ME_STAGING_DATA_EXPORT_PROVIDER_KEY
DATA_EXPORT_DELIVERY_TIMEOUT_MS=10000
DATA_EXPORT_MAX_BYTES=52428800
COMPANION_APPEAL_SUBMISSION_DAYS=30
COMPANION_APPEAL_RESPONSE_HOURS=72
COMPANION_REMEDIATION_OVERDUE_WORKER_ENABLED=true
COMPANION_REMEDIATION_OVERDUE_WORKER_INTERVAL_SECONDS=60
COMPANION_REMEDIATION_OVERDUE_WORKER_BATCH_SIZE=50
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_DELIVERY_INTERVAL_SECONDS=30
NOTIFICATION_DELIVERY_BATCH_SIZE=20
WECHAT_SUBSCRIBE_MESSAGES_ENABLED=false
WECHAT_SUBSCRIBE_TEMPLATES_JSON=

# Exercise the same durable, bounded internal fanout/preflight path as
# production. Provider delivery remains independently disabled below.
AVAILABILITY_REMINDER_PREPARATION_ENABLED=true
AVAILABILITY_REMINDER_PREPARATION_INTERVAL_SECONDS=60
AVAILABILITY_REMINDER_PREPARATION_BATCH_SIZE=20
AVAILABILITY_REMINDER_FANOUT_BATCH_SIZE=200
AVAILABILITY_REMINDER_FANOUT_BATCHES_PER_RUN=20
AVAILABILITY_REMINDER_FANOUT_LEASE_SECONDS=120
AVAILABILITY_REMINDER_FANOUT_MAX_FAILURES=8
AVAILABILITY_REMINDER_FANOUT_RETRY_BASE_SECONDS=30

# Keep real availability-reminder delivery off until this deployment has an
# approved availabilityReminder template and explicit operational approval.
AVAILABILITY_REMINDER_DELIVERY_ENABLED=false
AVAILABILITY_REMINDER_DELIVERY_INTERVAL_SECONDS=60
AVAILABILITY_REMINDER_DELIVERY_BATCH_SIZE=20

# Run seed on first staging boot only; set false after initial data load.
SEED_ON_STARTUP=true
