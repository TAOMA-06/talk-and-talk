# Staging deployment — copy to .env.staging and fill secrets before deploy.
NODE_ENV=production
APP_ENV=staging
HOST=0.0.0.0
PORT=3000
API_PREFIX=api/v1
APP_VERSION=0.1.0-staging

# Compose interpolation variables. Deploy with --env-file backend/api/.env.staging.
DEPLOY_ENV_FILE=../backend/api/.env.staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASSWORD
WECHAT_PAY_PRIVATE_KEY_HOST_PATH=./secrets/mock-private-key.txt

DATABASE_URL=postgres://talk:CHANGE_ME_STAGING_POSTGRES_PASSWORD@postgres:5432/talk_and_talk
# Must match REDIS_PASSWORD above.
REDIS_URL=redis://:CHANGE_ME_STAGING_REDIS_PASSWORD@redis:6379
CORS_ORIGINS=https://api-staging.talkandtalk.app

JWT_ACCESS_SECRET=CHANGE_ME_STAGING_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_REFRESH
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SMS_CODE_TTL_SECONDS=300

DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Keep disabled until a real, registered storage + analysis adapter is deployed.
# mock is acceptable only for non-customer development tests.
MEDIA_FEATURE_ENABLED=false
MEDIA_PROVIDER=disabled

WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
# CloudBase alternative: inject the PEM through WECHAT_PAY_PRIVATE_KEY.
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat_private_key.pem
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_NOTIFY_BASE_URL=https://api-staging.talkandtalk.app
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=

APPLE_SIGN_IN_BUNDLE_ID=com.talkandtalk.app

SMS_PROVIDER=mock
STAFF_TOTP_ENCRYPTION_KEY=CHANGE_ME_STAGING_STAFF_TOTP_KEY_32_CHARS_MINIMUM
RATE_LIMIT_PER_MINUTE=120
BODY_SIZE_LIMIT=1mb
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=60
PAYMENT_RECONCILIATION_BATCH_SIZE=50
METRICS_TOKEN=CHANGE_ME_STAGING_METRICS_TOKEN
LEGAL_CONSENT_VERSION=2.0-2026-07-20
LEGAL_CONSENT_EFFECTIVE_DATE=2026-07-20
LEGAL_PRIVACY_URL=https://api-staging.talkandtalk.app/legal/privacy.html
LEGAL_TERMS_URL=https://api-staging.talkandtalk.app/legal/terms.html
LEGAL_PLATFORM_RULES_URL=https://api-staging.talkandtalk.app/api/v1/legal/platform-rules
LEGAL_OPERATOR_NAME=Talk&Talk Staging（不可用于对外发布）
LEGAL_CONTACT_EMAIL=staging@example.invalid
LEGAL_CONTACT_PHONE=000-0000-0000
LEGAL_COMPLAINT_CHANNEL=Staging 工单（不可用于对外发布）
LEGAL_PRIVACY_RETENTION_DAYS=1095

COMMERCIAL_RELEASE_MODE=paidPilot
PLATFORM_FEE_BPS=1200
COMPANION_SETTLEMENT_HOLD_HOURS=96
REFUND_REQUEST_WINDOW_HOURS=72
ORDER_RESPONSE_WINDOW_MINUTES=10
ORDER_MAX_SCHEDULE_DAYS=30
ORDER_INTAKE_ENABLED=true
ORDER_MAX_OPEN_TOTAL=500
ORDER_MAX_OPEN_PER_USER=3
ORDER_MAX_PENDING_PER_COMPANION=20
PAYOUT_CLAIMS_ENABLED=true
SUPPORT_RESPONSE_HOURS=24
SUPPORT_MAX_OPEN_PER_USER=5
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_DELIVERY_INTERVAL_SECONDS=30
NOTIFICATION_DELIVERY_BATCH_SIZE=20
WECHAT_SUBSCRIBE_MESSAGES_ENABLED=false
WECHAT_SUBSCRIBE_TEMPLATES_JSON=

# Run seed on first staging boot only; set false after initial data load.
SEED_ON_STARTUP=true
