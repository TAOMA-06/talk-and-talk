# Staging deployment — copy to .env.staging and fill secrets before deploy.
NODE_ENV=production
APP_ENV=staging
HOST=0.0.0.0
PORT=3000
API_PREFIX=api/v1
APP_VERSION=0.1.0-staging

# Compose interpolation variables. Deploy with --env-file backend/api/.env.staging.
DEPLOY_ENV_FILE=../backend/api/.env.staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASSWORD
WECHAT_PAY_PRIVATE_KEY_HOST_PATH=./secrets/mock-private-key.txt

DATABASE_URL=postgres://talk:CHANGE_ME_STAGING_POSTGRES_PASSWORD@postgres:5432/talk_and_talk
# Must match REDIS_PASSWORD above.
REDIS_URL=redis://:CHANGE_ME_STAGING_REDIS_PASSWORD@redis:6379
CORS_ORIGINS=https://api-staging.talkandtalk.app

JWT_ACCESS_SECRET=CHANGE_ME_STAGING_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_REFRESH
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SMS_CODE_TTL_SECONDS=300

DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat_private_key.pem
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_NOTIFY_BASE_URL=https://api-staging.talkandtalk.app
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=

APPLE_SIGN_IN_BUNDLE_ID=com.talkandtalk.app

SMS_PROVIDER=mock
STAFF_TOTP_ENCRYPTION_KEY=CHANGE_ME_STAGING_STAFF_TOTP_KEY_32_CHARS_MINIMUM
RATE_LIMIT_PER_MINUTE=120
BODY_SIZE_LIMIT=1mb
METRICS_TOKEN=CHANGE_ME_STAGING_METRICS_TOKEN
LEGAL_CONSENT_VERSION=1.0-2026-07-19
LEGAL_PRIVACY_URL=https://api.talkandtalk.app/legal/privacy.html
LEGAL_TERMS_URL=https://api.talkandtalk.app/legal/terms.html

# Run seed on first staging boot only; set false after initial data load.
SEED_ON_STARTUP=true
