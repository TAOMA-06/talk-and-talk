# Production deployment — copy to .env.production and fill secrets before deploy.
NODE_ENV=production
APP_ENV=production
HOST=0.0.0.0
PORT=3000
API_PREFIX=api/v1
APP_VERSION=0.1.0

# Compose interpolation variables. Deploy with --env-file backend/api/.env.production.
DEPLOY_ENV_FILE=../backend/api/.env.production
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
WECHAT_PAY_PRIVATE_KEY_HOST_PATH=./secrets/wechat_private_key.pem

DATABASE_URL=postgres://talk:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/talk_and_talk
# Must match docker-compose.prod.yml REDIS_PASSWORD (requirepass).
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379
CORS_ORIGINS=https://api.talkandtalk.app

# Use two different cryptographically random values of at least 32 characters.
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_ACCESS_SECRET_32_CHARS_MINIMUM
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_REFRESH_SECRET_32_CHARS_MINIMUM
AUTH_IDENTITY_TOMBSTONE_HMAC_KEYS={"production-v1":"Q0hBTkdFX01FX1JBTkRPTV9BVVRIX1RPTUJTVCUzMl9CWVRFX0tFWQ=="}
AUTH_IDENTITY_TOMBSTONE_ACTIVE_KEY_ID=production-v1
AUTH_IDENTITY_REREGISTRATION_POLICY=after_tombstone_expiry
# Canonical duration format: <positive integer><s|m|h|d>. Access must be 5m-1h;
# refresh must be 1h-90d and strictly longer than access.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
REVIEW_JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_REVIEW_ACCESS_SECRET_32_CHARS_MINIMUM
REVIEW_JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_REVIEW_REFRESH_SECRET_32_CHARS_MINIMUM
REVIEW_JWT_ACCESS_TTL=15m
REVIEW_JWT_REFRESH_TTL=8h
SMS_CODE_TTL_SECONDS=300

# Required explicit fail-closed value. This release sends no user-authored
# content to DeepSeek or another generic external generative-AI service.
EXTERNAL_AI_USER_CONTENT_ENABLED=false

# Keep disabled until a real encrypted storage + image/OCR + transcription
# adapter has been registered and verified in staging. The bundled mock is not
# permitted in production.
MEDIA_FEATURE_ENABLED=false
MEDIA_PROVIDER=disabled

# Real-time voice is separately gated from attachment/media processing. Store
# the SDK secret in CloudBase/secret management only; never put it in the Mini
# Program bundle. Do not set TRTC_ENABLED=true until provider room restriction,
# Mini Program category/permissions, and two-device testing have passed.
TRTC_ENABLED=false
TRTC_SDK_APP_ID=
TRTC_SDK_SECRET_KEY=
TRTC_CALLBACK_SIGNING_KEY=
TRTC_PRIVATE_MAP_KEY_ENABLED=false
TRTC_USER_SIG_TTL_SECONDS=300
# Deliberate No-Go default. Set only after the rendered privacy policy and the
# WeChat privacy guide disclose TRTC and the approval/ticket reference exists.
TRTC_PRIVACY_DISCLOSURE_APPROVED=false
TRTC_PRIVACY_DISCLOSURE_REFERENCE=
# Required together with TRTC_ENABLED=true. Store these in CloudBase/Cloud Run
# secrets and grant only TRTC DismissRoomByStrRoomId on this SDKAppId.
TRTC_ROOM_CONTROL_ENABLED=false
# Temporary incident drain only. Never switch off room control before all
# recorded rooms have been closed and this flag is reset to false.
TRTC_EMERGENCY_STOP_ENABLED=false
TRTC_CONTROL_REGION=ap-guangzhou
TRTC_CONTROL_TIMEOUT_MS=5000
TRTC_ROOM_CONTROL_INTERVAL_SECONDS=15
TRTC_ROOM_CONTROL_BATCH_SIZE=10
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SECURITY_TOKEN=

WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
# CloudBase alternative: inject the PEM through WECHAT_PAY_PRIVATE_KEY.
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat_private_key.pem
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_NOTIFY_BASE_URL=https://api.talkandtalk.app
# Keep this AppSecret in the deployment secret store; never expose it to the Mini Program bundle.
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=

APPLE_SIGN_IN_BUNDLE_ID=

# Mini Program login uses WECHAT_MINIPROGRAM_* above. SMS is disabled until a real provider is wired.
# mock is rejected when APP_ENV=production; none returns SMS_UNAVAILABLE on send-code.
SMS_PROVIDER=none
# Unique 32+ character secret kept in the deployment secret store. Rotating it requires re-provisioning staff TOTP.
STAFF_TOTP_ENCRYPTION_KEY=CHANGE_ME_RANDOM_STAFF_TOTP_KEY_32_CHARS_MINIMUM
REVIEW_TOTP_ENCRYPTION_KEY=CHANGE_ME_RANDOM_REVIEW_TOTP_KEY_32_CHARS_MINIMUM
RATE_LIMIT_PER_MINUTE=120
BODY_SIZE_LIMIT=1mb
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=60
PAYMENT_RECONCILIATION_BATCH_SIZE=50
# Keep approval false until finance has signed the merchant/SOP evidence and
# replace the reference with a non-secret controlled document identifier.
WECHAT_DAILY_BILL_RECONCILIATION_ENABLED=true
WECHAT_DAILY_BILL_RECONCILIATION_APPROVED=false
WECHAT_DAILY_BILL_RECONCILIATION_APPROVAL_REFERENCE=
WECHAT_DAILY_BILL_RECONCILIATION_START_DATE=
WECHAT_DAILY_BILL_RECONCILIATION_HOUR=10
WECHAT_DAILY_BILL_RECONCILIATION_BATCH_SIZE=4
# WeChat Pay Consumer Complaints 2.0 callback endpoint:
# https://<WECHAT_PAY_NOTIFY_BASE_URL>/api/v1/payments/wechat/complaint-notify
WECHAT_PAY_COMPLAINTS_ENABLED=true
WECHAT_PAY_COMPLAINT_POLL_INTERVAL_SECONDS=300
WECHAT_PAY_COMPLAINT_BATCH_SIZE=50
METRICS_TOKEN=CHANGE_ME_RANDOM_METRICS_TOKEN_32_CHARS_MINIMUM
# Durable, consent-based transactional messages. Fill only template IDs that
# are approved for this Mini Program; IDs and field names are release inputs.
NOTIFICATION_DELIVERY_ENABLED=true
NOTIFICATION_DELIVERY_INTERVAL_SECONDS=30
NOTIFICATION_DELIVERY_BATCH_SIZE=20
WECHAT_SUBSCRIBE_MESSAGES_ENABLED=true
WECHAT_SUBSCRIBE_TEMPLATES_JSON=[{"key":"newOrder","templateId":"REPLACE_ME_NEW_ORDER_TEMPLATE_ID","page":"pages/orders/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"orderConfirmed","templateId":"REPLACE_ME_ORDER_CONFIRMED_TEMPLATE_ID","page":"pages/orders/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"orderRejected","templateId":"REPLACE_ME_ORDER_REJECTED_TEMPLATE_ID","page":"pages/orders/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"orderResponseExpired","templateId":"REPLACE_ME_ORDER_EXPIRED_TEMPLATE_ID","page":"pages/orders/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"paymentSuccess","templateId":"REPLACE_ME_PAYMENT_SUCCESS_TEMPLATE_ID","page":"pages/orders/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"serviceStarted","templateId":"REPLACE_ME_SERVICE_STARTED_TEMPLATE_ID","page":"pages/orders/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"serviceCompleted","templateId":"REPLACE_ME_SERVICE_COMPLETED_TEMPLATE_ID","page":"pages/orders/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"orderCancelled","templateId":"REPLACE_ME_ORDER_CANCELLED_TEMPLATE_ID","page":"pages/orders/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"reservationExpired","templateId":"REPLACE_ME_RESERVATION_EXPIRED_TEMPLATE_ID","page":"pages/orders/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"rescheduleRequested","templateId":"REPLACE_ME_RESCHEDULE_REQUESTED_TEMPLATE_ID","page":"pages/orders/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"rescheduleAccepted","templateId":"REPLACE_ME_RESCHEDULE_ACCEPTED_TEMPLATE_ID","page":"pages/orders/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"rescheduleRejected","templateId":"REPLACE_ME_RESCHEDULE_REJECTED_TEMPLATE_ID","page":"pages/orders/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"rescheduleExpired","templateId":"REPLACE_ME_RESCHEDULE_EXPIRED_TEMPLATE_ID","page":"pages/orders/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"rescheduleCancelled","templateId":"REPLACE_ME_RESCHEDULE_CANCELLED_TEMPLATE_ID","page":"pages/orders/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"supportUpdate","templateId":"REPLACE_ME_SUPPORT_UPDATE_TEMPLATE_ID","page":"pages/support/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}},{"key":"messageReceived","templateId":"REPLACE_ME_MESSAGE_RECEIVED_TEMPLATE_ID","page":"pages/messages/index","data":{"thing1":"{{title}}","thing2":"{{body}}"}}]

# Safe internal preparation: a window transaction writes one job; the worker
# expands it in stable bounded pages before preflight. This never calls WeChat.
AVAILABILITY_REMINDER_PREPARATION_ENABLED=true
AVAILABILITY_REMINDER_PREPARATION_INTERVAL_SECONDS=60
AVAILABILITY_REMINDER_PREPARATION_BATCH_SIZE=20
AVAILABILITY_REMINDER_FANOUT_BATCH_SIZE=200
AVAILABILITY_REMINDER_FANOUT_BATCHES_PER_RUN=20
AVAILABILITY_REMINDER_FANOUT_LEASE_SECONDS=120
AVAILABILITY_REMINDER_FANOUT_MAX_FAILURES=8
AVAILABILITY_REMINDER_FANOUT_RETRY_BASE_SECONDS=30

# This crosses the one-time authorization/provider boundary. Keep it false
# until the template list includes an approved availabilityReminder template
# and operations explicitly enables, observes, and can disable this runner.
AVAILABILITY_REMINDER_DELIVERY_ENABLED=false
AVAILABILITY_REMINDER_DELIVERY_INTERVAL_SECONDS=60
AVAILABILITY_REMINDER_DELIVERY_BATCH_SIZE=20

# Paid-pilot settlement is ledger + operator-confirmed transfer, not automatic
# payout. PLATFORM_FEE_BPS may be 0 but must be an explicit business decision.
COMMERCIAL_RELEASE_MODE=commercial
# First commercial launch surface. text_only hard-locks voice SKUs, rooms, and chat media
# even if TRTC/MEDIA flags are later mis-set (config validation also rejects that combo).
COMMERCIAL_SURFACE=text_only
# External controlled viewer used only through short-lived HMAC-signed admin URLs.
# The signing secret must be a non-placeholder value with at least 32 characters.
COMPANION_VOICE_EVIDENCE_VIEWER_URL=https://evidence.talkandtalk.example/voice-intro
COMPANION_VOICE_EVIDENCE_SIGNING_SECRET=CHANGE_ME_RANDOM_VOICE_EVIDENCE_SECRET_32_CHARS_MINIMUM
COMPANION_VOICE_EVIDENCE_URL_TTL_SECONDS=300
PLATFORM_FEE_BPS=0
COMPANION_SETTLEMENT_HOLD_HOURS=96
# Deliberate No-Go: set APPROVED=true and record the external legal/operations
# approval reference only after this exact version and window are approved.
REFUND_POLICY_VERSION=2026.08-v1
REFUND_POLICY_APPROVED=false
REFUND_POLICY_APPROVAL_REFERENCE=
REFUND_REQUEST_WINDOW_HOURS=72
REFUND_REVIEW_SLA_HOURS=24
REFUND_RESOLUTION_SLA_HOURS=72
ORDER_RESPONSE_WINDOW_MINUTES=10
# Required commercial boundary: ordinary order chat closes after the short
# service wrap-up, while completed-order history remains readable.
ORDER_CHAT_PRE_SERVICE_WINDOW_MINUTES=15
ORDER_CHAT_POST_SERVICE_WINDOW_MINUTES=15
ORDER_MAX_SCHEDULE_DAYS=30
ORDER_INTAKE_ENABLED=true
ORDER_MAX_OPEN_TOTAL=500
ORDER_MAX_OPEN_PER_USER=3
ORDER_MAX_PENDING_PER_COMPANION=20
PAYOUT_CLAIMS_ENABLED=true
SUPPORT_RESPONSE_HOURS=24
SUPPORT_MAX_OPEN_PER_USER=5
SUPPORT_PUBLIC_SERVICE_HOURS=REPLACE_ME_PUBLIC_SUPPORT_SERVICE_HOURS
SUPPORT_PUBLIC_STATUS_URL=https://REPLACE_ME_PUBLIC_STATUS_HOST
DATA_EXPORT_DELIVERY_BASE_URL=https://REPLACE_ME_PRIVATE_EXPORT_VAULT_HOST
DATA_EXPORT_DELIVERY_API_KEY=REPLACE_ME_DATA_EXPORT_PROVIDER_KEY
DATA_EXPORT_DELIVERY_TIMEOUT_MS=10000
DATA_EXPORT_MAX_BYTES=52428800
COMPANION_APPEAL_SUBMISSION_DAYS=30
COMPANION_APPEAL_RESPONSE_HOURS=72
COMPANION_REMEDIATION_OVERDUE_WORKER_ENABLED=true
COMPANION_REMEDIATION_OVERDUE_WORKER_INTERVAL_SECONDS=60
COMPANION_REMEDIATION_OVERDUE_WORKER_BATCH_SIZE=50
LEGAL_CONSENT_VERSION=2.2-2026-08-01
LEGAL_CONSENT_EFFECTIVE_DATE=2026-08-01
LEGAL_PRIVACY_URL=https://api.talkandtalk.app/legal/privacy.html
LEGAL_TERMS_URL=https://api.talkandtalk.app/legal/terms.html
LEGAL_PLATFORM_RULES_URL=https://api.talkandtalk.app/api/v1/legal/platform-rules
LEGAL_OPERATOR_NAME=REPLACE_ME_LEGAL_ENTITY_NAME
LEGAL_CONTACT_EMAIL=replace-me@example.com
LEGAL_CONTACT_PHONE=REPLACE_ME_COMPLAINT_PHONE
LEGAL_COMPLAINT_CHANNEL=REPLACE_ME_IN_APP_OR_EMAIL_COMPLAINT_CHANNEL
LEGAL_PRIVACY_RETENTION_DAYS=1095
# Deliberate No-Go default: legal/compliance must approve the policy and supply a non-secret reference.
ACCOUNT_DELETION_RETENTION_POLICY_APPROVED=false
ACCOUNT_DELETION_RETENTION_POLICY_APPROVAL_REFERENCE=
# Deliberate No-Go default: legal/compliance must approve legal-hold reasons,
# scope each reason to exact retention categories, and provide a release record.
ACCOUNT_DATA_RETENTION_LEGAL_HOLD_POLICY_APPROVED=false
ACCOUNT_DATA_RETENTION_LEGAL_HOLD_POLICY_VERSION=2026.08-v1
ACCOUNT_DATA_RETENTION_LEGAL_HOLD_POLICY_APPROVAL_REFERENCE=
ACCOUNT_DATA_RETENTION_LEGAL_HOLD_REASON_CODES_JSON=[]
# Deliberate No-Go default: safety/operations must approve the dated official
# resource catalog and supply a non-secret release record reference.
CRISIS_RESOURCES_APPROVED=false
CRISIS_RESOURCES_APPROVAL_REFERENCE=

# Never auto-seed production. Provision staff through an approved operational identity process.
SEED_ON_STARTUP=false
