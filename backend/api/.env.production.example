# Production deployment — copy to .env.production and fill secrets before deploy.
NODE_ENV=production
APP_ENV=production
PORT=3000
API_PREFIX=api/v1
APP_VERSION=0.1.0

DATABASE_URL=postgres://talk:CHANGE_ME@postgres:5432/talk_and_talk
# Must match docker-compose.prod.yml REDIS_PASSWORD (requirepass).
REDIS_URL=redis://:CHANGE_ME_REDIS@redis:6379
CORS_ORIGINS=https://api.talkandtalk.app

JWT_ACCESS_SECRET=CHANGE_ME_PRODUCTION_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_PRODUCTION_REFRESH
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SMS_CODE_TTL_SECONDS=300

DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat_private_key.pem
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_NOTIFY_BASE_URL=https://api.talkandtalk.app
# Keep this AppSecret in the deployment secret store; never expose it to the Mini Program bundle.
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=

APPLE_SIGN_IN_BUNDLE_ID=com.talkandtalk.app

# Production login strategy: Apple only until real SMS (aliyun/tencent) is wired.
# mock is rejected when APP_ENV=production; none returns SMS_UNAVAILABLE on send-code.
SMS_PROVIDER=none
RATE_LIMIT_PER_MINUTE=120
BODY_SIZE_LIMIT=1mb

# Never auto-seed production. Run prisma seed once manually, then rotate staff accounts.
SEED_ON_STARTUP=false

# Optional compose host vars (see docker-compose.prod.yml):
# POSTGRES_PASSWORD=...
# REDIS_PASSWORD=...   # must match REDIS_URL password
# WECHAT_PAY_PRIVATE_KEY_HOST_PATH=./secrets/wechat_private_key.pem
