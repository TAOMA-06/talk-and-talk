  @@index([purpose, attendanceDisputeId, uploaderId, status, createdAt], map: "MediaAsset_attendance_evidence_scope")
  @@index([purpose, companionId, uploaderId, status, createdAt], map: "MediaAsset_incident_evidence_scope")
  @@index([purpose, status, nextAttemptAt, moderationProcessingAt, createdAt], map: "MediaAsset_controlled_moderation_queue")
  @@index([messageId])
  @@index([expiresAt])
  @@index([storageDeletedAt, expiresAt, storageDeleteNextAttemptAt, id], map: "MediaAsset_storage_delete_due")
  @@index([storageDeleteLeaseExpiresAt, id], map: "MediaAsset_storage_delete_lease")
}

model MessageReadState {
