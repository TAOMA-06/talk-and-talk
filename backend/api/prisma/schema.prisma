// releasedAt so it cannot drift from the immutable placement/release actions.
model AccountDataRetentionLegalHold {
  id                String    @id @default(uuid())
  retentionRecordId String
  placementActionId String    @unique(map: "RetentionLegalHold_placementActionId_key")
  placedById        String
  placedAt          DateTime
  releaseActionId   String?   @unique(map: "RetentionLegalHold_releaseActionId_key")
  releasedById      String?
  releasedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  retentionRecord AccountDataRetentionRecord            @relation(fields: [retentionRecordId], references: [id], onDelete: Restrict, map: "RetentionLegalHold_record_fkey")
  placementAction AccountDataRetentionLegalHoldAction   @relation("RetentionLegalHoldPlacementAction", fields: [placementActionId], references: [id], onDelete: Restrict, map: "RetentionLegalHold_placementAction_fkey")
  releaseAction   AccountDataRetentionLegalHoldAction?  @relation("RetentionLegalHoldReleaseAction", fields: [releaseActionId], references: [id], onDelete: Restrict, map: "RetentionLegalHold_releaseAction_fkey")
  releaseRequests AccountDataRetentionLegalHoldAction[] @relation("RetentionLegalHoldReleaseRequests")
  placedBy        User                                  @relation("RetentionLegalHoldPlacer", fields: [placedById], references: [id], onDelete: Restrict, map: "RetentionLegalHold_placedBy_fkey")
  releasedBy      User?                                 @relation("RetentionLegalHoldReleaser", fields: [releasedById], references: [id], onDelete: Restrict, map: "RetentionLegalHold_releasedBy_fkey")

  @@index([retentionRecordId, releasedAt, placedAt, id], map: "RetentionLegalHold_record_state")
}

