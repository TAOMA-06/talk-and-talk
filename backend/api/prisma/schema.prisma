generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  companion
  moderator
  admin
}

enum AuthProvider {
  phone
  apple
  wechatMiniProgram
}

enum AccountStatus {
  active
  restricted
  banned
}

enum Availability {
  online
  available
  busy
}

enum CompanionServiceOfferingMode {
  text
  voice
}

enum MessageType {
  text
  image
  audio
  system
  safety
}

enum MessageModerationStatus {
  queued
  pendingReview
  published
  blocked
  removed
}

enum MessageVisibility {
  participants
  senderOnly
  staffOnly
}

enum MediaAssetKind {
  image
  audio
}

enum MediaAssetStatus {
  reserved
  uploaded
  scanning
  approved
  blocked
  expired
  failed
}

enum ModerationDecision {
  allow
  warn
  block
  review
}

enum RiskLevel {
  low
  medium
  high
}

enum ModerationSource {
  chat
  community
  report
  profile
}

enum ModerationCaseStatus {
  pending
  autoReviewing
  humanReview
  resolved
  dismissed
}

enum ModerationPriority {
  normal
  high
  critical
}

enum ModerationAppealStatus {
  pending
  upheld
  overturned
  dismissed
}

enum ChatRestrictionSource {
  automatic
  manual
}

enum OrderStatus {
  pending
  paying
  paid
  inService
  completed
  cancelled
  refunded
}

// A reschedule is intentionally a separate negotiation record instead of an
// OrderStatus. That keeps the paid/refund lifecycle intact and leaves a durable
// account of both appointment times even after the request is resolved.
enum OrderRescheduleRequestStatus {
  pending
  accepted
  rejected
  expired
  cancelled
}

enum OrderRescheduleRequesterRole {
  customer
  companion
}

// Timeline events are customer/companion-facing operational facts, not an
// alias for the internal AuditLog. They deliberately exclude private evidence
// and staff-only moderation or settlement metadata.
enum OrderTimelineEventType {
  orderCreated
  rescheduleRequested
  rescheduleAccepted
  rescheduleRejected
  rescheduleExpired
  rescheduleCancelled
}

enum OrderTimelineActorRole {
  customer
  companion
  system
}

enum PaymentTxnStatus {
  initiated
  success
  failed
  closed
}

enum RefundTxnStatus {
  pendingReview
  pending
  processing
  success
  failed
  rejected
}

enum CommunityPostKind {
  femaleRequest
  malePromotion
}

enum CommunityPostStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  paymentSuccess
  orderStatus
  moderationAlert
  safetyAlert
  supportUpdate
  messageReceived
}

enum NotificationDeliveryStatus {
  pending
  processing
  sent
  skipped
  failed
}

enum CompanionEarningStatus {
  pending
  available
  held
  paid
  void
}

enum CompanionRecoveryStatus {
  due
  pendingVerification
  recovered
}

enum CompanionRecoveryReason {
  confirmedPaidBeforeRefund
  payoutStateUncertain
}

enum CompanionCommercialStatus {
  pendingReview
  verified
  suspended
}

enum SupportTicketCategory {
  orderIssue
  refund
  safety
  privacy
  general
}

enum SupportTicketStatus {
  open
  inProgress
  resolved
  closed
}

enum SupportTicketPriority {
  normal
  high
  urgent
}

// A reminder candidate is evaluated once before any future delivery stage.
// The decision stays private operational state: it is neither a notification
// nor evidence that an external provider has been called.
enum AvailabilityReminderCandidateDecision {
  pending
  eligible
  skipped
}

// Keep persisted skip outcomes deliberately generic. They are useful for
// internal audit and retry analysis without exposing a customer's private
// preference, order, authorization, or profile details.
enum AvailabilityReminderCandidateSkipReason {
  favoriteUnavailable
  authorizationUnavailable
  availabilityUnavailable
  rateLimited
}

// A private authorization binding is deliberately separate from both a
// candidate and a provider delivery. Reservation, consumption, and lease
// states alone never claim that a remote message was attempted or delivered;
// only a later explicit provider outcome may do so.
enum AvailabilityReminderAttemptStatus {
  reserved
  readyToSend
  sending
  sent
  skipped
  failedBeforeSend
  rejected
  uncertain
}

// These are private state-machine outcomes, not recipient-visible delivery
// results. `uncertain` records a lost lease or unknown remote outcome without
// ever claiming that a provider call succeeded.
enum AvailabilityReminderAttemptOutcomeReason {
  favoriteUnavailable
  authorizationUnavailable
  availabilityUnavailable
  rateLimited
  handoffUnavailable
  preflightUnavailable
  sendLeaseExpired
  providerSkipped
  providerPreSendFailed
  providerRejected
  providerUnknown
}

enum LegalDocumentKind {
  terms
  privacy
  platformRules
}

enum DeletionRequestStatus {
  pending
  processing
  completed
  cancelled
}

enum LegalConsentSource {
  wechatMiniProgram
}

enum RecommendationPlacement {
  discoverHome
  communityRelated
  orderFollowup
}

enum RecommendationPolicyStatus {
  active
  paused
}

enum RecommendationTagSource {
  behavioral
}

model User {
  id                                  String                               @id @default(uuid())
  role                                UserRole                             @default(user)
  accountStatus                       AccountStatus                        @default(active)
  createdAt                           DateTime                             @default(now())
  updatedAt                           DateTime                             @updatedAt
  identities                          AuthIdentity[]
  staffCredential                     StaffCredential?
  profile                             UserProfile?
  refreshTokens                       RefreshToken[]
  conversations                       Conversation[]
  readStates                          MessageReadState[]
  conversationNotificationPreferences ConversationNotificationPreference[]
  conversationBlocks                  ConversationBlock[]                  @relation("ConversationBlocker")
  orders                              Order[]
  notifications                       Notification[]
  notificationDeliveries              NotificationDelivery[]
  subscriptionGrants                  WeChatSubscriptionGrant[]
  supportTickets                      SupportTicket[]                      @relation("SupportRequester")
  assignedSupportTickets              SupportTicket[]                      @relation("SupportAssignee")
  orderSupportFacts                   OrderSupportFact[]
  deletionRequests                    AccountDeletionRequest[]
  legalConsentReceipts                LegalConsentReceipt[]
  companionProfile                    CompanionProfile?                    @relation("CompanionOwner")
  communityPosts                      CommunityPost[]
  communityLikes                      CommunityLike[]
  communityPostReports                CommunityPostReport[]                @relation("CommunityPostReporter")
  reviews                             Review[]
  mediaAssets                         MediaAsset[]                         @relation("MediaAssetUploader")
  chatRestrictions                    ChatRestriction[]
  moderationSubjectCases              ModerationCase[]                     @relation("ModerationSubject")
  moderationReporterCases             ModerationCase[]                     @relation("ModerationReporter")
  moderationAppeals                   ModerationAppeal[]                   @relation("ModerationAppealer")
  recommendationPreference            UserRecommendationPreference?
  recommendationTags                  UserRecommendationTag[]
  recommendationRequests              RecommendationRequest[]
  companionFavorites                  CompanionFavorite[]
  companionRecentViews                CompanionRecentView[]
}

model AuthIdentity {
  id         String       @id @default(uuid())
  userId     String
  provider   AuthProvider
  providerId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model StaffCredential {
  id                   String    @id @default(uuid())
  userId               String    @unique
  username             String    @unique
  passwordHash         String
  totpSecretCiphertext String
  failedAttempts       Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username, lockedUntil])
}

model UserProfile {
  userId      String  @id
  displayName String?
  phone       String?
  age         Int?
  gender      String?
  isVerified  Boolean @default(false)
  safetyScore Int     @default(80)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanionProfile {
  id                        String                          @id
  ownerUserId               String?                         @unique
  name                      String
  role                      String
  initials                  String
  rating                    Float                           @default(0)
  reviewCount               Int                             @default(0)
  pricePerHalfHour          Int
  isOnline                  Boolean                         @default(false)
  isVerified                Boolean                         @default(false)
  bio                       String
  availableTimes            String[]
  languages                 String[]
  specialties               String[]
  completedOrders           Int                             @default(0)
  responseTime              String
  distanceKm                Float                           @default(0)
  availability              Availability                    @default(available)
  cityDistrict              String
  topicIds                  String[]                        @default([])
  isPublished               Boolean                         @default(false)
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  serviceTags               CompanionServiceTag[]
  serviceOfferings          CompanionServiceOffering[]
  availabilityWindows       CompanionAvailabilityWindow[]
  recurringAvailabilityRules CompanionRecurringAvailabilityRule[]
  availabilityBlackouts     CompanionAvailabilityBlackout[]
  conversations             Conversation[]
  orders                    Order[]
  owner                     User?                           @relation("CompanionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  reviews                   Review[]
  recommendationImpressions RecommendationImpression[]
  recommendationPolicies    CompanionRecommendationPolicy[]
  earnings                  CompanionEarning[]
  recoveries                CompanionRecovery[]
  commercialProfile         CompanionCommercialProfile?
  favorites                 CompanionFavorite[]
  recentViews               CompanionRecentView[]
  availabilityReminderCandidates AvailabilityReminderCandidate[]

  @@index([isPublished, availability])
  @@index([isOnline])
  @@index([ownerUserId])
}

// A customer-owned bookmark. This is intentionally not a social graph: it is
// never returned through a companion profile, never notifies the companion,
// and current public-visibility checks are reapplied whenever it is listed.
model CompanionFavorite {
  id                               String   @id @default(uuid())
  userId                           String
  companionId                      String
  availabilityReminderEnabled      Boolean  @default(false)
  availabilityReminderGrantId      String?  @unique
  availabilityReminderUpdatedAt    DateTime?
  availabilityReminderLastDeliveredAt DateTime?
  createdAt                        DateTime @default(now())

  user                          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion                     CompanionProfile               @relation(fields: [companionId], references: [id], onDelete: Cascade)
  availabilityReminderCandidates AvailabilityReminderCandidate[]

  @@unique([userId, companionId])
  @@index([userId, createdAt])
  @@index([companionId])
  @@index([companionId, availabilityReminderEnabled])
}

// A bounded, customer-owned recall list. It is intentionally separate from
// recommendations and bookmarks: a view is neither a relationship nor a
// preference signal, and it is never returned through a companion profile.
model CompanionRecentView {
  id          String   @id @default(uuid())
  userId      String
  companionId String
  viewedAt    DateTime @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([userId, companionId])
  @@index([userId, viewedAt])
  @@index([companionId])
}

model Conversation {
  id          String   @id @default(uuid())
  externalId  String
  userId      String
  companionId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                    User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion               CompanionProfile                     @relation(fields: [companionId], references: [id], onDelete: Cascade)
  messages                Message[]
  mediaAssets             MediaAsset[]
  readStates              MessageReadState[]
  notificationPreferences ConversationNotificationPreference[]
  blocks                  ConversationBlock[]
  orders                  Order[]

  @@unique([userId, externalId])
  @@unique([userId, companionId])
  @@index([userId, updatedAt])
  @@index([companionId])
}

model Order {
  id                                    String                        @id @default(uuid())
  userId                                String
  companionId                           String
  serviceOfferingId                     String?
  serviceOfferingCodeSnapshot           String?
  serviceOfferingTitleSnapshot          String?
  serviceOfferingDeliveryModeSnapshot   CompanionServiceOfferingMode?
  serviceOfferingDurationSnapshot       Int?
  serviceOfferingPriceCentsSnapshot     Int?
  serviceOfferingCurrencySnapshot       String?
  availabilityWindowId                  String?
  availabilityWindowStartsAtSnapshot    DateTime?
  availabilityWindowEndsAtSnapshot      DateTime?
  availabilityWindowCapacitySnapshot    Int?
  themeId                               String
  durationMinutes                       Int
  amountCents                           Int
  currency                              String                        @default("CNY")
  status                                OrderStatus                   @default(pending)
  scheduledAt                           DateTime
  companionNameSnapshot                 String
  companionRoleSnapshot                 String
  companionInitialsSnapshot             String
  themeNameSnapshot                     String
  conversationId                        String?
  recommendationImpressionId            String?                       @unique
  clientRequestId                       String?
  companionConfirmedAt                  DateTime?
  companionResponseDeadlineAt           DateTime?
  paymentReservationExpiresAt           DateTime?
  serviceStartedAt                      DateTime?
  platformFeeBps                        Int                           @default(0)
  platformFeeCents                      Int                           @default(0)
  companionPayableCents                 Int                           @default(0)
  paidAt                                DateTime?
  cancelledAt                           DateTime?
  completedAt                           DateTime?
  customerConfirmedAt                   DateTime?
  customerServiceGuidelinesConfirmedAt  DateTime?
  companionServiceGuidelinesConfirmedAt DateTime?
  refundRequestDeadlineAt               DateTime?
  settlementRecipientRefSnapshot        String?
  settlementRecipientMaskedSnapshot     String?
  taxProfileRefSnapshot                 String?
  identityEvidenceRefSnapshot           String?
  serviceAgreementVersionSnapshot       String?
  serviceAgreementEvidenceRefSnapshot   String?
  createdAt                             DateTime                      @default(now())
  updatedAt                             DateTime                      @updatedAt

  user                     User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion                CompanionProfile             @relation(fields: [companionId], references: [id], onDelete: Restrict)
  serviceOffering          CompanionServiceOffering?    @relation(fields: [serviceOfferingId], references: [id], onDelete: SetNull)
  availabilityWindow       CompanionAvailabilityWindow? @relation(fields: [availabilityWindowId], references: [id], onDelete: Restrict)
  conversation             Conversation?                @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  payments                 PaymentTransaction[]
  refunds                  RefundTransaction[]
  reviews                  Review[]
  earning                  CompanionEarning?
  supportTickets           SupportTicket[]
  supportFacts             OrderSupportFact[]
  experienceFeedback       OrderExperienceFeedback?
  rescheduleRequests       OrderRescheduleRequest[]
  timelineEvents           OrderTimelineEvent[]
  recommendationImpression RecommendationImpression?    @relation("RecommendationAttributedOrder", fields: [recommendationImpressionId], references: [id], onDelete: SetNull)

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@index([companionId, status])
  @@index([serviceOfferingId])
  @@index([availabilityWindowId])
  @@index([companionId, paymentReservationExpiresAt])
  @@index([status, companionResponseDeadlineAt])
  @@index([status, refundRequestDeadlineAt])
  @@index([status, createdAt])
  @@index([conversationId])
}

model OrderRescheduleRequest {
  id                                          String                       @id @default(uuid())
  orderId                                     String
  requestedByUserId                           String
  requestedByRole                             OrderRescheduleRequesterRole
  originalScheduledAt                         DateTime
  requestedScheduledAt                        DateTime
  requestedAvailabilityWindowId               String?
  requestedAvailabilityWindowStartsAtSnapshot DateTime?
  requestedAvailabilityWindowEndsAtSnapshot   DateTime?
  requestedAvailabilityWindowCapacitySnapshot Int?
  status                                      OrderRescheduleRequestStatus @default(pending)
  expiresAt                                   DateTime
  respondedAt                                 DateTime?
  respondedByUserId                           String?
  createdAt                                   DateTime                     @default(now())
  updatedAt                                   DateTime                     @updatedAt

  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  timelineEvents OrderTimelineEvent[]

  @@index([orderId, status, expiresAt])
  @@index([requestedByUserId, createdAt])
}

model OrderTimelineEvent {
  id                  String                 @id @default(uuid())
  orderId             String
  type                OrderTimelineEventType
  actorId             String?
  actorRole           OrderTimelineActorRole
  rescheduleRequestId String?
  payload             Json?
  createdAt           DateTime               @default(now())

  order             Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rescheduleRequest OrderRescheduleRequest? @relation(fields: [rescheduleRequestId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt, id])
  @@index([rescheduleRequestId])
}

model PaymentTransaction {
  id            String           @id @default(uuid())
  orderId       String
  outTradeNo    String           @unique
  provider      String           @default("wechat")
  amountCents   Int
  status        PaymentTxnStatus @default(initiated)
  prepayId      String?
  transactionId String?
  clientParams  Json?
  notifyPayload Json?
  paidAt        DateTime?
  expiresAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  order   Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds RefundTransaction[]

  @@unique([provider, transactionId])
  @@index([orderId])
  @@index([status])
  @@index([status, expiresAt])
}

model RefundTransaction {
  id                    String          @id @default(uuid())
  orderId               String
  paymentId             String
  outRefundNo           String          @unique
  amountCents           Int
  status                RefundTxnStatus @default(pending)
  reason                String?
  providerRefundId      String?         @unique
  initiatedById         String?
  supportTicketId       String?
  exceptionReasonCode   String?
  reviewedById          String?
  reviewedAt            DateTime?
  reviewNote            String?
  failureReason         String?
  providerQueryAttempts Int             @default(0)
  nextReconcileAt       DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment       PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  supportTicket SupportTicket?     @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)
  recovery      CompanionRecovery?

  @@index([orderId])
  @@index([paymentId])
  @@index([supportTicketId])
  @@index([status, nextReconcileAt])
}

model CommunityPost {
  id               String              @id @default(uuid())
  authorId         String
  kind             CommunityPostKind
  topic            String
  content          String
  coverImageUrl    String?
  coverAspectRatio Float?
  status           CommunityPostStatus @default(pending)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  author  User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes   CommunityLike[]
  reports CommunityPostReport[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
}

model CommunityLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

// A reporter-owned receipt for one currently public post. The full reason and
// staff evidence live only in the linked moderation case; this row exists to
// make duplicate submission atomic without turning reports into social data.
model CommunityPostReport {
  id               String   @id @default(uuid())
  postId           String
  reporterUserId   String
  moderationCaseId String?
  createdAt        DateTime @default(now())

  post           CommunityPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter       User            @relation("CommunityPostReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  moderationCase ModerationCase? @relation(fields: [moderationCaseId], references: [id], onDelete: SetNull)

  @@unique([postId, reporterUserId])
  @@index([reporterUserId, createdAt])
  @@index([postId, createdAt])
  @@index([moderationCaseId, createdAt])
}

model Review {
  id          String   @id @default(uuid())
  orderId     String   @unique
  userId      String
  companionId String
  rating      Int
  content     String
  createdAt   DateTime @default(now())

  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Restrict)

  @@index([companionId, createdAt])
  @@index([userId, createdAt])
}

// Private, post-service feedback belongs to the order rather than the public
// review surface. It deliberately has no relation to a companion profile and
// therefore cannot change public ratings or be read through companion lists.
model OrderExperienceFeedback {
  id        String   @id @default(uuid())
  orderId   String   @unique
  rating    Int
  tags      String[] @default([])
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model UserRecommendationPreference {
  userId                 String   @id
  personalizationEnabled Boolean  @default(true)
  topicIds               String[] @default([])
  city                   String?
  maxPricePerHalfHour    Int?
  preferredTimeSlots     String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRecommendationTag {
  id         String                  @id @default(uuid())
  userId     String
  topicId    String
  source     RecommendationTagSource @default(behavioral)
  weight     Float                   @default(0)
  disabledAt DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId, source])
  @@index([userId, disabledAt, updatedAt])
}

model RecommendationRequest {
  id               String                  @id @default(uuid())
  userId           String
  placement        RecommendationPlacement
  context          Json?
  algorithmVersion String
  personalized     Boolean
  expiresAt        DateTime
  createdAt        DateTime                @default(now())

  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  impressions RecommendationImpression[]

  @@index([userId, expiresAt])
  @@index([placement, createdAt])
}

model RecommendationImpression {
  id          String    @id @default(uuid())
  requestId   String
  companionId String
  position    Int
  score       Float
  reasonCodes String[]  @default([])
  servedAt    DateTime  @default(now())
  viewedAt    DateTime?
  clickedAt   DateTime?

  request   RecommendationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  companion CompanionProfile      @relation(fields: [companionId], references: [id], onDelete: Cascade)
  order     Order?                @relation("RecommendationAttributedOrder")

  @@unique([requestId, companionId])
  @@index([requestId, position])
  @@index([companionId, viewedAt])
  @@index([servedAt])
}

model CompanionRecommendationPolicy {
  id          String                     @id @default(uuid())
  companionId String
  placement   RecommendationPlacement
  status      RecommendationPolicyStatus @default(active)
  boostBps    Int                        @default(0)
  dailyCap    Int?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([companionId, placement])
  @@index([placement, status, startsAt, endsAt])
}

model Message {
  id                        String                  @id @default(uuid())
  conversationId            String
  senderId                  String
  senderName                String?
  content                   String
  type                      MessageType             @default(text)
  moderationStatus          MessageModerationStatus @default(published)
  visibility                MessageVisibility       @default(participants)
  moderationDecision        ModerationDecision?
  policyVersion             String?
  reviewedAt                DateTime?
  moderationProcessingToken String?
  moderationProcessingAt    DateTime?
  createdAt                 DateTime                @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  MediaAsset[]

  @@index([conversationId, createdAt, id])
  @@index([conversationId, moderationStatus, createdAt])
  @@index([moderationStatus, moderationProcessingAt])
  @@index([senderId])
}

model MediaAsset {
  id              String           @id @default(uuid())
  uploaderId      String
  conversationId  String
  messageId       String?
  kind            MediaAssetKind
  status          MediaAssetStatus @default(reserved)
  storageKey      String           @unique
  mimeType        String
  sizeBytes       Int
  sha256          String
  durationMs      Int?
  extractedText   String?
  analysis        Json?
  provider        String?
  providerVersion String?
  retryCount      Int              @default(0)
  nextAttemptAt   DateTime?
  lastError       String?
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  uploader     User         @relation("MediaAssetUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId, status, createdAt])
  @@index([uploaderId, createdAt])
  @@index([messageId])
  @@index([expiresAt])
}

model MessageReadState {
  id                String   @id @default(uuid())
  conversationId    String
  userId            String
  readAt            DateTime @default(now())
  lastReadMessageId String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// A participant-owned notification preference. It intentionally records only
// an active mute; removing the row restores the default and avoids retaining a
// history of unmuted conversation behavior.
model ConversationNotificationPreference {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  mutedAt        DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// A participant-owned boundary for one conversation. The row exists only while
// active, so unblocking restores the default without retaining a relationship
// history. It intentionally does not cancel or mutate any order.
model ConversationBlock {
  id              String   @id @default(uuid())
  conversationId  String
  blockedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  blockedBy    User         @relation("ConversationBlocker", fields: [blockedByUserId], references: [id], onDelete: Cascade)

  @@unique([conversationId, blockedByUserId])
  @@index([blockedByUserId, createdAt])
}

model ModerationCase {
  id                   String                @id @default(uuid())
  title                String
  category             String
  riskLevel            RiskLevel
  status               ModerationCaseStatus  @default(pending)
  source               ModerationSource
  content              String
  targetId             String?
  messageId            String?
  automaticCaseKey     String?               @unique
  conversationId       String?
  subjectUserId        String?
  reporterUserId       String?
  priority             ModerationPriority    @default(normal)
  dueAt                DateTime?
  assignedToUserId     String?
  policyVersion        String                @default("chat-v2")
  provider             String?
  providerVersion      String?
  aiScore              Float
  aiReason             String
  decision             ModerationDecision
  matchedRules         String[]
  usedAI               Boolean               @default(false)
  resolvedAt           DateTime?
  createdAt            DateTime              @default(now())
  evidences            ModerationEvidence[]
  actionLogs           ModerationActionLog[]
  appeals              ModerationAppeal[]
  restrictions         ChatRestriction[]
  communityPostReports CommunityPostReport[]
  subject              User?                 @relation("ModerationSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  reporter             User?                 @relation("ModerationReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)

  @@index([source, status])
  @@index([targetId])
  @@index([conversationId])
  @@index([subjectUserId, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([priority, dueAt])
  @@index([status, createdAt])
  @@index([riskLevel, createdAt])
  @@index([createdAt])
}

model ModerationAppeal {
  id            String                 @id @default(uuid())
  caseId        String                 @unique
  subjectUserId String
  reason        String
  status        ModerationAppealStatus @default(pending)
  reviewerId    String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime               @default(now())

  case        ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  subjectUser User           @relation("ModerationAppealer", fields: [subjectUserId], references: [id], onDelete: Cascade)

  @@index([subjectUserId, createdAt])
  @@index([status, createdAt])
}

model ChatRestriction {
  id             String                @id @default(uuid())
  userId         String
  caseId         String?
  source         ChatRestrictionSource @default(automatic)
  reason         String
  startsAt       DateTime              @default(now())
  endsAt         DateTime
  liftedAt       DateTime?
  liftedByUserId String?
  createdAt      DateTime              @default(now())

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  case ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([userId, endsAt])
  @@index([caseId])
}

model ModerationEvidence {
  id        String   @id @default(uuid())
  caseId    String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model ModerationActionLog {
  id        String   @id @default(uuid())
  caseId    String
  actorId   String?
  action    String
  note      String?
  createdAt DateTime @default(now())

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  // A business-event key makes the inbox row and its external delivery
  // idempotent across callback retries and worker restarts.
  eventKey  String?          @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model NotificationDelivery {
  id                String                     @id @default(uuid())
  notificationId    String
  userId            String
  templateKey       String
  status            NotificationDeliveryStatus @default(pending)
  attemptCount      Int                        @default(0)
  nextAttemptAt     DateTime                   @default(now())
  leaseToken        String?
  leaseExpiresAt    DateTime?
  providerMessageId String?
  errorCode         String?
  lastError         String?
  sentAt            DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, templateKey])
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([leaseExpiresAt])
}

model WeChatSubscriptionGrant {
  id                   String    @id @default(uuid())
  userId               String
  templateKey          String
  templateId           String?
  grantedAt            DateTime  @default(now())
  consumedAt           DateTime?
  consumedByDeliveryId String?   @unique
  createdAt            DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilityReminderAttempt AvailabilityReminderAttempt?

  @@index([userId, templateKey, templateId, consumedAt, grantedAt])
}

model CompanionEarning {
  id                                  String                 @id @default(uuid())
  orderId                             String                 @unique
  companionId                         String
  grossCents                          Int
  platformFeeBps                      Int
  platformFeeCents                    Int
  payableCents                        Int
  status                              CompanionEarningStatus @default(pending)
  availableAt                         DateTime
  payoutSubmittedAt                   DateTime?
  payoutSubmittedById                 String?
  paidAt                              DateTime?
  paidReference                       String?                @unique
  holdReason                          String?
  settlementRecipientRefSnapshot      String?
  settlementRecipientMaskedSnapshot   String?
  taxProfileRefSnapshot               String?
  identityEvidenceRefSnapshot         String?
  serviceAgreementVersionSnapshot     String?
  serviceAgreementEvidenceRefSnapshot String?
  paidAmountCents                     Int?
  paidRecipientRef                    String?
  payoutEvidenceDigest                String?
  createdAt                           DateTime               @default(now())
  updatedAt                           DateTime               @updatedAt

  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  companion  CompanionProfile    @relation(fields: [companionId], references: [id], onDelete: Restrict)
  recoveries CompanionRecovery[]

  @@index([companionId, status, availableAt])
  @@index([status, availableAt])
}

model CompanionCommercialProfile {
  companionId                 String                    @id
  status                      CompanionCommercialStatus @default(pendingReview)
  settlementRecipientRef      String                    @unique
  settlementRecipientMasked   String
  taxProfileRef               String
  identityEvidenceRef         String
  serviceAgreementVersion     String
  serviceAgreementEvidenceRef String
  submittedAt                 DateTime                  @default(now())
  submittedById               String
  verifiedAt                  DateTime?
  verifiedById                String?
  suspendedAt                 DateTime?
  suspendedById               String?
  suspendedReason             String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model CompanionRecovery {
  id                    String                  @id @default(uuid())
  refundId              String                  @unique
  earningId             String
  companionId           String
  amountCents           Int
  status                CompanionRecoveryStatus @default(due)
  reason                CompanionRecoveryReason @default(confirmedPaidBeforeRefund)
  evidenceReference     String?                 @unique
  evidenceSubmittedAt   DateTime?
  evidenceSubmittedById String?
  verifiedAt            DateTime?
  verifiedById          String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  refund    RefundTransaction @relation(fields: [refundId], references: [id], onDelete: Restrict)
  earning   CompanionEarning  @relation(fields: [earningId], references: [id], onDelete: Restrict)
  companion CompanionProfile  @relation(fields: [companionId], references: [id], onDelete: Restrict)

  @@index([companionId, status, createdAt])
  @@index([status, createdAt])
}

model SupportTicket {
  id               String                @id @default(uuid())
  userId           String
  orderId          String?
  category         SupportTicketCategory
  priority         SupportTicketPriority @default(normal)
  status           SupportTicketStatus   @default(open)
  subject          String
  body             String
  assignedToUserId String?
  dueAt            DateTime?
  resolution       String?
  resolutionCode   String?
  resolvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  requester  User                @relation("SupportRequester", fields: [userId], references: [id], onDelete: Cascade)
  order      Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedTo User?               @relation("SupportAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  refunds    RefundTransaction[]
  orderFacts OrderSupportFact[]

  @@index([userId, createdAt])
  @@index([orderId, status])
  @@index([status, priority, dueAt])
  @@index([assignedToUserId, status])
}

// A short, immutable statement a requester voluntarily adds to an active
// order-related support ticket. It intentionally has no attachment, message,
// moderation, or settlement relation: it is private support context only.
model OrderSupportFact {
  id                String   @id @default(uuid())
  supportTicketId   String
  orderId           String
  submittedByUserId String
  statement         String
  createdAt         DateTime @default(now())

  supportTicket SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  submittedBy   User          @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)

  @@index([supportTicketId, createdAt])
  @@index([orderId, createdAt])
  @@index([submittedByUserId, createdAt])
}

model AccountDeletionRequest {
  id        String                @id @default(uuid())
  userId    String
  status    DeletionRequestStatus @default(pending)
  note      String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
}

model LegalConsentReceipt {
  id              String             @id @default(uuid())
  userId          String
  version         String
  privacyVersion  String
  termsVersion    String
  privacyAccepted Boolean
  termsAccepted   Boolean
  adultConfirmed  Boolean
  acceptedAt      DateTime
  consentedAt     DateTime           @default(now())
  withdrawnAt     DateTime?
  privacyUrl      String
  termsUrl        String
  source          LegalConsentSource @default(wechatMiniProgram)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, version, consentedAt])
  @@index([userId, consentedAt])
}

model LegalDocumentVersion {
  id           String            @id @default(uuid())
  documentType LegalDocumentKind
  version      String
  contentHash  String
  html         String
  publishedAt  DateTime          @default(now())
  createdAt    DateTime          @default(now())

  @@unique([documentType, version])
  @@index([version, publishedAt])
}

model ModerationLabel {
  id               String             @id @default(uuid())
  text             String
  expectedDecision ModerationDecision
  actualDecision   ModerationDecision
  note             String?
  caseId           String?
  actorId          String?
  source           ModerationSource?
  createdAt        DateTime           @default(now())

  @@index([createdAt])
  @@index([caseId])
}

model ServiceTag {
  id         String                @id @default(uuid())
  name       String                @unique
  createdAt  DateTime              @default(now())
  companions CompanionServiceTag[]
}

model CompanionServiceTag {
  companionId String
  tagId       String

  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)
  tag       ServiceTag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companionId, tagId])
  @@index([tagId])
}

model CompanionServiceOffering {
  id              String                       @id @default(uuid())
  companionId     String
  code            String
  title           String
  description     String?
  deliveryMode    CompanionServiceOfferingMode
  durationMinutes Int
  priceCents      Int
  currency        String                       @default("CNY")
  topicIds        String[]                     @default([])
  isActive        Boolean                      @default(true)
  sortOrder       Int                          @default(0)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@unique([companionId, code])
  @@index([companionId, isActive, sortOrder])
}

model CompanionAvailabilityWindow {
  id                            String   @id @default(uuid())
  companionId                   String
  startsAt                      DateTime
  endsAt                        DateTime
  capacity                      Int      @default(1)
  isActive                      Boolean  @default(true)
  recurringAvailabilityRuleId   String?
  recurringOccurrenceStartsAt   DateTime?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  companion                     CompanionProfile               @relation(fields: [companionId], references: [id], onDelete: Cascade)
  recurringAvailabilityRule     CompanionRecurringAvailabilityRule? @relation("RecurringAvailabilityGeneratedWindows", fields: [recurringAvailabilityRuleId], references: [id], onDelete: SetNull)
  orders                        Order[]
  availabilityReminderCandidates AvailabilityReminderCandidate[]

  @@index([companionId, isActive, startsAt])
  @@index([companionId, isActive, endsAt])
  @@index([companionId, recurringAvailabilityRuleId, recurringOccurrenceStartsAt])
  @@unique([recurringAvailabilityRuleId, recurringOccurrenceStartsAt])
}

// A weekly template is intentionally not itself a bookable window. It stores
// only a Shanghai-local day/time range for a future, separately controlled
// materializer; no order, public availability, or notification reads it yet.
model CompanionRecurringAvailabilityRule {
  id                String   @id @default(uuid())
  companionId       String
  weekday           Int
  startsAtMinute    Int
  endsAtMinute      Int
  capacity          Int      @default(1)
  timezone          String   @default("Asia/Shanghai")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  companion                   CompanionProfile             @relation(fields: [companionId], references: [id], onDelete: Cascade)
  generatedAvailabilityWindows CompanionAvailabilityWindow[] @relation("RecurringAvailabilityGeneratedWindows")

  @@index([companionId, isActive, weekday, startsAtMinute])
}

// A blackout is a one-off, private schedule exception. It deliberately has no
// free-text reason or user-facing state: it will only guide a future window
// materializer and cannot alter existing windows or bookings on its own.
model CompanionAvailabilityBlackout {
  id          String   @id @default(uuid())
  companionId String
  startsAt    DateTime
  endsAt      DateTime
  timezone    String   @default("Asia/Shanghai")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@index([companionId, isActive, startsAt])
  @@index([companionId, isActive, endsAt])
}

// A private, deduplicated hint that one structured availability window was
// created or reactivated. It is not a notification intent or delivery record;
// the future delivery path must recheck every current condition before use.
model AvailabilityReminderCandidate {
  id                            String   @id @default(uuid())
  favoriteId                    String
  companionId                   String
  availabilityWindowId          String
  availabilityWindowUpdatedAt DateTime
  preflightDecision             AvailabilityReminderCandidateDecision @default(pending)
  preflightReason               AvailabilityReminderCandidateSkipReason?
  preflightedAt                 DateTime?
  createdAt                     DateTime @default(now())

  favorite           CompanionFavorite           @relation(fields: [favoriteId], references: [id], onDelete: Cascade)
  companion          CompanionProfile            @relation(fields: [companionId], references: [id], onDelete: Cascade)
  availabilityWindow CompanionAvailabilityWindow @relation(fields: [availabilityWindowId], references: [id], onDelete: Cascade)
  handoff            AvailabilityReminderHandoff?

  @@unique([favoriteId, availabilityWindowId, availabilityWindowUpdatedAt])
  @@index([favoriteId, createdAt])
  @@index([companionId, createdAt])
  @@index([availabilityWindowId, createdAt])
  @@index([preflightDecision, createdAt])
}

// A one-to-one, server-only handoff for an already eligible candidate. It is
// intentionally not a notification, delivery, schedule, recipient record, or
// provider attempt. The later delivery stage must recheck live state again.
model AvailabilityReminderHandoff {
  id          String   @id @default(uuid())
  candidateId String   @unique
  createdAt   DateTime @default(now())

  candidate AvailabilityReminderCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  attempt   AvailabilityReminderAttempt?

  @@index([createdAt])
}

// A durable, one-to-one authorization state record for a private handoff. It
// has no recipient payload, in-app notification, or message body. Its final
// stages may consume only this exact bound grant, issue a short private lease,
// and retain a minimal provider acknowledgement or error classification.
model AvailabilityReminderAttempt {
  id                       String                                  @id @default(uuid())
  handoffId                String                                  @unique
  subscriptionGrantId      String                                  @unique
  status                   AvailabilityReminderAttemptStatus       @default(reserved)
  outcomeReason            AvailabilityReminderAttemptOutcomeReason?
  authorizationConsumedAt  DateTime?
  sendLeaseToken           String?                                 @unique
  sendLeaseExpiresAt       DateTime?
  providerAttemptStartedAt DateTime?
  providerResolvedAt       DateTime?
  providerMessageId        String?
  providerErrorCode        String?
  createdAt                DateTime                                @default(now())
  updatedAt                DateTime                                @updatedAt

  handoff           AvailabilityReminderHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  subscriptionGrant WeChatSubscriptionGrant      @relation(fields: [subscriptionGrantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([status, sendLeaseExpiresAt])
  @@index([status, providerAttemptStartedAt])
}

model VerificationCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
