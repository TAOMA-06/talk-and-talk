model CrisisIntervention {
  id                    String                     @id @default(uuid())
  userId                String
  source                CrisisInterventionSource
  riskCode              CrisisInterventionRiskCode
  region                String
  resourcePolicyVersion String
  status                CrisisInterventionStatus   @default(resourcesPending)
  resourcesViewedAt     DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model AuthIdentity {
  id         String       @id @default(uuid())
  userId     String
  provider   AuthProvider
  providerId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

// Pseudonymous deny-relink evidence for an external identity whose owning
// account entered irreversible deletion processing. The clear provider id
// remains only in AuthIdentity and is erased by the deletion worker; login
// compares HMAC candidates so it cannot silently create a fresh active User.
model AuthIdentityTombstone {
  id                   String       @id @default(uuid())
  deletionRequestId    String
  sourceAuthIdentityId String
  provider             AuthProvider
  providerIdHmac       String       @db.Char(64)
  keyId                String       @db.VarChar(64)
  createdAt            DateTime     @default(now())
  expiresAt            DateTime?

  deletionRequest AccountDeletionRequest @relation(fields: [deletionRequestId], references: [id], onDelete: Restrict)

  @@unique([deletionRequestId, sourceAuthIdentityId], map: "AuthIdentityTombstone_deletionRequestId_sourceAuthIdentityId_ke")
  @@unique([deletionRequestId, provider, keyId, providerIdHmac], map: "AuthIdentityTombstone_deletionRequestId_provider_keyId_provider")
  @@index([provider, keyId, providerIdHmac, expiresAt], map: "AuthIdentityTombstone_login_lookup")
  @@index([deletionRequestId, expiresAt])
  @@index([expiresAt, id], map: "AuthIdentityTombstone_expiry_due")
}

model StaffCredential {
  id                     String                @id @default(uuid())
  userId                 String                @unique
  username               String                @unique
  status                 StaffCredentialStatus @default(active)
  passwordHash           String
  totpSecretCiphertext   String
  failedAttempts         Int                   @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  suspendedAt            DateTime?
  suspendedByUserId      String?
  suspensionReason       String?
  handoffToUserId        String?
  offboardingOperationId String?               @unique
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  user        User  @relation("StaffCredentialOwner", fields: [userId], references: [id], onDelete: Cascade)
  suspendedBy User? @relation("StaffCredentialSuspendedBy", fields: [suspendedByUserId], references: [id], onDelete: Restrict)
  handoffTo   User? @relation("StaffCredentialHandoffTo", fields: [handoffToUserId], references: [id], onDelete: Restrict)

  @@index([username, lockedUntil])
  @@index([status, updatedAt])
  @@index([suspendedByUserId, suspendedAt])
  @@index([handoffToUserId, suspendedAt])
}

model ReviewStaff {
  id                   String                @id @default(uuid())
  username             String                @unique
  displayName          String
  role                 ReviewStaffRole       @default(reviewer)
  status               ReviewStaffStatus     @default(active)
  passwordHash         String
  totpSecretCiphertext String
  failedAttempts       Int                   @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  sessions             ReviewSession[]
  auditLogs            ReviewAuditLog[]
  moderationActions    ModerationActionLog[] @relation("ReviewStaffModerationActions")
  moderationLabels     ModerationLabel[]     @relation("ReviewStaffModerationLabels")

  @@index([username, lockedUntil])
  @@index([status, role])
  @@index([status, role, displayName, username, id])
}

model ReviewSession {
  id         String    @id @default(uuid())
  reviewerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  reviewer ReviewStaff @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([reviewerId])
  @@index([reviewerId, revokedAt])
}

// This log is owned by the review department. It intentionally has no User
// relation, so a review decision cannot be mistaken for a consumer action.
model ReviewAuditLog {
  id           String   @id @default(uuid())
  reviewerId   String
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  reviewer ReviewStaff @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([reviewerId, createdAt])
  @@index([resourceType, resourceId])
  @@index([resourceType, resourceId, action, createdAt])
  @@index([createdAt])
}

