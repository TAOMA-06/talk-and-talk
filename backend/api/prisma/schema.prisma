  attendanceDisputeId         String?
  companionId                 String?
  kind                        MediaAssetKind
  status                      MediaAssetStatus  @default(reserved)
  storageKey                  String            @unique
  mimeType                    String
  sizeBytes                   Int
  sha256                      String
  durationMs                  Int?
  extractedText               String?
  analysis                    Json?
  provider                    String?
  providerVersion             String?
  retryCount                  Int               @default(0)
  nextAttemptAt               DateTime?
  lastError                   String?
  uploadExpiresAt             DateTime?
  moderationProcessingToken   String?           @unique
  moderationProcessingAt      DateTime?
  expiresAt                   DateTime?
  storageDeleteRequestedAt    DateTime?
  storageDeletedAt            DateTime?
  storageDeleteLeaseToken     String?           @unique
  storageDeleteLeaseExpiresAt DateTime?
  storageDeleteAttemptCount   Int               @default(0)
  storageDeleteNextAttemptAt  DateTime?
  storageDeleteLastErrorCode  String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  uploader                 User                              @relation("MediaAssetUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  conversation             Conversation?                     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message                  Message?                          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  supportTicket            SupportTicket?                    @relation("SupportTicketEvidenceScope", fields: [supportTicketId], references: [id], onDelete: Restrict)
