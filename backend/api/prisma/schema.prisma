  suspendedStaffCredentials            StaffCredential[]                        @relation("StaffCredentialSuspendedBy")
  staffCredentialHandoffs              StaffCredential[]                        @relation("StaffCredentialHandoffTo")
  profile                              UserProfile?
  refreshTokens                        RefreshToken[]
  conversations                        Conversation[]
  readStates                           MessageReadState[]
  conversationNotificationPreferences  ConversationNotificationPreference[]
  conversationBlocks                   ConversationBlock[]                      @relation("ConversationBlocker")
  orders                               Order[]
  notifications                        Notification[]
  notificationDeliveries               NotificationDelivery[]
  subscriptionGrants                   WeChatSubscriptionGrant[]
  supportTickets                       SupportTicket[]                          @relation("SupportRequester")
  assignedSupportTickets               SupportTicket[]                          @relation("SupportAssignee")
  orderSupportFacts                    OrderSupportFact[]
  boundCaseEvidenceAttachments         ControlledCaseEvidenceAttachment[]       @relation("CaseEvidenceBoundBy")
  deletionRequests                     AccountDeletionRequest[]
  startedDeletionRequests              AccountDeletionRequest[]                 @relation("AccountDeletionStartedBy")
  approvedDeletionRequests             AccountDeletionRequest[]                 @relation("AccountDeletionApprovedBy")
  completedDeletionRequests            AccountDeletionRequest[]                 @relation("AccountDeletionCompletedBy")
  dataRightsRequests                   DataRightsRequest[]                      @relation("DataRightsRequester")
  dataRightsRequestFollowUps           DataRightsRequestFollowUp[]
  handledDataRightsRequests            DataRightsRequest[]                      @relation("DataRightsHandler")
  invoiceRequests                      InvoiceRequest[]                         @relation("InvoiceRequester")
  handledInvoiceRequests               InvoiceRequest[]                         @relation("InvoiceHandler")
  identityVerificationRequests         IdentityVerificationRequest[]            @relation("IdentityVerificationSubject")
