  @@index([orderSupportFactId, createdAt], map: "CaseEvidence_order_fact_created")
  @@index([attendanceDisputeStatementId, createdAt], map: "CaseEvidence_attendance_statement_created")
  @@index([companionIncidentReportId, createdAt], map: "CaseEvidence_companion_incident_created")
  @@index([boundByUserId, createdAt], map: "CaseEvidence_bound_by_created")
}

