  paymentDisputeOrders     PaymentDisputeOrder[]

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@index([companionId, status])
  @@index([companionId, status, scheduledAt, id], map: "Order_companion_status_scheduledAt_id")
  @@index([serviceOfferingId])
  @@index([availabilityWindowId])
  @@index([companionId, companionConfirmedAt])
  @@index([companionId, paymentReservationExpiresAt])
  @@index([status, companionResponseDeadlineAt])
  @@index([status, refundRequestDeadlineAt])
  @@index([serviceIntentSnapshot, createdAt])
  @@index([status, createdAt])
  @@index([conversationId])
}

/// A single provider room per paid service order. Runtime eligibility still
/// derives from Order; this record only gives the provider a stable opaque room
/// identifier and an audit-friendly access footprint.
model VoiceSession {
  id                           String    @id @default(uuid())
  orderId                      String    @unique
  provider                     String    @default("trtc")
  roomId                       String    @unique
  firstAccessedAt              DateTime?
  lastAccessedAt               DateTime?
  accessCount                  Int       @default(0)
  terminationRequestedAt       DateTime?
  terminationCompletedAt       DateTime?
  terminationReason            String?
  terminationAttempts          Int       @default(0)
  terminationNextAttemptAt     DateTime?
  terminationLeaseUntil        DateTime?
  terminationLastError         String?
  terminationProviderRequestId String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attendanceEvents VoiceAttendanceEvent[]

  @@index([terminationCompletedAt, terminationNextAttemptAt, terminationLeaseUntil], map: "VoiceSession_terminationCompletedAt_terminationNextAttemptAt_te")
}

/// Immutable, metadata-only attendance evidence. Provider events are verified
/// against the raw Tencent callback body; client events are always auxiliary
/// and must never be used as the sole basis for a decision. No recording,
/// IP address, terminal type, or device fingerprint is retained.
model VoiceAttendanceEvent {
  id                 String                         @id @default(uuid())
  voiceSessionId     String
  participantUserId  String?
  participantRole    VoiceAttendanceParticipantRole
  type               VoiceAttendanceEventType
  source             VoiceAttendanceEventSource
  providerEventId    String?                        @unique
  clientEventId      String?
  providerOccurredAt DateTime?
  clientClaimedAt    DateTime?
  serverReceivedAt   DateTime                       @default(now())
  providerReasonCode Int?
  providerUniqueId   String?
  createdAt          DateTime                       @default(now())

  voiceSession VoiceSession @relation(fields: [voiceSessionId], references: [id], onDelete: Cascade)
  participant  User?        @relation("VoiceAttendanceEventParticipant", fields: [participantUserId], references: [id], onDelete: SetNull)

  @@unique([voiceSessionId, participantUserId, clientEventId])
  @@index([voiceSessionId, participantRole, providerOccurredAt])
  @@index([voiceSessionId, participantUserId, source, serverReceivedAt], map: "VoiceAttendanceEvent_session_participant_source_received_idx")
  @@index([participantUserId, serverReceivedAt])
}

/// A structured, bilateral fulfillment case. It is deliberately independent
/// from the free-text support queue and owns its own evidence and appeal state.
model AttendanceDispute {
  id                        String                         @id @default(uuid())
  orderId                   String                         @unique
  openedByUserId            String?
  openedByRole              VoiceAttendanceParticipantRole
  counterpartyUserId        String?
  issue                     AttendanceDisputeIssue
  status                    AttendanceDisputeStatus        @default(evidenceCollection)
  policyVersionSnapshot     String
  timezoneSnapshot          String
  evidenceDueAt             DateTime
  counterpartyResponseDueAt DateTime
  assignedToUserId          String?
  assignedAt                DateTime?
  decision                  AttendanceDisputeDecision?
  decisionReason            String?
  decidedByUserId           String?
  decidedAt                 DateTime?
  appealDeadlineAt          DateTime?
  appealedByUserId          String?
  appealedAt                DateTime?
  appealResponseDueAt       DateTime?
  appealAssignedToUserId    String?
  appealAssignedAt          DateTime?
  appealReviewedByUserId    String?
  appealReviewedAt          DateTime?
  finalDecision             AttendanceDisputeDecision?
  finalReason               String?
  finalizedAt               DateTime?
  refundTransactionId       String?                        @unique
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt

  order                Order                        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedBy             User?                        @relation("AttendanceDisputeOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)
  counterparty         User?                        @relation("AttendanceDisputeCounterparty", fields: [counterpartyUserId], references: [id], onDelete: SetNull)
  assignedTo           User?                        @relation("AttendanceDisputeAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  decidedBy            User?                        @relation("AttendanceDisputeDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  appealedBy           User?                        @relation("AttendanceDisputeAppealedBy", fields: [appealedByUserId], references: [id], onDelete: SetNull)
  appealAssignedTo     User?                        @relation("AttendanceDisputeAppealAssignee", fields: [appealAssignedToUserId], references: [id], onDelete: SetNull)
  appealReviewedBy     User?                        @relation("AttendanceDisputeAppealReviewer", fields: [appealReviewedByUserId], references: [id], onDelete: SetNull)
  refundTransaction    RefundTransaction?           @relation(fields: [refundTransactionId], references: [id], onDelete: SetNull)
  statements           AttendanceDisputeStatement[]
  evidenceUploadAssets MediaAsset[]                 @relation("AttendanceDisputeEvidenceScope")

  @@index([status, evidenceDueAt, counterpartyResponseDueAt])
  @@index([assignedToUserId, status, createdAt])
  @@index([appealAssignedToUserId, status, createdAt])
  @@index([openedByUserId, createdAt])
  @@index([counterpartyUserId, createdAt])
  @@index([decidedByUserId, createdAt])
  @@index([appealedByUserId, createdAt])
  @@index([appealReviewedByUserId, createdAt])
}

model AttendanceDisputeStatement {
  id                String                         @id @default(uuid())
  disputeId         String
  submittedByUserId String
  kind              AttendanceDisputeStatementKind
  statement         String
  createdAt         DateTime                       @default(now())

  dispute             AttendanceDispute                  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  submittedBy         User                               @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict)
  evidenceAttachments ControlledCaseEvidenceAttachment[]

  @@index([disputeId, createdAt])
  @@index([submittedByUserId, createdAt])
}

/// A one-row, provider-wide dispatch lease. It prevents horizontally scaled
/// API replicas from exceeding the external TRTC room-control rate limit while
/// still letting a later replica recover automatically after a crash.
model VoiceRoomControlDispatchLease {
  id         String    @id
  leaseToken String?
  leaseUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model OrderRescheduleRequest {
  id                                          String                       @id @default(uuid())
  orderId                                     String
  requestedByUserId                           String?
  requestedByRole                             OrderRescheduleRequesterRole
  originalScheduledAt                         DateTime
  requestedScheduledAt                        DateTime
  requestedAvailabilityWindowId               String?
  requestedAvailabilityWindowStartsAtSnapshot DateTime?
  requestedAvailabilityWindowEndsAtSnapshot   DateTime?
  requestedAvailabilityWindowCapacitySnapshot Int?
  status                                      OrderRescheduleRequestStatus @default(pending)
  expiresAt                                   DateTime
  respondedAt                                 DateTime?
  respondedByUserId                           String?
  createdAt                                   DateTime                     @default(now())
  updatedAt                                   DateTime                     @updatedAt

  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy    User?                @relation("OrderRescheduleRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  respondedBy    User?                @relation("OrderRescheduleRespondedBy", fields: [respondedByUserId], references: [id], onDelete: SetNull)
  timelineEvents OrderTimelineEvent[]

  @@index([orderId, status, expiresAt])
  @@index([requestedByUserId, createdAt, id])
  @@index([respondedByUserId, respondedAt, id])
}

model OrderTimelineEvent {
  id                  String                 @id @default(uuid())
  orderId             String
  type                OrderTimelineEventType
  actorId             String?
  actorRole           OrderTimelineActorRole
  rescheduleRequestId String?
  payload             Json?
  createdAt           DateTime               @default(now())

  order             Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rescheduleRequest OrderRescheduleRequest? @relation(fields: [rescheduleRequestId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt, id])
  @@index([rescheduleRequestId])
}

model PaymentTransaction {
  id             String           @id @default(uuid())
  orderId        String
  outTradeNo     String           @unique
  provider       String           @default("wechat")
  amountCents    Int
  status         PaymentTxnStatus @default(initiated)
  prepayId       String?
  transactionId  String?
  clientParams   Json?
  notifyPayload  Json?
  paidAt         DateTime?
  /// Immutable payment-success timestamp returned by WeChat. Local wall-clock
  /// timestamps must never be substituted for daily provider reconciliation.
  providerPaidAt DateTime?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds         RefundTransaction[]
  invoiceRequests InvoiceRequest[]
  disputes        PaymentDispute[]
  disputeOrders   PaymentDisputeOrder[]

  @@unique([provider, transactionId])
  @@index([orderId])
  @@index([status])
  @@index([status, expiresAt])
  @@index([status, providerPaidAt])
}

model RefundTransaction {
  id                        String          @id @default(uuid())
  orderId                   String
  paymentId                 String
  outRefundNo               String          @unique
  amountCents               Int
  status                    RefundTxnStatus @default(pending)
  reason                    String?
  providerRefundId          String?         @unique
  /// Immutable provider acceptance/success timestamp returned by WeChat.
  providerRefundAcceptedAt  DateTime?
  /// Immutable provider success_time. Refund success may occur on a later
  /// Shanghai bill date than create_time and must be attributed accordingly.
  providerRefundSucceededAt DateTime?
  initiatedById             String?
  supportTicketId           String?
  exceptionReasonCode       String?
  assignedToUserId          String?
  assignedAt                DateTime?
  reviewDueAt               DateTime?
  resolutionDueAt           DateTime
  reviewedById              String?
  reviewedAt                DateTime?
  reviewNote                String?
  failureReason             String?
  providerQueryAttempts     Int             @default(0)
  nextReconcileAt           DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment           PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  supportTicket     SupportTicket?     @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)
  assignedTo        User?              @relation("RefundAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  recovery          CompanionRecovery?
  attendanceDispute AttendanceDispute?

  @@index([orderId])
  @@index([paymentId])
  @@index([supportTicketId])
  @@index([assignedToUserId, status])
  @@index([status, reviewDueAt])
  @@index([status, resolutionDueAt])
  @@index([status, nextReconcileAt])
  @@index([status, providerRefundAcceptedAt])
  @@index([status, providerRefundSucceededAt])
}

/// Immutable identity and processing ledger for one official WeChat T+1 bill.
/// The downloaded statement itself is not retained: only provider/in-house
/// digests and normalized financial references are persisted.
model WeChatBillReconciliationRun {
  id               String              @id @default(uuid())
  provider         String              @default("wechat")
  source           String              @default("api")
  billDate         DateTime            @db.Date
  kind             WeChatBillKind
  status           WeChatBillRunStatus @default(pending)
  hashType         String?
  providerHash     String?
  contentSha256    String?
  downloadedBytes  Int?
  entryCount       Int                 @default(0)
  issueCount       Int                 @default(0)
  attemptCount     Int                 @default(0)
  leaseToken       String?
  leaseExpiresAt   DateTime?
  nextAttemptAt    DateTime            @default(now())
  lastErrorCode    String?
  lastErrorSummary String?
  requestedAt      DateTime?
  downloadedAt     DateTime?
  importedAt       DateTime?
  reconciledAt     DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  importProposalId String?             @unique

  entries        WeChatBillEntry[]
  issues         WeChatReconciliationIssue[]
  importProposal WeChatBillImportProposal?   @relation(fields: [importProposalId], references: [id], onDelete: Restrict)

  @@unique([provider, billDate, kind])
  @@index([status, nextAttemptAt])
  @@index([billDate, kind])
}

/// A merchant-platform export is parsed before persistence. Raw statement text
/// is never stored; only its immutable digest, private evidence reference and
/// the same minimal normalized facts used by API-downloaded bills survive.
model WeChatBillImportProposal {
  id                String                         @id @default(uuid())
  provider          String                         @default("wechat")
  source            String                         @default("merchantPlatform")
  billDate          DateTime                       @db.Date
  kind              WeChatBillKind
  status            WeChatBillImportProposalStatus @default(pending)
  contentSha256     String
  normalizedSha256  String
  sizeBytes         Int
  entryCount        Int
  evidenceReference String
  proposedByUserId  String
  proposedAt        DateTime                       @default(now())
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?

  proposedBy User                         @relation("WeChatBillImportProposer", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  reviewedBy User?                        @relation("WeChatBillImportReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  entries    WeChatBillImportEntry[]
  run        WeChatBillReconciliationRun?

  // Active-content uniqueness is enforced by a partial database index. A
  // rejected proposal remains immutable evidence but must not permanently
  // prevent a corrected operational submission of the same official file.
  @@index([status, proposedAt])
  @@index([billDate, kind, status])
}

model WeChatBillImportEntry {
  id                        String    @id @default(uuid())
  proposalId                String
  lineNumber                Int
  entryType                 String
  providerOccurredAt        DateTime?
  providerRefundAcceptedAt  DateTime?
  providerRefundSucceededAt DateTime?
  outTradeNo                String?
  transactionId             String?
  outRefundNo               String?
  providerRefundId          String?
  businessReference         String?
  businessName              String?
  businessType              String?
  tradeState                String?
  refundState               String?
  amountCents               Int?
  refundAmountCents         Int?
  feeCents                  Int?
  fundDirection             String?
  fundAmountCents           Int?
  accountType               String?
  rowDigest                 String
  createdAt                 DateTime  @default(now())

  proposal WeChatBillImportProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  @@unique([proposalId, lineNumber])
  @@index([outTradeNo])
  @@index([outRefundNo])
  @@index([businessReference])
}

/// Minimal normalized row from a verified official bill. Raw CSV text and
/// personal fields (for example openid/product description) are never stored.
model WeChatBillEntry {
  id                        String    @id @default(uuid())
  runId                     String
  lineNumber                Int
  entryType                 String
  providerOccurredAt        DateTime?
  providerRefundAcceptedAt  DateTime?
  providerRefundSucceededAt DateTime?
  outTradeNo                String?
  transactionId             String?
  outRefundNo               String?
  providerRefundId          String?
  businessReference         String?
  businessName              String?
  businessType              String?
  tradeState                String?
  refundState               String?
  amountCents               Int?
  refundAmountCents         Int?
  feeCents                  Int?
  fundDirection             String?
  fundAmountCents           Int?
  accountType               String?
  rowDigest                 String
  createdAt                 DateTime  @default(now())

  run    WeChatBillReconciliationRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  issues WeChatReconciliationIssue[]

  @@unique([runId, lineNumber])
  @@index([outTradeNo])
  @@index([transactionId])
  @@index([outRefundNo])
  @@index([businessReference])
}

/// Local double-entry boundary used for provider fund-statement comparison.
/// The provider bill is evidence, never the source of these rows.
model CashLedgerEntry {
  id                    String    @id @default(uuid())
  provider              String    @default("wechat")
  accountType           String
  bookedAt              DateTime
  expectedStatementDate DateTime? @db.Date
  businessName          String
  businessType          String
  direction             String
  grossCents            Int
  feeCents              Int       @default(0)
  netCents              Int
  providerReference     String
  sourceResourceType    String
  sourceResourceId      String
  evidenceReference     String
  createdAt             DateTime  @default(now())

  classificationProposals CashLedgerClassificationProposal[]

  @@unique([provider, accountType, providerReference, businessType], map: "CashLedgerEntry_provider_account_reference_business_key")
  @@unique([sourceResourceType, sourceResourceId, businessType], map: "CashLedgerEntry_source_resource_business_key")
  @@index([expectedStatementDate, accountType])
  @@index([providerReference])
  @@index([bookedAt])
}

/// Append-only, independently reviewed classification of an automatically
/// captured provider cash fact. Provider/source/amount facts stay immutable;
/// approval may only fill the initially unknown account and statement date.
model CashLedgerClassificationProposal {
  id                    String                         @id @default(uuid())
  cashLedgerEntryId     String
  accountType           String
  expectedStatementDate DateTime                       @db.Date
  evidenceReference     String
  evidenceDigestSha256  String
  proposedByUserId      String
  proposedAt            DateTime                       @default(now())
  status                WeChatBillImportProposalStatus @default(pending)
  reviewedByUserId      String?
  reviewedAt            DateTime?
  reviewNote            String?

  cashLedgerEntry CashLedgerEntry @relation(fields: [cashLedgerEntryId], references: [id], onDelete: Restrict)
  proposedBy      User            @relation("CashLedgerClassificationProposer", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  reviewedBy      User?           @relation("CashLedgerClassificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([cashLedgerEntryId, status], map: "CashLedgerClassificationProposal_entry_status")
  @@index([status, proposedAt])
}

model WeChatReconciliationIssue {
  id                String                          @id @default(uuid())
  runId             String
  entryId           String?
  fingerprint       String                          @unique
  kind              String
  severity          String                          @default("high")
  status            WeChatReconciliationIssueStatus @default(open)
  localResourceType String?
  localResourceId   String?
  providerReference String?
  expectedCents     Int?
  actualCents       Int?
  detailCode        String
  assignedToUserId  String?
  assignedAt        DateTime?
  resolvedByUserId  String?
  resolvedAt        DateTime?
  resolutionCode    String?
  resolutionNote    String?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  run                 WeChatBillReconciliationRun              @relation(fields: [runId], references: [id], onDelete: Restrict)
  entry               WeChatBillEntry?                         @relation(fields: [entryId], references: [id], onDelete: SetNull)
  resolutionProposals WeChatReconciliationResolutionProposal[]

  @@index([status, createdAt])
  @@index([assignedToUserId, status])
  @@index([runId, status])
  @@index([localResourceType, localResourceId])
}

/// Append-only human resolution evidence. Financial discrepancies remain
/// investigating until an independent reviewer approves one pending proposal.
model WeChatReconciliationResolutionProposal {
  id                   String                                       @id @default(uuid())
  issueId              String
  outcome              WeChatReconciliationIssueStatus
  resolutionCode       String
  resolutionNote       String
  evidenceReference    String
  evidenceDigestSha256 String
  proposedByUserId     String
  proposedAt           DateTime                                     @default(now())
  status               WeChatReconciliationResolutionProposalStatus @default(pending)
  reviewedByUserId     String?
  reviewedAt           DateTime?
  reviewNote           String?

  issue      WeChatReconciliationIssue @relation(fields: [issueId], references: [id], onDelete: Restrict)
  proposedBy User                      @relation("WeChatReconciliationResolutionProposer", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  reviewedBy User?                     @relation("WeChatReconciliationResolutionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([issueId, status, proposedAt], map: "WeChatResolutionProposal_issue_status_time")
  @@index([status, proposedAt])
}

model PaymentDispute {
  id                          String                      @id @default(uuid())
  channel                     String
  type                        String
  providerDisputeId           String
  idempotencyKey              String                      @unique
  orderId                     String?
  paymentId                   String?
  outTradeNo                  String?
  status                      PaymentDisputeStatus        @default(pendingSync)
  providerStatus              String?
  problemType                 String?
  complaintDetail             String?
  complaintOccurredAt         DateTime?
  firstResponseDueAt          DateTime?
  resolutionDueAt             DateTime?
  firstRespondedAt            DateTime?
  resolvedAt                  DateTime?
  incomingUserResponse        Boolean                     @default(false)
  complaintCount              Int                         @default(1)
  complaintFullRefunded       Boolean                     @default(false)
  requiresImmediateService    Boolean                     @default(false)
  inPlatformService           Boolean                     @default(false)
  applyRefundAmountCents      Int?
  latestActionType            String?
  fundingStatus               PaymentDisputeFundingStatus @default(unlinked)
  assignedSupportUserId       String?
  assignedAt                  DateTime?
  completionRequestId         String?                     @unique
  completionStatus            PaymentDisputeReplyStatus?
  completionProviderReference String?
  completionRequestedById     String?
  completionRequestedAt       DateTime?
  providerQueryAttempts       Int                         @default(0)
  lastProviderSyncAt          DateTime?
  nextReconcileAt             DateTime?
  reconcileLeaseToken         String?
  reconcileLeaseUntil         DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  order             Order?                           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment           PaymentTransaction?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  replies           PaymentDisputeReply[]
  attachments       PaymentDisputeAttachment[]
  notifications     PaymentDisputeNotification[]
  negotiationEvents PaymentDisputeNegotiationEvent[]
  complaintOrders   PaymentDisputeOrder[]
  recoveries        CompanionRecovery[]

  @@unique([channel, providerDisputeId])
  @@index([status, resolutionDueAt])
  @@index([nextReconcileAt, reconcileLeaseUntil])
  @@index([orderId, status])
  @@index([paymentId])
  @@index([outTradeNo])
  @@index([assignedSupportUserId, status])
}

/// One provider complaint can cover multiple transactions. An unmatched
/// outTradeNo remains durable and keeps the complaint financially unlinked.
model PaymentDisputeOrder {
  id             String    @id @default(uuid())
  disputeId      String
  orderId        String?
  paymentId      String?
  outTradeNo     String
  transactionId  String?
  amountCents    Int
  providerSeenAt DateTime  @default(now())
  matchedAt      DateTime?

  dispute PaymentDispute      @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  order   Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment PaymentTransaction? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([disputeId, outTradeNo])
  @@index([orderId, disputeId])
  @@index([paymentId])
  @@index([outTradeNo])
}

model PaymentDisputeReply {
  id                String                    @id @default(uuid())
  disputeId         String
  actorId           String
  clientRequestId   String                    @unique
  content           String
  status            PaymentDisputeReplyStatus @default(submitting)
  providerReference String?
  submittedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  dispute     PaymentDispute             @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  actor       User                       @relation("PaymentDisputeReplyActor", fields: [actorId], references: [id], onDelete: Restrict)
  attachments PaymentDisputeAttachment[]

  @@index([disputeId, createdAt])
  @@index([actorId, createdAt])
}

// Only provider media identifiers or irreversible URL digests are retained;
// remote complaint URLs and binary complaint evidence are not copied here.
model PaymentDisputeAttachment {
  id              String   @id @default(uuid())
  disputeId       String
  replyId         String?
  source          String
  mediaType       String
  providerMediaId String?
  remoteUrlDigest String?
  createdAt       DateTime @default(now())

  dispute PaymentDispute       @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  reply   PaymentDisputeReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([disputeId, source, providerMediaId])
  @@unique([disputeId, source, remoteUrlDigest])
  @@index([replyId])
}

// The encrypted callback body is deliberately not persisted. Retain only the
// official notification identifiers, compact summary and a replay digest.
model PaymentDisputeNotification {
  id                     String    @id @default(uuid())
  disputeId              String
  providerNotificationId String    @unique
  eventType              String
  actionType             String
  summary                String?
  rawDigest              String
  providerCreatedAt      DateTime?
  receivedAt             DateTime  @default(now())

  dispute PaymentDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId, receivedAt])
}

// Immutable, provider-authored negotiation history. Text is needed by the
// assigned case worker; remote evidence URLs are reduced to SHA-256 digests.
model PaymentDisputeNegotiationEvent {
  id             String    @id @default(uuid())
  disputeId      String
  providerLogId  String
  operator       String
  operateType    String
  operateDetails String?
  operatedAt     DateTime?
  mediaDigests   String[]  @default([])
  createdAt      DateTime  @default(now())

  dispute PaymentDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@unique([disputeId, providerLogId])
  @@index([disputeId, operatedAt])
}

model CommunityPost {
