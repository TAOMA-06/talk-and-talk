  updatedAt                 DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([userId, companionId])
  @@index([userId, createdAt])
  @@index([companionId])
}

// A companion-owned, reason-free boundary for future marketplace activity
// with one customer. It never changes existing orders, conversations, support,
// moderation, reviews, or account standing, and is never exposed to the
// customer. Removing the row restores the default without retaining a private
// relationship-choice history.
model CompanionCustomerFutureBoundary {
  id             String   @id @default(uuid())
  companionId    String
  customerUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)
  customer  User             @relation("FutureBookingBoundaryCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)

  @@unique([companionId, customerUserId])
  @@index([customerUserId, createdAt])
  @@index([companionId, createdAt])
}

