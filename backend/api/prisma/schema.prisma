  companionId String
  tagId       String

  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)
  tag       ServiceTag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companionId, tagId])
  @@index([tagId])
}

model CompanionServiceOffering {
  id              String                       @id @default(uuid())
  companionId     String
  code            String
  title           String
  description     String?
  deliveryMode    CompanionServiceOfferingMode
  durationMinutes Int
  priceCents      Int
  currency        String                       @default("CNY")
  topicIds        String[]                     @default([])
  isActive        Boolean                      @default(true)
  sortOrder       Int                          @default(0)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@unique([companionId, code])
  @@index([companionId, isActive, sortOrder])
}

model CompanionAvailabilityWindow {
  id                          String    @id @default(uuid())
  companionId                 String
  startsAt                    DateTime
  endsAt                      DateTime
  capacity                    Int       @default(1)
  isActive                    Boolean   @default(true)
  recurringAvailabilityRuleId String?
  recurringOccurrenceStartsAt DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  companion                      CompanionProfile                    @relation(fields: [companionId], references: [id], onDelete: Cascade)
  recurringAvailabilityRule      CompanionRecurringAvailabilityRule? @relation("RecurringAvailabilityGeneratedWindows", fields: [recurringAvailabilityRuleId], references: [id], onDelete: SetNull)
  orders                         Order[]
  availabilityReminderCandidates AvailabilityReminderCandidate[]
  availabilityReminderFanoutJobs AvailabilityReminderFanoutJob[]

  @@unique([recurringAvailabilityRuleId, recurringOccurrenceStartsAt], map: "CompanionAvailabilityWindow_recurringAvailabilityRuleId_recurri")
  @@index([companionId, isActive, startsAt])
  @@index([companionId, isActive, endsAt])
  @@index([companionId, recurringAvailabilityRuleId, recurringOccurrenceStartsAt], map: "CompanionAvailabilityWindow_companionId_recurringAvailabilityRu")
}

// A weekly template is intentionally not itself a bookable window. It stores
// only a Shanghai-local day/time range for a future, separately controlled
// materializer; no order, public availability, or notification reads it yet.
model CompanionRecurringAvailabilityRule {
  id             String   @id @default(uuid())
  companionId    String
  weekday        Int
  startsAtMinute Int
  endsAtMinute   Int
  capacity       Int      @default(1)
  timezone       String   @default("Asia/Shanghai")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companion                    CompanionProfile              @relation(fields: [companionId], references: [id], onDelete: Cascade)
  generatedAvailabilityWindows CompanionAvailabilityWindow[] @relation("RecurringAvailabilityGeneratedWindows")

  @@index([companionId, isActive, weekday, startsAtMinute], map: "CompanionRecurringAvailabilityRule_companionId_isActive_weekday")
}

// A blackout is a one-off, private schedule exception. It deliberately has no
// free-text reason or user-facing state: it will only guide a future window
// materializer and cannot alter existing windows or bookings on its own.
model CompanionAvailabilityBlackout {
  id          String   @id @default(uuid())
  companionId String
  startsAt    DateTime
  endsAt      DateTime
  timezone    String   @default("Asia/Shanghai")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@index([companionId, isActive, startsAt])
  @@index([companionId, isActive, endsAt])
}

// A private, deduplicated hint that one structured availability window was
// created or reactivated. It is not a notification intent or delivery record;
// the future delivery path must recheck every current condition before use.
model AvailabilityReminderCandidate {
  id                          String                                   @id @default(uuid())
  favoriteId                  String
  companionId                 String
  availabilityWindowId        String
  availabilityWindowUpdatedAt DateTime
  preflightDecision           AvailabilityReminderCandidateDecision    @default(pending)
  preflightReason             AvailabilityReminderCandidateSkipReason?
  preflightedAt               DateTime?
  preparationLeaseToken       String?                                  @unique(map: "AvailabilityReminderCandidate_preparation_token")
  preparationLeaseExpiresAt   DateTime?
  preparationFailureCount     Int                                      @default(0)
  preparationNextAttemptAt    DateTime                                 @default(now())
  preparationLastErrorCode    String?
  preparationFailedAt         DateTime?
  createdAt                   DateTime                                 @default(now())

  favorite           CompanionFavorite            @relation(fields: [favoriteId], references: [id], onDelete: Cascade)
  companion          CompanionProfile             @relation(fields: [companionId], references: [id], onDelete: Cascade)
  availabilityWindow CompanionAvailabilityWindow  @relation(fields: [availabilityWindowId], references: [id], onDelete: Cascade)
  handoff            AvailabilityReminderHandoff?

  @@unique([favoriteId, availabilityWindowId, availabilityWindowUpdatedAt], map: "AvailabilityReminderCandidate_favoriteId_availabilityWindowId_a")
  @@index([favoriteId, createdAt])
  @@index([companionId, createdAt])
  @@index([availabilityWindowId, createdAt], map: "AvailabilityReminderCandidate_availabilityWindowId_createdAt_id")
  @@index([preflightDecision, createdAt])
  @@index([preflightDecision, preparationNextAttemptAt, createdAt, id], map: "AvailabilityReminderCandidate_preparation_due")
  @@index([preparationLeaseExpiresAt], map: "AvailabilityReminderCandidate_preparation_lease")
}

// One immutable window-version event is expanded in stable favorite-id pages.
// A processing lease makes crashes recoverable; the unique window/version key
// and candidate key make enqueueing and every batch idempotent.
model AvailabilityReminderFanoutJob {
  id                          String                           @id @default(uuid())
  companionId                 String
  availabilityWindowId        String
  availabilityWindowUpdatedAt DateTime
  audienceCutoffAt            DateTime
  status                      AvailabilityReminderFanoutStatus @default(pending)
  cursorUserId                String?
  cursorFavoriteId            String?
  scannedCount                Int                              @default(0)
  candidateCreatedCount       Int                              @default(0)
  failureCount                Int                              @default(0)
  nextAttemptAt               DateTime                         @default(now())
  leaseToken                  String?                          @unique
  leaseExpiresAt              DateTime?
  lastErrorCode               String?
  completedAt                 DateTime?
  failedAt                    DateTime?
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt

  companion          CompanionProfile            @relation(fields: [companionId], references: [id], onDelete: Cascade)
  availabilityWindow CompanionAvailabilityWindow @relation(fields: [availabilityWindowId], references: [id], onDelete: Cascade)

  @@unique([availabilityWindowId, availabilityWindowUpdatedAt], map: "AvailabilityReminderFanoutJob_windowId_windowUpdatedAt")
  @@index([status, nextAttemptAt, updatedAt, id], map: "AvailabilityReminderFanoutJob_due")
  @@index([status, leaseExpiresAt], map: "AvailabilityReminderFanoutJob_lease")
  @@index([companionId, createdAt, id], map: "AvailabilityReminderFanoutJob_companion_createdAt_id")
}

// A one-to-one, server-only handoff for an already eligible candidate. It is
// intentionally not a notification, delivery, schedule, recipient record, or
// provider attempt. The later delivery stage must recheck live state again.
model AvailabilityReminderHandoff {
  id                        String                                    @id @default(uuid())
  candidateId               String                                    @unique
  reservationProcessedAt    DateTime?
  reservationOutcomeReason  AvailabilityReminderAttemptOutcomeReason?
  reservationLeaseToken     String?                                   @unique(map: "AvailabilityReminderHandoff_reservation_token")
  reservationLeaseExpiresAt DateTime?
  reservationFailureCount   Int                                       @default(0)
  reservationNextAttemptAt  DateTime                                  @default(now())
  reservationLastErrorCode  String?
  reservationFailedAt       DateTime?
  createdAt                 DateTime                                  @default(now())

  candidate AvailabilityReminderCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  attempt   AvailabilityReminderAttempt?

  @@index([createdAt])
  @@index([reservationProcessedAt, createdAt, id], map: "AvailabilityReminderHandoff_reservation_due")
  @@index([reservationProcessedAt, reservationNextAttemptAt, createdAt, id], map: "AvailabilityReminderHandoff_worker_due")
  @@index([reservationLeaseExpiresAt], map: "AvailabilityReminderHandoff_worker_lease")
}

// A durable, one-to-one authorization state record for a private handoff. It
// has no recipient payload, in-app notification, or message body. Its final
// stages may consume only this exact bound grant, issue a short private lease,
// and retain a minimal provider acknowledgement or error classification.
model AvailabilityReminderAttempt {
  id                        String                                    @id @default(uuid())
  handoffId                 String                                    @unique
  subscriptionGrantId       String                                    @unique
  status                    AvailabilityReminderAttemptStatus         @default(reserved)
  outcomeReason             AvailabilityReminderAttemptOutcomeReason?
  authorizationConsumedAt   DateTime?
  sendLeaseToken            String?                                   @unique
  sendLeaseExpiresAt        DateTime?
  providerAttemptStartedAt  DateTime?
  providerResolvedAt        DateTime?
  providerMessageId         String?
  providerErrorCode         String?
  deliveryClaimToken        String?                                   @unique(map: "AvailabilityReminderAttempt_delivery_token")
  deliveryClaimExpiresAt    DateTime?
  deliveryFailureCount      Int                                       @default(0)
  deliveryNextAttemptAt     DateTime                                  @default(now())
  deliveryLastErrorCode     String?
  deliveryFailedAt          DateTime?
  operationalResolvedAt     DateTime?
  operationalResolvedById   String?
  operationalResolutionCode String?
  operationalResolutionNote String?
  operationalEvidenceRef    String?
  createdAt                 DateTime                                  @default(now())
  updatedAt                 DateTime                                  @updatedAt

  handoff               AvailabilityReminderHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  subscriptionGrant     WeChatSubscriptionGrant     @relation(fields: [subscriptionGrantId], references: [id], onDelete: Cascade)
  operationalResolvedBy User?                       @relation("AvailabilityReminderAttemptOperationalResolver", fields: [operationalResolvedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([status, sendLeaseExpiresAt])
  @@index([status, providerAttemptStartedAt])
  @@index([status, deliveryNextAttemptAt, createdAt, id], map: "AvailabilityReminderAttempt_delivery_due")
  @@index([deliveryClaimExpiresAt], map: "AvailabilityReminderAttempt_delivery_claim")
  @@index([status, operationalResolvedAt, createdAt, id], map: "AvailabilityReminderAttempt_terminal_resolution")
  @@index([operationalResolvedById, operationalResolvedAt], map: "AvailabilityReminderAttempt_operational_resolver")
}

model VerificationCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, consumedAt, expiresAt, createdAt, id], map: "VerificationCode_active_lookup")
  @@index([expiresAt, id], map: "VerificationCode_retention_due")
}

model RefreshToken {
  id             String    @id @default(uuid())
  userId         String
  tokenHash      String    @unique
  sessionLabel   String?
  clientPlatform String?
  lastUsedAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt, id], map: "RefreshToken_retention_due")
}
