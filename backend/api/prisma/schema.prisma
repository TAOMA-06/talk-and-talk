  content              String
  targetId             String?
  messageId            String?
  automaticCaseKey     String?               @unique
  conversationId       String?
  subjectUserId        String?
  reporterUserId       String?
  priority             ModerationPriority    @default(normal)
  dueAt                DateTime?
  assignedToUserId     String?
  policyVersion        String                @default("chat-v2")
  provider             String?
  providerVersion      String?
  aiScore              Float
  aiReason             String
  decision             ModerationDecision
  matchedRules         String[]
  usedAI               Boolean               @default(false)
  resolvedAt           DateTime?
  appealDeadlineAt     DateTime?
  appealPolicyVersion  String?
