  status                    String    @default("pending")
  reasonCode                String    @db.VarChar(64)
  authorityReference        String    @db.VarChar(160)
  policyVersion             String    @db.VarChar(64)
  policyApprovalReference   String    @db.VarChar(160)
  requestedById             String
  requestedAt               DateTime  @default(now())
  decidedById               String?
  decidedAt                 DateTime?
  decisionReference         String?   @db.VarChar(160)
  decisionReasonCode        String?   @db.VarChar(64)
  clientRequestId           String    @db.VarChar(80)
  partialErasurePhase       String?
  partialErasureCursor      String?
  partialErasedRecordCount  Int
  partialExpiryAttemptCount Int
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  retentionRecord AccountDataRetentionRecord     @relation(fields: [retentionRecordId], references: [id], onDelete: Restrict, map: "RetentionLegalHoldAction_record_fkey")
  legalHold       AccountDataRetentionLegalHold? @relation("RetentionLegalHoldReleaseRequests", fields: [legalHoldId], references: [id], onDelete: Restrict, map: "RetentionLegalHoldAction_hold_fkey")
  placementFor    AccountDataRetentionLegalHold? @relation("RetentionLegalHoldPlacementAction")
  releaseFor      AccountDataRetentionLegalHold? @relation("RetentionLegalHoldReleaseAction")
  requestedBy     User                           @relation("RetentionLegalHoldActionRequester", fields: [requestedById], references: [id], onDelete: Restrict, map: "RetentionLegalHoldAction_requestedBy_fkey")
  decidedBy       User?                          @relation("RetentionLegalHoldActionDecider", fields: [decidedById], references: [id], onDelete: Restrict, map: "RetentionLegalHoldAction_decidedBy_fkey")

  @@unique([requestedById, clientRequestId], map: "RetentionLegalHoldAction_requester_client_key")
  @@index([retentionRecordId, action, status, requestedAt, id], map: "RetentionLegalHoldAction_record_queue")
  @@index([legalHoldId, action, status, requestedAt, id], map: "RetentionLegalHoldAction_hold_queue")
