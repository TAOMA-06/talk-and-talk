generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  companion
  moderator
  admin
}

enum AuthProvider {
  phone
  apple
  wechatMiniProgram
}

enum AccountStatus {
  active
  restricted
  banned
}

enum Availability {
  online
  available
  busy
}

enum MessageType {
  text
  system
  safety
}

enum ModerationDecision {
  allow
  warn
  block
  review
}

enum RiskLevel {
  low
  medium
  high
}

enum ModerationSource {
  chat
  community
  report
  profile
}

enum ModerationCaseStatus {
  pending
  autoReviewing
  humanReview
  resolved
  dismissed
}

enum OrderStatus {
  pending
  paying
  paid
  inService
  completed
  cancelled
  refunded
}

enum PaymentTxnStatus {
  initiated
  success
  failed
  closed
}

enum RefundTxnStatus {
  pendingReview
  pending
  processing
  success
  failed
  rejected
}

enum CommunityPostKind {
  femaleRequest
  malePromotion
}

enum CommunityPostStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  paymentSuccess
  orderStatus
  moderationAlert
  safetyAlert
}

enum DeletionRequestStatus {
  pending
  processing
  completed
  cancelled
}

model User {
  id            String        @id @default(uuid())
  role          UserRole      @default(user)
  accountStatus AccountStatus @default(active)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  identities    AuthIdentity[]
  profile       UserProfile?
  refreshTokens RefreshToken[]
  conversations Conversation[]
  readStates    MessageReadState[]
  orders        Order[]
  notifications Notification[]
  deletionRequests AccountDeletionRequest[]
  companionProfile CompanionProfile? @relation("CompanionOwner")
  communityPosts CommunityPost[]
  communityLikes CommunityLike[]
  reviews Review[]
}

model AuthIdentity {
  id         String       @id @default(uuid())
  userId     String
  provider   AuthProvider
  providerId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model UserProfile {
  userId      String  @id
  displayName String?
  phone       String?
  age         Int?
  gender      String?
  isVerified  Boolean @default(false)
  safetyScore Int     @default(80)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanionProfile {
  id               String       @id
  ownerUserId      String?      @unique
  name             String
  role             String
  initials         String
  rating           Float        @default(0)
  reviewCount      Int          @default(0)
  pricePerHalfHour Int
  isOnline         Boolean      @default(false)
  isVerified       Boolean      @default(false)
  bio              String
  availableTimes   String[]
  languages        String[]
  specialties      String[]
  completedOrders  Int          @default(0)
  responseTime     String
  distanceKm       Float        @default(0)
  availability     Availability @default(available)
  cityDistrict     String
  isPublished      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  serviceTags      CompanionServiceTag[]
  conversations    Conversation[]
  orders           Order[]
  owner            User?        @relation("CompanionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  reviews          Review[]

  @@index([isPublished, availability])
  @@index([isOnline])
  @@index([ownerUserId])
}

model Conversation {
  id          String   @id @default(uuid())
  externalId  String
  userId      String
  companionId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion CompanionProfile   @relation(fields: [companionId], references: [id], onDelete: Cascade)
  messages  Message[]
  readStates MessageReadState[]
  orders    Order[]

  @@unique([userId, externalId])
  @@unique([userId, companionId])
  @@index([userId, updatedAt])
  @@index([companionId])
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  companionId     String
  themeId         String
  durationMinutes Int
  amountCents     Int
  currency        String      @default("CNY")
  status          OrderStatus @default(pending)
  scheduledAt     DateTime
  companionNameSnapshot String
  companionRoleSnapshot String
  companionInitialsSnapshot String
  themeNameSnapshot String
  conversationId  String?
  paidAt          DateTime?
  cancelledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion    CompanionProfile     @relation(fields: [companionId], references: [id], onDelete: Restrict)
  conversation Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  payments     PaymentTransaction[]
  refunds      RefundTransaction[]
  reviews      Review[]

  @@index([userId, createdAt])
  @@index([companionId, status])
  @@index([status, createdAt])
  @@index([conversationId])
}

model PaymentTransaction {
  id            String           @id @default(uuid())
  orderId       String
  outTradeNo    String           @unique
  provider      String           @default("wechat")
  amountCents   Int
  status        PaymentTxnStatus @default(initiated)
  prepayId      String?
  transactionId String?
  clientParams  Json?
  notifyPayload Json?
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  order   Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds RefundTransaction[]

  @@unique([provider, transactionId])
  @@index([orderId])
  @@index([status])
}

model RefundTransaction {
  id               String          @id @default(uuid())
  orderId          String
  paymentId        String
  outRefundNo      String          @unique
  amountCents      Int
  status           RefundTxnStatus @default(pending)
  reason           String?
  providerRefundId String?
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  failureReason    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order   Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paymentId])
}

model CommunityPost {
  id               String              @id @default(uuid())
  authorId         String
  kind             CommunityPostKind
  topic            String
  content          String
  coverImageUrl    String?
  coverAspectRatio Float?
  status           CommunityPostStatus @default(pending)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  author User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes  CommunityLike[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
}

model CommunityLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model Review {
  id          String   @id @default(uuid())
  orderId     String   @unique
  userId      String
  companionId String
  rating      Int
  content     String
  createdAt   DateTime @default(now())

  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Restrict)

  @@index([companionId, createdAt])
  @@index([userId, createdAt])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  senderName     String?
  content        String
  type           MessageType @default(text)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@index([senderId])
}

model MessageReadState {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  readAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ModerationCase {
  id           String               @id @default(uuid())
  title        String
  category     String
  riskLevel    RiskLevel
  status       ModerationCaseStatus @default(pending)
  source       ModerationSource
  content      String
  targetId     String?
  messageId    String?
  aiScore      Float
  aiReason     String
  decision     ModerationDecision
  matchedRules String[]
  usedAI       Boolean              @default(false)
  resolvedAt   DateTime?
  createdAt    DateTime             @default(now())
  evidences    ModerationEvidence[]
  actionLogs   ModerationActionLog[]

  @@index([source, status])
  @@index([targetId])
  @@index([status, createdAt])
  @@index([riskLevel, createdAt])
  @@index([createdAt])
}

model ModerationEvidence {
  id        String   @id @default(uuid())
  caseId    String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model ModerationActionLog {
  id        String   @id @default(uuid())
  caseId    String
  actorId   String?
  action    String
  note      String?
  createdAt DateTime @default(now())

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model AccountDeletionRequest {
  id        String                @id @default(uuid())
  userId    String
  status    DeletionRequestStatus @default(pending)
  note      String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
}

model ModerationLabel {
  id               String              @id @default(uuid())
  text             String
  expectedDecision ModerationDecision
  actualDecision   ModerationDecision
  note             String?
  caseId           String?
  actorId          String?
  source           ModerationSource?
  createdAt        DateTime            @default(now())

  @@index([createdAt])
  @@index([caseId])
}

model ServiceTag {
  id         String   @id @default(uuid())
  name       String   @unique
  createdAt  DateTime @default(now())
  companions CompanionServiceTag[]
}

model CompanionServiceTag {
  companionId String
  tagId       String

  companion CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)
  tag       ServiceTag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companionId, tagId])
  @@index([tagId])
}

model VerificationCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
