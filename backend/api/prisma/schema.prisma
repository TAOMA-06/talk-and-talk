  previousIsVerified  Boolean
  status              IdentityVerificationRequestStatus @default(pending)
  reason              String
  evidenceReference   String                            @unique
  submittedById       String
  submittedAt         DateTime                          @default(now())
  reviewedById        String?
  reviewedAt          DateTime?
  reviewReason        String?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt

  subject     User  @relation("IdentityVerificationSubject", fields: [userId], references: [id], onDelete: Restrict)
  submittedBy User  @relation("IdentityVerificationSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("IdentityVerificationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, submittedAt])
  @@index([userId, status, createdAt])
  @@index([submittedById, createdAt])
  @@index([reviewedById, reviewedAt])
