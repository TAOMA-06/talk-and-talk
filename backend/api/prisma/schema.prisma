  recommendationRequests               RecommendationRequest[]
  companionRecommendationExclusions    UserCompanionRecommendationExclusion[]
  futureBookingBoundariesAsCustomer    CompanionCustomerFutureBoundary[]         @relation("FutureBookingBoundaryCustomer")
  companionFavorites                   CompanionFavorite[]
  companionRecentViews                 CompanionRecentView[]
  voiceAttendanceEvents                VoiceAttendanceEvent[]                   @relation("VoiceAttendanceEventParticipant")
  openedAttendanceDisputes             AttendanceDispute[]                      @relation("AttendanceDisputeOpenedBy")
  attendanceDisputeCounterparties      AttendanceDispute[]                      @relation("AttendanceDisputeCounterparty")
  assignedAttendanceDisputes           AttendanceDispute[]                      @relation("AttendanceDisputeAssignee")
  assignedRefunds                      RefundTransaction[]                      @relation("RefundAssignee")
  decidedAttendanceDisputes            AttendanceDispute[]                      @relation("AttendanceDisputeDecider")
  appealedAttendanceDisputes           AttendanceDispute[]                      @relation("AttendanceDisputeAppealedBy")
  appealAssignedAttendanceDisputes     AttendanceDispute[]                      @relation("AttendanceDisputeAppealAssignee")
