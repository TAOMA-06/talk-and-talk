  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

// A reporter-owned receipt for one currently public post. The full reason and
// staff evidence live only in the linked moderation case; this row exists to
// make duplicate submission atomic without turning reports into social data.
model CommunityPostReport {
  id               String   @id @default(uuid())
